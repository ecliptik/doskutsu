@@ -408,6 +413,12 @@ void Pixtone::shutdown()
 
 int Pixtone::play(int32_t chan, int32_t slot, int32_t loop)
 {
+  // patch 0131 (Phase 11 wave-35 Phase 12 audio instrumentation):
