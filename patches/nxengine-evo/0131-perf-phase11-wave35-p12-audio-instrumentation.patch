diff --git a/src/Utils/diagnostic_timers.h b/src/Utils/diagnostic_timers.h
index e3b014d..220fe38 100644
--- a/src/Utils/diagnostic_timers.h
+++ b/src/Utils/diagnostic_timers.h
@@ -1002,6 +1002,109 @@ bool p10_audio_instr_active();
 // BK_FOLLOWFG / BK_FASTLEFT branches are clipped.
 bool bg_subregion_active();
 
+// patch 0131 (Phase 11 wave-35 Phase 12 instrumentation contract per
+// `docs/PHASE11-WAVE-35-CONTRACT.md` § 8). Engine-side P12 audio
+// brackets — pre-instrumentation iter for the wave-36+ Phase 12
+// audio-cost-attribution optimization program. The wave-33 § 7 anchor
+// that put "Phase 12 Pixtone-decouple" at rank #1 was based on a
+// pre-port-era understanding of Pixtone synthesis (per-frame); tree-
+// grep revealed Pixtone is ALREADY pre-rendered at init (line 318
+// `snd.render()` runs once per .pxt slot). The ~31 ms unattributed
+// audio cost from `audio_cost_attribution_unknown.md` lives somewhere
+// in: main-thread MidiScheduler::tick + Pixtone::play/stop dispatch,
+// or audio-thread SDL3_mixer mix-down, or cross-thread cooperative-
+// scheduler yield. Wave-35 instrumentation decomposes the slice into
+// timeable sub-buckets so wave-36 can attack the right one.
+//
+// 3 main-thread counter pairs + 6 RAII bracket timers per § 8 contract:
+//
+//   midi_tick:    MidiScheduler::tick body bracket (per-frame, all
+//                 backends that dispatch through MidiScheduler — opl3,
+//                 wb, midi_stub). Captures MIDI event dispatch + per-
+//                 backend register writes (OPL3 ADL writes; WB MPU-401
+//                 writes; midi_stub LOG_DEBUG silence).
+//   pixtone_play: Pixtone::play + Pixtone::playResampled body bracket
+//                 (per-SFX-trigger). Captures the MIX_StopTrack +
+//                 MIX_SetTrackAudio + MIX_PlayTrack chain cost + (in
+//                 playResampled) SDL_AudioStream resample cost on first
+//                 (slot, percent) hit.
+//   pixtone_stop: Pixtone::stop body bracket (per-SFX-event). Captures
+//                 the MIX_StopTrack call cost.
+//
+// All gated on SDL_HINT_DOSKUTSU_P12_AUDIO_INSTR=1 (strict-"1"; default
+// OFF). Cost when env off: ~zero (cached static-const-bool; -O3 hoists
+// the per-call guard). Cost when env on: ~6 SDL_GetTicksNS reads per
+// flip (MidiScheduler::tick) + ~2 reads per SFX trigger (rare).
+//
+// Audit-emit line in _maybe_flush_phase_timing_audit (Renderer.cpp,
+// gated on FLIP_INSTR per § 8): one-liner with all 6 counter values.
+// Per-block reset cluster runs unconditionally to keep cadence clean.
+//
+// Cross-thread NOTE: these brackets are MAIN THREAD only. Audio-thread
+// SDL3_mixer mix-down is sdl-engine's SDL/0054 lane (separate patch);
+// IRQ-5 ISR work is covered by patch 0100 existing exports
+// (g_p10_audio_irq_count_block / g_p10_audio_irq_wall_us_block). Cross-
+// thread synchronization not required — main-thread-only writes from
+// engine-owned code paths.
+extern std::uint64_t g_p12_midi_tick_accum_ns_block;
+extern std::uint32_t g_p12_midi_tick_count_block;
+extern std::uint64_t g_p12_pixtone_play_accum_ns_block;
+extern std::uint32_t g_p12_pixtone_play_count_block;
+extern std::uint64_t g_p12_pixtone_stop_accum_ns_block;
+extern std::uint32_t g_p12_pixtone_stop_count_block;
+
+// Forward-decl env helper. Definition in Renderer.cpp anonymous-
+// namespace ablation cluster; file-scope wrapper at end-of-file per
+// W20B build-fix amendment. Strict-"1" match per CLAUDE.md convention;
+// default OFF (instrumentation has per-call cost; opt-in only).
+bool p12_audio_instr_active();
+
+// RAII timer structs — pattern matches MdtBgBackdropTimer (slot 0125).
+// Constructor reads SDL_GetTicksNS unconditionally; destructor
+// short-circuits on the env-helper guard (the cached const-bool keeps
+// the guard out of the hot per-flip path at -O3). Off-path overhead:
+// 2 SDL_GetTicksNS calls per construction + 1 guard read on destruct.
+// On-path: same 2 reads + 1 accumulator add + 1 counter increment.
+//
+// Per call site: place RAII timer at function entry; scope ends at
+// function exit. All return paths (early return, normal fall-through)
+// trigger the destructor identically.
+struct P12MidiTickTimer
+{
+  std::uint64_t t0;
+  P12MidiTickTimer() : t0(SDL_GetTicksNS()) {}
+  ~P12MidiTickTimer()
+  {
+    if (!p12_audio_instr_active()) return;
+    g_p12_midi_tick_accum_ns_block += SDL_GetTicksNS() - t0;
+    ++g_p12_midi_tick_count_block;
+  }
+};
+
+struct P12PixtonePlayTimer
+{
+  std::uint64_t t0;
+  P12PixtonePlayTimer() : t0(SDL_GetTicksNS()) {}
+  ~P12PixtonePlayTimer()
+  {
+    if (!p12_audio_instr_active()) return;
+    g_p12_pixtone_play_accum_ns_block += SDL_GetTicksNS() - t0;
+    ++g_p12_pixtone_play_count_block;
+  }
+};
+
+struct P12PixtoneStopTimer
+{
+  std::uint64_t t0;
+  P12PixtoneStopTimer() : t0(SDL_GetTicksNS()) {}
+  ~P12PixtoneStopTimer()
+  {
+    if (!p12_audio_instr_active()) return;
+    g_p12_pixtone_stop_accum_ns_block += SDL_GetTicksNS() - t0;
+    ++g_p12_pixtone_stop_count_block;
+  }
+};
+
 }  // namespace Diag
 }  // namespace NXE
 
