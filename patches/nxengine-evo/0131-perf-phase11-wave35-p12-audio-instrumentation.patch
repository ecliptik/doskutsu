 // patch 0125 (Phase 11 wave-29 mds_tilemap_bg sub-decomposition):
 // mds_bg_instr_active() forward-decl joins the family. Same file-
 // scope-after-both-namespace-closes definition pattern (heeds W20B
@@ -773,6 +787,35 @@ inline bool _abl_bg_subregion()
   return v;
 }
 
+// DOS-PORT (patch 0131, Phase 11 wave-35 Phase 12 audio instrumentation
+// per docs/PHASE11-WAVE-35-CONTRACT.md § 8). Strict-"1" match, default
+// OFF (instrumentation has per-call cost — 2 SDL_GetTicksNS reads per
+// bracketed function + per-block accumulator updates). Opt-in via
+// SDL_HINT_DOSKUTSU_P12_AUDIO_INSTR=1 for the wave-35 measurement iter.
+//
+// Single env-var gates 3 bracket families:
+//   - MidiScheduler::tick body (main thread, per-frame)
+//   - Pixtone::play + Pixtone::playResampled bodies (main thread, per-
+//     SFX-trigger)
+//   - Pixtone::stop body (main thread, per-SFX-event)
+//
+// Same env-var convention as the wave-35 SDL/0054 sibling (sdl-engine
+// will use the SAME hint name so a single SET in the BAT enables both
+// engine-side and SDL-side bracket sets simultaneously).
+//
+// Cached static-const-bool — -O3 hoists the per-call guard out of the
+// RAII timer's destructor guard expression at most call sites; the
+// MidiScheduler::tick guard cannot hoist further because each tick()
+// call constructs a new RAII timer instance, but the cost on the off
+// path is one cached-bool branch + one SDL_GetTicksNS (constructor
+// unconditional read; destructor short-circuits before accumulator
+// touch).
+inline bool _abl_p12_audio_instr()
+{
+  static const bool v = _strict_truthy_env("SDL_HINT_DOSKUTSU_P12_AUDIO_INSTR");
+  return v;
+}
+
 // drawSurface NULL-texture diagnostic (Phase 7 black-screen bug, task #14).
 // Track which Surface objects produce NULL textures so we log each origin
 // once + a periodic running count, instead of hundreds of identical lines
@@ -1873,6 +1916,36 @@ void _maybe_flush_phase_timing_audit()
   NXE::Diag::g_bg_visible_y_recomputes_block     = 0;
   // (clip_top / clip_bot kept across boundary; they're sample-readout.)
 
+  // patch 0131 (Phase 11 wave-35 Phase 12 audio instrumentation per
+  // docs/PHASE11-WAVE-35-CONTRACT.md § 8). Emit [p12-audio ...] line
+  // gated on FLIP_INSTR (same gate as flip-stat / flip-body-stat /
+  // bg-subregion). Reports per-block accumulator sums in µs + counts
+  // for 3 main-thread audio brackets. Counts vary by event frequency:
+  // midi_tick_count typically ~100 per block (per-frame); pixtone_play
+  // / pixtone_stop counts ~SFX-trigger-rate × 100/fps (sparse in
+  // steady-state). Audio-thread + IRQ-5 timing comes from sibling
+  // SDL/0054 [p12-sdl ...] emit line (sdl-engine's lane).
+  if (_abl_flip_instr())
+  {
+    LOG_INFO("[p12-audio n=100 midi_tick_us={} midi_tick_count={} pixtone_play_us={} pixtone_play_count={} pixtone_stop_us={} pixtone_stop_count={}]",
+             (unsigned long)(NXE::Diag::g_p12_midi_tick_accum_ns_block / 1000ULL),
+             NXE::Diag::g_p12_midi_tick_count_block,
+             (unsigned long)(NXE::Diag::g_p12_pixtone_play_accum_ns_block / 1000ULL),
+             NXE::Diag::g_p12_pixtone_play_count_block,
+             (unsigned long)(NXE::Diag::g_p12_pixtone_stop_accum_ns_block / 1000ULL),
+             NXE::Diag::g_p12_pixtone_stop_count_block);
+  }
+  // patch 0131: reset all 6 P12 counters unconditionally — sample
+  // contents accumulated since prior reset; idx-style reset zeroes
+  // them for the next block. Per-flush guard above only emits;
+  // counters always reset cleanly.
+  NXE::Diag::g_p12_midi_tick_accum_ns_block    = 0;
+  NXE::Diag::g_p12_midi_tick_count_block       = 0;
+  NXE::Diag::g_p12_pixtone_play_accum_ns_block = 0;
+  NXE::Diag::g_p12_pixtone_play_count_block    = 0;
+  NXE::Diag::g_p12_pixtone_stop_accum_ns_block = 0;
+  NXE::Diag::g_p12_pixtone_stop_count_block    = 0;
+
   // DOS-PORT (patch 0124): reset W28 sub-bucket sample idx unconditionally
   // (sample-array contents are overwritten next flip; idx reset lets the
   // cadence repeat cleanly).
@@ -7117,3 +7190,10 @@ bool tile_bounds_skip_active() { return ::NXE::Graphics::_abl_tile_bounds_skip()
 namespace NXE { namespace Diag {
 bool bg_subregion_active() { return ::NXE::Graphics::_abl_bg_subregion(); }
 }}
+
+// DOS-PORT (patch 0131, Phase 11 wave-35 Phase 12 audio
+// instrumentation): p12_audio_instr_active() env-helper accessor.
+// Same file-scope-after-both-namespace-closes definition pattern.
+namespace NXE { namespace Diag {
+bool p12_audio_instr_active() { return ::NXE::Graphics::_abl_p12_audio_instr(); }
+}}
