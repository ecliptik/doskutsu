+  // (early-return on !chunk, _findFreeTrack failure, normal play
+  // dispatch) trigger the destructor identically.
+  NXE::Diag::P12PixtonePlayTimer _p12_ppt;
   if (_sound_fx[slot].chunk)
   {
     // DOS-PORT: same track-pool dispatch as playResampled(). chan == -1
@@ -504,6 +515,14 @@ int Pixtone::_findFreeTrack()
 
 int Pixtone::playResampled(int32_t chan, int32_t slot, int32_t loop, uint32_t percent)
 {
+  // patch 0131 (Phase 11 wave-35): share the play accumulator with
+  // Pixtone::play (playResampled is the same lever class — per-SFX-
+  // trigger dispatch). The first-call-per-(slot,percent) cost
+  // includes the SDL_AudioStream resample (CPU work proportional to
+  // raw_master_len) which is NOT amortized by the resampled[]
+  // cache after that; flush-instr's decomp distinguishes cached vs
+  // fresh by the count/avg ratio if it matters.
+  NXE::Diag::P12PixtonePlayTimer _p12_ppt;
