+// is the cached killswitch (SDL_HINT_DOSKUTSU_SKIP_REDUNDANT_CLEAR,
+// default-ON since the wave-53 validation iter; strict-"0" to disable).
+bool map_clear_is_redundant();
+bool skip_redundant_clear_enabled();
+
