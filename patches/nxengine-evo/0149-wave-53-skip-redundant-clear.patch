@@ -695,12 +695,21 @@ void DrawScene(void)
   NXE::Diag::g_mds_decomp_pass = NXE::Diag::MDS_PASS_CLEAR;
   {
     NXE::Diag::MdsClearTimer _mc;
-    if (!bg_skip_unchanged)
+    // patch 0149 (wave-53 lever 3 -- MODEX sec.5.7): skip the full-
+    // screen clearScreen(BLACK) when an opaque backdrop will provably
+    // repaint every screen row this frame -- the memset is redundant.
+    // Killswitch + predicate live in map.cpp; skip_redundant_clear_
