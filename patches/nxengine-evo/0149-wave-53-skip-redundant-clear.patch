+// DOS-PORT (patch 0149, Phase 11 wave-53 lever 3 -- MODEX sec.5.7):
+// cached killswitch for the skip-redundant-clearScreen lever.
+// SDL_HINT_DOSKUTSU_SKIP_REDUNDANT_CLEAR. DEFAULT-ON since the wave-53
+// validation iter (real-HW +1.02 fps, mechanism-verified, build-qa
+// pixel-identical SKIP=0-vs-=1 on the canonical scene); strict-"0" to
+// disable, matching the bg-skip / mds-clear-LUT lever-killswitch
+// convention. Sentinel-cached on first call (the
+// `_backdrop_cache_is_disabled()` idiom) -- never a per-flip getenv.
+// First call emits the build-qa BANNERS-grep banner.
+static int g_skip_redundant_clear = -1;  // -1 undecided / 0 off / 1 on
+bool skip_redundant_clear_enabled()
+{
+  if (g_skip_redundant_clear < 0)
+  {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_SKIP_REDUNDANT_CLEAR");
+    // Default-ON: enabled unless the env var is the literal "0".
+    g_skip_redundant_clear = (e && e[0] == '0' && e[1] == '\0') ? 0 : 1;
+    LOG_INFO("map: skip-redundant-clear lever {}",
+             g_skip_redundant_clear
+                 ? "ENABLED (default since wave-53 promotion)"
+                 : "DISABLED (SDL_HINT_DOSKUTSU_SKIP_REDUNDANT_CLEAR=0 killswitch)");
+  }
+  return g_skip_redundant_clear == 1;
+}
+
+// DOS-PORT (patch 0149, Phase 11 wave-53 lever 3): skip-clear predicate.
+// Returns true (DrawScene's clearScreen(BLACK) may be skipped) iff the
+// backdrop pass will provably repaint EVERY screen row this frame, so
+// the full-screen memset is pure redundant work. THE essential
+// correctness rule (design sec.1): never trust patch 0130's
+// FG-occlusion table for clear-coverage -- skip only when the BACKDROP
+// itself covers all rows. See WAVE-53-CLEAR-INTO-BACKDROP-DESIGN.md
+// sec.2.1. Called from game.cpp DrawScene, only when the killswitch is
+// on (short-circuited by skip_redundant_clear_enabled()).
+bool map_clear_is_redundant()
+{
+  switch (map.scrolltype)
+  {
+    case BK_HIDE:
+    case BK_HIDE2:
+    case BK_HIDE3:
+      // The HIDE* handler inside map_draw_backdrop self-does a full
+      // clearScreen, so clauses (3) backdrop-asset / (4) coverage are
+      // N/A -- allow through on (1)+(2) alone. Clause (2): the backdrop
+      // pass only runs when !flipacceltime; if set, no self-clear
+      // happens this frame -> DrawScene's clear is required.
+      return (flipacceltime == 0);
+
+    case BK_FIXED:
+    case BK_PARALLAX:
+    case BK_FOLLOWFG:
+      break;  // full-screen-image scrolltypes -- check clauses 2,3,4
+
+    default:
+      // BK_FASTLEFT / BK_FASTLEFT_LAYERS / NOFALLLEFT / anything else:
+      // full-screen backdrop coverage is not guaranteed (design sec.0)
+      // -- never skip the clear.
+      return false;
+  }
+
+  // Clause 2: the backdrop pass is gated on !flipacceltime in
+  // DrawScene; if set, the backdrop does not draw -> clear required.
+  if (flipacceltime != 0)
+    return false;
+
+  // Clause 3: the backdrop pass early-returns without drawing if the
+  // backdrop asset is not loaded -> on that path the clear is required.
+  if (!backdrop[map.backdrop])
+    return false;
+
+  // Clause 4: the backdrop must cover the FULL screen this frame. With
+  // patch 0130's sub-region partial-blit active (default-ON) the
+  // backdrop may blit only rows [bg_top, bg_bot]. Skip the clear only
+  // when that range is the whole screen. bg_subregion disabled ->
+  // backdrop always blits full-screen -> clause passes.
+  if (NXE::Diag::bg_subregion_active())
+  {
+    int bg_top = 0, bg_bot = 0;
+    // Same pre-draw computation patch 0130 runs inside
+    // map_draw_backdrop; this call warms its (curmap, mapy_tile) cache
+    // so the subsequent map_draw_backdrop call hits it -- one compute
+    // per frame, no added cost. The bool return is not used: whole-
+    // screen vs proper-subset vs degenerate-empty are all distinguished
+    // by the (bg_top,bg_bot) out-params directly.
+    _compute_bg_visible_yrange(&bg_top, &bg_bot);
+    const int sh = Renderer::getInstance()->screenHeight;
+    if (!(bg_top == 0 && bg_bot == sh - 1))
+      return false;  // backdrop blits only a sub-region -> keep clear
+  }
+
+  return true;
+}
+
 // for FindObject--finding NPC's by ID2
 Object *ID2Lookup[65536];
 
