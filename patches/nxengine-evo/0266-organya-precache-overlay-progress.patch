From b7b618c6a984c2162b978058d202767d475d5441 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Wed, 8 Jul 2026 14:09:47 -0700
Subject: [PATCH] patch 0266 -- #16: make the organya first-launch precache
 overlay actually visible on g2k

The organya first-launch auto-precache cold-renders each song for ~10-14 s
(minutes for the full set). rc3 proved the operator saw only "Loading.." and
quit, so the READY sentinel was never written and the batch re-triggered every
launch -- yet the per-song LOG showed the loop DID iterate (song 1/41) behind a
frozen frame.

ROOT CAUSE (present-path): past the first DIRTY_FIRST_N_FRAMES (=3) flips,
Renderer::flip() takes the direct-VESA fast path (patch 0086, default-ON), which
dosmemputs _cached_window_surface -> VRAM and SKIPS SDL_RenderPresent. The
overlay draws with PRIMITIVES only (clearScreen/font/drawRect/fillRect) and its
flips happen back-to-back deep inside the blocking precache render, all past
frame 3 -> on the direct-VESA path those primitive draws are never synced into
the surface that gets copied, so nothing reaches the display. showLoadingScreen
shows only because it is flip #1 (within first-N) -> forced full SDL_RenderPresent
path. So "Loading.." (the last full-path frame) stays frozen on screen while the
overlay's flips no-op.

FIX (engine-side, minimal, organya-only):
- New Renderer::forceFullPresent() sets _force_full_refresh (which flip() honors
  then self-clears each frame, and which gates the direct-VESA attempt off).
- _oc_draw_progress() calls forceFullPresent() before flip(), so every overlay
  frame takes the same proven-visible full SDL_RenderPresent path showLoadingScreen
  gets via first-N.
- Overlay text simplified to plain, clearly-worded lines per the operator steer:
  "Building music cache -- one-time, please wait" + "song N/total" (+ the coarse
  and intra-song bars, now actually visible). The rc3 spinner + heartbeat are
  dropped (the spinner never showed and is unnecessary once the frame presents).
- Keep the per-song LOG line so a returned DEBUG.LOG shows real batch progress.

No behavior change to the render / sentinel / ESC-skip logic. forceFullPresent
is a clean reusable primitive for any future pre-title primitive-drawn overlay.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 src/graphics/Renderer.cpp | 10 ++++++++++
 src/graphics/Renderer.h   | 12 ++++++++++++
 src/main.cpp              | 31 +++++++++++++++++++++++++------
 3 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/src/graphics/Renderer.cpp b/src/graphics/Renderer.cpp
index 05ce1ac3..99ca1ddf 100644
--- a/src/graphics/Renderer.cpp
+++ b/src/graphics/Renderer.cpp
@@ -4396,6 +4396,16 @@ const std::array<Uint8, 256>* Renderer::paletteRemapFor(const std::string &asset
   return nullptr;
 }
 
+// DOS-PORT (patch 0266, #16): force the next flip() onto the full
+// SDL_RenderPresent present path (skips the direct-VESA fast path for that
+// frame). flip() gates _dv_attempt on !_force_full_refresh and resets the flag
+// to false at the end of the flip, so this is a per-frame request. See the
+// header comment for the precache-overlay rationale.
+void Renderer::forceFullPresent()
+{
+  _force_full_refresh = true;
+}
+
 bool Renderer::flushAll()
 {
   LOG_DEBUG("Renderer::flushAll()");
diff --git a/src/graphics/Renderer.h b/src/graphics/Renderer.h
index db53f023..cc03c828 100644
--- a/src/graphics/Renderer.h
+++ b/src/graphics/Renderer.h
@@ -73,6 +73,18 @@ class Renderer
 
     bool flushAll();
 
+    // DOS-PORT (patch 0266, #16): force the NEXT flip() onto the full
+    // SDL_RenderPresent present path (sets _force_full_refresh, which flip()
+    // honors then self-clears). Needed by pre-title overlays that draw with
+    // primitives (clearScreen/font/drawRect/fillRect) rather than surface
+    // blits: past the first DIRTY_FIRST_N_FRAMES flips, flip() otherwise takes
+    // the direct-VESA fast path (patch 0086), which copies _cached_window_
+    // surface -> VRAM and skips SDL_RenderPresent, so primitive-only draws in a
+    // back-to-back flip phase (the organya auto-precache render) never reach
+    // the display. Calling this before the flip routes that frame through the
+    // same proven-visible full path showLoadingScreen gets via first-N.
+    void forceFullPresent();
+
     void showLoadingScreen();
 
     void drawSurface(Surface *src, int x, int y);
diff --git a/src/main.cpp b/src/main.cpp
index c1937bb3..e20aa209 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1309,18 +1309,22 @@ static void _oc_draw_progress(uint32_t cur_beat, uint32_t total_beats)
   const int H = r->screenHeight;
   r->clearScreen(0, 0, 0);
 
-  const char *line1 = "Rendering music (one time)...";
+  // DOS-PORT (patch 0266, #16): plain, clearly-worded lines on the screen the
+  // user already sees. (rc3 proved the earlier spinner overlay never reached
+  // g2k's display -- see forceFullPresent() below for why; a spinner is not
+  // needed once the frame actually presents.)
+  const char *line1 = "Building music cache -- one-time, please wait";
   r->font.draw((W - (int)r->font.getWidth(line1)) / 2, H / 2 - 30, line1, 0xFFFFFF, true);
 
   const int bx0 = 40;
   const int bx1 = W - 40;
 
-  // coarse "song N/M" bar -- batch mode only (single in-game renders have no N/M)
+  // coarse "song N/total" line + bar -- batch mode only (single in-game renders
+  // have no N/total).
   if (g_oc_batch_active && g_oc_song_total > 0)
   {
-    char buf[80];
-    snprintf(buf, sizeof buf, "song %d/%d  %s", g_oc_song_idx, g_oc_song_total,
-             g_oc_song_name.c_str());
+    char buf[48];
+    snprintf(buf, sizeof buf, "song %d/%d", g_oc_song_idx, g_oc_song_total);
     r->font.draw((W - (int)r->font.getWidth(buf)) / 2, H / 2 - 14, buf, 0xC0C0C0, true);
     const int cy = H / 2 + 2;
     r->drawRect(bx0, cy, bx1, cy + 6, 0x80, 0x80, 0x80);
@@ -1341,6 +1345,16 @@ static void _oc_draw_progress(uint32_t cur_beat, uint32_t total_beats)
       r->fillRect(bx0 + 1, iy + 1, bx0 + 1 + fillw, iy + 5, 0x40, 0xC0, 0xFF);
   }
 
+  // DOS-PORT (patch 0266, #16): CRITICAL -- force this frame onto the full
+  // SDL_RenderPresent path. This overlay draws with PRIMITIVES only
+  // (clearScreen/font/drawRect/fillRect) and its flips happen back-to-back deep
+  // inside the blocking precache render, well past the first DIRTY_FIRST_N_FRAMES
+  // flips. Without this, flip() takes the direct-VESA fast path (patch 0086),
+  // which dosmemputs _cached_window_surface -> VRAM and skips SDL_RenderPresent,
+  // so these primitive draws never reach the g2k display and the screen stays
+  // frozen on showLoadingScreen's last full-path frame ("Loading.."). rc3
+  // confirmed exactly that. forceFullPresent() self-clears each flip.
+  r->forceFullPresent();
   r->flip();
 }
 
@@ -1922,7 +1936,12 @@ int main(int argc, char *argv[])
         g_oc_song_idx      = i;
         g_oc_song_name     = _oc_basename(path);
         g_oc_last_inner_px = -1;          // reset the intra-song bar for the new song
-        _oc_draw_progress(0, 0);          // coarse N/M update + empty inner bar + flip
+        // patch 0266 (#16): log per song so a returned DEBUG.LOG shows real batch
+        // progress (the batch otherwise logs only start + completion, so a
+        // mid-render quit leaves no trace of how far it got).
+        LOG_INFO("organya auto-precache: rendering song {}/{} ({})", i,
+                 g_oc_song_total, g_oc_song_name.c_str());
+        _oc_draw_progress(0, 0);          // coarse N/total update + empty inner bar + flip
         _oc_poll_esc();                   // catch ESC pressed between songs
         if (g_oc_abort)
           break;
