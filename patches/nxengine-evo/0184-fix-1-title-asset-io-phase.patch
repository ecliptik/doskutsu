+++ b/src/intro/title.cpp
@@ -285,6 +285,37 @@ static void selectoption(int index)
   }
 }
 
+// DOS-PORT (patch 0184, v1.0.4 P2 FIX-1): the title screen's one-time
+// asset loads (music + backdrop in title_init below) are SCENE-load IO,
+// but the io-audit phase global (patch 0180) sticks at gameplay (2)
+// after the first load_stage -- so on a title (re)entry they get
+// mis-tagged phase=gameplay and trip the permanent IO-audit gate, even
+// though they are a one-time menu-entry load, not a gameplay stall (the
+// phase comment in map.cpp even states the title should tag boot). This
+// lever wraps those loads in the load-band phase so they're correctly
+// classified. Default ON since the v1.0.4 P2 io-gate A/B confirmed it
+// (build-qa #6: title curly.org + bkMoon moved gameplay->load_stage);
+// killswitch SDL_HINT_DOSKUTSU_EAGER_TITLE_IO=0 restores the legacy
+// tag. Sentinel-cached, no per-frame getenv. First call emits the
+// build-qa banner.
+extern "C" void io_audit_set_phase(int);
+extern "C" int  io_audit_get_phase(void);
+static bool _eager_title_io()
+{
+  static int v = -1;
+  if (v < 0)
+  {
+    // default-ON since the v1.0.4 P2 io-gate A/B confirmed the fix
+    // (build-qa #6); killswitch =0 restores the legacy gameplay-phase
+    // tag. Inverse strict-match (the patch 0088 killswitch idiom).
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_EAGER_TITLE_IO");
+    v = (e && e[0] == '0' && e[1] == 0) ? 0 : 1;
+    LOG_INFO("title: eager-title-IO phase tag {} (set SDL_HINT_DOSKUTSU_EAGER_TITLE_IO=0 to disable)",
+             v ? "ENABLED (default)" : "DISABLED (killswitch)");
+  }
+  return v == 1;
+}
+
 bool title_init(int param)
 {
   memset(&title, 0, sizeof(title));
@@ -308,8 +339,15 @@ bool title_init(int param)
 
   title.sprite = titlescreens[t].sprite;
   title.frames = titlescreens[t].frames;
+  // patch 0184 (FIX-1): tag the title's one-time music+backdrop load as
+  // load-band (scene-load) IO, not gameplay, so the IO-audit gate does
+  // not flag it. Default-OFF -> byte-identical (loads + tag unchanged).
+  const bool _eti      = _eager_title_io();
+  const int  _eti_prev = _eti ? io_audit_get_phase() : 0;
+  if (_eti) io_audit_set_phase(1);
   NXE::Sound::SoundManager::getInstance()->music(titlescreens[t].songtrack);
   map_set_backdrop(titlescreens[t].backdrop);
+  if (_eti) io_audit_set_phase(_eti_prev);
   map.scrolltype = BK_FASTLEFT_LAYERS;
   map.motionpos  = 0;
 
