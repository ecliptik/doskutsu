+// DOS-PORT (patch 0185, v1.0.4 P2 FIX-2): stage entry-music preload
+// lever. The stage's entry music is set by a <CMU in the entry TSC
+// event, which runs on the FIRST gameplay frame after load_stage -- so
+// the .org decode lands at phase=gameplay (a disk-IO stall, the
+// SFXPAUSE class). When ON, load_stage peeks the entry event for its
+// first <CMU song# and starts it DURING the load band; music() caches
+// via _currentSong so the frame-1 <CMU same-song> returns early -> zero
+// gameplay-phase .org load. Strict "1", default OFF; sentinel-cached.
+// (Mid-stage / boss <CMU> changes are out of scope -- they stay
+// allowlisted; preloading all music is infeasible.)
+static bool _preload_stage_music()
+{
+  static int v = -1;
+  if (v < 0)
+  {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_PRELOAD_STAGE_MUSIC");
+    v = (e && e[0] == '1' && e[1] == 0) ? 1 : 0;
+    LOG_INFO("load_stage: entry-music preload {} (set SDL_HINT_DOSKUTSU_PRELOAD_STAGE_MUSIC=1 to enable)",
+             v ? "ENABLED" : "disabled (default)");
+  }
+  return v == 1;
+}
+
 // DOS-PORT (patch 0175, SFXPAUSE diagnostic): per-cave-entry trace of
 // load_stage sub-phases + the SHARED cave counter. This patch owns
 // g_loadstage_cave_counter + the loadstage_current_cave() extern
@@ -1430,6 +1454,23 @@ bool load_stage(int stage_no)
   }
   MIDGAP_PUMP(); // patch 0162 Leg A seam 6: post-tsc->Load (.tsc)
 
+  // patch 0185 (FIX-2): preload the stage's ENTRY music inside the load
+  // band (phase=load_stage, via the IoAuditPhaseGuard above) so the
+  // entry event's frame-1 <CMU> is a no-op -- no phase=gameplay .org
+  // decode stall. Peek the entry event for its first <CMU song#; music()
+  // sets _currentSong so the later same-song <CMU> returns early. Best-
+  // effort + default-OFF (skip on no-CMU / no entry event / lever off).
+  if (_preload_stage_music())
+  {
+    const int _entry_song =
+        game.tsc->PeekFirstCMU(game.switchstage.eventonentry, TSC::ScriptPages::SP_MAP);
+    if (_entry_song > 0)
+    {
+      LOG_INFO("[load-stage] preloading entry music song={} (cave={})", _entry_song, _lst_cave);
+      NXE::Sound::SoundManager::getInstance()->music(_entry_song);
+    }
+  }
+
   const Uint64 _lst_t_backdrop = _lst_active ? SDL_GetTicksNS() : 0;
   map_set_backdrop(stages[stage_no].bg_no);
   map.scrolltype = stages[stage_no].scroll_type;
diff --git a/src/tsc.cpp b/src/tsc.cpp
index e545d4a7..f9ae6c43 100644
--- a/src/tsc.cpp
+++ b/src/tsc.cpp
@@ -441,6 +441,49 @@ const uint8_t *TSC::FindScriptData(int scriptno, ScriptPages pageno, ScriptPages
   return &(page->scripts.find(scriptno)->second.front());
 }
 
+// DOS-PORT (patch 0185, v1.0.4 P2 FIX-2): walk a script's compiled
+// bytecode for the first non-zero <CMU song, read-only (no execution,
+// no side effects). Opcodes are 1 byte; each takes cmd_table[].nparams
+// args of 2 bytes (big-endian, matching ExecScript at tsc.cpp ~677).
+// OP_TEXT is followed by a null-terminated string (ExecScript advances
+// strlen+1). OP_END terminates. A malformed/unknown opcode or running
+// off the data bails (-1) -- best-effort; the caller just skips the
+// preload. The iteration guard is a defensive backstop against a
+// non-terminated buffer.
+int TSC::PeekFirstCMU(int scriptno, ScriptPages pageno)
+{
+  ScriptPages found;
+  const uint8_t *p = FindScriptData(scriptno, pageno, &found);
+  if (!p)
+    return -1;
+
+  uint32_t ip = 0;
+  for (int guard = 0; guard < 65536; guard++)
+  {
+    uint8_t cmd = p[ip++];
+    if (cmd == OP_END)
+      return -1;
+    if (cmd == OP_TEXT)
+    {
+      while (p[ip] != '\0')
+        ip++;
+      ip++; // skip the terminator
+      continue;
+    }
+    if (cmd >= OP_COUNT)
+      return -1; // malformed / not a known opcode
+    const int nparams = cmd_table[cmd].nparams;
+    if (cmd == OP_CMU)
+    {
+      const int song = ((int)p[ip] << 8) | p[ip + 1];
+      if (song != 0)
+        return song; // first real (non-silence) music command
+    }
+    ip += (uint32_t)nparams * 2;
+  }
+  return -1;
+}
+
 bool TSC::StartScript(int scriptno, ScriptPages pageno)
 {
   const uint8_t *program;
diff --git a/src/tsc.h b/src/tsc.h
index ff70ba1e..8871e011 100644
--- a/src/tsc.h
+++ b/src/tsc.h
@@ -65,6 +65,16 @@ public:
   void StopScript(ScriptInstance *s);
   bool JumpScript(int newscriptno, ScriptPages pageno = ScriptPages::SP_NULL);
 
+  // DOS-PORT (patch 0185, v1.0.4 P2 FIX-2): read-only peek -- walk the
+  // compiled bytecode of script `scriptno` (page `pageno`, falling back
+  // to head.tsc like FindScriptData) for the FIRST non-zero <CMU song
+  // command, WITHOUT executing the script. Returns the song number, or
+  // -1 if the script is absent / has no <CMU before <END / hits a
+  // malformed opcode. Used by load_stage to preload a stage's entry
+  // music during the load band so the frame-1 entry-<CMU> is a no-op
+  // (no gameplay-phase .org load).
+  int PeekFirstCMU(int scriptno, ScriptPages pageno);
+
   void Clear();
   bool Init(void);
   void Close(void);
