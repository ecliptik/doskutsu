+// DOS-PORT (patch 0179, SFXPAUSE diagnostic): frame-spike anomaly
+// detector. NO fixed window -- emits a [frame-spike] line every time
+// the inter-frame wall delta in run_tick_fixed exceeds 50 ms, for the
+// whole session. A session-wide perf diagnostic (the no-window form
+// that caught the fire-frame stall, which all the frame-30-windowed
+// probes missed). Default OFF; opt-in via strict "1" on
+// SDL_HINT_DOSKUTSU_FRAME_SPIKE_DETECT. ~10-20 emits/session.
+static int  g_frame_spike_decided = -1;
+static bool frame_spike_detect_active()
+{
+  if (g_frame_spike_decided < 0)
+  {
+    const char *e = SDL_GetHint("SDL_HINT_DOSKUTSU_FRAME_SPIKE_DETECT");
+    g_frame_spike_decided = (e && e[0] == '1' && e[1] == '\0') ? 1 : 0;
+    if (g_frame_spike_decided)
+    {
+      LOG_INFO("frame-spike detect: ENABLED (opt-in via "
+               "SDL_HINT_DOSKUTSU_FRAME_SPIKE_DETECT=1; emits one "
+               "[frame-spike] line per inter_frame_ms > 50; default "
+               "OFF; runs for the whole session, no fixed window)");
+    }
+  }
+  return g_frame_spike_decided == 1;
+}
+
+// DOS-PORT (patch 0179, SFXPAUSE diagnostic): fire-dispatch path
+// FIRST-CALL bracket. Separate env gate; emits [firepath] func=NAME
+// wall_us=N on the FIRST call per session of each instrumented fire-
+// path function (FireWeapon / CreateBullet / effect / ai_polar_shot).
+// Per-function static-bool _seen flag (gated on the probe so a boot-
+// OFF-then-ON session still captures the first call once the gate
+// goes hot). Default OFF; opt-in via strict "1" on
+// SDL_HINT_DOSKUTSU_FIREPATH_TRACE.
+static int  g_firepath_trace_decided = -1;
+static bool firepath_trace_active_main()
+{
+  if (g_firepath_trace_decided < 0)
+  {
+    const char *e = SDL_GetHint("SDL_HINT_DOSKUTSU_FIREPATH_TRACE");
+    g_firepath_trace_decided = (e && e[0] == '1' && e[1] == '\0') ? 1 : 0;
+    if (g_firepath_trace_decided)
+    {
+      LOG_INFO("firepath trace: ENABLED (opt-in via "
+               "SDL_HINT_DOSKUTSU_FIREPATH_TRACE=1; emits one "
+               "[firepath] line per bracketed function on FIRST CALL "
+               "per session; never resets; default OFF)");
+    }
+  }
+  return g_firepath_trace_decided == 1;
+}
+
+// patch 0179 extern accessor for the firepath brackets in p_arms.cpp,
+// ObjManager.cpp, caret.cpp, ai/weapons/polar_mgun.cpp.
+extern "C" bool firepath_trace_active(void)
+{
+  return firepath_trace_active_main();
+}
+
 static void run_tick_fixed(void)
 {
   static int frameskip      = 0;
@@ -430,6 +488,23 @@ static void run_tick_fixed(void)
     frame_paused     = game.paused;
   }
 
+  // patch 0179 (SFXPAUSE) frame-spike anomaly detector. Emits a
+  // [frame-spike] line ONLY when the inter-frame wall delta exceeds
+  // 50 ms. Independent of FINE_INSTR; no fixed window -- runs the
+  // whole session so fire-frame / load-frame stalls are captured
+  // wherever they occur. last_ns is the file-scope static the FT
+  // accumulator uses, so the arithmetic is invariant across this
+  // probe being ON or OFF.
+  if (last_ns != 0 && frame_spike_detect_active())
+  {
+    const Uint64 _spike_ns = now_ns - last_ns;
+    if (_spike_ns > (Uint64)50 * 1000000ull)
+    {
+      LOG_INFO("[frame-spike] inter_ms={}",
+               (unsigned long long)(_spike_ns / 1000000ull));
+    }
+  }
+
   // --- LOGIC: tick_state() at a fixed 50 Hz ---
   if (game.paused)
   {
