+/* Cave Story port -- TAS (tool-assisted) record/replay support.
+ *
+ * Engine-side, game-tick-keyed input record/replay for the doskutsu real-HW
+ * iter loop. Eliminates operator-timing variability from cross-iter perf
+ * comparisons by serving deterministic input from a pre-recorded `.TAS` file.
+ *
+ * Design: docs/internal/WAVE-41-TAS-DESIGN.md (gitignored).
+ *
+ * Threading-zero invariant per CLAUDE.md: all hooks run synchronously on the
+ * main loop's call stack (called from run_tick() in main.cpp). No worker
+ * threads. File I/O is blocking; per-event fsync on record to survive
+ * mid-run crashes (precedent: patch 0036 DEBUG.LOG fsync).
+ *
+ * Default-OFF gate: when neither DOSKUTSU_TAS_RECORD nor _REPLAY is set, all
+ * hooks are no-ops at their first guard. Binary behaves byte-identical to
+ * wave-37 production. Verified by build-qa task #5 re-gate + the two-witness
+ * pattern (strings + runtime banner).
+ *
+ * Copyright (C) 2026 Micheal Waltz / doskutsu authors.
+ * SPDX-License-Identifier: GPL-3.0-only
+ */
+#ifndef _TAS_H
+#define _TAS_H
+
+#include <cstdint>
+
+namespace TAS
+{
+
+// Boot-time init. Reads the four DOSKUTSU_TAS_* env vars, parses, opens
+// the record/replay file if applicable, calls seedrand() if PRNG_SEED is
+// set. Safe to call with no env vars set (no-op).
+//
+// Called from main() in main.cpp early (after Logger::init runs, before
+// game state machinery is built so logging is available + seedrand can
+// run before any random() call).
+//
+// Idempotent at the env-var level: re-invoking would attempt to reopen
+// files. Intended for single-call usage.
+void init();
+
+// Per-tick hook. Called from run_tick() in main.cpp AFTER input_poll()
+// has updated the global inputs[] array, BEFORE any game logic reads
+// inputs[].
+//
+//   tick_id   monotonically-increasing tick counter from run_tick's
+//             static int tick_count; source of truth for replay timing
+//   inputs    pointer to global inputs[INPUT_COUNT] from input.h
+//   n_inputs  INPUT_COUNT (=28 per input.h)
+//
+// Behavior:
+//   neither RECORD nor REPLAY set: returns immediately (no-op)
+//   RECORD: compute mask from inputs[]; if mask differs from
+//           last-recorded mask, append (tick_id, mask) to the open
+//           record file and fsync.
+//   REPLAY: while pending event tick <= tick_id, apply the recorded
+//           mask to inputs[] (full overwrite of inputs[0..n_inputs-1]),
+//           consume the event, prefetch next.
+void apply_input(uint32_t tick_id, bool *inputs, int n_inputs);
+
+// Auto-exit predicate. Returns true if DOSKUTSU_TAS_AUTO_EXIT_TICK is
+// non-zero AND tick_id has reached it. Caller (run_tick) sets
+// game.running = false to terminate the main loop cleanly; the
+// existing engine-shutdown[1..8] sequence in main.cpp runs unchanged.
+//
+// Returns false when env var is 0 / unset (no auto-exit; runs until
+// operator presses ESC or QUIT event).
+bool should_exit(uint32_t tick_id);
+
+// Shutdown hook. Closes any open record/replay file. Called from
+// main()'s shutdown path before SDL_Quit so the record file is fully
+// flushed even if SDL_Quit hangs (per cooperative-scheduler concerns
+// in [[wave_38_cooperative_scheduler_starvation_is_real]] -- shutdown
+// path itself has historically hung on real HW per W22-WB-D triage).
+void shutdown();
+
+} // namespace TAS
+
+#endif // _TAS_H
