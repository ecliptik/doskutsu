diff --git a/src/map.cpp b/src/map.cpp
index 0a4e108..83c57a4 100644
--- a/src/map.cpp
+++ b/src/map.cpp
@@ -145,6 +145,189 @@ static int g_bg_visible_cache_curmap = -1;
 static int g_bg_visible_cached_top = 0;
 static int g_bg_visible_cached_bot_inclusive = -1;  // -1 = empty range
 
+// DOS-PORT (patch 0143, Phase 11 wave 48 H-A skip-when-unchanged):
+// memoize the BG state across frames + early-out at the
+// clearScreen+map_draw_backdrop pair when nothing has changed since
+// the last successful BG render. See map.h for API contract.
+//
+// Correctness contract (per nx-engine wave-48 audit; team-lead ack):
+// skip MUST cover BOTH the per-frame clearScreen(BLACK) at the top
+// of DrawScene AND the map_draw_backdrop() call below it. The wave-
+// 15-and-later unconditional Renderer::clearScreen blanks the
+// full 320x240 window surface to BLACK every frame; skipping only
+// the backdrop blit leaves BG-visible regions black. The pre-
+// existing backdrop cache (patches 0080 / 0126) skips the tile-loop
+// on cache HIT but STILL issues drawCachedBackdrop (cache->window
+// blit) -- the 5.4 ms flush-instr measured at Mimiga BK_PARALLAX
+// canonical scene IS that blit (plus the clearScreen it has to
+// undo). Patch 0143 supersedes that partial-skip behavior: when the
+// scroll-state key matches the last successful frame, we skip BOTH
+// the clear and the cache->window blit entirely, relying on the
+// window surface's pre-existing pixels to remain valid for the BG-
+// visible region. (FG-tilelayer + sprites continue to redraw on
+// top, so they remain correctness-safe.)
+//
+// Key invalidation list:
+//   - First frame post-init (sentinel curmap=-1)
+//   - flipacceltime transitions in either direction (encoded in key)
+//   - curmap / backdrop_id / scrolltype change (scene transition)
+//   - displayed_xscroll / displayed_yscroll change (player motion)
+//   - Renderer::_cached_window_surface pointer change (window
+//     surface re-fetch via SDL_GetWindowSurface; patch 0036 line
+//     3611 path)
+//   - SDL_DOSVesaDirectGetGeneration bump (direct-VESA mode change;
+//     same source-of-truth used by the existing direct-VESA fast
+//     path at Renderer.cpp:4072)
+//   - LoadBackdropIfNeeded failure (explicit invalidate call)
+//   - Killswitch SDL_HINT_DOSKUTSU_BG_SKIP_WHEN_UNCHANGED=0 active
+//
+// Telemetry:
+//   - g_bg_skip_total_skips_block, g_bg_skip_total_flips_block
+//     reset every 100 emitted banners; first-skip banner fires once
+//     on the first skip event per process lifetime.
+static int  g_bg_skip_killswitch_decided = -1;  // -1=undecided, 0=ON, 1=killswitch
+static bool g_bg_skip_state_valid        = false;
+static int  g_bg_skip_last_curmap        = -1;
+static int  g_bg_skip_last_backdrop_id   = -1;
+static int  g_bg_skip_last_scrolltype    = -1;
+static int  g_bg_skip_last_displayed_xscroll = INT_MIN;
+static int  g_bg_skip_last_displayed_yscroll = INT_MIN;
+static int  g_bg_skip_last_flipacceltime_nz  = -1;
+static void *g_bg_skip_last_win_ptr      = nullptr;
+static Uint32 g_bg_skip_last_dvesa_gen   = 0;
+static unsigned g_bg_skip_total_skips_block = 0;
+static unsigned g_bg_skip_total_flips_block = 0;
+static unsigned g_bg_skip_total_skips_global = 0;
+static bool g_bg_skip_first_event_logged = false;
+// Banner cadence: emit one line per N skips so the log doesn't
+// drown in steady-state skip telemetry. Patch 0126's WARM->THRASHING
+// emit uses 1-per-transition; here we use 1-per-100-skips because
+// skips are expected to be the common case in stationary scenes.
+static constexpr unsigned BG_SKIP_BANNER_INTERVAL = 100;
+
+extern int flipacceltime;  // global; also re-declared at the bottom of
+                            // this file alongside the patch-0097 tilemap
+                            // cache machinery (multiple extern decls are
+                            // harmless in C++ as long as they agree).
+
+// Strict-0 killswitch match. Mirrors Renderer.cpp's _strict_falsy_env
+// helper signature; consolidated locally to avoid pulling in
+// graphics/Renderer.h's helper namespace.
+static bool _bg_skip_killswitch_engaged()
+{
+  if (g_bg_skip_killswitch_decided < 0)
+  {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_BG_SKIP_WHEN_UNCHANGED");
+    g_bg_skip_killswitch_decided = (e && e[0] == '0' && e[1] == 0) ? 1 : 0;
+    LOG_INFO("map: BG skip-when-unchanged {} (set SDL_HINT_DOSKUTSU_"
+             "BG_SKIP_WHEN_UNCHANGED=0 to disable; default ON; "
+             "patch 0143 supersedes partial-skip behavior of 0080/0126)",
+             g_bg_skip_killswitch_decided ? "DISABLED (killswitch)"
+                                          : "ENABLED (default)");
+  }
+  return g_bg_skip_killswitch_decided == 1;
+}
+
+// Public API impl (declared in map.h).
+
+bool map_backdrop_should_skip_clear_and_draw()
+{
+  ++g_bg_skip_total_flips_block;
+
+  if (_bg_skip_killswitch_engaged())
+    return false;
+
+  // Never skip when flipacceltime is set -- BG isn't drawn on those
+  // frames either way, and the prior frame's BG content may be stale
+  // relative to current scene state. Encoded via key field below too,
+  // but explicit early-out keeps the skip-decision readable.
+  if (flipacceltime != 0)
+    return false;
+
+  if (!g_bg_skip_state_valid)
+    return false;
+
+  Renderer *r = Renderer::getInstance();
+  if (!r)
+    return false;
+  void *win_ptr = (void *)r->_cached_window_surface;
+  Uint32 dvesa_gen = SDL_DOSVesaDirectGetGeneration();
+
+  const bool keys_match =
+      g_bg_skip_last_curmap            == game.curmap          &&
+      g_bg_skip_last_backdrop_id       == map.backdrop         &&
+      g_bg_skip_last_scrolltype        == map.scrolltype       &&
+      g_bg_skip_last_displayed_xscroll == map.displayed_xscroll &&
+      g_bg_skip_last_displayed_yscroll == map.displayed_yscroll &&
+      g_bg_skip_last_flipacceltime_nz  == 0                    &&
+      g_bg_skip_last_win_ptr           == win_ptr              &&
+      g_bg_skip_last_dvesa_gen         == dvesa_gen;
+
+  if (!keys_match)
+    return false;
+
+  // Commit to skip. Telemetry side-effects from here.
+  ++g_bg_skip_total_skips_block;
+  ++g_bg_skip_total_skips_global;
+
+  if (!g_bg_skip_first_event_logged)
+  {
+    g_bg_skip_first_event_logged = true;
+    LOG_INFO("bg-skip: first event (state unchanged; backdrop_id={} "
+             "scrolltype={} curmap={} dscroll=({},{}); tot skips=1 / "
+             "tot flips={} this block)",
+             map.backdrop, map.scrolltype, game.curmap,
+             map.displayed_xscroll, map.displayed_yscroll,
+             g_bg_skip_total_flips_block);
+  }
+  else if ((g_bg_skip_total_skips_block % BG_SKIP_BANNER_INTERVAL) == 0)
+  {
+    const unsigned hit_pct = g_bg_skip_total_flips_block
+        ? (g_bg_skip_total_skips_block * 100u) / g_bg_skip_total_flips_block
+        : 0u;
+    LOG_INFO("bg-skip: backdrop redraw skipped (state unchanged; "
+             "tot skips={} / tot flips={} / hit-rate={}% / global "
+             "skips={} since boot)",
+             g_bg_skip_total_skips_block, g_bg_skip_total_flips_block,
+             hit_pct, g_bg_skip_total_skips_global);
+    // Reset block counters after each emit so the hit-rate is windowed
+    // not cumulative (cumulative climbs asymptotically and stops being
+    // diagnostic after a few seconds). Mirrors patch 0125's [mds-bg-
+    // stat ...] per-N-flush block cadence.
+    g_bg_skip_total_skips_block = 0;
+    g_bg_skip_total_flips_block = 0;
+  }
+
+  return true;
+}
+
+void map_backdrop_record_present_success()
+{
+  // Snapshot the current frame's key. Called from map_draw_backdrop
+  // after the backdrop[] surface check passes (i.e., we've committed
+  // to drawing BG content this frame). All subsequent code paths
+  // inside map_draw_backdrop (cache HIT, cache MISS render+blit,
+  // thrashing direct-to-window, legacy tile-loop fallback) draw the
+  // BG to the window surface, so recording success eagerly here is
+  // safe -- the only "didn't draw" exit is the no-backdrop early-
+  // return which calls map_backdrop_invalidate_skip_state() instead.
+  Renderer *r = Renderer::getInstance();
+  g_bg_skip_last_curmap            = game.curmap;
+  g_bg_skip_last_backdrop_id       = map.backdrop;
+  g_bg_skip_last_scrolltype        = map.scrolltype;
+  g_bg_skip_last_displayed_xscroll = map.displayed_xscroll;
+  g_bg_skip_last_displayed_yscroll = map.displayed_yscroll;
+  g_bg_skip_last_flipacceltime_nz  = (flipacceltime != 0) ? 1 : 0;
+  g_bg_skip_last_win_ptr           = r ? (void *)r->_cached_window_surface : nullptr;
+  g_bg_skip_last_dvesa_gen         = SDL_DOSVesaDirectGetGeneration();
+  g_bg_skip_state_valid            = true;
+}
+
+void map_backdrop_invalidate_skip_state()
+{
+  g_bg_skip_state_valid = false;
+}
+
 // DOS-PORT (patch 0080): probe killswitch once on first call. Strict
 // "0" match disables the cache (lets a real-HW iter reproduce wave-9
 // pre-cache behavior for ablation). All other values keep the
@@ -973,9 +1156,28 @@ void map_draw_backdrop(void)
   {
     LoadBackdropIfNeeded(map.backdrop);
     if (!backdrop[map.backdrop])
+    {
+      // patch 0143: BG was NOT drawn this frame -- invalidate
+      // skip-state so next frame's should_skip_clear_and_draw()
+      // returns false regardless of key match.
+      map_backdrop_invalidate_skip_state();
       return;
+    }
   }
 
+  // patch 0143 (wave 48 skip-when-unchanged): record current scroll-
+  // state key as "last successfully-drawn frame" before we drop into
+  // the per-scrolltype switch. From this point forward, every code
+  // path returns having drawn the BG to the window surface (cache HIT
+  // drawCachedBackdrop, cache MISS render+blit, thrashing direct-to-
+  // window, BK_FASTLEFT_LAYERS DrawFastLeftLayered fallback, BK_HIDE
+  // clearScreen, legacy tile-loop fall-through at function end).
+  // Recording success eagerly here saves us from instrumenting each
+  // of the ~7 return points; the only "didn't draw" exit is the no-
+  // backdrop early-return above, which already called
+  // map_backdrop_invalidate_skip_state() instead.
+  map_backdrop_record_present_success();
+
   switch (map.scrolltype)
   {
     case BK_FIXED:
diff --git a/src/map.h b/src/map.h
index 91b780c..480d6f4 100644
--- a/src/map.h
+++ b/src/map.h
@@ -123,6 +123,25 @@ void initmap(void);
 void map_set_backdrop(int backdrop_no);
 void map_draw_backdrop(void);
 void DrawFastLeftLayered(void);
+
+// DOS-PORT (patch 0143, Phase 11 wave 48 H-A skip-when-unchanged):
+// memoize the backdrop's scroll-state key + early-out at the
+// clearScreen+map_draw_backdrop pair when nothing has changed since
+// the previous successful BG render. Default-ON; killswitch via
+// SDL_HINT_DOSKUTSU_BG_SKIP_WHEN_UNCHANGED=0 (strict-0 match).
+//
+// Per nx-engine's wave-48 audit + team-lead scope-expansion ack: skip
+// is correctness-safe ONLY when we skip BOTH the per-frame
+// clearScreen(BLACK) (game.cpp DrawScene) AND map_draw_backdrop().
+// Skipping only the backdrop leaves the window's BG-visible regions
+// black (the wave-15-and-later unconditional clear in
+// Renderer::clearScreen blanks the full 320x240 surface before
+// map_draw_backdrop runs). Scoped to DrawScene caller, not the
+// backdrop function's internals.
+bool map_backdrop_should_skip_clear_and_draw();
+void map_backdrop_record_present_success();
+void map_backdrop_invalidate_skip_state();
+
 void map_flush_graphics();
 void map_drawwaterlevel(void);
 void map_draw(uint8_t foreground);
