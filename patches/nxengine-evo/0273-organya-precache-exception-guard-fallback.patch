From 1d60eadfc5c087186185ba8a01ec1f6173180f83 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Sat, 11 Jul 2026 20:50:22 -0700
Subject: [PATCH] patch 0273 -- #1 FIX: organya-precache exception GUARD
 (graceful on-demand fallback)

The g2k cold-cache organya precache exits-to-DOS via an uncaught exception
(leading cause std::bad_alloc / OOM). Default-ON killswitch
SDL_HINT_DOSKUTSU_ORG_PRECACHE_GUARD: the precache try/catch (added by 0272) now,
on any std::exception OR catch(...), degrades gracefully -- LOG + abort the batch
+ do NOT write READY.OK -> songs cold-render on demand in-game (the warm
game-loop context that works, == ORG_AUTOCACHE=0). No crash regardless of which
alloc threw. =0 restores the old hard-exit (A/B / FXOFF cell). One-shot
"exception GUARD ENABLED" banner on the batch path. The 0272 diagnostic
try/catch + mallinfo still run on the catch path, so bundled with 0272 one g2k
run FIXES (boots through) AND CONFIRMS (logs type + heap wall). The DPMI-unlock
memory relief is split out to 0274 (default-dormant this card for a clean
heap-wall baseline). Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 src/main.cpp | 54 ++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/src/main.cpp b/src/main.cpp
index dc9d0b50..584fec1c 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1339,6 +1339,28 @@ static bool _oc_present_probe_on(void)
   return decided != 0;
 }
 
+// patch 0273 (#1 FIX): precache exception GUARD. Default ON. When ON, an
+// allocation failure / exception in the first-launch precache batch is CAUGHT
+// and degrades to on-demand in-game cold-render (the warm game-loop context that
+// works -- the ORG_AUTOCACHE=0 path) instead of the uncaught-exception ->
+// terminate -> abort() exit-to-DOS that the g2k cold-cache organya boot hit.
+// SDL_HINT_DOSKUTSU_ORG_PRECACHE_GUARD=0 restores the old hard-exit (A/B).
+static bool _oc_precache_guard_on(void)
+{
+  static int decided = -1;
+  if (decided < 0)
+  {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_ORG_PRECACHE_GUARD");
+    decided = (e && e[0] == '0' && e[1] == '\0') ? 0 : 1;  // default ON; only "0" disables
+  }
+  return decided != 0;
+}
+
+// patch 0273: set true when the guard catches + bails the batch, so the post-loop
+// does NOT write the READY.OK sentinel (the cache is incomplete -> retry next
+// boot / on-demand this session).
+static bool g_oc_precache_bailed = false;
+
 // fsync'd pre-render step breadcrumb + heap snapshot. First-song(s) only (the
 // crash is iter 1). The LAST flushed line names the dying step; the heap trace
 // (uordblks climbing toward fordblks==0 / arena) shows if a subsequent alloc is
@@ -2021,6 +2043,13 @@ int main(int argc, char *argv[])
       // (inert unless SDL_HINT_DOSKUTSU_ORGCACHE_PRESENT_PROBE=1). Diagnoses why
       // the overlay reads as a static "Loading.." on g2k.
       Renderer::getInstance()->setPresentProbeActive(true);
+      // patch 0273 (#1 FIX): one-shot guard-state banner (fires on every organya
+      // cold-cache first boot -- the batch path) = default runtime witness +
+      // revert-detector for the exception guard.
+      LOG_INFO("organya auto-precache: exception GUARD {} "
+               "(SDL_HINT_DOSKUTSU_ORG_PRECACHE_GUARD; on OOM -> on-demand "
+               "fallback instead of crash)",
+               _oc_precache_guard_on() ? "ENABLED (default)" : "DISABLED (=0)");
 #ifdef __DJGPP__
       // patch 0272 (#1 crash probe): install the in-LOG fault handlers for the
       // precache window (SIGSEGV/SIGFPE/SIGILL -- genuine CPU faults, where
@@ -2066,14 +2095,27 @@ int main(int argc, char *argv[])
         if (_oc_present_probe_on())
           LOG_CRITICAL("precache: caught std::exception what='{}' at song={}",
                        e.what(), g_oc_song_idx);
-        throw;
+        // patch 0273 (#1 FIX): guard ON (default) -> degrade gracefully, no
+        // crash. guard OFF -> re-throw (old abort, for A/B).
+        if (!_oc_precache_guard_on())
+          throw;
+        LOG_WARN("organya auto-precache: GUARD caught '{}' at song {}/{} -> "
+                 "aborting batch; songs cold-render on demand in-game (no crash; "
+                 "no READY.OK). SDL_HINT_DOSKUTSU_ORG_PRECACHE_GUARD=0 restores the "
+                 "old hard-exit.", e.what(), g_oc_song_idx, g_oc_song_total);
+        g_oc_precache_bailed = true;
       }
       catch (...)
       {
         if (_oc_present_probe_on())
           LOG_CRITICAL("precache: caught UNKNOWN (non-std) exception at song={}",
                        g_oc_song_idx);
-        throw;
+        if (!_oc_precache_guard_on())
+          throw;
+        LOG_WARN("organya auto-precache: GUARD caught unknown exception at song "
+                 "{}/{} -> on-demand render, no crash.", g_oc_song_idx,
+                 g_oc_song_total);
+        g_oc_precache_bailed = true;
       }
       g_oc_batch_active = false;
 #ifdef __DJGPP__
@@ -2087,6 +2129,14 @@ int main(int argc, char *argv[])
                  "skipped={} failed={}); remaining songs cold-render on demand "
                  "behind the overlay; batch resumes next launch (no sentinel).",
                  rendered, skipped, failed);
+      else if (g_oc_precache_bailed)
+        // patch 0273 (#1 FIX): guard bailed -- do NOT write READY.OK (cache
+        // incomplete). Songs cold-render on demand in-game this session; the
+        // batch re-attempts next boot (and re-bails quickly if memory is still
+        // short). No crash -- graceful degradation.
+        LOG_INFO("organya auto-precache: GUARD-BAILED (rendered={} skipped={} "
+                 "failed={}); NO sentinel; on-demand cold-render this session.",
+                 rendered, skipped, failed);
       else
       {
         org_cache_sentinel_write();
-- 
2.47.3

