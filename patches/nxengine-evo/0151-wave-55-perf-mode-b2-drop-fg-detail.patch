@@ -813,6 +818,53 @@ int perf_mode_level()
   return g_perf_mode;
 }
 
+// DOS-PORT (patch 0151, Phase 11 wave-55 -- Track A cut B2, drop the
+// FG-over-sprite detail layer; PHASE11-WAVE-55-CONTRACT.md sec.1.1 +
+// sec.3): per-tile filter for the foreground tile pass. Returns true
+// (the tile is dropped this frame) iff PERF_MODE>=1, this is the FG
+// pass, AND the tile's attribute word is EXACTLY TA_FOREGROUND --
+// i.e. "foreground" is its SOLE attribute, so it is purely decorative
+// over-sprite detail.
+//
+// THE NX?-2 ESSENTIAL RULE (contract sec.3, nx-engine STOP-and-ack
+// audit): the exact-equality test `attr == TA_FOREGROUND` is what
+// makes B2 safe. The vanilla tile-attribute table (tilekey.dat; the
+// in-source mirror is the commented ta[] above) freely OR's
+// TA_FOREGROUND with TA_SLOPE_* on real tilecodes, and map_draw()
+// strictly partitions tiles -- a TA_FOREGROUND tile draws ONLY in the
+// FG pass. A FULL skip of the FG pass would therefore make every
+// slope-FG tile invisible-but-still-solid (the player walks a slope
+// they cannot see -- a gameplay defect). Exact equality drops a tile
+// ONLY when foreground is its lone attribute: ANY collision / hazard /
+// water / current / destroyable bit set -> attr != TA_FOREGROUND ->
+// the tile is still drawn. The cut cannot create invisible collision
+// geometry by construction, and it is bit-value-agnostic (no need to
+// enumerate the TA_SLOPE_* sub-bits).
+//
+// `foreground` is the map_draw() pass selector (TA_FOREGROUND for the
+// FG pass, 0 for BG). The call sites already gate on
+// `(tileattr[t] & TA_FOREGROUND) == foreground`, so on the BG pass a
+// passing tile has the FOREGROUND bit clear and `attr == TA_FOREGROUND`
+// is already false -- the explicit `foreground == TA_FOREGROUND` guard
+// is kept anyway for intent. perf_mode_level() is the wave-54 boot-
+// cached value -- no per-flip getenv. The first frame B2 actually
+// filters a tile, one banner is emitted (the runtime witness the cut
+// is REACHED, not merely embedded).
+static bool _perf_b2_skip_fg_tile(uint32_t attr, uint8_t foreground)
+{
+  if (perf_mode_level() < 1)
+    return false;
+  if (foreground != TA_FOREGROUND || attr != TA_FOREGROUND)
+    return false;
+  static bool s_b2_banner_done = false;
+  if (!s_b2_banner_done)
+  {
+    s_b2_banner_done = true;
+    LOG_INFO("perf-mode B2: decorative FG detail dropped (collision tiles kept)");
+  }
+  return true;
+}
+
 // DOS-PORT (patch 0149, Phase 11 wave-53 lever 3): skip-clear predicate.
 // Returns true (DrawScene's clearScreen(BLACK) may be skipped) iff the
 // backdrop pass will provably repaint EVERY screen row this frame, so
@@ -1463,54 +1515,7 @@ void map_draw_backdrop(void)
   // map_backdrop_invalidate_skip_state() instead.
   map_backdrop_record_present_success();
 
-  // DOS-PORT (patch 0150, Phase 11 wave-54 -- Track A cut A2,
-  // pin-backdrop; PHASE11-WAVE-54-CONTRACT.md sec.1.2): when
-  // PERF_MODE>=1, treat a scrolling full-screen backdrop (BK_PARALLAX
-  // / BK_FOLLOWFG) as BK_FIXED for THIS draw. The BK_FIXED case body
-  // pins parscroll to 0,0; that pins the only frame-varying component
-  // of the 0080/0126 backdrop-tile-loop cache key, so the key goes
-  // frame-invariant and the cache HITS every scrolling frame -- the
-  // per-frame parallax RE-RENDER is elided (the cache->window blit
-  // floor remains). On static frames wave-48 bg-skip (patch 0143)
-  // already elides the backdrop entirely; A2's addressable cost is the
-  // scrolling frames only.
-  //
-  // NX-AUTHOR-1 (contract sec.1.2, contract-of-record version, ack'd
-  // by flush-instr): the effective scrolltype is a LOCAL that drives
-  // ONLY the switch below -- never a persistent map.scrolltype
-  // mutation. Other code reads map.scrolltype (map_clear_is_redundant()
-  // switches on it; save/load; map reload). The cache-key store AND
-  // compare are deliberately left reading map.scrolltype / map.parscroll_*
-  // unchanged: map.scrolltype is per-map invariant so store==compare
-  // holds, and the pin reaches the key through the parscroll component
-  // alone. Swapping only the compare side to the effective value would
-  // create a permanent store/compare mismatch -> permanent cache miss
-  // -> A2 collapse; this is why the literal value is NOT touched.
-  //
-  // BK_FASTLEFT / BK_FASTLEFT_LAYERS / NOFALLLEFT are NOT pinned --
-  // their scroll is an intentional gameplay effect (Ironhead
-  // auto-scroll); pinning would freeze it (visual breakage, not a
-  // fidelity trade). BK_FIXED / BK_HIDE* are already fixed / self-
-  // clearing -- untouched. PERF_MODE=0 -> eff == map.scrolltype -> this
-  // function is bit-identical to the patch-0149 original.
-  int eff_scrolltype = map.scrolltype;
-  if (perf_mode_level() >= 1 &&
-      (map.scrolltype == BK_PARALLAX || map.scrolltype == BK_FOLLOWFG))
-  {
-    eff_scrolltype = BK_FIXED;
-    // One banner per process, on the first frame A2 actually converts
-    // a draw -- the runtime witness that the cut is REACHED, not just
-    // embedded (strings|grep proves embed only).
-    static bool s_a2_banner_done = false;
-    if (!s_a2_banner_done)
-    {
-      s_a2_banner_done = true;
-      LOG_INFO("perf-mode A2: backdrop pinned (BK_PARALLAX/FOLLOWFG -> "
-               "BK_FIXED; parscroll 0,0 -- parallax re-render elided)");
-    }
-  }
-
-  switch (eff_scrolltype)
+  switch (map.scrolltype)
   {
     case BK_FIXED:
       map.parscroll_x = 0;
@@ -2287,7 +2292,10 @@ void _tilemap_render_plain_tiles_into_cache(SDL_Surface *cache, uint8_t foregrou
         if (((game.curmap == 71) && (tilecode[t] == 0x41)) || ((game.curmap == 31)))
         {
         }
-        else if ((tileattr[t] & TA_FOREGROUND) == foreground)
+        // patch 0151 (wave-55 cut B2): drop purely-decorative FG tiles
+        // when PERF_MODE>=1; collision-bearing FG tiles still draw.
+        else if ((tileattr[t] & TA_FOREGROUND) == foreground &&
+                 !_perf_b2_skip_fg_tile(tileattr[t], foreground))
         {
           // Skip TA_CURRENT (animated water) and 0x43 (destroyable) —
           // those render live, not cached.
@@ -2339,7 +2347,10 @@ void _tilemap_render_special_tiles_to_window(uint8_t foreground)
         if (((game.curmap == 71) && (tilecode[t] == 0x41)) || ((game.curmap == 31)))
         {
         }
-        else if ((tileattr[t] & TA_FOREGROUND) == foreground)
+        // patch 0151 (wave-55 cut B2): drop purely-decorative FG tiles
+        // when PERF_MODE>=1; collision-bearing FG tiles still draw.
+        else if ((tileattr[t] & TA_FOREGROUND) == foreground &&
+                 !_perf_b2_skip_fg_tile(tileattr[t], foreground))
         {
           if (tileattr[t] & TA_CURRENT)
           {
@@ -2447,7 +2458,10 @@ inline void _tilemap_inner_render_dispatch(
             ++NXE::Diag::g_mds_tfg_tiles_skipped_attr;
           }
         }
-        else if ((tileattr[t] & TA_FOREGROUND) == foreground)
+        // patch 0151 (wave-55 cut B2): drop purely-decorative FG tiles
+        // when PERF_MODE>=1; collision-bearing FG tiles still draw.
+        else if ((tileattr[t] & TA_FOREGROUND) == foreground &&
+                 !_perf_b2_skip_fg_tile(tileattr[t], foreground))
         {
           if (tileattr[t] & TA_CURRENT)
           {
