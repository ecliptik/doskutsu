diff --git a/src/sound/MidiBackendOpl3.cpp b/src/sound/MidiBackendOpl3.cpp
index 98e2c7e..064b19f 100644
--- a/src/sound/MidiBackendOpl3.cpp
+++ b/src/sound/MidiBackendOpl3.cpp
@@ -330,16 +330,30 @@ MidiBackendOpl3::~MidiBackendOpl3()
 {
   if (_ready)
   {
-    // Silence all voices + restore Adlib OPL2 mode for any subsequent
-    // process that might use the chip. Idempotent.
+    // patch 0106 (Phase 10 OPL3 hanging-note fix): UNCONDITIONALLY
+    // KEY-OFF all 18 voices, ignoring engine-side `_voices[v].active`
+    // bookkeeping. The chip's KEY-ON state is the essential
+    // ground-truth for whether a note is sounding; engine bookkeeping
+    // can drift out of sync (e.g., LRU-stolen voices, redundant
+    // note-offs from SMF arrangements, or the loop-from-start in
+    // MidiScheduler::tick re-dispatching on top of a still-sustaining
+    // note). Belt-and-braces: SDL_DOSOpl3Shutdown below ALSO silences
+    // all 18 voices unconditionally (per its impl in
+    // vendor/SDL/src/core/dos/SDL_dos_audio_synth.c), but doing it
+    // here too ensures audible silence even if SDL_DOSOpl3Shutdown
+    // call is somehow skipped (defensive).
+    //
+    // Per W22-WB-D real-HW iter 2026-05-07 evidence: prior version
+    // had `if (_voices[v].active)` guard which skipped voices whose
+    // engine-side active=false but had chip KEY-ON=1 (drift). The
+    // guard is now removed; all 18 voices KEY-OFF unconditionally.
     for (int v = 0; v < VOICES; ++v)
     {
-      if (_voices[v].active)
-        SDL_DOSOpl3VoiceNoteOff(v);
+      SDL_DOSOpl3VoiceNoteOff(v);
     }
     SDL_DOSOpl3Shutdown();
-    LOG_INFO("opl3 backend shutdown (all voices silenced; OPL2 mode "
-             "restored)");
+    LOG_INFO("opl3 backend shutdown (all 18 voices KEY-OFF unconditionally; "
+             "OPL2 mode restored; chip state safe for next process)");
   }
 }
 
diff --git a/src/sound/MidiScheduler.cpp b/src/sound/MidiScheduler.cpp
index 480119d..49ee670 100644
--- a/src/sound/MidiScheduler.cpp
+++ b/src/sound/MidiScheduler.cpp
@@ -137,6 +137,40 @@ void MidiScheduler::stop()
   _playing = false;
 }
 
+void MidiScheduler::shutdown()
+{
+  // patch 0106 (Phase 10 OPL3 hanging-note fix): explicit teardown
+  // path called from SoundManager::shutdown() to guarantee the
+  // backend's destructor fires in deterministic order BEFORE the
+  // engine fully exits. See header comment for the W22-WB-D real-HW
+  // motivation (OPL3 chip retains KEY-ON across process exit when
+  // singleton dtor never fires).
+  //
+  // Order:
+  //   1. stop() -- fires on_song_stop on the backend (e.g.,
+  //      MidiBackendOpl3 silences all 18 voices via VoiceNoteOff).
+  //   2. _backend.reset() -- unique_ptr unwind triggers backend dtor
+  //      (e.g., MidiBackendOpl3::~MidiBackendOpl3 -> unconditional
+  //      18-voice KEY-OFF + SDL_DOSOpl3Shutdown which silences again
+  //      AND clears the OPL3 enable bit, restoring Adlib OPL2 mode).
+  //   3. _events.clear() -- release the parsed SMF event list.
+  //
+  // Idempotent: re-calling shutdown() after the first call is a
+  // no-op (stop() bails on !_playing; _backend is already null).
+  if (_playing)
+  {
+    stop();
+  }
+  if (_backend)
+  {
+    _backend.reset();  // -> backend dtor fires -> chip state restored
+  }
+  _events.clear();
+  _next_event_idx = 0;
+  _current_tick = 0;
+  _position_us = 0;
+}
+
 // ----------------------------------------------------------------------
 // Per-frame tick (driven from SoundManager::runFade)
 // ----------------------------------------------------------------------
diff --git a/src/sound/MidiScheduler.h b/src/sound/MidiScheduler.h
index 2e0a812..de655d2 100644
--- a/src/sound/MidiScheduler.h
+++ b/src/sound/MidiScheduler.h
@@ -128,6 +128,24 @@ public:
   // Disarm playback. tick() becomes a no-op until next start().
   void stop();
 
+  // Tear down the scheduler: stop any active playback (which fires
+  // on_song_stop on the backend, propagating per-backend cleanup
+  // like MidiBackendWaveBlaster's All-Notes-Off + MidiBackendOpl3's
+  // 18-voice KEY-OFF), then release the backend (unique_ptr unwind
+  // -> backend dtor fires -> SDL_DOSMpu401Shutdown / SDL_DOSOpl3Shutdown
+  // restores chip state). Called from SoundManager::shutdown().
+  //
+  // Why not rely on Singleton<MidiScheduler>::~Singleton at process
+  // exit: undefined order across compilation units. On real DOS HW
+  // (per W22-WB-D iter 2026-05-07 evidence) the singleton's dtor
+  // does not fire before process termination, leaving the OPL3 chip
+  // with a held KEY-ON bit -> audible hanging note that persists
+  // across the next program's run until reboot. Explicit shutdown
+  // plumbing from SoundManager guarantees deterministic teardown
+  // order: this method runs in the engine's normal exit path BEFORE
+  // MIX_DestroyMixer, with all engine state still valid.
+  void shutdown();
+
   // Advance playback position to now_ms. Dispatches all events whose
   // absolute timing has elapsed since the previous tick. Backend's
   // note_on / note_off / control_change / program_change fire
diff --git a/src/sound/SoundManager.cpp b/src/sound/SoundManager.cpp
index ef950b4..8c9a147 100644
--- a/src/sound/SoundManager.cpp
+++ b/src/sound/SoundManager.cpp
@@ -502,6 +502,18 @@ bool SoundManager::init()
 
 void SoundManager::shutdown()
 {
+  // patch 0106 (Phase 10 OPL3 hanging-note fix): MidiScheduler shutdown
+  // FIRST. Released backend's dtor (MidiBackendOpl3 / WaveBlaster /
+  // Stub) fires here in deterministic teardown order, ensuring chip
+  // state is restored (OPL3 KEY-OFF all voices + OPL2-mode disable;
+  // MPU-401 reset) BEFORE process exit. Without this explicit call,
+  // Singleton<MidiScheduler>::~Singleton fires at undefined order
+  // during CRT cleanup; on real DOS HW (per W22-WB-D iter 2026-05-07
+  // evidence) the singleton dtor sometimes does not fire at all
+  // before process termination, leaving the OPL3 chip with held
+  // KEY-ON -> audible hanging note that persists until reboot.
+  MidiScheduler::getInstance()->shutdown();
+
   Organya::getInstance()->shutdown();
   Pixtone::getInstance()->shutdown();
 
