     if (_res < 0) _res = 0;
+    // DOS-PORT (patch 0306): untruncated accumulate for the per-flip total,
+    // BEFORE the bounded sample push below. Note the enclosing `if` already
+    // caps on g_eng_residual_idx, so on the 1:1 path a block with more than
+    // g_eng_tick_block_size ticks stops accumulating here too -- that bound
+    // is pre-existing and shared with the sample array rather than something
+    // this patch introduces. The fixed-timestep path pushes no residual at
+    // all (see 0305), so its residual total reads 0, which is honest.
+    NXE::Diag::g_eng_residual_accum_ns_block += (Uint64)_res;
+    ++NXE::Diag::g_eng_residual_calls_block;
     NXE::Diag::g_eng_residual_samples[NXE::Diag::g_eng_residual_idx++] = (Uint64)_res;
   }
 
