+++ b/src/Utils/diagnostic_timers.h
@@ -42,6 +42,29 @@ extern std::uint64_t g_audio_service_accum_ns_global;
 extern int g_audio_service_count_block;
 extern int g_audio_service_count_global;
 
+// DOS-PORT (patch 0306): monotonic-safe elapsed-ns read.
+//
+// Every timer below computed `SDL_GetTicksNS() - t0` into an UNSIGNED value.
+// On DOS, SDL's timebase is uclock, which is not reliably monotonic -- the
+// SDL/0110 music pump reprograms PIT ch0 underneath it, and 0122 only papers
+// over part of that. When the clock steps backwards the subtraction wraps to
+// ~1.8e19 ns.
+//
+// This was already happening and already in the logs: the pre-0306
+// [engine-tick-stat] clear_screen line carries `max=18446744073654.68` ms.
+// A median over 100 samples hid it, so nobody noticed. A SUM cannot hide it,
+// so the per-flip totals this patch adds turned one wrapped sample into a
+// nonsense bucket -- which is how it was found.
+//
+// Clamping to 0 is right rather than merely convenient: a backwards clock
+// means the interval is unmeasurable, not that it was enormous. Dropping it
+// biases a total slightly low; keeping it destroys the total outright.
+static inline std::uint64_t _nxe_diag_dt(std::uint64_t t0)
+{
+  const std::uint64_t now = SDL_GetTicksNS();
+  return (now > t0) ? (now - t0) : 0;
+}
