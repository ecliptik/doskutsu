@@ -6312,3 +6327,9 @@ bool p10_audio_instr_active() { return ::NXE::Graphics::_abl_p10_audio_instr();
 namespace NXE { namespace Diag {
 bool mds_tfg_instr_active() { return ::NXE::Graphics::_abl_mds_tfg_instr(); }
 }}
