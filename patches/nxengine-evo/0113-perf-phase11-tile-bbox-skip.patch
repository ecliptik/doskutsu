   int blit_x_start = -(scroll_x % TILE_W);
-  for (int y = 0; y <= (Renderer::getInstance()->screenHeight / TILE_H) + MAP_DRAW_EXTRA_Y; y++)
+
+  const int x_max_inclusive = (Renderer::getInstance()->screenWidth  / TILE_W) + MAP_DRAW_EXTRA_X;
+  const int y_max_inclusive = (Renderer::getInstance()->screenHeight / TILE_H) + MAP_DRAW_EXTRA_Y;
+
+  // patch 0113: pre-compute bbox-clipped iteration range when killswitch
+  // is ON. mapx+x >= 0 -> x >= -mapx (clamped to 0 lower bound, since
+  // x can't be negative). mapx+x < map.xsize -> x < map.xsize - mapx,
+  // so x_end_inclusive = map.xsize - mapx - 1 (clamped to x_max_inclusive
+  // upper bound). Same logic for y.
+  int x_loop_start = 0;
+  int x_loop_end_inclusive = x_max_inclusive;
+  int y_loop_start = 0;
+  int y_loop_end_inclusive = y_max_inclusive;
+  if (bbox_skip_on)
+  {
+    if (-mapx > x_loop_start) x_loop_start = -mapx;
+    if (map.xsize - mapx - 1 < x_loop_end_inclusive)
+      x_loop_end_inclusive = map.xsize - mapx - 1;
+    if (-mapy > y_loop_start) y_loop_start = -mapy;
+    if (map.ysize - mapy - 1 < y_loop_end_inclusive)
+      y_loop_end_inclusive = map.ysize - mapy - 1;
+    // Defensive: if the clipped range is empty (camera entirely
+    // outside map; shouldn't happen in normal play, but rare edge
+    // cases on small test maps could), skip the loops entirely.
+    // Apply the blit_x/blit_y adjustment for x_loop_start so the
+    // clipped first column blits at the correct screen position.
+    blit_x_start += x_loop_start * TILE_W;
+    blit_y       += y_loop_start * TILE_H;
+  }
+  for (int y = y_loop_start; y <= y_loop_end_inclusive; y++)
   {
     int blit_x = blit_x_start;
-    for (int x = 0; x <= (Renderer::getInstance()->screenWidth / TILE_W) + MAP_DRAW_EXTRA_X; x++)
+    for (int x = x_loop_start; x <= x_loop_end_inclusive; x++)
