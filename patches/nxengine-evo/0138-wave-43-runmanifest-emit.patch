 src/main.cpp | 200 +++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 200 insertions(+)

diff --git a/src/main.cpp b/src/main.cpp
index 67478f1..0608ac2 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -22,6 +22,21 @@
 #include "trig.h"
 #include "tsc.h"
 
+// Patch 0138 (wave 43 RUNMANIFEST): shared schema-v1 emit helper from
+// probe-engineer's task #16 handoff. Header-only C; `extern "C"` guards
