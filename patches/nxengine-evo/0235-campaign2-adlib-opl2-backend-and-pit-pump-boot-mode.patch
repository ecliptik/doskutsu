+/* Cave Story port -- Campaign 2 (AdLib / OPL-FM, patch 0235).
+ * MidiBackendOpl2 implementation. See MidiBackendOpl2.h for the design +
+ * docs/internal/ADLIB-NATIVE-DESIGN.md for the full campaign rationale.
+ *
+ * This is a deliberately self-contained sibling of MidiBackendOpl3 (lead
+ * decision (a), 2026-06-21: NEW class, isolation -- do not refactor the
+ * shipped OPL3 path). The instrument bank + loader + GM-bucket map + note
+ * table are duplicated from MidiBackendOpl3.cpp (file-scope statics there
+ * are not externally visible). The duplication is pure const data + a
+ * read-only loader; zero blast radius onto the shipped backend. The chip
+ * I/O reuses the bank-agnostic SDL transport helpers (voices 0-8 ->
+ * primary bank); only Detect / InitChip / Shutdown are OPL2-specific.
+ */
+
+#include "MidiBackendOpl2.h"
+
+#include "../ResourceManager.h"
+#include "../Utils/Logger.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_dosmidi_tick.h>  // SDL_DOSMidiIsrAnyActive (SDL/0110): gate the DPMI lock under EITHER pump
+
+#ifdef __DJGPP__
+#include <dpmi.h>  // _go32_dpmi_lock_data for instance + patch-bank
+#endif
+
+// Cross-vendor extern declarations for the SDL/0037+ OPL transport helpers
+// (voices 0-8 / primary bank reused verbatim) + the SDL/0110 OPL2 chip
+// helpers. Same file-scope C-linkage pattern as MidiBackendOpl3.cpp.
+extern "C" {
+  // OPL2-specific chip lifecycle (SDL/0110):
+  bool SDL_DOSOpl2Detect(void);
+  void SDL_DOSOpl2InitChip(void);
+  void SDL_DOSOpl2Shutdown(void);
+  // Bank-agnostic transport (SDL/0037; primary bank for voice_id 0-8):
+  void SDL_DOSOpl3WriteRegister(uint16_t reg, uint8_t value);
+  void SDL_DOSOpl3VoiceWritePatch(int voice_id, const uint8_t patch[12]);
+  void SDL_DOSOpl3VoiceNoteOn(int voice_id, uint16_t freq, uint8_t block);
+  void SDL_DOSOpl3VoiceNoteOff(int voice_id);
+}
+
+namespace NXE
+{
+namespace Sound
+{
+
+// ============================================================================
+// Patch bank -- 8 representative patches (duplicated from MidiBackendOpl3.cpp).
+// 12-byte SBI layout per SDL_DOSOpl3VoiceWritePatch:
+//   patch[0..4] op0 (modulator); patch[5] channel FB/CONN(+pan, no-op on OPL2);
+//   patch[6..10] op1 (carrier); patch[11] signed semitone transpose (engine).
+// RR>=8 on all (wub-wub-safe, mirrors patch 0171).
+// ============================================================================
+
+static constexpr uint8_t PATCH_PIANO[12] = {
+  0x01, 0x08, 0xE6, 0x48, 0x00, 0xF8, 0x01, 0x00, 0xF4, 0x48, 0x00, 0x00,
+};
+static constexpr uint8_t PATCH_MALLET[12] = {
+  0x01, 0x10, 0xF0, 0x88, 0x00, 0xF8, 0x01, 0x00, 0xF0, 0xC8, 0x00, 0x00,
+};
+static constexpr uint8_t PATCH_ORGAN[12] = {
+  0x01, 0x18, 0xF0, 0x08, 0x00, 0xFE, 0x01, 0x00, 0xF0, 0x08, 0x00, 0x00,
+};
+static constexpr uint8_t PATCH_GUITAR[12] = {
+  0x21, 0x10, 0xE2, 0x18, 0x00, 0xFA, 0x01, 0x00, 0xF1, 0x68, 0x00, 0x00,
+};
+static constexpr uint8_t PATCH_BRASS[12] = {
+  0x21, 0x18, 0x91, 0x18, 0x00, 0xFC, 0x21, 0x00, 0x71, 0x18, 0x00, 0x00,
+};
+static constexpr uint8_t PATCH_REED[12] = {
+  0x21, 0x10, 0x71, 0x18, 0x00, 0xF8, 0x21, 0x00, 0x91, 0x68, 0x00, 0x00,
+};
+static constexpr uint8_t PATCH_PAD[12] = {
+  0x21, 0x18, 0x71, 0x08, 0x01, 0xF6, 0x21, 0x00, 0x51, 0x08, 0x01, 0x00,
+};
+static constexpr uint8_t PATCH_DRUM[12] = {
+  0x0F, 0x00, 0xFF, 0x0F, 0x07, 0xF0, 0x0F, 0x00, 0xFF, 0x0F, 0x07, 0x00,
+};
+
+// Runtime bank (loaded from data/opl3bank.dat). Separate static storage
+// from the OPL3 backend's -- only one of the two backends is ever
+// constructed in a given process (adlib XOR opl3), so no double-load.
+static uint8_t _loaded_patch_bank[128][12];
+static int     _loaded_patch_bank_count = 0;
+
+// Try to load data/opl3bank.dat (DOPL3v1; same format + file the OPL3
+// backend loads). Returns true on success; false leaves state unchanged.
+static bool _try_load_opl2_bank(void)
+{
+  const std::string path =
+      ResourceManager::getInstance()->getPath("opl3bank.dat", false);
+  std::FILE *fp = std::fopen(path.c_str(), "rb");
+  if (!fp)
+  {
+    LOG_INFO("opl2 backend: opl3bank.dat not found at '{}'; using 8-patch "
+             "placeholder bank.", path);
+    return false;
+  }
+  uint8_t header[12];
+  if (std::fread(header, 1, sizeof header, fp) != sizeof header)
+  {
+    LOG_WARN("opl2 backend: opl3bank.dat header truncated; 8-patch placeholder.");
+    std::fclose(fp);
+    return false;
+  }
+  static const uint8_t k_magic[8] = { 'D', 'O', 'P', 'L', '3', 'v', '1', 0x0A };
+  if (std::memcmp(header, k_magic, 8) != 0)
+  {
+    LOG_WARN("opl2 backend: opl3bank.dat magic mismatch; 8-patch placeholder.");
+    std::fclose(fp);
+    return false;
+  }
+  const uint8_t version      = header[8];
+  const uint8_t num_programs = header[9];
+  const uint8_t reserved_lo  = header[10];
+  const uint8_t reserved_hi  = header[11];
+  if (version != 0x01 || num_programs == 0 || num_programs > 128 ||
+      reserved_lo != 0 || reserved_hi != 0)
+  {
+    LOG_WARN("opl2 backend: opl3bank.dat header invalid (version={} "
+             "num_programs={} reserved={},{}); 8-patch placeholder.",
+             (int)version, (int)num_programs, (int)reserved_lo, (int)reserved_hi);
+    std::fclose(fp);
+    return false;
+  }
+  const std::size_t payload_bytes = (std::size_t)num_programs * 12u;
+  if (std::fread(_loaded_patch_bank, 1, payload_bytes, fp) != payload_bytes)
+  {
+    LOG_WARN("opl2 backend: opl3bank.dat payload truncated; 8-patch placeholder.");
+    std::memset(_loaded_patch_bank, 0, sizeof _loaded_patch_bank);
+    std::fclose(fp);
+    return false;
+  }
+  std::fclose(fp);
+  _loaded_patch_bank_count = (int)num_programs;
+
+#ifdef __DJGPP__
+  // DPMI-lock the runtime bank: _apply_patch reads it from IRQ-0 context
+  // under the PIT pump. (rodata placeholders are already locked.)
+  _go32_dpmi_lock_data((void *)_loaded_patch_bank,
+                       (unsigned long)sizeof(_loaded_patch_bank));
+#endif
+
+  LOG_INFO("opl2 backend: opl3bank.dat loaded {} programs from '{}' "
+           "({} bytes). OPL2 ignores the SBI panning nibble; programs >= {} "
+           "fall back to the 8-patch family bucket; drum channel uses "
+           "PATCH_DRUM.", (int)num_programs, path,
+           (unsigned long)payload_bytes, (int)num_programs);
+  return true;
+}
+
+// GM program (0-127) -> placeholder patch family (identical buckets to
+// MidiBackendOpl3).
+static const uint8_t *_program_to_patch(int program)
+{
+  if (program < 0 || program > 127) return PATCH_PIANO;
+  if (program < _loaded_patch_bank_count) return _loaded_patch_bank[program];
+  const int bucket = program / 8;
+  switch (bucket)
+  {
+    case 0:  return PATCH_PIANO;
+    case 1:  return PATCH_MALLET;
+    case 2:  return PATCH_ORGAN;
+    case 3:  return PATCH_GUITAR;
+    case 4:  return PATCH_GUITAR;
+    case 5:  return PATCH_PAD;
+    case 6:  return PATCH_PAD;
+    case 7:  return PATCH_BRASS;
+    case 8:  return PATCH_REED;
+    case 9:  return PATCH_REED;
+    case 10: return PATCH_GUITAR;
+    case 11: return PATCH_PAD;
+    case 12: return PATCH_PAD;
+    case 13: return PATCH_GUITAR;
+    case 14: return PATCH_MALLET;
+    case 15: return PATCH_PIANO;
+    default: return PATCH_PIANO;
+  }
+}
+
+// Base F-num table at block=4 (octave reference), 12 semitones from C.
+static const uint16_t _base_fnum_table[12] = {
+  363, 385, 408, 432, 458, 485,
+  514, 544, 577, 611, 647, 686,
+};
+
+void MidiBackendOpl2::_midi_note_to_fnum_block(int note,
+                                               std::uint16_t *out_fnum,
+                                               std::uint8_t *out_block)
+{
+  if (note < 0)   note = 0;
+  if (note > 127) note = 127;
+  const int rel = note - 60;  // MIDI note 60 = C4; reference block = 4
+  int octave_delta;
+  int semitone;
+  if (rel >= 0)
+  {
+    octave_delta = rel / 12;
+    semitone     = rel % 12;
+  }
+  else
+  {
+    octave_delta = -((-rel + 11) / 12);
+    semitone     = ((rel % 12) + 12) % 12;
+  }
+  int block = 4 + octave_delta;
+  if (block < 0) block = 0;
+  if (block > 7) block = 7;
+  *out_fnum  = _base_fnum_table[semitone];
+  *out_block = (std::uint8_t)block;
+}
+
+// ============================================================================
+// MidiBackendOpl2 implementation
+// ============================================================================
+
+MidiBackendOpl2::MidiBackendOpl2()
+{
+  LOG_INFO("opl2 backend probing for OPL chip (Adlib timer-1 sequence on "
+           "0x388)...");
+
+  if (!SDL_DOSOpl2Detect())
+  {
+    _ready = false;
+    LOG_INFO("opl2 backend probe failed -- no OPL chip detected at 0x388. "
+             "AdLib music will be SILENT this run (no SB/OPL present). "
+             "Expected on a box with neither an AdLib/OPL2 card nor a "
+             "PicoGUS in /mode adlib.");
+    return;
+  }
+
+  // Detected. OPL2 init: WSE on, 0xBD cleared, 9 primary-bank voices
+  // KEY-OFF; NO OPL3 0x105/0x104, NO secondary bank.
+  SDL_DOSOpl2InitChip();
+  _ready = true;
+
+  _try_load_opl2_bank();
+
+  for (int ch = 0; ch < MIDI_CHANNELS; ++ch)
+  {
+    _channel_program[ch]    = 0;
+    _channel_volume[ch]     = 100;
+    _channel_expression[ch] = 127;
+  }
+
+  LOG_INFO("opl2 backend ready (OPL2 detected; 9-voice single-bank allocator "
+           "armed; bank={}; clock = PIT/IRQ-0 OPL music pump, NOT SB IRQ-5; "
+           "MUSIC ONLY -- no PCM SFX on a DAC-less AdLib card).",
+           _loaded_patch_bank_count > 0
+               ? "runtime opl3bank.dat ACTIVE"
+               : "8-patch placeholder ACTIVE");
+
+  // DPMI-lock the whole instance so the PIT/IRQ-0 ISR's
+  // tick_isr -> _backend->note_on/off/... reads (_voices[9],
+  // _channel_program[16], etc.) stay resident across IRQ context. Gate on
+  // the SHARED predicate (SDL/0110) -- under the AdLib PIT pump the SB-only
+  // SDL_DOSMidiIsrTickActive() is false, but the pump still preempts the
+  // cooperative scheduler, so the lock is required here too.
+#ifdef __DJGPP__
+  if (SDL_DOSMidiIsrAnyActive())
+  {
+    _go32_dpmi_lock_data((void *)this, (unsigned long)sizeof(*this));
+  }
+#endif
+}
+
+MidiBackendOpl2::~MidiBackendOpl2()
+{
+  if (_ready)
+  {
+    // Clear the chip-wide rhythm/tremolo/vibrato latch FIRST (mirrors the
+    // OPL3 wub-wub mitigation), then KEY-OFF all 9 voices unconditionally,
+    // then the SDL OPL2 shutdown (TL-sweep + KEY-OFF + 0xBD clear).
+    SDL_DOSOpl3WriteRegister(0xBD, 0x00);
+    for (int v = 0; v < VOICES; ++v)
+    {
+      SDL_DOSOpl3VoiceNoteOff(v);
+    }
+    SDL_DOSOpl2Shutdown();
+    LOG_INFO("opl2 backend shutdown (all 9 voices KEY-OFF; 0xBD cleared; "
+             "chip state safe for next process)");
+  }
+}
+
+int MidiBackendOpl2::_allocate_voice()
+{
+  ++_voice_alloc_count;
+  int free_voice = -1;
+  int lru_voice  = 0;
+  for (int v = 0; v < VOICES; ++v)
+  {
+    if (!_voices[v].active)
+    {
+      if (free_voice < 0) free_voice = v;
+    }
+    if (_voices[v].last_used < _voices[lru_voice].last_used)
+    {
+      lru_voice = v;
+    }
+  }
+  const int chosen = (free_voice >= 0) ? free_voice : lru_voice;
+  if (free_voice < 0)
+  {
+    SDL_DOSOpl3VoiceNoteOff(chosen);  // LRU steal: silence prior occupant
+  }
+  _voices[chosen].last_used = _voice_alloc_count;
+  return chosen;
+}
+
+int MidiBackendOpl2::_find_voice(int channel, int note)
+{
+  for (int v = 0; v < VOICES; ++v)
+  {
+    if (_voices[v].active &&
+        _voices[v].midi_channel == (std::uint8_t)channel &&
+        _voices[v].midi_note    == (std::uint8_t)note)
+    {
+      return v;
+    }
+  }
+  return -1;
+}
+
+void MidiBackendOpl2::_apply_patch(int voice_id, int channel, int program)
+{
+  const uint8_t *patch =
+      (channel == DRUM_CHANNEL) ? PATCH_DRUM : _program_to_patch(program);
+  SDL_DOSOpl3VoiceWritePatch(voice_id, patch);
+}
+
+void MidiBackendOpl2::_silence_voice(int voice_id)
+{
+  if (voice_id < 0 || voice_id >= VOICES) return;
+  SDL_DOSOpl3VoiceNoteOff(voice_id);
+  _voices[voice_id].active = false;
+}
+
+void MidiBackendOpl2::note_on(int channel, int note, int velocity)
+{
+  if (!_ready) return;
+  if (velocity == 0)
+  {
+    note_off(channel, note, 0);
+    return;
+  }
+
+  const int voice = _allocate_voice();
+  _voices[voice].active       = true;
+  _voices[voice].midi_channel = (std::uint8_t)(channel & 0x0F);
+  _voices[voice].midi_note    = (std::uint8_t)(note    & 0x7F);
+
+  _apply_patch(voice, channel, _channel_program[channel & 0x0F]);
+
+  // Honor patch[11] as a SIGNED int8 semitone transpose (DMXOPL/GENMIDI
+  // convention; mirrors patch 0232 in the OPL3 backend). midi_note keeps
+  // the ORIGINAL note for note_off matching; only the frequency calc is
+  // transposed.
+  const std::uint8_t *_xpatch =
+      (channel == DRUM_CHANNEL)
+          ? PATCH_DRUM
+          : _program_to_patch(_channel_program[channel & 0x0F]);
+  const int _play_note = note + (int)(std::int8_t)_xpatch[11];
+
+  std::uint16_t fnum  = 0;
+  std::uint8_t  block = 4;
+  _midi_note_to_fnum_block(_play_note, &fnum, &block);
+  SDL_DOSOpl3VoiceNoteOn(voice, fnum, block);
+}
+
+void MidiBackendOpl2::note_off(int channel, int note, int velocity)
+{
+  (void)velocity;
+  if (!_ready) return;
+  const int voice = _find_voice(channel, note);
+  if (voice >= 0)
+  {
+    _silence_voice(voice);
+  }
+}
+
+void MidiBackendOpl2::control_change(int channel, int controller, int value)
+{
+  if (!_ready) return;
+  switch (controller)
+  {
+    case 7:   _channel_volume[channel & 0x0F]     = (std::uint8_t)(value & 0x7F); break;
+    case 11:  _channel_expression[channel & 0x0F] = (std::uint8_t)(value & 0x7F); break;
+    case 120:
+    case 123:
+    {
+      for (int v = 0; v < VOICES; ++v)
+      {
+        if (_voices[v].active &&
+            _voices[v].midi_channel == (std::uint8_t)(channel & 0x0F))
+        {
+          _silence_voice(v);
+        }
+      }
+      break;
+    }
+    default:
+      break;
+  }
+}
+
+void MidiBackendOpl2::program_change(int channel, int program)
+{
+  if (!_ready) return;
+  _channel_program[channel & 0x0F] = (std::uint8_t)(program & 0x7F);
+}
+
+void MidiBackendOpl2::on_song_start()
+{
+  if (!_ready) return;
+  for (int v = 0; v < VOICES; ++v)
+  {
+    if (_voices[v].active)
+    {
+      SDL_DOSOpl3VoiceNoteOff(v);
+      _voices[v].active = false;
+    }
+  }
+  for (int ch = 0; ch < MIDI_CHANNELS; ++ch)
+  {
+    _channel_program[ch]    = 0;
+    _channel_volume[ch]     = 100;
+    _channel_expression[ch] = 127;
+  }
+  LOG_INFO("opl2 backend: on_song_start");
+}
+
+void MidiBackendOpl2::on_song_stop()
+{
+  if (!_ready) return;
+  for (int v = 0; v < VOICES; ++v)
+  {
+    if (_voices[v].active)
+    {
+      SDL_DOSOpl3VoiceNoteOff(v);
+      _voices[v].active = false;
+    }
+  }
+  LOG_INFO("opl2 backend: on_song_stop");
+}
+
+}  // namespace Sound
+}  // namespace NXE
diff --git a/src/sound/MidiBackendOpl2.h b/src/sound/MidiBackendOpl2.h
new file mode 100644
index 00000000..ff0255b8
--- /dev/null
+++ b/src/sound/MidiBackendOpl2.h
@@ -0,0 +1,119 @@
+/* Cave Story port -- Campaign 2 (AdLib / OPL-FM, patch 0235). MidiBackendOpl2:
+ * concrete MidiBackend implementation that routes MIDI events to a real
+ * OPL2 (YM3812 / AdLib-compatible) FM synthesizer -- 9 voices, single
+ * register bank at 0x388/0x389, NO OPL3 secondary bank, NO 4-op.
+ *
+ * This is the engine half of the native-AdLib campaign. It exists so a
+ * pure AdLib / OPL-only card (including a PicoGUS in `/mode adlib`, which
+ * emulates OPL2 only) plays Cave Story MUSIC natively on the OPL chip.
+ * The music clock is NOT the Sound Blaster IRQ-5 (there is no SB on such
+ * a box) -- it is the 8253 PIT / IRQ-0 OPL music pump
+ * (SDL_DOSOplTimerPump*, SDL/0110), which drives the SAME
+ * MidiScheduler::tick_isr the SB path uses. See
+ * docs/internal/ADLIB-NATIVE-DESIGN.md for the full design + the
+ * 2026-06-21 lead decisions.
+ *
+ * Relationship to MidiBackendOpl3 (lead decision (a), 2026-06-21): this
+ * is a NEW class, deliberately NOT a parameterization of the shipped
+ * MidiBackendOpl3 -- isolation keeps the v1.4.x OPL3 production path
+ * byte-untouched. It REUSES the bank-agnostic SDL transport helpers
+ * (SDL_DOSOpl3VoiceWritePatch / VoiceNoteOn / VoiceNoteOff /
+ * WriteRegister) for voice_id 0-8 verbatim -- those route to the primary
+ * bank (reg < 0x100 -> ports 0x388/0x389) and work unchanged on a real
+ * OPL2. Only chip init / detect / shutdown differ (SDL_DOSOpl2*).
+ *
+ * HARD LIMIT -- MUSIC ONLY. A pure AdLib card has no DAC and no DMA, so
+ * Cave Story's Pixtone PCM SFX cannot play on this path. The SFX path is
+ * skipped cleanly (no mixer is created under AUDIO_BACKEND=adlib).
+ *
+ * Instrument bank: loads the SAME data/opl3bank.dat GM bank the OPL3
+ * backend uses (DMXOPL-derived, nx 0233). The 12-byte SBI records are
+ * OPL2-compatible -- the per-channel FB/CONN byte's L/R panning nibble
+ * (CHA-CHD) is simply ignored by an OPL2 chip. On absence the 8-patch
+ * placeholder family-bucket is used, identical to the OPL3 backend.
+ *
+ * Selected when SDL_HINT_DOSKUTSU_AUDIO_BACKEND=adlib (explicit-only;
+ * no auto-detect this phase per lead decision (b)). SoundManager::init
+ * detects OPL2 via SDL_DOSOpl2Detect, installs this backend, registers
+ * the MIDI tick, and starts the PIT pump.
+ */
+
+#ifndef _MIDI_BACKEND_OPL2_H
+#define _MIDI_BACKEND_OPL2_H
+
+#include "MidiScheduler.h"
+
+#include <cstdint>
+
+namespace NXE
+{
+namespace Sound
+{
+
+class MidiBackendOpl2 : public MidiBackend
+{
+public:
+  MidiBackendOpl2();
+  ~MidiBackendOpl2() override;
+
+  // True if SDL_DOSOpl2Detect succeeded in the constructor. Polled by
+  // SoundManager::init() to decide install-or-skip.
+  bool isReady() const { return _ready; }
+
+  void note_on(int channel, int note, int velocity)               override;
+  void note_off(int channel, int note, int velocity)              override;
+  void control_change(int channel, int controller, int value)     override;
+  void program_change(int channel, int program)                   override;
+  void on_song_start()                                            override;
+  void on_song_stop()                                             override;
+
+private:
+  // OPL2 = 9 voices, single (primary) bank. (OPL3's 18-voice second bank
+  // does not exist on an OPL2 chip / in PicoGUS AdLib mode.)
+  static constexpr int VOICES = 9;
+
+  // 16 MIDI channels (4-bit channel field per MIDI spec).
+  static constexpr int MIDI_CHANNELS = 16;
+
+  // Drum channel = MIDI channel 9 (0-indexed; per GM spec).
+  static constexpr int DRUM_CHANNEL = 9;
+
+  // Per-voice state. Used for note->voice tracking and LRU steal.
+  struct Voice
+  {
+    bool         active       = false;  // currently playing a note
+    std::uint8_t midi_channel = 0;      // 0-15
+    std::uint8_t midi_note    = 0;      // 0-127
+    std::uint64_t last_used   = 0;      // monotonic counter; LRU steal target
+  };
+
+  // Find a free voice or LRU-steal an active one. Returns voice ID 0-8.
+  int  _allocate_voice();
+
+  // Reverse lookup: find the voice currently playing (channel, note).
+  // Returns -1 if no match (idempotent note-off).
+  int  _find_voice(int channel, int note);
+
+  // Apply the GM patch for `program` on `channel` to voice `voice_id`.
+  void _apply_patch(int voice_id, int channel, int program);
+
+  // Convert MIDI note (0-127) to OPL (fnum, block) tuple.
+  void _midi_note_to_fnum_block(int note, std::uint16_t *out_fnum,
+                                std::uint8_t *out_block);
+
+  // Issue silence for a single voice (clear key-on bit).
+  void _silence_voice(int voice_id);
+
+  bool          _ready             = false;
+  Voice         _voices[VOICES];
+  std::uint64_t _voice_alloc_count = 0;  // monotonic; voice's last_used
+                                         // = this at time of allocation
+  std::uint8_t  _channel_program[MIDI_CHANNELS]    = {0};
+  std::uint8_t  _channel_volume[MIDI_CHANNELS]      = {0};
+  std::uint8_t  _channel_expression[MIDI_CHANNELS]  = {0};
+};
+
+}  // namespace Sound
+}  // namespace NXE
+
+#endif  // _MIDI_BACKEND_OPL2_H
