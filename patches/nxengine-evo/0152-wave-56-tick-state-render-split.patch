+// DOS-PORT (patch 0152, Phase 11 wave-56 -- Track B B1): the logic
+// half of the tick. debug_clear + (when not paused) TSC RunScripts +
+// the esc-pause check + the per-mode logic. For GM_NORMAL the ModeSim
+// block runs via game_tick_normal_state(); paused / non-GM_NORMAL
+// modes defer their whole OnTick to the render half (wave-57's
+// accumulator never multi-runs those). The dispatch decision is made
+// ONCE here and latched in _tick_dispatch so tick_render_submit()
+// honors the SAME decision even though the esc-pause check (sets
+// game.paused) or RunScripts/sim (can change game.mode) may mutate the
+// globals between the two halves -- contract sec.1.6, refinement A.
+// tick_state() is drawcall-free on the GM_NORMAL path: the structural
+// foreclosure of the wave-36 -28 fps drawcall-coupling trap.
+void Game::tick_state(void)
+{
+  debug_clear();
+
+  if (game.paused)
+  {
+    _tick_dispatch      = TD_PAUSED;
+    _tick_dispatch_mode = game.paused;
+  }
+  else
+  {
+    // run scripts
+    {
+      NXE::Diag::TscInterpTimer _tit;
+      tsc->RunScripts();
+    }
+
+    if (justpushed(ESCKEY)
+        && (game.mode == GM_NORMAL || game.mode == GM_INVENTORY || game.mode == GM_MAP_SYSTEM || game.mode == GM_ISLAND
+            || game.mode == GM_CREDITS))
+    {
+      game.pause(GP_PAUSED);
+    }
+
+    // Latch the dispatch decision (refinement A): made once, here,
+    // AFTER RunScripts + the esc-pause check -- exactly where the
+    // legacy single OnTick dispatch read game.mode. tick_render_submit
+    // honors this latch, never re-reads game.paused/game.mode.
+    if (game.mode == GM_NORMAL)
+    {
+      _tick_dispatch = TD_GM_NORMAL_SPLIT;
+      NXE::Diag::ModeTickStateTimer _mtst;
+      game_tick_normal_state();
+    }
+    else
+    {
+      _tick_dispatch      = TD_OTHER;
+      _tick_dispatch_mode = game.mode;
+    }
+  }
+}
+
+// DOS-PORT (patch 0152, Phase 11 wave-56 -- Track B B1): the drawcall
+// half of the tick. clearScreen + the per-mode render (dispatched off
+// the _tick_dispatch latch set by tick_state(), NOT a re-read of
+// game.paused/game.mode) + the debug overlay. For GM_NORMAL the
+// DrawScene / HUD / Post passes run via game_tick_normal_render();
+// paused and non-GM_NORMAL modes run their whole OnTick here, after
+// clearScreen (so the legacy clearScreen-before-any-draw ordering
+// holds -- contract sec.1.3).
+void Game::tick_render_submit(void)
+{
+  {
+    NXE::Diag::ClearScreenTimer _cst;
+    Renderer::getInstance()->clearScreen(BLACK);
+  }
+
+  switch (_tick_dispatch)
+  {
+    case TD_PAUSED:
+    {
+      NXE::Diag::ModeTickRenderTimer _mtrt;
+      tickfunctions[_tick_dispatch_mode].OnTick();
+    }
+    break;
+
+    case TD_GM_NORMAL_SPLIT:
+    {
+      NXE::Diag::ModeTickRenderTimer _mtrt;
+      game_tick_normal_render();
+    }
+    break;
+
+    case TD_OTHER:
+    {
+      NXE::Diag::ModeTickRenderTimer _mtrt;
+      tickfunctions[_tick_dispatch_mode].OnTick();
+    }
+    break;
+  }
+
+  {
+    NXE::Diag::DebugOverlayTimer _dot;
+    DrawDebug();
+    console.Draw();
+  }
+}
