   if (dst_y + dst_h > screenHeight) dst_h = screenHeight - dst_y;
   if (dst_w <= 0 || dst_h <= 0) return;
 
+  // DOS-PORT (patch 0296, Path B): the rects recorded above are in the
+  // engine's 320x240 logical space, but they are consumed as window-
+  // surface coordinates by the SDL_UpdateWindowSurfaceRects partial
+  // flush in flip(). Translate into the centred box so a partial flush
+  // pushes the region that was actually drawn. Zero offset (and so no
+  // change) whenever the surface is exactly 320x240. This must run AFTER
+  // the logical clip above, which is what bounds the rect to 320x240.
+  if (_dos_center_active)
+  {
+    dst_x += _dos_center_ox;
+    dst_y += _dos_center_oy;
+  }
+
   const int new_x2 = dst_x + dst_w;
   const int new_y2 = dst_y + dst_h;
 
@@ -5352,6 +5467,31 @@ void Renderer::flip()
     bbox_pixels = bbox.w * bbox.h;
   }
 
+  // DOS-PORT (patch 0296, Path B): clamp the flush rect to the live
+  // 320x240 box. The prev-frame diff reports changed regions as FULL-
+  // SURFACE-WIDTH bands (_compute_diff_rects sets x=0, w=width), so on a
+  // 512x384 surface the bbox would push 512-wide rows even though only
+  // the centred 320 columns can ever change -- the margin is painted
+  // once and never drawn into again. Intersecting with the box takes the
+  // steady-state flush from surface-sized down to logical-sized, which
+  // is where the per-frame cost of this card lives (a 512x384 flush
+  // measured 7.44 ms on the POD-83 against 2.87 ms for a 320x240 one,
+  // and that ratio is bytes pushed). No-op when centring is inactive.
+  if (_dos_center_active && bbox.w > 0 && bbox.h > 0)
+  {
+    const int bx1 = (bbox.x > _dos_center_ox) ? bbox.x : _dos_center_ox;
+    const int by1 = (bbox.y > _dos_center_oy) ? bbox.y : _dos_center_oy;
+    const int bx2 = ((bbox.x + bbox.w) < (_dos_center_ox + 320))
+                        ? (bbox.x + bbox.w) : (_dos_center_ox + 320);
+    const int by2 = ((bbox.y + bbox.h) < (_dos_center_oy + 240))
+                        ? (bbox.y + bbox.h) : (_dos_center_oy + 240);
+    bbox.x = bx1;
+    bbox.y = by1;
+    bbox.w = (bx2 > bx1) ? (bx2 - bx1) : 0;
+    bbox.h = (by2 > by1) ? (by2 - by1) : 0;
+    bbox_pixels = bbox.w * bbox.h;
+  }
+
   // DOS-PORT (patch 0082 + 0084): diff-engagement + bbox diagnostics.
   if (_prev_diff_engaged)
   {
@@ -5384,10 +5524,24 @@ void Renderer::flip()
   // The legacy DIRTY_THRESHOLD_PIXELS (50%) is preserved as a fallback
