+      _abl_direct_vesa() && !first_n_force && !_force_full_refresh
+      && !_dos_center_active;
   bool _direct_vesa_done = false;
   if (_dv_attempt)
   {
@@ -5499,6 +5663,23 @@ void Renderer::flip()
       const Uint64 _t = _flip_instr_on ? SDL_GetTicksNS() : 0;
       if (bbox.w > 0 && bbox.h > 0)
       {
+        // DOS-PORT (patch 0296, Path B): one-shot witness of what the
