+  //
+  // DOS-PORT (patch 0296, Path B): ...except when the backend could not
+  // give us a surface as small as the logical screen at all. See the
+  // _dos_center_active block in Renderer.h for the full rationale. On a
+  // card whose smallest VBE mode exceeds 320x240 (ATI Mach64-CT: no
+  // double scanning, so 512x384 is its floor) the aspect ratio matches
+  // exactly, so LETTERBOX resolves to SDL's STRETCH branch and scales
+  // the game up -- while drawTileFast keeps writing 1:1 at the origin.
+  // Centring at 1:1 is the coherent answer: it costs no scaling work,
+  // needs no per-path scale awareness, and the offset is zero on every
+  // card that does offer 320x240, which keeps that path untouched.
+  int _dos_out_w = 0;
+  int _dos_out_h = 0;
+  SDL_GetRenderOutputSize(_renderer, &_dos_out_w, &_dos_out_h);
+  const bool _dos_oversized = (_dos_out_w > 320 || _dos_out_h > 240);
+  const bool _dos_center_ks = !_strict_falsy_env("SDL_HINT_DOSKUTSU_CENTER_OVERSIZED");
+
+  if (_dos_oversized && _dos_center_ks)
+  {
+    _dos_center_active = true;
+    _dos_center_ox = (_dos_out_w - 320) / 2;
+    _dos_center_oy = (_dos_out_h - 240) / 2;
+
+    // Disable the logical presentation (no scaling) and translate with a
+    // viewport instead. Order matters: with a logical presentation live
+    // the viewport would be interpreted in logical coordinates, so the
+    // presentation must be dropped first for the viewport to mean output
+    // pixels.
+    if (!SDL_SetRenderLogicalPresentation(_renderer, 320, 240,
+                                          SDL_LOGICAL_PRESENTATION_DISABLED))
+    {
+      LOG_WARN("Renderer::initVideo: SDL_SetRenderLogicalPresentation(DISABLED) failed: {}",
+               SDL_GetError());
+    }
+    SDL_Rect _dos_vp = {_dos_center_ox, _dos_center_oy, 320, 240};
+    if (!SDL_SetRenderViewport(_renderer, &_dos_vp))
+    {
+      LOG_WARN("Renderer::initVideo: SDL_SetRenderViewport failed: {}", SDL_GetError());
+    }
+
+    LOG_INFO("center-oversized: ENGAGED surface={}x{} logical=320x240 offset={},{} "
+             "(backend offered no 320x240 mode; the game is centred 1:1 and the "
+             "margins are cleared once; set SDL_HINT_DOSKUTSU_CENTER_OVERSIZED=0 "
+             "to restore the scaled logical-presentation path)",
+             _dos_out_w, _dos_out_h, _dos_center_ox, _dos_center_oy);
+  }
+  else
   {
-    LOG_WARN("Renderer::initVideo: SDL_SetRenderLogicalPresentation failed: {}", SDL_GetError());
+    if (!SDL_SetRenderLogicalPresentation(_renderer, 320, 240, SDL_LOGICAL_PRESENTATION_LETTERBOX))
+    {
+      LOG_WARN("Renderer::initVideo: SDL_SetRenderLogicalPresentation failed: {}", SDL_GetError());
+    }
+
+    LOG_INFO("center-oversized: {} surface={}x{} logical=320x240 offset=0,0",
+             _dos_oversized ? "DISABLED (killswitch =0)"
+                            : "not needed (surface matches the logical screen)",
