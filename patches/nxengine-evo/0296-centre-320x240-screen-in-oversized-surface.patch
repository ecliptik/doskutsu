   }
 #endif
 
@@ -3982,6 +4036,12 @@ bool Renderer::initVideo()
   // mode change or window-surface invalidation).
   _cached_window_surface = SDL_GetWindowSurface(_window);
 
+  // DOS-PORT (patch 0296, Path B): paint the margin around the centred
+  // box before the first drawcall, so the area outside the game is black
+  // from the first frame rather than showing leftover VRAM. No-op unless
