+    _dos_center_clear_margins();
   }
   // DOS-PORT (patch 0051): SDL_RenderPresent flushed the queue.
   _renderer_queue_dirty = false;
@@ -4696,6 +4760,44 @@ SDL_Window* Renderer::window()
 // trivially bounded (<= DIRTY_RECTS_MAX iterations of cheap int
 // compares) so the per-call overhead is negligible (single-digit
 // nanoseconds). No allocation after the initial reserve in initVideo.
+// DOS-PORT (patch 0296, Path B): paint the margin around the centred
+// 320x240 box. Nothing ever draws there -- the render viewport clips the
+// renderer to the box and drawTileFast clips itself -- so without this
+// the margin shows whatever the BIOS or a previous program left in VRAM.
+//
+// Once per window surface, not per frame: the four edge rects are filled
+// directly on the surface (no renderer involvement, so the viewport does
+// not clip them) and a full refresh is forced so the whole surface
+// reaches VRAM on the next flip. No-op unless centring is active.
+void Renderer::_dos_center_clear_margins()
+{
+  if (!_dos_center_active) return;
+  SDL_Surface *win = _cached_window_surface;
+  if (!win) return;
+  if (win == _dos_center_cleared_for) return;
+
+  // Index 0 is black in the master palette (initVideo's indexed-mode
+  // smoke asserts idx0=(0,0,0)); on the RGB565 fallback 0 is black too,
+  // so a plain zero fill is correct for both formats.
+  const SDL_Rect edges[4] = {
+      {0, 0, win->w, _dos_center_oy},                                   // top
+      {0, _dos_center_oy + 240, win->w, win->h - _dos_center_oy - 240}, // bottom
+      {0, _dos_center_oy, _dos_center_ox, 240},                         // left
+      {_dos_center_ox + 320, _dos_center_oy,                            // right
+       win->w - _dos_center_ox - 320, 240},
+  };
+  for (const SDL_Rect &r : edges)
+  {
+    if (r.w > 0 && r.h > 0)
+      SDL_FillSurfaceRect(win, &r, 0);
+  }
+
+  _dos_center_cleared_for = win;
+  _force_full_refresh = true;
+  LOG_INFO("center-oversized: margins cleared for surface {}x{} around box at {},{}",
+           win->w, win->h, _dos_center_ox, _dos_center_oy);
+}
