+    _dos_center_clear_margins();
   }
   else if (_flip_instr_on)
   {
@@ -7387,6 +7573,41 @@ void Renderer::drawTileFast(Surface *src, int dstx, int dsty, int srcx, int srcy
   SDL_Rect srcrect = {srcx, srcy, TILE_W, TILE_H};
   SDL_Rect dstrect = {dstx, dsty, TILE_W, TILE_H};
 
+  // DOS-PORT (patch 0296, Path B): this is the ONE direct-to-window
+  // writer with no 320x240 dimension gate -- _try_fast_blit,
+  // _try_fast_blit_alpha, _ensure_handrolled_surface, drawCachedBackdrop
+  // and drawCachedTilemap all bail out on an oversized surface and fall
+  // back to the renderer, but drawTileFast writes straight through. That
+  // is why the Mach64 photographs show a 1:1 tilemap in the corner of an
+  // otherwise scaled screen.
+  //
+  // _blit_indexed clamps against the destination SURFACE, not against
+  // the logical screen, so translating alone would let a tile that hangs
+  // off the logical right or bottom edge spill into the cleared margin.
+  // Clip to the logical box first (carrying the source rect with it),
