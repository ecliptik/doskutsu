+    // flip()), so the nexttick / timeRemaining pacing below is bypassed
+    // for these iterations. Any other mode -- or FIXED_TIMESTEP=0 --
+    // falls through to the UNCHANGED wave-56 1:1 path. nexttick is
+    // reset so the first non-fixed iteration after leaving GM_NORMAL
+    // runs run_tick() immediately rather than against a stale deadline.
+    if (fixed_timestep_active() && game.mode == GM_NORMAL)
+    {
+      run_tick_fixed();
+      nexttick = 0;
+      continue;
+    }
+
     // get time until next tick
     int32_t curtime       = SDL_GetTicks();
     int32_t timeRemaining = nexttick - curtime;
