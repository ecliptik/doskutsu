@@ -456,6 +477,30 @@ void Game::tick_state(void)
       _tick_dispatch_mode = game.mode;
     }
   }
+
+  // DOS-PORT (patch 0153, Phase 11 wave-57 -- Track B B2): under
+  // FIXED_TIMESTEP the 3 screen effects advance their animation state
+  // HERE -- in tick_state(), at the 50 Hz logic rate -- instead of
+  // inside Draw() (which runs in tick_render_submit at the render
+  // rate). This is required, not cosmetic: game logic polls
+  // fade.getstate() to sequence stage transitions, so the fade MUST
+  // advance at the logic rate or the transition desyncs. The effect
+  // Tick() functions are pure state mutations -- drawcall-free, safe
+  // for the accumulator to multi-run. flashscreen/starflash Tick only
+  // when enabled (ScreenEffects::Draw gates their Draw on .enabled, so
+  // their Draw-embedded advance only ran when enabled); fade.Tick is
+  // unconditional (SE_Fade::Draw is called unconditionally and self-
+  // gates internally on its state). When FIXED_TIMESTEP is off this
+  // block is skipped and each effect advances inside Draw() exactly as
+  // in wave-56 (the if(!fixed_timestep_active()) guard in each Draw).
+  if (fixed_timestep_active())
+  {
+    fade.Tick();
+    if (starflash.enabled)
+      starflash.Tick();
+    if (flashscreen.enabled)
+      flashscreen.Tick();
+  }
 }
 
