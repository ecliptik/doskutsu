+// DOS-PORT (patch 0153, Phase 11 wave-57 -- Track B B2): the
+// fixed-timestep accumulator path. Called from gameloop() in place of
+// run_tick() when SDL_HINT_DOSKUTSU_FIXED_TIMESTEP=1 and the current
+// mode is GM_NORMAL. Per PHASE11-WAVE-57-CONTRACT.md sec.1 +
+// FIXED-TIMESTEP-DESIGN.md sec.3.
+//
+// Game logic (tick_state) advances at a fixed 50 Hz off a wall-clock
+// accumulator; render (tick_render_submit + flip) runs ONCE per
+// displayed frame. At ~30 fps render the game then plays at its
+// correct authored 50 Hz speed instead of ~60% slow-motion.
+//
+// THE wave-36 FORECLOSURE: the catch-up while-loop body is
+// tick_state() (+ input_poll + TAS hook) and NOTHING that draws or
+// flips -- tick_render_submit()/flip() are OUTSIDE the loop. The
+// catch-up loop re-pays only ~1 ms of logic per extra tick, never
+// N x ~17 ms of drawcalls (the wave-36 -28 fps trap).
+//
+// run_tick() (the 1:1 path) is deliberately left untouched so the
+// FIXED_TIMESTEP=0 default path stays byte-identical to wave-56; this
+// function replicates run_tick()'s load-bearing per-frame machinery
+// (update_fps / the flipacceltime flip path / runFade / heartbeat /
+// TAS auto-exit) rather than refactoring run_tick().
+static void run_tick_fixed(void)
+{
+  static int frameskip      = 0;
+  static Uint64 accum_ns    = 0;
+  static Uint64 last_ns     = 0;
+  static bool   ft_inited   = false;
+
+  // 1e9 / GAME_FPS -- the fixed logic tick interval (20 ms at 50 Hz).
+  const Uint64 TICK_NS     = (Uint64)1000000000 / GAME_FPS;
+  const int    MAX_CATCHUP = 5;  // spiral-of-death clamp
+
+  const Uint64 now_ns = SDL_GetTicksNS();
+  if (!ft_inited)
+  {
+    ft_inited = true;
+    last_ns   = now_ns;  // first entry: start with no backlog
+  }
+
+  // --- LOGIC: tick_state() at a fixed 50 Hz ---
+  if (game.paused)
+  {
+    // STOP-1 latch-freshness invariant (contract sec.1.3): a paused
+    // frame MUST still run exactly one tick_state() so _tick_dispatch
+    // is latched TD_PAUSED -- otherwise it stays stale and
+    // tick_render_submit() runs the wrong half (the pause screen never
+    // appears -> unpause never processed -> hang). No catch-up while
+    // paused; reset the accumulator so the unpause frame does not see
+    // the paused interval as a backlog.
+    //
+    // lastinputs is snapshotted at the START of the epoch (before
+    // input_poll), NOT after tick_state(): the pause-mode OnTick runs
+    // in tick_render_submit() below and uses justpushed() for menu
+    // navigation / unpause -- it needs lastinputs to still hold the
+    // PRIOR frame's inputs. A memcpy after tick_state() would make
+    // lastinputs == inputs, zero every justpushed() edge, and hang the
+    // pause menu (same latent-bug class as the STOP-1 stale latch).
+    memcpy(lastinputs, inputs, sizeof(lastinputs));
+    input_poll();
+    TAS::apply_input((uint32_t)++g_tick_count, inputs, INPUT_COUNT);
+    game.tick_state();
+    accum_ns = 0;
+    last_ns  = now_ns;
+  }
+  else
+  {
+    accum_ns += (now_ns - last_ns);
+    last_ns = now_ns;
+
+    int n = 0;
+    // Catch-up loop: tick_state() ONLY. The guard leaves the loop the
+    // moment a tick_state() transitions out of GM_NORMAL (via RunScripts
+    // OR a sim-triggered setmode -- the wave-56 latch alone misses the
+    // latter, so the loop checks game.mode/paused directly) or pauses
+    // -- other modes run 1:1 (FIXED-TIMESTEP-DESIGN sec.2.2).
+    //
+    // lastinputs is snapshotted at the START of each iteration (before
+    // input_poll) -- so it holds the PRIOR logic tick's inputs while
+    // this tick's tick_state() runs, giving game_tick_normal_state()'s
+    // sim correct per-logic-tick justpushed() edges (load-bearing under
+    // TAS replay, which rewrites inputs[] per tick_count). It also
+    // still holds the prior tick's inputs through tick_render_submit()
+    // below -- so a TD_OTHER OnTick reached when a catch-up tick_state
+    // transitioned mode still sees real justpushed() edges (not the
+    // all-false a post-tick_state memcpy would produce).
+    while (accum_ns >= TICK_NS && n < MAX_CATCHUP
+           && game.mode == GM_NORMAL && !game.paused)
+    {
+      memcpy(lastinputs, inputs, sizeof(lastinputs));
+      input_poll();
+      TAS::apply_input((uint32_t)++g_tick_count, inputs, INPUT_COUNT);
+      game.tick_state();
+      accum_ns -= TICK_NS;
+      ++n;
+    }
+    // Spiral-of-death clamp + re-entry resync: drop stale backlog. Also
+    // catches re-entry from the 1:1 path (where now_ns - last_ns was a
+    // large gap) -- the backlog is dropped after a <=MAX_CATCHUP burst.
+    if (accum_ns > (Uint64)MAX_CATCHUP * TICK_NS)
+      accum_ns = 0;
+  }
+
+  // --- RENDER: ONCE per displayed frame ---
+  game.tick_render_submit();
+
+  if (settings->show_fps)
+    update_fps();
+
+  if (!flipacceltime)
+  {
+    Renderer::getInstance()->flip();
+  }
+  else
+  {
+    flipacceltime--;
+    if (--frameskip < 0)
+    {
+      Renderer::getInstance()->flip();
+      frameskip = 256;
+    }
+  }
+
+  SoundManager::getInstance()->runFade();
+
+  if ((g_tick_count % 300) == 0)
+    LOG_INFO("run_tick_fixed #{}: heartbeat (loop alive)", g_tick_count);
+
+  if (TAS::should_exit((uint32_t)g_tick_count))
+    game.running = false;
+}
+
