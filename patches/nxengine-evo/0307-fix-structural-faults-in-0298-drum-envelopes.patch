 static constexpr uint8_t PATCH_DRUM_SNARE[12] = {
-  0x0E, 0x00, 0xFB, 0x0C, 0x07,  // op0: MULT=14, logsaw, DR=11 RR=12
+  0x0E, 0x08, 0xFB, 0xFC, 0x07,  // op0: MULT=14, logsaw, DR=11 RR=12
