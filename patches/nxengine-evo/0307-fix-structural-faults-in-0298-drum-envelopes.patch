+++ b/src/sound/MidiBackendOpl3.cpp
@@ -256,59 +256,85 @@ static constexpr uint8_t PATCH_DRUM[12] = {
 // need revision, and revise the table rather than reverting the mechanism.
 // ============================================================================
 
+// DOS-PORT (patch 0307): 0298's envelopes were authored from register
+// semantics and never heard. Round F's EAR cell heard them on BOTH backends
