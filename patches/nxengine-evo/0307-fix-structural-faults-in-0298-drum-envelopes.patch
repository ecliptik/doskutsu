+++ b/src/sound/MidiBackendOpl2.cpp
@@ -96,29 +96,55 @@ static constexpr uint8_t PATCH_DRUM[12] = {
 // left alone deliberately: changing it is a timbre decision that wants
 // the operator's ear, not a silent divergence introduced in a patch whose
 // envelopes are themselves unheard.
+// DOS-PORT (patch 0307): 0298's envelopes were authored from register
+// semantics and never heard. Round F's EAR cell heard them on BOTH backends
+// and reported clipped cymbal/blip sounds with correct note placement --
+// mechanism right, constants wrong, exactly as 0298 predicted. Two faults,
+// both of which 0298 inherited unchanged from the PATCH_DRUM it replaced:
+//
+//   1. SL=0 on every operator (high nibble of bytes 3 and 9). The decay
+//      phase's target equalled the peak, so decay terminated immediately and
+//      DR never ran -- the six differentiated DR values below provably did
+//      nothing, and the audible tail was RR alone. Now SL=15, so decay
+//      traverses the full range at DR as authored. Each patch's original RR
+//      is preserved in the low nibble, so the open/closed hat distinction
+//      built with RR 6 vs 15 survives and the DR distinction starts working.
+//
+//   2. Modulator TL=0 (byte 1; KSL is 0 throughout so byte 1 is TL directly,
+//      0 = loudest). The modulator drove the carrier at maximum depth, and
+//      with modulator MULT at 14-15 on the noisy entries that is deep
+//      high-ratio FM -- dense inharmonic sidebands. That is the clang.
+//      Now attenuated per drum: more for the pitched entries (kick, tom),
+//      less for the noisy ones (snare, hats, perc). Carrier TL (byte 7)
+//      stays 0 -- that is the drum's output level and it was correct.
+//
+// Fault 1 is structural and provable. Fault 2's eight replacement values are
+// reasoned from the register semantics, NOT heard -- which is precisely what
+// 0298 did. They are a second pass and should be expected to need revision;
+// revise the constants, not the mechanism. EAR is still the gate.
 static constexpr uint8_t PATCH_DRUM_KICK[12] = {
-  0x01, 0x00, 0xF8, 0x0A, 0x00, 0xF0, 0x01, 0x00, 0xF7, 0x0B, 0x00, 0x00,
+  0x01, 0x10, 0xF8, 0xFA, 0x00, 0xF0, 0x01, 0x00, 0xF7, 0xFB, 0x00, 0x00,
 };
 static constexpr uint8_t PATCH_DRUM_SNARE[12] = {
-  0x0E, 0x00, 0xFB, 0x0C, 0x07, 0xF0, 0x0E, 0x00, 0xFA, 0x0C, 0x07, 0x00,
+  0x0E, 0x08, 0xFB, 0xFC, 0x07, 0xF0, 0x0E, 0x00, 0xFA, 0xFC, 0x07, 0x00,
 };
 static constexpr uint8_t PATCH_DRUM_HAT_CLOSED[12] = {
-  0x0F, 0x00, 0xFE, 0x0F, 0x07, 0xF0, 0x0F, 0x00, 0xFE, 0x0F, 0x07, 0x00,
+  0x0F, 0x06, 0xFE, 0xFF, 0x07, 0xF0, 0x0F, 0x00, 0xFE, 0xFF, 0x07, 0x00,
 };
 static constexpr uint8_t PATCH_DRUM_HAT_OPEN[12] = {
-  0x0F, 0x00, 0xF8, 0x06, 0x07, 0xF0, 0x0F, 0x00, 0xF8, 0x06, 0x07, 0x00,
+  0x0F, 0x06, 0xF8, 0xF6, 0x07, 0xF0, 0x0F, 0x00, 0xF8, 0xF6, 0x07, 0x00,
 };
 static constexpr uint8_t PATCH_DRUM_TOM[12] = {
-  0x02, 0x00, 0xF9, 0x09, 0x00, 0xF0, 0x02, 0x00, 0xF9, 0x09, 0x00, 0x00,
+  0x02, 0x12, 0xF9, 0xF9, 0x00, 0xF0, 0x02, 0x00, 0xF9, 0xF9, 0x00, 0x00,
 };
 static constexpr uint8_t PATCH_DRUM_PERC[12] = {
-  0x0C, 0x00, 0xEA, 0x0B, 0x07, 0xF0, 0x0C, 0x00, 0xEA, 0x0B, 0x07, 0x00,
+  0x0C, 0x0A, 0xEA, 0xFB, 0x07, 0xF0, 0x0C, 0x00, 0xEA, 0xFB, 0x07, 0x00,
 };
 static constexpr uint8_t PATCH_DRUM_SIDESTICK[12] = {
-  0x04, 0x00, 0xFD, 0x0E, 0x00, 0xF0, 0x04, 0x00, 0xFD, 0x0E, 0x00, 0x00,
+  0x04, 0x14, 0xFD, 0xFE, 0x00, 0xF0, 0x04, 0x00, 0xFD, 0xFE, 0x00, 0x00,
 };
 static constexpr uint8_t PATCH_DRUM_CRASH[12] = {
-  0x0F, 0x00, 0xF5, 0x04, 0x07, 0xF0, 0x0F, 0x00, 0xF5, 0x04, 0x07, 0x00,
+  0x0F, 0x06, 0xF5, 0xF4, 0x07, 0xF0, 0x0F, 0x00, 0xF5, 0xF4, 0x07, 0x00,
 };
 
 static const uint8_t *_drum_patch_for_key(int note)
