+// DOS-PORT (patch 0145, Phase 11 wave-51): opaque-span colorkey blit
+// lever. See BlitSpans.h for the rationale. Three pieces live here next
+// to `_blit_indexed`:
+//   _span_copy            -- per-run copy primitive (rep movsl idiom)
+//   blit_asm_span_enabled -- cached SDL_HINT_DOSKUTSU_ASM_BLIT gate
+//   build_blit_span_table -- the load-time per-row run scan
+
+// Copy `n` bytes src->dst with the P54C `rep movsl` fast-string idiom
+// plus a 0-3 byte tail. This is what replaces `_blit_indexed`'s
+// per-pixel `if (px != colorkey)` branch: the span table already
+// excluded every transparent pixel, so a run is an unconditional
+// contiguous copy. Forward copy only -- an opaque span never overlaps
+// its own destination.
+static inline void _span_copy(Uint8 *d, const Uint8 *s, unsigned n)
+{
+#if defined(__i386__)
+  unsigned dwords = n >> 2;
+  unsigned tail = n & 3u;
+  __asm__ __volatile__(
+      "cld\n\t"
+      "rep movsl\n\t"
+      "movl %3, %%ecx\n\t"
+      "rep movsb"
+      : "+D"(d), "+S"(s), "+c"(dwords)
+      : "r"(tail)
+      : "memory", "cc");
+#else
+  SDL_memcpy(d, s, (size_t)n);
+#endif
+}
+
+// Cached-at-boot gate. Strict "1" opt-in (default-OFF for wave-51) --
+// matches the project diagnostic-hint convention; `_strict_truthy_env`
+// is the shared helper near the top of this file. Evaluated once.
+bool blit_asm_span_enabled()
+{
+  static const bool v = _strict_truthy_env("SDL_HINT_DOSKUTSU_ASM_BLIT");
+  return v;
+}
+
+// Scan an INDEX8 SDL_Surface and collapse each row's non-colorkey
+// pixels into contiguous (start,len) runs. Runs are emitted left-to-
+// right so each row's run list is sorted ascending by `start`. Called
+// once per candidate surface, at load (Surface::spanTable lazy build).
+BlitSpanTable *build_blit_span_table(SDL_Surface *s, Uint8 colorkey)
+{
+  if (!s || !s->pixels || s->format != SDL_PIXELFORMAT_INDEX8)
+    return nullptr;
+  if (s->w <= 0 || s->h <= 0 || s->w > 65535 || s->h > 65535)
+    return nullptr;  // run start/len are Uint16; bail rather than wrap
+
+  const bool must_lock = SDL_MUSTLOCK(s);
+  if (must_lock && !SDL_LockSurface(s))
+    return nullptr;
+
+  BlitSpanTable *t = new BlitSpanTable();
+  t->w = s->w;
+  t->h = s->h;
+  t->row_off.reserve((size_t)s->h + 1);
+  t->row_off.push_back(0);
+
+  const int pitch = s->pitch;
+  const int w = s->w;
+  const Uint8 *base = (const Uint8 *)s->pixels;
+  for (int y = 0; y < s->h; ++y)
+  {
+    const Uint8 *row = base + (size_t)y * pitch;
+    int col = 0;
+    while (col < w)
+    {
+      while (col < w && row[col] == colorkey)
+        ++col;                          // skip transparent run
+      if (col >= w)
+        break;
+      const int run_start = col;
+      while (col < w && row[col] != colorkey)
+        ++col;                          // accumulate opaque run
+      BlitSpanRun r;
+      r.start = (Uint16)run_start;
+      r.len = (Uint16)(col - run_start);
+      t->runs.push_back(r);
+    }
+    t->row_off.push_back((Uint32)t->runs.size());
+  }
+
+  if (must_lock)
+    SDL_UnlockSurface(s);
+  return t;
+}
+
