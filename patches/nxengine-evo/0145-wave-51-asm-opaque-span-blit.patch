@@ -5151,7 +5269,46 @@ static inline bool _blit_indexed(SDL_Surface *dst, SDL_Surface *src,
   const Uint8 *sp = (const Uint8 *)src->pixels + sy * src_pitch + sx;
   Uint8 *dp = (Uint8 *)dst->pixels + dst_y * dst_pitch + dst_x;
 
-  if (has_colorkey)
+  if (has_colorkey && spans)
+  {
+    // DOS-PORT (patch 0145, wave-51): opaque-span fast path. The
+    // colorkey test was hoisted to surface-load time -- here we only
+    // copy each precomputed run. `sx`/`sy` are the clip-adjusted
+    // source origin and sp/dp already point at (sx,sy)/(dst_x,dst_y),
+    // so a source column `c` maps to byte offset (c - sx) in BOTH the
+    // sp row and the dp row. Each run is intersected with the clipped
+    // column window [sx, sx+cols); runs are sorted ascending so the
+    // walk breaks once a run starts past the window. Pixel-identical
+    // to the per-pixel loop below (it copies exactly the non-colorkey
+    // pixels and leaves colorkey pixels untouched).
+    const int sx_end = sx + cols;
+    const int tbl_h = spans->h;
+    const BlitSpanRun *runs = spans->runs.data();
+    const Uint32 *row_off = spans->row_off.data();
