+#ifndef _BLITSPANS_H
+#define _BLITSPANS_H
+
+// DOS-PORT (patch 0145, Phase 11 wave-51): opaque-span tables for the
+// hand-tuned colorkey blit lever ("the one untried lever" from the
+// Latch & Plane consultancy memo). The legacy `_blit_indexed` colorkey
+// path runs a per-pixel `if (px != colorkey)` branch -- on the P54C
+// that branch is unpredictable and DJGPP GCC's Pentium U/V scheduler
+// pairs it poorly. This lever precomputes, ONCE at surface load, the
+// contiguous runs of non-colorkey ("opaque") pixels in each source row;
+// at blit time `_blit_indexed` copies each run with the `rep movsl`
+// fast-string idiom and never re-tests the colorkey. No runtime
+// codegen, modest memory.
+//
+// Gated on SDL_HINT_DOSKUTSU_ASM_BLIT (strict "1" opt-in, default-OFF
+// for wave-51). When the gate is OFF no span table is ever built (zero
+// memory, zero cost) and `_blit_indexed` keeps its legacy per-pixel
+// loop byte-for-byte.
+
+#include <SDL3/SDL.h>
+
+#include <cstdint>
+#include <vector>
+
+namespace NXE
+{
+namespace Graphics
+{
+
+// One contiguous run of non-colorkey ("opaque") pixels within a single
+// source-surface row. `start` / `len` are in source-surface column
+// coordinates (NOT clipped to any srcrect -- the blit intersects them).
+struct BlitSpanRun
+{
+  std::uint16_t start;
+  std::uint16_t len;
+};
+
+// Per-source-surface opaque-span table. Built once at surface load when
+// SDL_HINT_DOSKUTSU_ASM_BLIT is on AND the cached CPU surface is
+// INDEX8 + colorkeyed. For row y, runs[ row_off[y] .. row_off[y+1] )
+// are that row's opaque runs, sorted ascending by `start`; a
+// fully-opaque row collapses to a single run. `row_off` has h+1
+// entries (row_off[0]==0, row_off[h]==runs.size()).
+struct BlitSpanTable
+{
+  int w = 0;
+  int h = 0;
+  std::vector<BlitSpanRun>   runs;
+  std::vector<std::uint32_t> row_off;
+};
+
+// Cached-at-boot gate accessor (defined in Renderer.cpp). True when the
+// operator opted in with SDL_HINT_DOSKUTSU_ASM_BLIT=1. Constant for the
+// run -- evaluated once on first call, never per-blit.
+bool blit_asm_span_enabled();
+
+// Scan an INDEX8 SDL_Surface and build its opaque-span table. The
+// caller owns the returned pointer (delete it). Returns nullptr if the
+// surface is unusable (NULL, NULL pixels, or not INDEX8). `colorkey` is
+// the transparent palette index.
+BlitSpanTable *build_blit_span_table(SDL_Surface *s, std::uint8_t colorkey);
+
+}; // namespace Graphics
+}; // namespace NXE
+
+#endif // _BLITSPANS_H
