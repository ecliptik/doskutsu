+// DOS-PORT (patch 0145, Phase 11 wave-51): opaque-span lever accessor.
+// Lazily builds the non-colorkey run table the first time it is asked
+// for, then caches it for the surface's lifetime. `_span_table_built`
+// guards the build so a non-candidate surface (lever off, non-INDEX8,
+// or no colorkey) is probed exactly once and thereafter returns nullptr
+// at zero cost. The actual scan + the gate check both live in
+// Renderer.cpp (build_blit_span_table / blit_asm_span_enabled) so the
+// lever's logic stays in one translation unit alongside `_blit_indexed`.
+const BlitSpanTable *Surface::spanTable()
+{
+  if (!_span_table_built)
+  {
+    _span_table_built = true;
+    if (blit_asm_span_enabled() && _surface_cpu && _has_colorkey &&
+        _surface_cpu->format == SDL_PIXELFORMAT_INDEX8)
+    {
+      _span_table = build_blit_span_table(_surface_cpu, (Uint8)_colorkey);
+    }
+  }
+  return _span_table;
+}
+
 void Surface::cleanup()
 {
   if (_texture)
@@ -607,6 +629,13 @@ void Surface::cleanup()
     SDL_DestroySurface(_surface_cpu);
     _surface_cpu = nullptr;
   }
+  // DOS-PORT (patch 0145, Phase 11 wave-51): free the opaque-span table
+  // alongside the CPU surface it was built from. Reset `_span_table_built`
+  // so a reloaded surface (Tileset::load deletes+reloads) rebuilds its
+  // table against the new pixels.
+  delete _span_table;
+  _span_table = nullptr;
+  _span_table_built = false;
