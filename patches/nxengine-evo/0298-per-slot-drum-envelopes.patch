diff --git a/src/sound/MidiBackendOpl3.cpp b/src/sound/MidiBackendOpl3.cpp
index e3cc88d7..823d410e 100644
--- a/src/sound/MidiBackendOpl3.cpp
+++ b/src/sound/MidiBackendOpl3.cpp
@@ -219,6 +219,118 @@ static constexpr uint8_t PATCH_DRUM[12] = {
   0x00,
 };
 
+// ============================================================================
+// DOS-PORT (patch 0298): per-slot drum envelopes.
+//
+// PATCH_DRUM above is ONE maximally-percussive noise burst -- MULT=15,
+// AR=15/DR=15, RR=15, WS=7 -- used for every drum in the kit. On the OPL3
+// that is a click: the entire kit differs only by the MIDI note's pitch,
+// so a kick and a closed hat are the same sound an octave apart. The
+// Shack is the audible case, and the AdLib cell had it silent outright.
+//
+// Which notes can actually arrive is fixed and knowable, not open-ended.
+// The MIDI set is our own org2mid output, and its DRUM_GM_KEY[] table
+// (tools/org2mid/org2mid.c) maps the eight Organya drum SLOTS to exactly
+// eight GM keys -- 35, 38, 42, 46, 45, 39, plus 37 and 49 as forward-compat
+// stubs for slots 6/7, which are SND_NULL across all 42 stock .org files.
+// The engine side agrees: Organya.cpp indexes DrumSamples[idx - 8], so the
+// drum sound is chosen by slot, and slot is what org2mid keys on. Nothing
+// else can reach channel 9, so eight envelopes cover the corpus exactly and
+// the default below is genuinely unreachable with stock data.
+//
+// Character targets, and the FM parameter doing the work in each:
+//
+//   35 KICK       low MULT + sine WS -> pitched body, not noise; medium DR
+//   38 SNARE      high MULT + logsaw WS -> noisy; DR shorter than the tom
+//   42 HAT CLOSED max MULT, fastest DR/RR -> the shortest thing in the kit
+//   46 HAT OPEN   same timbre as 42, DR/RR relaxed -> it must read as the
+//                 SAME instrument ringing on, not as a different one
+//   45 TOM        low MULT + sine -> pitched like the kick, longer decay
+//   39 PERC/CLAP  noisy like the snare, slower attack for a softer edge
+//   37 SIDESTICK  stub: short, dry, pitched
+//   49 CRASH      stub: noisy with the longest RR in the table
+//
+// NOT VERIFIED BY EAR. These are authored from the OPL3 register semantics
+// documented at the head of this file, not tuned against the chip. Round F's
+// EAR cell is the gate; treat the values as a first pass that is expected to
+// need revision, and revise the table rather than reverting the mechanism.
+// ============================================================================
+
+static constexpr uint8_t PATCH_DRUM_KICK[12] = {
+  0x01, 0x00, 0xF8, 0x0A, 0x00,  // op0: MULT=1, sine, AR=15 DR=8, RR=10
+  0xF0,                          // FB/CONN: stereo + FB=0 + AM
+  0x01, 0x00, 0xF7, 0x0B, 0x00,  // op1: matched, slightly shorter tail
+  0x00,
+};
+
+static constexpr uint8_t PATCH_DRUM_SNARE[12] = {
+  0x0E, 0x00, 0xFB, 0x0C, 0x07,  // op0: MULT=14, logsaw, DR=11 RR=12
+  0xF0,
+  0x0E, 0x00, 0xFA, 0x0C, 0x07,  // op1: matched
+  0x00,
+};
+
+static constexpr uint8_t PATCH_DRUM_HAT_CLOSED[12] = {
+  0x0F, 0x00, 0xFE, 0x0F, 0x07,  // op0: max MULT, DR=14 RR=15 -- shortest
+  0xF0,
+  0x0F, 0x00, 0xFE, 0x0F, 0x07,
+  0x00,
+};
+
+static constexpr uint8_t PATCH_DRUM_HAT_OPEN[12] = {
+  0x0F, 0x00, 0xF8, 0x06, 0x07,  // op0: same timbre as 42, DR=8 RR=6
+  0xF0,                          //      -- same instrument, ringing on
+  0x0F, 0x00, 0xF8, 0x06, 0x07,
+  0x00,
+};
+
+static constexpr uint8_t PATCH_DRUM_TOM[12] = {
+  0x02, 0x00, 0xF9, 0x09, 0x00,  // op0: MULT=2, sine -> pitched, DR=9
+  0xF0,
+  0x02, 0x00, 0xF9, 0x09, 0x00,
+  0x00,
+};
+
+static constexpr uint8_t PATCH_DRUM_PERC[12] = {
+  0x0C, 0x00, 0xEA, 0x0B, 0x07,  // op0: AR=14 (softer edge), DR=10
+  0xF0,
+  0x0C, 0x00, 0xEA, 0x0B, 0x07,
+  0x00,
+};
+
+static constexpr uint8_t PATCH_DRUM_SIDESTICK[12] = {
+  0x04, 0x00, 0xFD, 0x0E, 0x00,  // stub (slot 6 unused in stock data)
+  0xF0,
+  0x04, 0x00, 0xFD, 0x0E, 0x00,
+  0x00,
+};
+
+static constexpr uint8_t PATCH_DRUM_CRASH[12] = {
+  0x0F, 0x00, 0xF5, 0x04, 0x07,  // stub (slot 7 unused): longest RR
+  0xF0,
+  0x0F, 0x00, 0xF5, 0x04, 0x07,
+  0x00,
+};
+
+// GM percussion key -> envelope. Anything org2mid cannot emit falls back to
+// the pre-0298 single burst, so a hand-authored or third-party MIDI on the
+// drum channel degrades to exactly the old behaviour rather than silence.
+static const uint8_t *_drum_patch_for_key(int note)
+{
+  switch (note)
+  {
+    case 35: return PATCH_DRUM_KICK;
+    case 38: return PATCH_DRUM_SNARE;
+    case 42: return PATCH_DRUM_HAT_CLOSED;
+    case 46: return PATCH_DRUM_HAT_OPEN;
+    case 45: return PATCH_DRUM_TOM;
+    case 39: return PATCH_DRUM_PERC;
+    case 37: return PATCH_DRUM_SIDESTICK;
+    case 49: return PATCH_DRUM_CRASH;
+    default: return PATCH_DRUM;
+  }
+}
+
 // ============================================================================
 // Patch 0141 (wave 46 Phase 10.5): runtime patch-bank loader
 // ============================================================================
@@ -709,12 +821,16 @@ int MidiBackendOpl3::_find_voice(int channel, int note)
   return -1;
 }
 
-void MidiBackendOpl3::_apply_patch(int voice_id, int channel, int program)
+void MidiBackendOpl3::_apply_patch(int voice_id, int channel, int program,
+                                   int note)
 {
   const uint8_t *patch;
   if (channel == DRUM_CHANNEL)
   {
-    patch = PATCH_DRUM;
+    // DOS-PORT (patch 0298): the drum channel ignores `program` by design
+    // (GM puts the kit on the note, not the program), so the note IS the
+    // instrument selector here -- which is why it had to be threaded in.
+    patch = _drum_patch_for_key(note);
   }
   else
   {
@@ -752,7 +868,7 @@ void MidiBackendOpl3::note_on(int channel, int note, int velocity)
 
   // Apply the patch for this MIDI channel's current program (or drum
   // patch on drum channel).
-  _apply_patch(voice, channel, _channel_program[channel & 0x0F]);
+  _apply_patch(voice, channel, _channel_program[channel & 0x0F], note);
 
   // patch 0232 (DOPL3v1 transpose): honor patch[11] as a SIGNED int8
   // semitone offset, applied to the played note before the (fnum, block)
@@ -769,7 +885,7 @@ void MidiBackendOpl3::note_on(int channel, int note, int velocity)
   // offset is 0 and behavior is byte-identical to pre-0232 (no killswitch).
   const std::uint8_t *_xpatch =
       (channel == DRUM_CHANNEL)
-          ? PATCH_DRUM
+          ? _drum_patch_for_key(note)   // patch 0298: same table as dispatch
           : _program_to_patch(_channel_program[channel & 0x0F]);
   const int _play_note = note + (int)(std::int8_t)_xpatch[11];
 
