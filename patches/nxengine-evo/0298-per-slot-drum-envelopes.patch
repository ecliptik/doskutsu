diff --git a/src/sound/MidiBackendOpl2.cpp b/src/sound/MidiBackendOpl2.cpp
index 17a50764..56a46284 100644
--- a/src/sound/MidiBackendOpl2.cpp
+++ b/src/sound/MidiBackendOpl2.cpp
@@ -81,6 +81,62 @@ static constexpr uint8_t PATCH_DRUM[12] = {
   0x0F, 0x00, 0xFF, 0x0F, 0x07, 0xF0, 0x0F, 0x00, 0xFF, 0x0F, 0x07, 0x00,
 };
 
+// DOS-PORT (patch 0298): per-slot drum envelopes, byte-identical to the
+// OPL3 backend's table. Kept as a separate copy rather than shared,
+// matching how this file already carries its own copies of all eight
+// PATCH_* constants -- only one backend is constructed per process
+// (adlib XOR opl3), and the duplication is the established convention
+// here. See MidiBackendOpl3.cpp for the character rationale per key and
+// for why the eight GM keys below are the complete reachable set.
+//
+// Chip note: bytes [4]/[10] carry WS=7, which is an OPL3 waveform. A real
+// OPL2 honours only WS 0-3 and masks the rest, so the noisy entries land
+// on quarter-sine instead of logsaw. That is pre-existing behaviour --
+// the PATCH_DRUM above it already ships WS=7 on this path -- and it is
+// left alone deliberately: changing it is a timbre decision that wants
+// the operator's ear, not a silent divergence introduced in a patch whose
+// envelopes are themselves unheard.
+static constexpr uint8_t PATCH_DRUM_KICK[12] = {
+  0x01, 0x00, 0xF8, 0x0A, 0x00, 0xF0, 0x01, 0x00, 0xF7, 0x0B, 0x00, 0x00,
+};
+static constexpr uint8_t PATCH_DRUM_SNARE[12] = {
+  0x0E, 0x00, 0xFB, 0x0C, 0x07, 0xF0, 0x0E, 0x00, 0xFA, 0x0C, 0x07, 0x00,
+};
+static constexpr uint8_t PATCH_DRUM_HAT_CLOSED[12] = {
+  0x0F, 0x00, 0xFE, 0x0F, 0x07, 0xF0, 0x0F, 0x00, 0xFE, 0x0F, 0x07, 0x00,
+};
+static constexpr uint8_t PATCH_DRUM_HAT_OPEN[12] = {
+  0x0F, 0x00, 0xF8, 0x06, 0x07, 0xF0, 0x0F, 0x00, 0xF8, 0x06, 0x07, 0x00,
+};
+static constexpr uint8_t PATCH_DRUM_TOM[12] = {
+  0x02, 0x00, 0xF9, 0x09, 0x00, 0xF0, 0x02, 0x00, 0xF9, 0x09, 0x00, 0x00,
+};
+static constexpr uint8_t PATCH_DRUM_PERC[12] = {
+  0x0C, 0x00, 0xEA, 0x0B, 0x07, 0xF0, 0x0C, 0x00, 0xEA, 0x0B, 0x07, 0x00,
+};
+static constexpr uint8_t PATCH_DRUM_SIDESTICK[12] = {
+  0x04, 0x00, 0xFD, 0x0E, 0x00, 0xF0, 0x04, 0x00, 0xFD, 0x0E, 0x00, 0x00,
+};
+static constexpr uint8_t PATCH_DRUM_CRASH[12] = {
+  0x0F, 0x00, 0xF5, 0x04, 0x07, 0xF0, 0x0F, 0x00, 0xF5, 0x04, 0x07, 0x00,
+};
+
+static const uint8_t *_drum_patch_for_key(int note)
+{
+  switch (note)
+  {
+    case 35: return PATCH_DRUM_KICK;
+    case 38: return PATCH_DRUM_SNARE;
+    case 42: return PATCH_DRUM_HAT_CLOSED;
+    case 46: return PATCH_DRUM_HAT_OPEN;
+    case 45: return PATCH_DRUM_TOM;
+    case 39: return PATCH_DRUM_PERC;
+    case 37: return PATCH_DRUM_SIDESTICK;
+    case 49: return PATCH_DRUM_CRASH;
+    default: return PATCH_DRUM;
+  }
+}
+
 // Runtime bank (loaded from data/opl3bank.dat). Separate static storage
 // from the OPL3 backend's -- only one of the two backends is ever
 // constructed in a given process (adlib XOR opl3), so no double-load.
@@ -325,10 +381,14 @@ int MidiBackendOpl2::_find_voice(int channel, int note)
   return -1;
 }
 
-void MidiBackendOpl2::_apply_patch(int voice_id, int channel, int program)
+void MidiBackendOpl2::_apply_patch(int voice_id, int channel, int program,
+                                   int note)
 {
+  // patch 0298: on DRUM_CHANNEL the note is the instrument selector, not
+  // the program -- GM puts the kit on the note.
   const uint8_t *patch =
-      (channel == DRUM_CHANNEL) ? PATCH_DRUM : _program_to_patch(program);
+      (channel == DRUM_CHANNEL) ? _drum_patch_for_key(note)
+                                : _program_to_patch(program);
   SDL_DOSOpl3VoiceWritePatch(voice_id, patch);
 }
 
@@ -353,7 +413,7 @@ void MidiBackendOpl2::note_on(int channel, int note, int velocity)
   _voices[voice].midi_channel = (std::uint8_t)(channel & 0x0F);
   _voices[voice].midi_note    = (std::uint8_t)(note    & 0x7F);
 
-  _apply_patch(voice, channel, _channel_program[channel & 0x0F]);
+  _apply_patch(voice, channel, _channel_program[channel & 0x0F], note);
 
   // Honor patch[11] as a SIGNED int8 semitone transpose (DMXOPL/GENMIDI
   // convention; mirrors patch 0232 in the OPL3 backend). midi_note keeps
@@ -361,7 +421,7 @@ void MidiBackendOpl2::note_on(int channel, int note, int velocity)
   // transposed.
   const std::uint8_t *_xpatch =
       (channel == DRUM_CHANNEL)
-          ? PATCH_DRUM
+          ? _drum_patch_for_key(note)   // patch 0298: same table as dispatch
           : _program_to_patch(_channel_program[channel & 0x0F]);
   const int _play_note = note + (int)(std::int8_t)_xpatch[11];
 
