+  }
+};
+
+struct MdsPlayerTimer
+{
+  std::uint64_t t0;
+  MdsPlayerTimer() : t0(SDL_GetTicksNS()) {}
+  ~MdsPlayerTimer()
+  {
+    if (!mode_draw_scene_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
