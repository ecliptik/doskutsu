+    if (!mode_draw_scene_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
+    g_mds_tilemap_bg_dt_this_tick = dt;
+    if (g_mds_tilemap_bg_idx < g_eng_tick_block_size)
+      g_mds_tilemap_bg_samples[g_mds_tilemap_bg_idx++] = dt;
+  }
+};
+
+struct MdsObjectLoopTimer
+{
