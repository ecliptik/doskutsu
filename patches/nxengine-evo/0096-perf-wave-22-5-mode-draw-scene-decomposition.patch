+// DOS-PORT (patch 0096, Phase 9 wave 22.5 W22B mode_draw_scene
+// decomposition): 6 sub-bracket RAII timers + residual derivation.
+// Decomposes the wave-22 W22A2-measured mode_draw_scene = 22.53 ms
+// gameplay (84% of mode_tick = THE primary lever per W22A findings sec. 10
+// + wave-23 candidate-E ranking) into 6 work-type sub-buckets covering
+// `DrawScene()` body at vendor/nxengine-evo/src/game.cpp:489-736.
+//
+// The brackets fire only inside `DrawScene()` body -- title menu's
+// `draw_title()` is NOT bracketed by W22.5 (out of scope per contract
+// sec. 1; title's mode_draw_scene continues as a single number from W22A).
+//
+// Gated on SDL_HINT_DOSKUTSU_MODE_DRAW_SCENE_INSTR=1 (NEW; option B per
+// contract sec. 2 -- preserves the MODE_*_INSTR family-prefix consistency
+// from W22A's MODE_TICK_INSTR; rejects strict-"1" violation of numeric
+// escalation `=2`). Cached static-const-bool -- -O2 hoists per-tick
+// guards.
+//
+// Sub-buckets (sibling, non-overlapping inside `DrawScene()` scope):
+//   MdsClearTimer            - clearScreen(BLACK) at game.cpp:493
+//   MdsTilemapBgTimer        - map_draw_backdrop + map_draw(false) +
+//                              tintScreen at game.cpp:496-503
+//   MdsObjectLoopTimer       - the object for-loop body
+//                              at game.cpp:506-710 (per-object
+//                              drawSprite + drawSpotLight switch)
+//   MdsPlayerTimer           - DrawPlayer() at game.cpp:713
+//   MdsTilemapFgTimer        - map_draw(TA_FOREGROUND) +
+//                              map_draw_oob() at game.cpp:716-721
+//   MdsCaretsWaterFloatsTimer- Carets::DrawAll + map_drawwaterlevel +
+//                              FloatText::DrawAll at game.cpp:725-731
+//
+// Residual = mode_draw_scene_total - sum(6 sub-buckets), clamped 0,
+// computed in `game_tick_normal()` IMMEDIATELY AFTER the
+// ModeDrawSceneTimer scope closes (NOT at end-of-DrawScene). Reuses
+// W22A's `g_mt_draw_scene_dt_this_tick` populated by ModeDrawSceneTimer
+// in patch 0095 -- that local is only written when the W22A timer
+// destructor fires at scope-exit, which happens INSIDE
+// game_tick_normal() around the DrawScene() call. Reading the variable
+// inside DrawScene() before the destructor would see stale data; same
+// trap as W22A residual reading post-EngineTickTimer (per W22A
+// contract sec. 4 / W22B contract sec. 4 placement rationale).
+//
+// Self-validation: small mds_residual median (<1 ms) means brackets
+// are exhaustive. Large mds_residual surfaces an unbracketed chunk
+// inside DrawScene() body (e.g. function entry/exit overhead, debug
+// DrawBoundingBoxes) for wave-23 candidate-E refinement.
+//
+// COUPLING (mirrors W22A's coupling on FINE_INSTR): the W22.5 residual
+// computation requires MODE_TICK_INSTR=1 because g_mt_draw_scene_dt_-
+// this_tick is only written when W22A's gate is also active. With
+// MODE_DRAW_SCENE_INSTR=1 but MODE_TICK_INSTR=0, the residual silently
+// clamps to 0 every tick (sub-bucket samples remain valid). Operator's
+// W22B iter sets both hints; documented in BOOT.md.
+//
+// Storage: 6 sample arrays + 6 idxes + 6 per-tick dt locals + 1
+// residual array + 1 residual idx, all extern-declared here, defined
+// in Renderer.cpp where the audit-flush emission lives. Reuses W22A's
+// `g_eng_tick_block_size = 100` cadence (per contract sec. 3 -- NO new
+// block_size constant introduced).
+
+// Forward-declare the env helper. Definition lives in Renderer.cpp's
+// ablation-flag cluster (alongside _abl_flip_instr / _abl_fine_instr /
+// _abl_mode_tick_instr / _abl_mode_draw_scene_instr / _abl_direct_-
+// vesa). Mirrors W22A's `mode_tick_instr_active()` precedent.
+bool mode_draw_scene_instr_active();
+
+// Sample-array storage (extern; defined in Renderer.cpp). Sized at
+// `g_eng_tick_block_size` (= 100), shared with W20B + W22A per
+// contract sec. 3.
+extern std::uint64_t g_mds_clear_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mds_tilemap_bg_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mds_object_loop_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mds_player_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mds_tilemap_fg_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mds_carets_water_floats_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mds_residual_samples[g_eng_tick_block_size];
+extern int g_mds_clear_idx;
+extern int g_mds_tilemap_bg_idx;
+extern int g_mds_object_loop_idx;
+extern int g_mds_player_idx;
+extern int g_mds_tilemap_fg_idx;
+extern int g_mds_carets_water_floats_idx;
+extern int g_mds_residual_idx;
+
+// Per-tick dt locals -- written by each timer's destructor, consumed
+// by the new residual block in game_tick_normal() AFTER the
+// ModeDrawSceneTimer scope closes. Reset by caller at Game::tick
+// entry so leftover-from-prior-tick doesn't pollute the residual
+// subtraction (mirrors W22A's reset cluster).
+extern std::uint64_t g_mds_clear_dt_this_tick;
+extern std::uint64_t g_mds_tilemap_bg_dt_this_tick;
+extern std::uint64_t g_mds_object_loop_dt_this_tick;
+extern std::uint64_t g_mds_player_dt_this_tick;
+extern std::uint64_t g_mds_tilemap_fg_dt_this_tick;
+extern std::uint64_t g_mds_carets_water_floats_dt_this_tick;
+
+// Sub-bucket RAII timers. Same destructor pattern as W22A: capture
+// dt, write to per-tick local, push to sample array (with bounds-
+// check + env gate). Cost when env unset: 1 SDL_GetTicksNS at
+// construction (always) + 1 at destruction + 1 branch-on-cached-bool.
+// Mirrors W22A's `ModeSimTimer` etc. -- same pattern, layered
+// independently behind the new `mode_draw_scene_instr_active()` gate.
+struct MdsClearTimer
+{
+  std::uint64_t t0;
+  MdsClearTimer() : t0(SDL_GetTicksNS()) {}
+  ~MdsClearTimer()
+  {
+    if (!mode_draw_scene_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
+    g_mds_clear_dt_this_tick = dt;
+    if (g_mds_clear_idx < g_eng_tick_block_size)
+      g_mds_clear_samples[g_mds_clear_idx++] = dt;
+  }
+};
+
+struct MdsTilemapBgTimer
+{
+  std::uint64_t t0;
+  MdsTilemapBgTimer() : t0(SDL_GetTicksNS()) {}
+  ~MdsTilemapBgTimer()
