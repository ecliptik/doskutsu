+    if (g_mds_tilemap_fg_idx < g_eng_tick_block_size)
+      g_mds_tilemap_fg_samples[g_mds_tilemap_fg_idx++] = dt;
+  }
+};
+
+struct MdsCaretsWaterFloatsTimer
+{
+  std::uint64_t t0;
+  MdsCaretsWaterFloatsTimer() : t0(SDL_GetTicksNS()) {}
