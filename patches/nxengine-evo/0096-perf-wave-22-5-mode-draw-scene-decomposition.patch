+};
+
+struct MdsTilemapFgTimer
+{
+  std::uint64_t t0;
+  MdsTilemapFgTimer() : t0(SDL_GetTicksNS()) {}
+  ~MdsTilemapFgTimer()
+  {
+    if (!mode_draw_scene_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
