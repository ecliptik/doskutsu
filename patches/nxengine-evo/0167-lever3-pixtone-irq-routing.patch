@@ -60,6 +65,138 @@ namespace NXE
 namespace Sound
 {
 
+// DOS-PORT (patch 0167, Lever 3 Pixtone IRQ-mix). Sentinel-cached
+// killswitch helper for SDL_HINT_DOSKUTSU_PIXTONE_IRQ_MIX. Strict-"1"
+// opt-in; default OFF. Same idiom as nxengine/0162-v2 (MIDGAP_PUMP) /
+// 0164 (TICKPUMP) / 0165 (probe). Banner emit on first call.
+//
+// When ENABLED, Pixtone::play routes non-resampled SFX through the
+// SB16 IRQ-5 ISR mix path (SDL_DOSPixtoneStart / Stop / IsActive from
+// sdl-engine's SDL/0071) instead of SDL3_mixer's track pool. The ISR
+// path bypasses the cooperative-scheduler audio thread that hypothesis
+// C confirmed as the SFX-stutter cause (max single-callback latency
+// 1701 ms on real DX2-66 per #120 sec.22).
+//
+// When DISABLED (default), Pixtone::play uses the existing SDL3_mixer
+// dispatch path -- byte-identical to pre-0167 at the rendered-frame
+// level. The killswitch gates only the routing branches; counter
+// state machines and probe-side reads handle both paths transparently.
+//
+// Pixtone::playResampled v1 scope: always routes through SDL3_mixer
+// (no L3 path). The resampled-buffer storage isn't directly
+// IRQ-mixable via raw_master_buf; v2 candidate if stream SFX
+// (SND_STREAM1/2/PROPELLOR) need IRQ-mix.
+static int  g_pixtone_irq_mix_decided = -1;
+static bool pixtone_irq_mix_active()
+{
+  // patch 0167-v3 (Bug 5 defensive interlock per flush-instr's #131
+  // sec.24.8 + ratified hand-off): refuse L3 outright whenever the
+  // music backend is Organya, regardless of what the cached decision
+  // below resolved to. This check runs on EVERY call (cheap enum
+  // compare; no SDL_GetHint, no SDL boundary cross) instead of being
+  // folded into the lazy cache. Rationale:
+  //
+  //   * PLAY3 hung at scene transition with L3=1 + AUDIO_BACKEND=opl3
+  //     where the OPL3 probe failed at SoundManager::init -> probe
+  //     chain fell back to Organya AFTER pixtone_irq_mix_active()'s
+  //     first call had already cached "L3 engaged" (the SDL-side
+  //     SDL_DOSPixtoneIRQMixActive() returned true because OpenDevice
+  //     ran before the probe fallback). The cached decision then
+  //     stayed "engaged" while the actual music backend was Organya,
+  //     and the dangerous combination became reachable.
+  //
+  //   * Source-only investigation could not pin the deep L3+Organya
+  //     conflict mechanism (Organya + SDL3_mixer-Pixtone-fallback
+  //     resource conflict at scene transition is one of two adjacent
+  //     hypotheses; engine-spin-waiting-for-Organya-callback under
+  //     L3=1 is the other). Both are deferred to v1.0.2's deep root-
+  //     cause campaign.
+  //
+  //   * For v1.0.1 we make the dangerous combination unrepresentable
+  //     in the engine: the engine NEVER enters any L3 routing branch
+  //     when Organya is the live music backend, irrespective of the
+  //     cached decision or the SDL-side gate's resolution. Per-call
+  //     enum compare closes the probe-fallback race the v2 cache had.
+  //
+  // TAS-baseline-invariance note (carried over from #133 STOP-and-ack
+  // discussion): this interlock fires from Pixtone::play / setVolume
+  // call sites which run inside game.tick(); the LOG_ERROR emit is
+  // gated by an emit-once latch so it does not flood the log nor add
+  // per-tick wall-time that could shift TAS replay state determinism.
+  const bool organya_active =
+      (NXE::Diag::g_p10_audio_backend_active == NXE::Diag::AudioBackend::organya);
+
+  if (g_pixtone_irq_mix_decided < 0)
+  {
+    // patch 0167-v2 (Bug 5 fix per flush-instr's #127 sec.23.6 Option A):
+    // the engine-side decision must match the SDL-side backend-gate-query
+    // result. SDL/0071's SDL_DOSPixtoneIRQMixActive() reads SDL_HINT_-
+    // DOSKUTSU_PIXTONE_IRQ_MIX at OpenDevice AND validates the audio
+    // backend is non-Organya AND validates the ISR-mix infrastructure
+    // engaged. If env=1 but SDL refused (e.g. Organya backend selected),
+    // the engine-side must fall back to SDL3_mixer to keep audio
+    // working; we honor that by AND-ing the env parse with the SDL
+    // backend-gate-query result. Three-state banner so the operator sees
+    // which of the three outcomes was decided.
+    //
+    // Safe timing: pixtone_irq_mix_active() is called from Pixtone::
+    // play/stop/setVolume, all post-OpenDevice; SDL_DOSPixtoneIRQMix
+    // Active() returns cached state from the SDL-side OpenDevice
+    // resolution per sec.23.7.
+    const char *e = SDL_GetHint("SDL_HINT_DOSKUTSU_PIXTONE_IRQ_MIX");
+    const bool env_set     = (e && e[0] == '1' && e[1] == '\0');
+    const bool sdl_engaged = SDL_DOSPixtoneIRQMixActive();
+    g_pixtone_irq_mix_decided = (env_set && sdl_engaged) ? 1 : 0;
+    if (g_pixtone_irq_mix_decided)
+    {
+      LOG_INFO("pixtone IRQ-mix: ENABLED (opt-in; SDL backend engaged)");
+    }
+    else if (env_set && !sdl_engaged)
+    {
+      LOG_INFO("pixtone IRQ-mix: DISABLED (env=1 but SDL backend refused; "
+               "likely Organya audio backend selected -- falling back to "
+               "SDL3_mixer for SFX. To engage L3 set "
+               "SDL_HINT_DOSKUTSU_AUDIO_BACKEND to opl3 / wb / midi-stub.)");
+    }
+    else
+    {
+      LOG_INFO("pixtone IRQ-mix: DISABLED (default)");
+    }
+  }
+
+  // Defensive interlock: even if the cached decision says ENGAGED, force
+  // OFF when the live music backend is Organya. Emit-once LOG_ERROR so
+  // the operator sees WHY their L3=1 combination got ignored on this run.
+  if (g_pixtone_irq_mix_decided == 1 && organya_active)
+  {
+    static bool _l3_organya_interlock_warned = false;
+    if (!_l3_organya_interlock_warned)
+    {
+      LOG_ERROR("pixtone IRQ-mix: L3 + ORGANYA IS KNOWN-INCOMPATIBLE; "
+                "forcing L3-OFF (Bug 5 defensive interlock; deep root-"
+                "cause deferred to v1.0.2). The L3 cache resolved ENGAGED "
+                "but the live music backend is Organya -- most-likely "
+                "cause: AUDIO_BACKEND=opl3 (default) with OPL3 probe "
+                "fallback to Organya AFTER L3's SDL-side OpenDevice gate "
+                "resolved. To engage L3 set SDL_HINT_DOSKUTSU_AUDIO_"
+                "BACKEND to wb / midi-stub, OR verify OPL3 probe succeeds "
+                "on your hardware (see audio backend: opl3 banner above).");
+      _l3_organya_interlock_warned = true;
+    }
+    return false;
+  }
+
+  return g_pixtone_irq_mix_decided == 1;
+}
+
+// Global gain mirror for SDL3_mixer-compat path. Pixtone's existing
+// setVolume API is GLOBAL across all SFX (sets MIX_SetTrackGain on
+// every pool entry to the same value). Under L3, each new SFX play
+// reads its slot's gain_x256 -- which setVolume mirrors across all
+// slots so the L3 path matches the SDL3_mixer global-gain semantic.
+// v2 candidate: per-slot SDL_DOSPixtoneSetGain API for live updates.
+static int16_t g_global_gain_x256 = 256;  // 1.0 default
+
 static struct
 {
   int8_t table[256];
