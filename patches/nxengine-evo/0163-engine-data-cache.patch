   // SDL3_image: IMG_Init / IMG_Quit / IMG_INIT_* / IMG_GetError are gone.
diff --git a/src/nxe_cache.cpp b/src/nxe_cache.cpp
new file mode 100644
index 0000000..36a33f3
--- /dev/null
+++ b/src/nxe_cache.cpp
@@ -0,0 +1,208 @@
+// DOS-PORT (patch 0163, data cache): implementation. See nxe_cache.h
+// for the design rationale + the public API contract.
+
+#include "nxe_cache.h"
+#include "ResourceManager.h"
+#include "Utils/Logger.h"
+
+#include <SDL3/SDL.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+
+#include <dirent.h>
+#include <sys/stat.h>
+
+namespace {
+
+bool                                              g_inited           = false;
+int                                               g_enabled_cached   = -1;
+std::unordered_map<std::string, nxe::cache::Blob> g_blobs;
+int                                               g_total_files      = 0;
+std::size_t                                       g_total_bytes      = 0;
+int                                               g_total_skipped    = 0;
+std::size_t                                       g_skipped_bytes    = 0;
+
+void preload_file(const std::string &abs_path)
+{
+  std::FILE *fp = std::fopen(abs_path.c_str(), "rb");
+  if (!fp)
+    return;  // not present on disk -- silent skip (mod overlays, optional files)
+
+  if (std::fseek(fp, 0, SEEK_END) != 0)
+  {
+    std::fclose(fp);
+    return;
+  }
+  long len = std::ftell(fp);
+  if (len <= 0)
+  {
+    std::fclose(fp);
+    return;
+  }
+  std::rewind(fp);
+
+  unsigned char *buf = static_cast<unsigned char *>(std::malloc(static_cast<std::size_t>(len)));
+  if (!buf)
+  {
+    ++g_total_skipped;
+    g_skipped_bytes += static_cast<std::size_t>(len);
+    LOG_WARN("data cache: malloc({}) failed for '{}'; skipped (cache lookup will miss, "
+             "falls through to disk -- partial cache is still better than none)",
+             len, abs_path);
+    std::fclose(fp);
+    return;
+  }
+  std::size_t got = std::fread(buf, 1, static_cast<std::size_t>(len), fp);
+  std::fclose(fp);
+  if (got != static_cast<std::size_t>(len))
+  {
+    std::free(buf);
+    LOG_WARN("data cache: short read of '{}' ({} of {} bytes); skipped", abs_path, got, len);
+    return;
+  }
+
+  nxe::cache::Blob blob;
+  blob.data = buf;
+  blob.size = static_cast<std::size_t>(len);
+  g_blobs[abs_path] = blob;
+  ++g_total_files;
+  g_total_bytes += static_cast<std::size_t>(len);
+}
+
+// Enumerate abs_dir's regular files; for each, optionally filter by
+// suffix (case-insensitive); preload matches. Silent skip on opendir
+// failure (logs once) -- not all directories are present in all mods.
+void preload_dir(const std::string &abs_dir, const char *ext_filter)
+{
+  DIR *d = ::opendir(abs_dir.c_str());
+  if (!d)
+  {
+    LOG_WARN("data cache: opendir('{}') failed; dir skipped", abs_dir);
+    return;
+  }
+  struct ::dirent *ent;
+  while ((ent = ::readdir(d)) != nullptr)
+  {
+    if (ent->d_name[0] == '.')
+      continue;  // skip "." and ".."
+
+    if (ext_filter)
+    {
+      std::size_t nlen = std::strlen(ent->d_name);
+      std::size_t elen = std::strlen(ext_filter);
+      if (nlen <= elen)
+        continue;
+      bool ok = true;
+      for (std::size_t i = 0; i < elen; ++i)
+      {
+        char a = ent->d_name[nlen - elen + i];
+        char b = ext_filter[i];
+        if (a >= 'A' && a <= 'Z') a = static_cast<char>(a + 32);
+        if (b >= 'A' && b <= 'Z') b = static_cast<char>(b + 32);
+        if (a != b) { ok = false; break; }
+      }
+      if (!ok)
+        continue;
+    }
+
+    std::string full = abs_dir;
+    if (!full.empty() && full.back() != '/')
+      full += '/';
+    full += ent->d_name;
+
+    struct ::stat st;
+    if (::stat(full.c_str(), &st) != 0)
+      continue;
+    if (!S_ISREG(st.st_mode))
+      continue;
+
+    preload_file(full);
+  }
+  ::closedir(d);
+}
+
+// Preload a named subdirectory (relative to the base data dir). The
+// extension filter is optional (NULL = preload all regular files).
+void preload_subdir(const char *reldir, const char *ext_filter)
+{
+  std::string abs_dir = ResourceManager::getInstance()->getPathForDir(reldir);
+  while (!abs_dir.empty() && abs_dir.back() == '/')
+    abs_dir.pop_back();
+  LOG_INFO("data cache: preloading {}/ ...", reldir);
+  preload_dir(abs_dir, ext_filter);
+}
+
+}  // anonymous namespace
+
+namespace nxe {
+namespace cache {
+
+bool enabled()
+{
+  if (g_enabled_cached < 0)
+  {
+    const char *e    = SDL_GetHint("SDL_HINT_DOSKUTSU_DATA_CACHE");
+    g_enabled_cached = (e && e[0] == '1' && e[1] == '\0') ? 1 : 0;
+    LOG_INFO("data cache: {}",
+             g_enabled_cached ? "ENABLED (opt-in)" : "DISABLED (default)");
+  }
+  return g_enabled_cached == 1;
+}
+
+void init()
+{
+  if (g_inited)
+    return;
+  g_inited = true;
+  if (!enabled())
+    return;
+
+  // Access-pattern preload order: Stage/*.pbm -> Npc/*.pbm -> top-level
+  // *.pbm. .pbm files only -- the dominant freeze cause (Tileset::load
+  // .pbm reads on real DX2-66 CF exceed the audio ring depth, while
+  // the smaller engine reads .pxm / .pxe / .pxa / .tsc / .pxt each fit
+  // under the ring depth and route through myfopen which is uncached).
+  // Stage/ loads first (the heaviest single class, ~600 KB of Prt*.pbm
+  // tilesets) so the first stage transition is RAM-fast even if a
+  // later phase is interrupted (e.g. malloc failure descopes top-level
+  // but Stage/ is already resident).
+
+  preload_subdir("Stage", ".pbm");
+  preload_subdir("Npc",   ".pbm");
+
+  // Top-level .pbm scan: enumerate the base data dir directly with a
+  // ".pbm" extension filter to pick up Face*, Arms, Bullet, Caret,
+  // casts, ArmImg, etc. without sweeping .dat / .tbl / other top-level
+  // files. The base dir is from ResourceManager::getBasePath().
+  LOG_INFO("data cache: preloading top-level *.pbm ...");
+  std::string base = ResourceManager::getInstance()->getBasePath();
+  while (!base.empty() && base.back() == '/')
+    base.pop_back();
+  preload_dir(base, ".pbm");
+
+  LOG_INFO("data cache: preload complete -- {} files / {} bytes resident / "
+           "{} skipped ({} bytes malloc-failed)",
+           g_total_files, g_total_bytes, g_total_skipped, g_skipped_bytes);
+}
+
+const Blob *find(const std::string &path)
+{
+  if (!enabled())
+    return nullptr;
+  auto it = g_blobs.find(path);
+  return (it != g_blobs.end()) ? &it->second : nullptr;
+}
+
+const Blob *find(const char *path)
+{
+  if (!path)
+    return nullptr;
+  return find(std::string(path));
+}
+
+}  // namespace cache
+}  // namespace nxe
diff --git a/src/nxe_cache.h b/src/nxe_cache.h
new file mode 100644
index 0000000..199c786
--- /dev/null
+++ b/src/nxe_cache.h
@@ -0,0 +1,69 @@
+// DOS-PORT (patch 0163, data cache): boot-time preload of .pbm
+// bitmap assets into RAM, with cache-hit interception in
+// Surface::loadImage. Targets the 486-class campaign Bug 1 stage-load
+// freezes (Tileset::load's single uninterruptible fread on .pbm
+// tileset bitmaps -- ~64-100 KB each, ~400-1400 ms on CompactFlash --
+// exceeds the audio ring depth of ~372 ms, so no in-engine pump can
+// bridge it; cached reads at ~5-20 ms stay well inside the ring).
+// Sibling module to ResourceManager (path resolver) -- keeps the
+// Singleton boundary clean. See docs/internal/DATA-CACHE-DESIGN.md.
+//
+// Scope is .pbm files ONLY (the dominant freeze cause -- all .pbm
+// reads in the engine go through Surface::loadImage -> SDL_LoadBMP,
+// the single intercept point). The other small engine assets
+// (.pxm / .pxe / .pxa / .tsc / .pxt) read via fopen/myfopen are NOT
+// cached: each individual fread is sub-ring-depth so they do not
+// cause audible underrun. v1 scoping; v2 may widen if iter shows
+// residual misses.
+//
+// Killswitch: SDL_HINT_DOSKUTSU_DATA_CACHE. v1 default OFF (opt-in
+// via "=1"); same hygiene as nxengine/0162-v2. Sentinel-cached at
+// the first nxe::cache::enabled() call -- single SDL_GetHint then
+// cached int; banner emit on the decision.
+
+#ifndef _NXE_CACHE_H
+#define _NXE_CACHE_H
+
+#include <cstddef>
+#include <cstdio>
+#include <string>
+
+namespace nxe {
+namespace cache {
+
+// One cached file. data is malloc'd at preload, owned by the cache
+// (lifetime = process lifetime; no eviction in v1). size is the byte
+// length. Lookups return a const Blob* into the cache's internal map;
+// the pointer is stable until process exit.
+struct Blob
+{
+  unsigned char *data;
+  std::size_t    size;
+};
+
+// Returns true if SDL_HINT_DOSKUTSU_DATA_CACHE is set to "1". Reads
+// the hint once (sentinel-cached) and emits the build-qa BANNERS
+// banner on the decision. Safe to call before init().
+bool enabled();
+
+// Boot-time preload. Call once at engine init AFTER SDL_Init (for
+// SDL_GetHint) and AFTER ResourceManager init. Idempotent. With
+// enabled() == false, returns immediately (the hint decision banner
+// fires regardless). Otherwise enumerates Stage / Npc / top-level
+// .pbm / pxt in access-pattern order (highest-stakes first), reads
+// each file into a malloc'd buffer, and stores by absolute path
+// (matching what ResourceManager::getPath returns at lookup time).
+// On per-file malloc failure: skip + log + continue (partial cache
+// is still better than none; the lookup miss falls through to disk).
+void init();
+
+// Lookup by absolute path. Returns nullptr on miss or when disabled.
+// Lookup is O(1) (unordered_map). Safe from any thread (the cache is
+// initialized once at boot and never mutated thereafter).
+const Blob *find(const std::string &path);
+const Blob *find(const char *path);
+
+}  // namespace cache
+}  // namespace nxe
+
+#endif  // _NXE_CACHE_H
-- 
