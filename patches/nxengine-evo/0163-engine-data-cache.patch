diff --git a/src/graphics/Surface.cpp b/src/graphics/Surface.cpp
index 0b9ffba..185cf42 100644
--- a/src/graphics/Surface.cpp
+++ b/src/graphics/Surface.cpp
@@ -3,2 +3,3 @@
 #include "../Utils/Logger.h"
+#include "../nxe_cache.h"  // patch 0163 (data cache, intercept B): loadImage cache-hit path
 #include "zoom.h"
@@ -177,3 +178,23 @@ bool Surface::loadImage(const std::string &pbm_name, bool use_colorkey)
 
-  SDL_Surface *image = SDL_LoadBMP(pbm_name.c_str());
+  // patch 0163 (data cache, intercept B): if SDL_HINT_DOSKUTSU_DATA_CACHE
+  // is enabled AND pbm_name is in the cache, load the BMP from the
+  // cached memory blob via SDL3's SDL_LoadBMP_IO + SDL_IOFromConstMem.
+  // The resulting SDL_Surface is structurally-identical to SDL_LoadBMP's
+  // (same pixel data, same palette, same dimensions), so the colorkey +
+  // INDEX8 + paletteRemap path below runs against an identical surface
+  // regardless of byte source. On cache miss OR with cache disabled,
+  // fall through to plain SDL_LoadBMP -- the v1 default (cache off)
+  // gives byte-identical rendered frames to pre-0163.
+  SDL_Surface *image = nullptr;
+  {
+    const nxe::cache::Blob *blob = nxe::cache::find(pbm_name);
+    if (blob)
+    {
+      SDL_IOStream *io = SDL_IOFromConstMem(blob->data, blob->size);
+      if (io)
+        image = SDL_LoadBMP_IO(io, true);  // closeio=true: SDL closes the IOStream
+    }
+  }
+  if (!image)
+    image = SDL_LoadBMP(pbm_name.c_str());
   if (!image)
