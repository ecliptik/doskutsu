     void drawTileToSurface(SDL_Surface *dst, int dst_x, int dst_y, int t);
+
+    // DOS-PORT (patch 0328: blank-tile skip). Per-tile "fully
+    // transparent" table, rebuilt at every tileset load by
+    // _computeBlankTiles(). _tile_blank[t] == 1 iff every pixel of
+    // tile index t equals the tileset's colorkey (master index 0 /
+    // black) -- i.e. drawing it via _blit_indexed writes ZERO pixels,
+    // so the blit is a no-op the backdrop already shows through.
+    // map.cpp's BG tile loop skips those blits (byte-identical output).
+    // Indexed by the unsigned-char map tile value (0..255), so the hot
+    // loop needs no bounds check. Returns a stable pointer to the
+    // 256-entry table (all-zero -> "nothing skippable", the safe
+    // fallback when the surface has no colorkey or is not INDEX8).
+    const uint8_t *blankTable() const { return _tile_blank; }
   private:
+    // patch 0328: scan the loaded tilesheet and mark fully-transparent
+    // tiles. Safe-by-construction: only tiles whose every pixel is the
+    // colorkey are marked (their blit already writes nothing). Called
+    // from load() after _tileset is (re)populated.
+    void _computeBlankTiles();
+
     Surface *_tileset = nullptr;
     int _current_tileset = -1;
+    // patch 0328: 1 = tile is fully colorkey (skippable no-op blit).
+    uint8_t _tile_blank[256] = {0};
 };
 
 }; // namespace Graphics
