+// DOS-PORT (patch 0328: blank-tile skip). Scan the loaded tilesheet and
+// mark every tile whose pixels are ALL the colorkey (master index 0 /
+// black in indexed mode). Such a tile's blit is a proven no-op --
+// _blit_indexed writes only pixels where `px != colorkey` (Renderer.cpp),
+// so an all-colorkey tile writes nothing and the backdrop already shows
+// through it. map.cpp's BG loop skips those blits, which is byte-
+// identical to performing them.
+//
+// Safe-by-construction fallbacks (all -> "nothing skippable"): no
+// tileset, no CPU surface, no colorkey, or a non-INDEX8 surface. The
+// DOS build is always INDEX8 (wave-16 indexed mode) with colorkey 0, so
+// the scan runs in production; anything else leaves the table all-zero
+// and the loop skips nothing. Mirrors drawTile's exact src-rect math
+// (16 tiles per row, TILE_W x TILE_H) so the detection matches the
+// actual blit region.
+void Tileset::_computeBlankTiles()
+{
+  for (int i = 0; i < 256; ++i)
+    _tile_blank[i] = 0;
+
+  if (!_tileset)
+    return;
+  SDL_Surface *s = _tileset->surfaceCpu();
+  if (!s || !_tileset->hasColorkey())
+    return;
+  if (s->format != SDL_PIXELFORMAT_INDEX8)
+    return;
+
+  const Uint8 ck = (Uint8)(_tileset->colorkey() & 0xFFu);
+  const Uint8 *px = (const Uint8 *)s->pixels;
+  const int pitch = s->pitch;
+  const int tiles_per_row = 16;
+  const int ntiles_y = s->h / TILE_H;
+  const int ntiles = tiles_per_row * ntiles_y;
+
+  int nblank = 0;
+  for (int t = 0; t < ntiles && t < 256; ++t)
+  {
+    const int srcx = (t % 16) * TILE_W;
+    const int srcy = (t / 16) * TILE_H;
+    // Defensive: never read outside the surface (a short/odd sheet).
+    if (srcx + TILE_W > s->w || srcy + TILE_H > s->h)
+      continue;
+    bool blank = true;
+    for (int yy = 0; yy < TILE_H && blank; ++yy)
+    {
+      const Uint8 *row = px + (srcy + yy) * pitch + srcx;
+      for (int xx = 0; xx < TILE_W; ++xx)
+      {
+        if (row[xx] != ck) { blank = false; break; }
+      }
+    }
+    if (blank)
+    {
+      _tile_blank[t] = 1;
+      ++nblank;
+    }
+  }
+
+  LOG_INFO("Tileset::load: blank-tile precompute -- {} of {} tiles fully "
+           "transparent (tileset {})",
+           nblank, ntiles, _current_tileset);
+}
+
