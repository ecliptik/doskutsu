+// ============================================================================
+// patch 0144 (Phase 11 wave 49 H-A mds_clear LUT swap)
+// ============================================================================
+//
+// Per-row coverage LUT for the INDEX8 clearScreen path. See map.h for the
+// API contract + correctness model. The LUT is 256 entries (sized to
+// MAP_MAXSIZEY to cover any res-config; clearScreen only reads up through
+// win->h on each call).
+//
+// Wave-48 H-A bg-skip (patch 0143) ALREADY skips clearScreen + map_draw_
+// backdrop atomically on no-state-change frames. Patch 0144 attacks the
+// remaining clearScreen cost on the OTHER frames (when bg_skip_unchanged
+// is false: scene transition, player motion, flipacceltime exit). For
+// those non-skip frames, the clearScreen runs and pays ~2.23 ms for the
+// 76800-byte sysmem memset; patch 0144 reduces the byte count by ~70%
+// on Mimiga-class rooms via static per-row analysis.
+//
+// Lever class per WAVE-49-MDS-CLEAR-DESIGN sec. 2.2: bytes-ELIMINATED
+// (bandwidth-bound), not bytes-substituted. Architectural pressure-test
+// vs the wave-48 cache-cost-matches-render-cost pattern.
+
+static uint8_t g_mds_clear_row_skip_lut[MAP_MAXSIZEY];
+static bool    g_mds_clear_lut_built     = false;
+static int     g_mds_clear_lut_curmap    = -1;
+static int     g_mds_clear_lut_killswitch_decided = -1;  // -1=undecided, 0=ON, 1=killswitch
+static bool    g_mds_clear_lut_dispatch_eligible_flag = false;
+static unsigned g_mds_clear_lut_rebuilds_global = 0;
+
+static bool _mds_clear_lut_killswitch_engaged()
+{
+  if (g_mds_clear_lut_killswitch_decided < 0)
+  {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_MDS_CLEAR_LUT");
+    g_mds_clear_lut_killswitch_decided = (e && e[0] == '0' && e[1] == 0) ? 1 : 0;
+    LOG_INFO("map: mds_clear LUT {} (set SDL_HINT_DOSKUTSU_MDS_CLEAR_LUT=0 "
+             "to disable; default ON; patch 0144 wave-49 bandwidth lever)",
+             g_mds_clear_lut_killswitch_decided ? "DISABLED (killswitch)"
+                                                : "ENABLED (default)");
+  }
+  return g_mds_clear_lut_killswitch_decided == 1;
+}
+
+// Build the per-row skip LUT for the currently-loaded map. For each
+// possible screen-row sy (0..SCREEN_HEIGHT-1), determine if ANY map row
+// that could land on sy under ANY valid scroll position has at least
+// one tile == 0 column. If yes: row may be exposable -> LUT[sy] = 1
+// (must clear). If no: row is statically FG-opaque -> LUT[sy] = 0 (skip).
+//
+// Conservative bound: walks the FULL map column range, not just visible
+// columns. The static analysis is correct so long as map.tiles[][] is
+// not mutated at runtime; runtime mutations call
+// map_mds_clear_lut_invalidate() to force a lazy rebuild.
+static void _mds_clear_lut_rebuild()
+{
+  // win->h depends on res config; we read it lazily from Renderer.
+  // Default to 240 if Renderer unavailable (early-boot pre-init).
+  Renderer *r = Renderer::getInstance();
+  const int screen_h = (r && r->screenHeight > 0 && r->screenHeight <= MAP_MAXSIZEY)
+                       ? r->screenHeight : 240;
+  const int tile_h   = TILE_H;
+  const int map_h_px = map.ysize * tile_h;
+  const int max_scroll_y_px = (map_h_px > screen_h) ? (map_h_px - screen_h) : 0;
+
+  // Pre-pass: per-map-row "has any tile == 0 column" flag.
+  // Avoids re-scanning map width for each screen-Y; trades O(SH * MX *
+  // MY/TILE_H) for O(MX * MY) + O(SH * MY/TILE_H).
+  bool row_has_tile_0[MAP_MAXSIZEY];
+  for (int my = 0; my < map.ysize && my < MAP_MAXSIZEY; my++)
+  {
+    bool has = false;
+    for (int mx = 0; mx < map.xsize; mx++)
+    {
+      if (map.tiles[mx][my] == 0) { has = true; break; }
+    }
+    row_has_tile_0[my] = has;
+  }
+
+  // Main pass: per-screen-Y aggregation.
+  int k_skip = 0;
+  for (int sy = 0; sy < screen_h && sy < MAP_MAXSIZEY; sy++)
+  {
+    const int map_y_min = sy / tile_h;
+    int map_y_max = (max_scroll_y_px + sy) / tile_h;
+    if (map_y_max >= map.ysize) map_y_max = map.ysize - 1;
+
+    bool exposable = false;
+    for (int my = map_y_min; my <= map_y_max; my++)
+    {
+      if (row_has_tile_0[my]) { exposable = true; break; }
+    }
+    g_mds_clear_row_skip_lut[sy] = exposable ? 1 : 0;
+    if (!exposable) ++k_skip;
+  }
+  // Fill the tail beyond screen_h with 1 (clear) as defensive default --
+  // any out-of-range query should fall to the safe "clear" verdict.
+  for (int sy = screen_h; sy < MAP_MAXSIZEY; sy++)
+    g_mds_clear_row_skip_lut[sy] = 1;
+
+  g_mds_clear_lut_built  = true;
+  g_mds_clear_lut_curmap = game.curmap;
+  ++g_mds_clear_lut_rebuilds_global;
+
+  const int k_keep = screen_h - k_skip;
+  const int k_skip_pct = (screen_h > 0) ? (k_skip * 100 / screen_h) : 0;
+  const int k_keep_pct = 100 - k_skip_pct;
+  LOG_INFO("mds-clear-lut: rebuilt N={} entries (k_skip={}% k_keep={}%; "
+           "curmap={} map_size={}x{}; rebuild #{} since boot)",
+           screen_h, k_skip_pct, k_keep_pct,
+           game.curmap, map.xsize, map.ysize,
+           g_mds_clear_lut_rebuilds_global);
+  (void)k_keep;  // computed for clarity; not directly used after format
+}
+
+void map_mds_clear_lut_invalidate()
+{
+  // Mark stale; next ensure_built() call triggers rebuild lazily.
+  // Lazy semantics: a TSC <CMP burst that fires N mutations in one tick
+  // produces a single rebuild on the next clearScreen call, not N
+  // rebuilds.
+  g_mds_clear_lut_built = false;
+}
+
+void map_mds_clear_lut_ensure_built()
+{
+  // Rebuild when (a) never built, (b) map changed since last build,
+  // (c) invalidated by a tile mutation. All three resolve to "built ==
+  // false || curmap != game.curmap."
+  if (!g_mds_clear_lut_built || g_mds_clear_lut_curmap != game.curmap)
+  {
+    _mds_clear_lut_rebuild();
+  }
+}
+
+void map_mds_clear_lut_set_dispatch_eligible(bool eligible)
+{
+  g_mds_clear_lut_dispatch_eligible_flag = eligible;
+}
+
+bool map_mds_clear_lut_dispatch_eligible()
+{
+  // Caller (Renderer::clearScreen INDEX8 path) ALSO checks the killswitch
+  // before consulting the LUT. Both must be true for skip-dispatch.
+  return g_mds_clear_lut_dispatch_eligible_flag
+         && !_mds_clear_lut_killswitch_engaged();
+}
+
+bool map_mds_clear_lut_should_skip_row(int sy)
+{
+  // Defensive bounds: out-of-range -> "clear" (safe default; never skip).
+  if (!g_mds_clear_lut_built || sy < 0 || sy >= MAP_MAXSIZEY) return false;
+  // LUT[sy] == 0 = skip-eligible; LUT[sy] == 1 = must clear.
+  return g_mds_clear_row_skip_lut[sy] == 0;
+}
+
 // DOS-PORT (patch 0080): probe killswitch once on first call. Strict
 // "0" match disables the cache (lets a real-HW iter reproduce wave-9
 // pre-cache behavior for ablation). All other values keep the
@@ -2936,6 +3090,17 @@ void map_ChangeTileWithSmoke(int x, int y, int newtile, int nclouds, bool boomfl
   // ~hundreds of destroyable tiles per map, never approaches limit).
   ++g_tile_mutation_counter;
 
+  // DOS-PORT (patch 0144, Phase 11 wave 49 mds_clear LUT): invalidate
+  // the per-row skip LUT. The mutation may have introduced a tile-0
+  // column into a previously-fully-FG-opaque row OR removed the last
+  // tile-0 column from an exposable row -- either direction can flip
+  // the row's LUT entry. Lazy semantics: invalidate marks stale; next
+  // clearScreen call triggers _mds_clear_lut_rebuild via
+  // map_mds_clear_lut_ensure_built. Heavypress floor-break (heavypress.
+  // cpp:136/220), Balrog cutscene (balrog.cpp:237), and every door-
+  // open scripted event reach this site.
+  map_mds_clear_lut_invalidate();
+
   int xa = ((x * TILE_W) + (TILE_W / 2)) * CSFI;
   int ya = ((y * TILE_H) + (TILE_H / 2)) * CSFI;
   SmokeXY(xa, ya, nclouds, TILE_W / 2, TILE_H / 2, push_behind);
