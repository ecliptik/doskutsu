+// DOS-PORT (patch 0125, Phase 11 wave-29 mds_tilemap_bg sub-decomposition
+// per docs/PHASE11-WAVE-29-CONTRACT.md): 3 sub-bracket RAII timers +
+// derived residual sub-decomposing W22.5's `mds_tilemap_bg` parent
+// bucket. iter K K3 measured `mds_tilemap_bg` median = 8.30 ms post-
+// slot-0117 = 28% of inter_flip on First Cave Tier-2 heavy-music -- the
+// dominant remaining single-bucket engine-side slice. Wave-28 refuted
+// the iter K residual-decomp prediction that the 12 ms unmeasured slice
+// lived inside `phase=total`; instead it lives in `engine_tick - phase=
+// total` ~ 24 ms, and `mds_tilemap_bg` is its largest unmeasured sub-
+// slice. Cutting it in half (~4 ms) lands the session 40 fps goal.
+//
+// The brackets fire ONLY inside `DrawScene()` body -- at the three call
+// sites inside the existing W22.5 `MdsTilemapBgTimer` scope at game.cpp
+// lines 605-615:
+//   line 609: map_draw_backdrop()          (only when !flipacceltime)
+//   line 610: map_draw(false)              (only when !flipacceltime)
+//   line 614: tintScreen()                 (only when settings->lights)
+//
+// Three competing hypotheses for the 8 ms (per contract sec. 0.3):
+//   H-A  mdt_bg_backdrop dominant  (2-5 ms; BK_FASTLEFT_LAYERS parallax)
+//   H-B  mdt_bg_tilelayer dominant (3-6 ms; ~150 tiles x ~50 us)
+//   H-C  mdt_bg_tintscreen dominant (0.5-4 ms; 76800-pixel darkening)
+// Wave-30 lever depends on which dominates; can't pick without data.
+//
+// Gated on SDL_HINT_DOSKUTSU_MDS_BG_INSTR=1 (NEW; strict-1 per CLAUDE.md
+// convention; family-prefix consistency with W25's MDS_TFG_INSTR).
+// Cached static-const-bool -- -O2 hoists per-tick guards.
+//
+// Sub-buckets (sibling, non-overlapping inside MdsTilemapBgTimer
+// scope at game.cpp:605-615):
+//   MdtBgBackdropTimer   - map_draw_backdrop() at game.cpp:609
+//   MdtBgTilelayerTimer  - map_draw(false) at game.cpp:610
+//   MdtBgTintscreenTimer - tintScreen() at game.cpp:614 (inside
+//                           settings->lights conditional; never
+//                           constructs when lights=off)
+//
+// Residual = mds_tilemap_bg_total - sum(3 sub-buckets), clamped 0,
+// computed in `game_tick_normal()` after DrawScene returns (placement
+// alongside the W22.5 residual block at game.cpp:515 area -- same
+// rationale as W22.5: parent total has been written by the
+// MdsTilemapBgTimer destructor by the time DrawScene returns). Reuses
+// W22.5's `g_mds_tilemap_bg_dt_this_tick` populated by
+// MdsTilemapBgTimer in patch 0096 -- NO new SDL_GetTicksNS read.
+//
+// COUPLING (mirrors W22.5's coupling on MODE_TICK_INSTR): the W29
+// residual requires MODE_DRAW_SCENE_INSTR=1 because g_mds_tilemap_bg_-
+// dt_this_tick is only written when W22.5's gate is also active. With
+// MDS_BG_INSTR=1 but MODE_DRAW_SCENE_INSTR=0, residual silently clamps
+// to 0 every tick (sub-bucket samples remain valid). Operator's W29A
+// iter sets MODE_DRAW_SCENE_INSTR=1 alongside MDS_BG_INSTR=1 per
+// contract sec. 6.
+//
+// Storage: 3 sample arrays + 3 idxes + 3 per-tick dt locals + 1
+// residual array + 1 residual idx, all extern-declared here, defined
+// in Renderer.cpp where the audit-flush emission lives. Reuses W22.5's
+// `g_eng_tick_block_size = 100` cadence (per contract sec. 3 -- NO new
+// block_size constant introduced).
+//
+// Critical placement decision (per contract sec. 4): MdtBgTintscreenTimer
+// scope MUST live inside the `if (settings->lights)` conditional, NOT
+// outside it. When lights=off, the timer never constructs (no
+// SDL_GetTicksNS cost), the dt local stays at the per-tick-reset zero,
+// and the bucket emits `n=0` placeholder per sec. 3.
+
+// Forward-decl the env helper. Definition lives in Renderer.cpp's
+// ablation-flag cluster (alongside _abl_flip_instr / _abl_mode_tick_-
+// instr / _abl_mode_draw_scene_instr / _abl_mds_tfg_instr); forwarded
+// via file-scope wrapper at end-of-Renderer.cpp per the W20B build-
+// fix amendment about avoiding the nested NXE::Graphics::NXE::Diag
+// trap. Strict-"1" match for SDL_HINT_DOSKUTSU_MDS_BG_INSTR.
+bool mds_bg_instr_active();
+
+// Sample-array storage (extern; defined in Renderer.cpp). Sized at
+// `g_eng_tick_block_size` (= 100), shared with W20B + W22A + W22.5 +
+// W25 per contract sec. 3.
+extern std::uint64_t g_mdt_bg_backdrop_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mdt_bg_tilelayer_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mdt_bg_tintscreen_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mdt_bg_residual_samples[g_eng_tick_block_size];
+extern int g_mdt_bg_backdrop_idx;
+extern int g_mdt_bg_tilelayer_idx;
+extern int g_mdt_bg_tintscreen_idx;
+extern int g_mdt_bg_residual_idx;
+
+// Per-tick dt locals -- written by each timer's destructor, consumed
+// by the new residual block in `game_tick_normal()` after DrawScene
+// returns. Reset by caller at Game::tick entry so leftover-from-prior-
+// tick doesn't pollute the residual subtraction (mirrors W22.5's
+// reset cluster).
+extern std::uint64_t g_mdt_bg_backdrop_dt_this_tick;
+extern std::uint64_t g_mdt_bg_tilelayer_dt_this_tick;
+extern std::uint64_t g_mdt_bg_tintscreen_dt_this_tick;
+
+// Sub-bucket RAII timers. Same destructor pattern as W22.5: capture
+// dt, write to per-tick local, push to sample array (with bounds-
+// check + env gate). Cost when env unset: 1 SDL_GetTicksNS at
+// construction + 1 at destruction + 1 branch-on-cached-bool.
+// MdtBgTintscreenTimer never constructs when lights=off because the
+// caller's `if (settings->lights)` conditional gates the timer's
+// scope-block (see game.cpp at line 614).
+struct MdtBgBackdropTimer
+{
+  std::uint64_t t0;
+  MdtBgBackdropTimer() : t0(SDL_GetTicksNS()) {}
+  ~MdtBgBackdropTimer()
+  {
+    if (!mds_bg_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
+    g_mdt_bg_backdrop_dt_this_tick = dt;
+    if (g_mdt_bg_backdrop_idx < g_eng_tick_block_size)
+      g_mdt_bg_backdrop_samples[g_mdt_bg_backdrop_idx++] = dt;
+  }
+};
+
+struct MdtBgTilelayerTimer
+{
+  std::uint64_t t0;
+  MdtBgTilelayerTimer() : t0(SDL_GetTicksNS()) {}
+  ~MdtBgTilelayerTimer()
+  {
+    if (!mds_bg_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
+    g_mdt_bg_tilelayer_dt_this_tick = dt;
+    if (g_mdt_bg_tilelayer_idx < g_eng_tick_block_size)
+      g_mdt_bg_tilelayer_samples[g_mdt_bg_tilelayer_idx++] = dt;
+  }
+};
+
+struct MdtBgTintscreenTimer
+{
+  std::uint64_t t0;
+  MdtBgTintscreenTimer() : t0(SDL_GetTicksNS()) {}
+  ~MdtBgTintscreenTimer()
+  {
+    if (!mds_bg_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
+    g_mdt_bg_tintscreen_dt_this_tick = dt;
+    if (g_mdt_bg_tintscreen_idx < g_eng_tick_block_size)
+      g_mdt_bg_tintscreen_samples[g_mdt_bg_tintscreen_idx++] = dt;
+  }
+};
