+// ---------------------------------------------------------------------------
+// DOS-PORT (patch 0270, #3 -- v1.6.3): Pixtone SFX render-output disk cache.
+//
+// Both Pixtone::init() (SB16/OPL3/organya DAC path) and Pixtone::initGusSfx()
+// (GF1 path) synthesise every fxNN.pxt from scratch at boot via stPXSound::
+// render() -- the per-sample wavetable synth. Across the 0x75 (117) SFX that is
+// ~51 s of pure CPU on a Pentium-class box, paid on EVERY launch and IDENTICAL
+// across all audio backends (both init paths run the same render()).
+//
+// This is the shape the organya PCM cache (patch 0215 / ORG_AUTOCACHE) already
+// solves for music: render once on first launch, persist to disk, load the
+// cache on subsequent boots. That cache is organya-only; Pixtone was never
+// cached (hence the 51 s). This patch caches the render() OUTPUT --
+// stPXSound::final_buffer (int8_t, S8 mono @ 22050 Hz, final_size bytes). That
+// artifact is TIER-INDEPENDENT (always S8/mono/22050; init() resamples it to
+// the runtime S16 tier, initGusSfx() uploads it to GF1 DRAM), so ONE cache
+// skips the render on every backend and every tier -- and it is the smallest
+// possible artifact (8-bit mono, single copy, not one-per-tier).
+//
+// Blob: CACHE\PXT\PXTSFX.BIN =
+//   PxtCacheHeader { magic 'PXC1', build DOSKUTSU_BUILD_SHA12, num_sounds }
+//   + num_sounds x PxtCacheIndex { present, size }        (slot i = entry i-1)
+//   + concatenated S8 PCM for every present slot, `size` bytes each, in order.
+// A single blob (not one file per slot) keeps the CF FAT directory to one
+// entry. The version key is the FULL build SHA in the file CONTENT -- a rebuild
+// (which may change the synth math or NUM_SOUNDS) invalidates the cache; like
+// ORG_AUTOCACHE, swapping the .pxt data WITHOUT a rebuild will not invalidate
+// (accepted + documented). fopen is always "rb"/"wb" (DJGPP text mode would
+// corrupt the binary PCM).
+//
+// Killswitch: default-ON, disabled only by the exact string
+// SDL_HINT_DOSKUTSU_PXT_AUTOCACHE=0 (strict-killswitch idiom, mirrors
+// ORG_AUTOCACHE / PIXTONE_IRQ_MIX). With it off the slots render as before and
+// NO cache is read or written (byte-identical boot, just slow).
+// ---------------------------------------------------------------------------
+extern "C" bool io_audit_enabled(void);
+extern "C" void io_audit_emit(const char *op, const char *path, long bytes,
+                              unsigned long long usec);
+
+#define _DOSKUTSU_PXTCACHE_STRINGIFY(x) #x
+#define _DOSKUTSU_PXTCACHE_STR(x) _DOSKUTSU_PXTCACHE_STRINGIFY(x)
+#ifndef DOSKUTSU_BUILD_SHA12
+#define DOSKUTSU_BUILD_SHA12 UNKNOWN_____
+#endif
+
+struct PxtCacheHeader
+{
+  char     magic[4];    // 'P','X','C','1'
+  char     build[16];   // DOSKUTSU_BUILD_SHA12 (12 chars + nul pad)
+  uint32_t num_sounds;  // NUM_SOUNDS at build time
+  uint32_t reserved;    // 0 (future use)
+};
+
+struct PxtCacheIndex
+{
+  uint32_t present;     // 0/1 -- slot has a .pxt (matches a successful load())
+  uint32_t size;        // final_size bytes for this slot (0 when absent)
+};
+
+struct PxtCacheSlot
+{
+  bool                present = false;
+  std::vector<int8_t> pcm;  // render() final_buffer: S8 mono @ 22050, final_size bytes
+};
+
+enum class PxtCacheResult { Disabled, Hit, Built, BuildWriteFailed };
+
+// Strict-killswitch: default ON; only the exact "0" disables. Sentinel-cached.
+static bool _pxt_autocache_enabled(void)
+{
+  static int decided = -1;
+  if (decided < 0)
+  {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_PXT_AUTOCACHE");
+    decided = (e && e[0] == '0' && e[1] == '\0') ? 0 : 1;
+  }
+  return decided != 0;
+}
+
+static std::string _pxt_cache_base_dir(void)
+{
+  return ResourceManager::getInstance()->getBasePath() + "CACHE";
+}
+static std::string _pxt_cache_dir(void)
+{
+  return _pxt_cache_base_dir() + "/PXT";
+}
+static std::string _pxt_cache_file(void)
+{
+  return _pxt_cache_dir() + "/PXTSFX.BIN";  // 8.3-safe
+}
+
+// Render ONE slot's fxNN.pxt to its S8 final_buffer. Returns false if the .pxt
+// is absent (mirrors load()==false -> "slot has no SFX"). On success `out`
+// holds the render() output; the transient stPXSound is freed here.
+static bool _pxt_render_slot(uint32_t slot, std::vector<int8_t> &out)
+{
+  std::string path = ResourceManager::getInstance()->getPathForDir("pxt/");
+  std::ostringstream fn;
+  fn << path << "fx" << std::hex << std::setw(2) << std::setfill('0') << slot << ".pxt";
+  stPXSound snd;
+  if (!snd.load(fn.str()))
+    return false;
+  snd.render();  // -> final_buffer: S8 mono @ 22050 (0246 OOM guard -> silence)
+  if (snd.final_buffer && snd.final_size > 0)
+    out.assign(snd.final_buffer, snd.final_buffer + snd.final_size);
+  else
+    out.clear();
+  snd.freeBuf();
+  return true;
+}
+
+// Try to load the cache blob into `slots` (sized num_sounds+1, slot-indexed).
+// Returns true only on a fully-validated hit; on any miss/mismatch/short-read
+// `slots` is reset so the caller renders + rebuilds.
+static bool _pxt_cache_try_load(uint32_t num_sounds, std::vector<PxtCacheSlot> &slots)
+{
+  const bool   _ioa = io_audit_enabled();
+  const Uint64 _t0  = _ioa ? SDL_GetTicksNS() : 0;
+  FILE *fp = fopen(_pxt_cache_file().c_str(), "rb");
+  if (!fp)
+    return false;
+
+  PxtCacheHeader h;
+  bool ok = (fread(&h, 1, sizeof h, fp) == sizeof h)
+            && h.magic[0] == 'P' && h.magic[1] == 'X'
+            && h.magic[2] == 'C' && h.magic[3] == '1'
+            && strncmp(h.build, _DOSKUTSU_PXTCACHE_STR(DOSKUTSU_BUILD_SHA12),
+                       sizeof h.build) == 0
+            && h.num_sounds == num_sounds;
+
+  std::vector<PxtCacheIndex> idx;
+  if (ok)
+  {
+    idx.resize(num_sounds);
+    ok = (fread(idx.data(), sizeof(PxtCacheIndex), num_sounds, fp) == num_sounds);
+  }
+
+  long total = 0;
+  if (ok)
+  {
+    for (uint32_t i = 0; i < num_sounds && ok; ++i)
+    {
+      if (!idx[i].present)
+        continue;
+      const uint32_t s = i + 1;
+      slots[s].present = true;
+      slots[s].pcm.resize(idx[i].size);
+      if (idx[i].size)
+      {
+        ok = (fread(slots[s].pcm.data(), 1, idx[i].size, fp) == idx[i].size);
+        total += (long)idx[i].size;
+      }
+    }
+  }
+  fclose(fp);
+
+  if (!ok)
+    slots.assign(num_sounds + 1, PxtCacheSlot());  // corrupt/stale -> discard
+
+  if (_ioa)
+    io_audit_emit("pxt_sfx_cache", _pxt_cache_file().c_str(),
+                  ok ? total : 0,
+                  (unsigned long long)((SDL_GetTicksNS() - _t0) / 1000ull));
+  return ok;
+}
+
+// Persist `slots` to the blob. Best-effort: a write failure (full / read-only
+// CF) removes any partial file + returns false; the in-RAM slots still serve
+// this boot (just uncached next boot).
+static bool _pxt_cache_write(uint32_t num_sounds, const std::vector<PxtCacheSlot> &slots)
+{
+  mkdir(_pxt_cache_base_dir().c_str(), 0777);  // best-effort; EEXIST is fine
+  mkdir(_pxt_cache_dir().c_str(), 0777);
+  FILE *fp = fopen(_pxt_cache_file().c_str(), "wb");
+  if (!fp)
+  {
+    LOG_WARN("[pxt-cache] could not open {} for write; SFX will re-render next "
+             "boot.", _pxt_cache_file());
+    return false;
+  }
+
+  PxtCacheHeader h;
+  memset(&h, 0, sizeof h);
+  h.magic[0] = 'P'; h.magic[1] = 'X'; h.magic[2] = 'C'; h.magic[3] = '1';
+  snprintf(h.build, sizeof h.build, "%s",
+           _DOSKUTSU_PXTCACHE_STR(DOSKUTSU_BUILD_SHA12));
+  h.num_sounds = num_sounds;
+  h.reserved   = 0;
+
+  bool ok = (fwrite(&h, 1, sizeof h, fp) == sizeof h);
+
+  std::vector<PxtCacheIndex> idx(num_sounds);
+  for (uint32_t i = 0; i < num_sounds; ++i)
+  {
+    const uint32_t s = i + 1;
+    idx[i].present = slots[s].present ? 1u : 0u;
+    idx[i].size    = slots[s].present ? (uint32_t)slots[s].pcm.size() : 0u;
+  }
+  ok = ok && (fwrite(idx.data(), sizeof(PxtCacheIndex), num_sounds, fp) == num_sounds);
+
+  long total = 0;
+  for (uint32_t i = 0; i < num_sounds && ok; ++i)
+  {
+    const uint32_t s = i + 1;
+    if (idx[i].present && idx[i].size)
+    {
+      ok = (fwrite(slots[s].pcm.data(), 1, idx[i].size, fp) == idx[i].size);
+      total += (long)idx[i].size;
+    }
+  }
+  fclose(fp);
+
+  if (!ok)
+  {
+    remove(_pxt_cache_file().c_str());  // don't leave a truncated blob to load
+    LOG_WARN("[pxt-cache] write failed/short -> removed partial {}.",
+             _pxt_cache_file());
+    return false;
+  }
+  LOG_INFO("[pxt-cache] wrote cache: {} bytes PCM across {} slots -> {} "
+           "(CF footprint).", total, (int)num_sounds, _pxt_cache_file());
+  return ok;
+}
+
+// Load the SFX render cache if valid, else render every slot once + write it.
+// Fills `slots` (slot-indexed, 1..num_sounds). Single point both init() and
+// initGusSfx() call before their per-slot consume loops.
+static PxtCacheResult _pxt_load_or_build_cache(uint32_t num_sounds,
+                                               std::vector<PxtCacheSlot> &slots)
+{
+  slots.assign(num_sounds + 1, PxtCacheSlot());
+
+  const bool use_cache = _pxt_autocache_enabled();
+  if (use_cache && _pxt_cache_try_load(num_sounds, slots))
+    return PxtCacheResult::Hit;
+
+  // Miss (or disabled): render every present slot once. Only one slot's synth
+  // buffers are resident at a time (freed inside _pxt_render_slot); the S8 PCM
+  // accumulates in `slots` (~1-2 MB total for the full set).
+  for (uint32_t s = 1; s <= num_sounds; ++s)
+    slots[s].present = _pxt_render_slot(s, slots[s].pcm);
+
+  if (!use_cache)
+    return PxtCacheResult::Disabled;
+
+  return _pxt_cache_write(num_sounds, slots) ? PxtCacheResult::Built
+                                             : PxtCacheResult::BuildWriteFailed;
+}
+
+static const char *_pxt_cache_result_str(PxtCacheResult r)
+{
+  switch (r)
+  {
+    case PxtCacheResult::Hit:              return "HIT (loaded cache; render skipped)";
+    case PxtCacheResult::Built:            return "BUILT (rendered once + wrote cache)";
+    case PxtCacheResult::BuildWriteFailed: return "BUILT (rendered; cache WRITE FAILED)";
+    case PxtCacheResult::Disabled:         return "DISABLED (killswitch; rendered, no cache)";
+  }
+  return "?";
+}
+
 Pixtone::Pixtone() {}
 Pixtone::~Pixtone() {}
 
