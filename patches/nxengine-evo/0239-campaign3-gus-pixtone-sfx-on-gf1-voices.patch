+// patch 0239 (Campaign 3 GUS, #28): render the 117 .pxt and upload them into
+// the GF1 card's DRAM as 8-bit UNSIGNED mono @ 22050 Hz. Replaces init() on the
+// AUDIO_BACKEND=gus path (no SDL3_mixer device exists). Runs in main-loop init
+// context (file I/O + synth are fine here, not the IRQ note path).
+bool Pixtone::initGusSfx()
+{
+  if (_inited)
+  {
+    LOG_ERROR("pxt_init: pxt module already initialized");
+    return false;
+  }
+  _inited   = true;
+  _gus_mode = true;
+
+  for (uint16_t i = 0; i < 256; i++)
+    _sound_fx[i].channel = -1;
+  for (int v = 0; v < 32; v++)
+    _gus_voice_slot[v] = -1;
+
+  // Wave-model tables (identical to init()).
+  for (uint32_t seed = 0, i = 0; i < 256; ++i)
+  {
+    seed                       = (seed * 214013) + 2531011;
+    wave[MOD_SINE].table[i]    = 0x40 * std::sin(i * 3.1416 / 0x80);
+    wave[MOD_TRI].table[i]     = ((0x40 + i) & 0x80) ? 0x80 - i : i;
+    wave[MOD_SAWUP].table[i]   = -0x40 + i / 2;
+    wave[MOD_SAWDOWN].table[i] = 0x40 - i / 2;
+    wave[MOD_SQUARE].table[i]  = 0x40 - (i & 0x80);
+    wave[MOD_NOISE].table[i]   = (signed char)(seed >> 16) / 2;
+  }
+
+  SDL_DOSGusState st;
+  if (!SDL_DOSGusGetState(&st) || !st.valid)
+  {
+    LOG_WARN("gus SFX: GF1 not active (SDL_DOSGusGetState); SFX silent this "
+             "run. The game still runs (music continues on the GF1).");
+    return false;
+  }
+
+  // MUSIC-PRIORITY DRAM CAP (#28 robustness): reserve room for a song's GM .pat
+  // set so the SFX bank can NEVER starve the music (the headline). SFX fills DRAM
+  // only up to (dram_size - RESERVE_FOR_MUSIC); the remainder stays free for the
+  // MidiBackendGus per-song .pat residency. On a large card all 117 SFX fit; on a
+  // small card SFX degrades gracefully (over-budget SFX stay silent) but music
+  // ALWAYS loads. Without this, bq-pg's 256KB DOSBox GF1 filled with SFX alone ->
+  // music starved. INVARIANT (holds at any DRAM size), not a measured perf-tune.
+  // RESERVE_FOR_MUSIC is a CONSERVATIVE DEFAULT -- REFINE once realhw #30 reports
+  // the real PicoGUS /mode gus DRAM size (via the SDL/0112 detect banner) + the
+  // actual per-song .pat footprint.
+  static const uint32_t RESERVE_FOR_MUSIC = 320u * 1024u;  // ~a song's instrument set
+  const uint32_t sfx_budget =
+      (st.dram_size > RESERVE_FOR_MUSIC) ? (st.dram_size - RESERVE_FOR_MUSIC)
+                                         : (st.dram_size / 2);  // tiny card: 50/50 floor
+  LOG_INFO("Loading Sound FX (GUS / GF1 DRAM)... SFX budget = {} KB of {} KB "
+           "(reserving {} KB for the song's .pat set -- music-priority).",
+           (unsigned)(sfx_budget / 1024), (unsigned)(st.dram_size / 1024),
+           (unsigned)(RESERVE_FOR_MUSIC / 1024));
+  std::string path = ResourceManager::getInstance()->getPathForDir("pxt/");
+  int uploaded = 0, failed = 0, skipped = 0;
+  uint32_t sfx_used = 0;
+  for (uint32_t slot = 1; slot <= NUM_SOUNDS; slot++)
+  {
+    std::ostringstream filename;
+    filename << path << "fx" << std::hex << std::setw(2) << std::setfill('0') << slot << ".pxt";
+    stPXSound snd;
+    if (!snd.load(filename.str()))
+      continue;
+    snd.render();  // -> final_buffer: 8-bit SIGNED mono @ 22050 Hz, final_size bytes
+
+    if (snd.final_buffer && snd.final_size > 0)
+    {
+      const uint32_t n = (uint32_t)snd.final_size;
+      // Music-priority cap: skip this SFX if it would push the bank past the
+      // budget (continue, not break, so a smaller later SFX can still fit).
+      if (sfx_used + n > sfx_budget)
+      {
+        ++skipped;
+        snd.freeBuf();
+        continue;
+      }
+      uint8_t *tmp = (uint8_t *)std::malloc(n);
+      if (tmp)
+      {
+        // .pxt is 8-bit signed; GF1 8-bit DRAM is UNSIGNED -> flip the sign bit.
+        for (uint32_t k = 0; k < n; ++k)
+          tmp[k] = (uint8_t)((uint8_t)snd.final_buffer[k] ^ 0x80);
+        const uint32_t addr = SDL_DOSGusUploadSample(tmp, n, 0 /*is16bit*/);
+        std::free(tmp);
+        if (addr != SDL_DOSGUS_BAD_ADDR)
+        {
+          _sound_fx[slot].gus_dram_addr = addr;
+          _sound_fx[slot].gus_len       = n;
+          _sound_fx[slot].gus_resident  = true;
+          ++uploaded;
+          sfx_used += n;  // music-priority budget accounting
+        }
+        else
+        {
+          ++failed;
+          LOG_WARN("gus SFX: DRAM full uploading slot {} ({} bytes); this SFX "
+                   "stays silent (the music-priority cap should normally "
+                   "prevent this).", slot, n);
+        }
+      }
+    }
+    snd.freeBuf();
+  }
+
+  SDL_DOSGusState st2;
+  const unsigned used_kb =
+      (SDL_DOSGusGetState(&st2) && st2.valid) ? (unsigned)(st2.dram_used / 1024) : 0;
+  LOG_INFO("gus SFX: uploaded {} of {} .pxt to GF1 DRAM (8-bit unsigned mono @ "
+           "22050 Hz; {} failed; {} skipped over the music-priority budget). "
+           "Persistent SFX bank = {} KB DRAM (the MidiBackendGus per-song .pat "
+           "residency preserves it via its auto-snapshotted keep-mark at first "
+           "song start; the reserve above it always fits a song's instruments).",
+           uploaded, (int)NUM_SOUNDS, failed, used_kb);
+  return uploaded > 0;
+}
+
+// patch 0239 (Campaign 3 GUS, #28): return GF1 voices that finished playing a
+// one-shot SFX back to the shared pool, so they can be reused + a preempting
+// play() can find a free voice. Reads the live hardware voice-active mask. Only
+// touches voices THIS subsystem owns (_gus_voice_slot[v] >= 0); music voices
+// (owned by MidiBackendGus) are left alone. Main-loop context.
+void Pixtone::_gusReap()
+{
+  SDL_DOSGusState st;
+  if (!SDL_DOSGusGetState(&st) || !st.valid)
+    return;
+  const int nv = (st.num_voices < 32) ? st.num_voices : 32;
+  for (int v = 0; v < nv; ++v)
+  {
+    const int32_t slot = _gus_voice_slot[v];
+    if (slot >= 0 && ((st.voice_active_mask >> v) & 1u) == 0u)
+    {
+      SDL_DOSGusStopVoice(v);
+      _gus_voice_slot[v] = -1;
+      if (slot < 256 && _sound_fx[slot].channel == v)
+        _sound_fx[slot].channel = -1;
+    }
+  }
+}
+
+// patch 0239 (Campaign 3 GUS, #28): start a resident SFX on a GF1 voice.
+// percent = playback-rate percentage (100 = native 22050 Hz; the playResampled
+// pitch variants pass other values). Returns the GF1 voice id, or -1 if
+// dropped (not resident / pool exhausted). Main-loop context (playSfx is called
+// from game logic, not the IRQ note pump).
+int Pixtone::_gusPlay(int32_t slot, int32_t loop, uint32_t percent)
+{
+  if (slot < 0 || slot >= 256 || !_sound_fx[slot].gus_resident)
+  {
+    LOG_DEBUG("gus SFX: slot {} not resident; dropped.", slot);
+    return -1;
+  }
+
+  _gusReap();  // reclaim finished one-shot voices first
+
+  // Preempt: if this slot is already sounding, stop its voice.
+  const int32_t prev = _sound_fx[slot].channel;
+  if (prev >= 0 && prev < 32)
+  {
+    SDL_DOSGusStopVoice(prev);
+    _gus_voice_slot[prev]   = -1;
+    _sound_fx[slot].channel = -1;
+  }
+
+  int v = SDL_DOSGusAllocVoice();
+  if (v < 0 || v >= 32)
+  {
+    // Shared pool exhausted (music holds the voices). Drop the SFX -- a
+    // legitimate resource-pressure outcome, not an error.
+    LOG_DEBUG("gus SFX: no free GF1 voice for slot {} (shared pool full).", slot);
+    return -1;
+  }
+
+  uint32_t rate = 22050u;
+  if (percent != 0 && percent != 100)
+    rate = (uint32_t)(((uint64_t)22050u * percent) / 100u);
+  if (rate == 0) rate = 22050u;
+
+  const uint32_t start = _sound_fx[slot].gus_dram_addr;
+  const uint32_t end   = start + _sound_fx[slot].gus_len;
+  const uint32_t flags = (loop != 0) ? SDL_DOSGUS_LOOP : 0u;  // 8-bit -> no _16BIT
+
+  SDL_DOSGusSetVoiceFreq(v, rate);
+  SDL_DOSGusSetVoiceVol(v, _gus_sfx_vol_255);
+  SDL_DOSGusSetVoicePan(v, 128);  // SFX are mono -> center
+  SDL_DOSGusStartVoice(v, start, end, start /*loopstart*/, flags);
+
+  _sound_fx[slot].channel = v;
+  _gus_voice_slot[v]      = slot;
+  return v;
+}
