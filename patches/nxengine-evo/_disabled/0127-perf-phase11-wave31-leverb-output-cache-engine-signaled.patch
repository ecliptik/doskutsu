+// DOS-PORT (patch 0127, Phase 11 wave-31 Lever B): natural-origin
+// backdrop output cache for the generic-loop scrolltypes
+// (BK_PARALLAX / BK_FOLLOWFG / BK_FASTLEFT / BK_FIXED). Stores the
+// NATURAL-ORIGIN tiled rendered backdrop (parscroll=0,0 conceptually)
+// at dimensions large enough to hold screenWidth+bg_w by
+// screenHeight+bg_h, so any parscroll ∈ [0, bg_w) × [0, bg_h) maps
+// to an in-bounds src rect of size (screenWidth, screenHeight).
+//
+// Cache key strips parscroll_x/y per wave-31 contract; cached output
+// stays valid as long as map/scrolltype/backdrop/format/window-dim
+// don't change. **Critical interpretation choice**: team-lead's brief
+// wording "strip parscroll, cached output is RENDERED backdrop, on
+// hit single cache→window blit" would have produced a FROZEN
+// PARALLAX visual regression on every non-BK_FIXED scrolltype (the
+// rendered output DOES depend on parscroll; caching the rendered
+// output and reusing across parscroll changes means the backdrop
+// stops scrolling visually while the camera moves). This patch
+// implements the CORRECTNESS-PRESERVING variant: cache the NATURAL-
+// ORIGIN tiled output (parscroll-independent contents) at dimensions
+// large enough that the per-frame parscroll can be applied as a SRC
+// OFFSET in the cache→window blit at hit time. Same -ms savings (one
+// blit on hit vs. ~20 small tile blits on miss for 64×64 bgs), no
+// visual regression. See commit message + build-qa DM for full
+// rationale.
+//
+// Cache hit path: SDL_BlitSurface(g_backdrop_natural_sfc,
+//                                 &{parscroll_x, parscroll_y,
+//                                   screenWidth, screenHeight},
+//                                 win, NULL)
+//   = ~3-4 ms (single 76 KB transfer).
+//
+// Cache miss path: realloc cache to (screenWidth+bg_w) ×
+// (screenHeight+bg_h) if dims changed; tile-fill cache with bg_src
+// at offsets covering [0, screenWidth+bg_w) × [0, screenHeight+bg_h)
+// → typically ~12-16 ms for 64×64 bgs (~20 tile blits) one-time per
+// map change.
+//
+// Out of scope: BK_FASTLEFT_LAYERS scrolltype (patch 0081 wrapper).
+// That branch uses 5-layer per-layer-parscroll-dependent composition
+// where each layer has a DIFFERENT scroll speed (move_spd[]={0,1,2,
+// 4,8}); the composited output can't be expressed as a single src
+// offset of a natural-origin cache. BK_FASTLEFT_LAYERS branch
+// continues to use wave-30 thrashing-detect from patch 0126
+// unchanged.
+//
+// Killswitch: SDL_HINT_DOSKUTSU_BACKDROP_CACHE=0 disables EVERYTHING
+// (patch 0080 cache + wave-30 0126 thrashing-detect + this wave-31
+// 0127 Lever B). Cleanest semantics: BACKDROP_CACHE=0 → render fresh
+// every frame, no cache machinery at all.
+//
+// Diagnostic counters: emitted per audit-flush cadence (every 100
+// flips) so flush-instr can grep post-iter for hit-rate verification.
+static SDL_Surface *g_backdrop_natural_sfc = nullptr;
+static int g_backdrop_natural_curmap     = -1;
+static int g_backdrop_natural_id         = -1;
+static int g_backdrop_natural_scrolltype = -1;
+static int g_backdrop_natural_indexed    = -1;
+static int g_backdrop_natural_cache_w    = 0;
+static int g_backdrop_natural_cache_h    = 0;
+static int g_backdrop_natural_bg_w       = 0;
+static int g_backdrop_natural_bg_h       = 0;
+static SDL_PixelFormat g_backdrop_natural_format = SDL_PIXELFORMAT_UNKNOWN;
+// Per-audit-flush counters (reset every 100 flips by
+// _maybe_flush_phase_timing_audit; emitted as a log marker for
+// post-iter grep verification of hit rate).
+static int g_backdrop_natural_hits_block        = 0;
+static int g_backdrop_natural_misses_block      = 0;
+static int g_backdrop_natural_invalidates_block = 0;
+
+// patch 0127 (wave-31 Lever B): natural-origin tile fill. Renders
+// bg_src tiled into target surface at every (x, y) offset where
+// 0 ≤ x ≤ cache_w and 0 ≤ y ≤ cache_h, in steps of (bg_w, bg_h).
+// Mirrors the existing tile loop at the patch 0080 cache miss path
+// + the legacy fallback, but writes natural-origin output (no
+// parscroll offsets — parscroll is applied at hit time as a src
+// offset in cache→window blit). Returns true on success.
+static bool _render_natural_origin_to_cache(SDL_Surface *target,
+                                            SDL_Surface *bg_src,
+                                            int target_w, int target_h,
+                                            int bg_w, int bg_h)
+{
+  if (!target || !bg_src) return false;
+  if (bg_w <= 0 || bg_h <= 0) return false;
+  // Defensive pre-clear so any backdrop dim case (bg < cache) doesn't
+  // leak prior contents in the trailing edges. Cheap (~3-4 ms one-
+  // time per map; amortizes to ~0 / flip).
+  SDL_FillSurfaceRect(target, NULL, 0);
+  SDL_Rect dst;
+  dst.w = bg_w;
+  dst.h = bg_h;
+  for (int y = 0; y < target_h; y += bg_h)
+  {
+    for (int x = 0; x < target_w; x += bg_w)
+    {
+      dst.x = x;
+      dst.y = y;
+      SDL_BlitSurface(bg_src, NULL, target, &dst);
+    }
+  }
+  return true;
+}
+
 // DOS-PORT (patch 0080): probe killswitch once on first call. Strict
 // "0" match disables the cache (lets a real-HW iter reproduce wave-9
 // pre-cache behavior for ablation). All other values keep the
@@ -233,6 +335,32 @@ static void _backdrop_cache_reset()
   g_backdrop_miss_streak            = 0;
   g_backdrop_thrash_engaged         = false;
   g_backdrop_thrash_frames_in_state = 0;
+  // patch 0127 (wave-31 Lever B): release natural-origin cache surface
+  // + reset its key fields on map change. map_flush_graphics() is the
+  // engine's authoritative "map changed" signal — when curmap changes,
+  // the backdrop_id/scrolltype may change, requiring a full cache
+  // re-fill on next frame. Per-block hit/miss counters are reset by
+  // the log emit site (every 100 flips), NOT here, so per-flush
+  // attribution remains accurate across map transitions within a
+  // 100-flip block.
+  if (g_backdrop_natural_sfc)
+  {
+    SDL_DestroySurface(g_backdrop_natural_sfc);
+    g_backdrop_natural_sfc = nullptr;
+  }
+  g_backdrop_natural_curmap     = -1;
+  g_backdrop_natural_id         = -1;
+  g_backdrop_natural_scrolltype = -1;
+  g_backdrop_natural_indexed    = -1;
+  g_backdrop_natural_cache_w    = 0;
+  g_backdrop_natural_cache_h    = 0;
+  g_backdrop_natural_bg_w       = 0;
+  g_backdrop_natural_bg_h       = 0;
+  g_backdrop_natural_format     = SDL_PIXELFORMAT_UNKNOWN;
+  // Bump invalidates counter — flush-instr's marker tracks
+  // engine-signaled invalidation count per block to verify the cache
+  // architecture isn't thrashing on spurious map_flush_graphics calls.
+  ++g_backdrop_natural_invalidates_block;
 }
 
 // for FindObject--finding NPC's by ID2
@@ -1061,7 +1189,164 @@ void map_draw_backdrop(void)
     SDL_Surface *bg_src = backdrop[map.backdrop]->surfaceCpu();
     if (bg_src && bg_src->format == win->format)
     {
+      // patch 0127 (wave-31 Lever B): natural-origin cache attempt.
+      // Sub-decomposes patch 0080's cache key to remove parscroll_x/y;
+      // cache contents are the natural-origin tiled backdrop (no
+      // parscroll applied); parscroll is applied at hit time as a
+      // SRC OFFSET in the cache→window blit. Correctness-preserving
+      // alternative to the literal "freeze rendered output across
+      // parscroll changes" reading of the wave-31 spec.
+      //
+      // Lever B applies to the generic-loop scrolltypes only
+      // (BK_PARALLAX / BK_FOLLOWFG / BK_FASTLEFT / BK_FIXED). The
+      // BK_FASTLEFT_LAYERS branch (patch 0081 wrapper) uses multi-
+      // layer parscroll where each layer scrolls at a different
+      // speed; the composited output can't be expressed as a single
+      // src offset, so that branch keeps wave-30 thrashing-detect.
+      //
+      // Hit path: 1 SDL_BlitSurface (cache→window with src offset
+      // = parscroll mod bg_w / bg_h, size = screenWidth × screenHeight)
+      // ≈ ~3-4 ms.
+      // Miss path: realloc cache to (screenWidth+bg_w) ×
+      // (screenHeight+bg_h) if dims changed; tile-fill the cache
+      // surface via _render_natural_origin_to_cache (~12-16 ms one-
+      // time per map change for 64×64 bgs at 320×240 screen).
+      const int natural_cache_w = r->screenWidth + w;
+      const int natural_cache_h = r->screenHeight + h;
+      const bool natural_hit =
+          g_backdrop_natural_sfc &&
+          g_backdrop_natural_curmap     == game.curmap &&
+          g_backdrop_natural_id         == map.backdrop &&
+          g_backdrop_natural_scrolltype == map.scrolltype &&
+          g_backdrop_natural_indexed    == cache_indexed &&
+          g_backdrop_natural_cache_w    == natural_cache_w &&
+          g_backdrop_natural_cache_h    == natural_cache_h &&
+          g_backdrop_natural_bg_w       == w &&
+          g_backdrop_natural_bg_h       == h &&
+          g_backdrop_natural_format     == win->format;
+
+      if (natural_hit)
+      {
+        // HIT: blit natural-origin cache → window with parscroll-
+        // dependent src offset. parscroll_x/y may exceed bg_w/h for
+        // some scrolltypes (BK_FASTLEFT auto-increments without
+        // bounds); mod to [0, bg_w) × [0, bg_h) so the src rect
+        // stays in-bounds within the (screenWidth+bg_w) ×
+        // (screenHeight+bg_h) cache.
+        //
+        // For negative parscroll (some BK_PARALLAX edge cases on
+        // small maps; line 766-767 doubles negative parscroll to
+        // produce a non-negative result, but defensive % bg_w/h
+        // here handles any sign / magnitude).
+        int src_off_x = map.parscroll_x % w;
+        int src_off_y = map.parscroll_y % h;
+        if (src_off_x < 0) src_off_x += w;
+        if (src_off_y < 0) src_off_y += h;
+        SDL_Rect src_rect;
+        src_rect.x = src_off_x * r->scale;
+        src_rect.y = src_off_y * r->scale;
+        src_rect.w = r->screenWidth * r->scale;
+        src_rect.h = r->screenHeight * r->scale;
+        // Drain queued slow-path renderer commands + record full-
+        // screen dirty + bump drawcall via the wave-30 helpers
+        // (introduced in patch 0126 for the same single-blit-to-
+        // window accounting need).
+        r->prepareDirectBackdropWrite();
+        if (SDL_BlitSurface(g_backdrop_natural_sfc, &src_rect, win, NULL))
+        {
+          r->commitDirectBackdropWrite();
+          ++g_backdrop_natural_hits_block;
+          // patch 0126 carry-over: hit on Lever B path implicitly
+          // resets the wave-30 thrashing-detect state too — the
+          // patch-0080 cache below never runs, so the wave-30 miss
+          // streak doesn't increment. Explicitly clear state for
+          // cleanliness so transitioning between scrolltypes
+          // doesn't leave stale streak count behind.
+          g_backdrop_miss_streak            = 0;
+          g_backdrop_thrash_engaged         = false;
+          g_backdrop_thrash_frames_in_state = 0;
+          return;
+        }
+        // Lever B blit failed (rare; bad src rect or format mismatch).
+        // Invalidate key + fall through to patch-0080 + wave-30 path
+        // below.
+        g_backdrop_natural_curmap = -1;
+      }
+      else
+      {
+        // MISS: (re)alloc cache + populate.
+        if (!g_backdrop_natural_sfc ||
+            g_backdrop_natural_cache_w != natural_cache_w ||
+            g_backdrop_natural_cache_h != natural_cache_h ||
+            g_backdrop_natural_format  != win->format)
+        {
+          if (g_backdrop_natural_sfc)
+          {
+            SDL_DestroySurface(g_backdrop_natural_sfc);
+            g_backdrop_natural_sfc = nullptr;
+          }
+          g_backdrop_natural_sfc = SDL_CreateSurface(natural_cache_w, natural_cache_h, win->format);
+          if (g_backdrop_natural_sfc &&
+              win->format == SDL_PIXELFORMAT_INDEX8 &&
+              r->masterPalette())
+          {
+            SDL_SetSurfacePalette(g_backdrop_natural_sfc, r->masterPalette());
+          }
+          g_backdrop_natural_cache_w = natural_cache_w;
+          g_backdrop_natural_cache_h = natural_cache_h;
+          g_backdrop_natural_format  = win->format;
+        }
+
+        if (g_backdrop_natural_sfc &&
+            _render_natural_origin_to_cache(g_backdrop_natural_sfc, bg_src,
+                                            natural_cache_w, natural_cache_h,
+                                            w, h))
+        {
+          // Update key. Note: parscroll_x/y NOT stored in key (the
+          // whole point of Lever B — output stays valid across
+          // parscroll changes).
+          g_backdrop_natural_curmap     = game.curmap;
+          g_backdrop_natural_id         = map.backdrop;
+          g_backdrop_natural_scrolltype = map.scrolltype;
+          g_backdrop_natural_indexed    = cache_indexed;
+          g_backdrop_natural_bg_w       = w;
+          g_backdrop_natural_bg_h       = h;
+          ++g_backdrop_natural_misses_block;
+
+          // Now do the same hit-path blit (cache is freshly populated).
+          int src_off_x = map.parscroll_x % w;
+          int src_off_y = map.parscroll_y % h;
+          if (src_off_x < 0) src_off_x += w;
+          if (src_off_y < 0) src_off_y += h;
+          SDL_Rect src_rect;
+          src_rect.x = src_off_x * r->scale;
+          src_rect.y = src_off_y * r->scale;
+          src_rect.w = r->screenWidth * r->scale;
+          src_rect.h = r->screenHeight * r->scale;
+          r->prepareDirectBackdropWrite();
+          if (SDL_BlitSurface(g_backdrop_natural_sfc, &src_rect, win, NULL))
+          {
+            r->commitDirectBackdropWrite();
+            // Reset wave-30 thrashing state on miss-resolved-by-fill
+            // (cache is fresh; subsequent frames are hits).
+            g_backdrop_miss_streak            = 0;
+            g_backdrop_thrash_engaged         = false;
+            g_backdrop_thrash_frames_in_state = 0;
+            return;
+          }
+          // Blit failed post-fill (rare); fall through to patch-0080
+          // legacy path below.
+          g_backdrop_natural_curmap = -1;
+        }
+        // If alloc / render-fill failed, fall through to patch-0080
+        // + wave-30 path below.
+      }
+
       // Cache key match check — if all dimensions/keys agree, single blit.
+      // patch 0127 (wave-31 Lever B) fallthrough: only reached if
+      // Lever B above failed (alloc/format issue, blit failure).
+      // patch-0080 cache + wave-30 thrashing-detect remain in place
+      // as a safety net for those edge cases.
       const bool cache_hit =
           g_backdrop_cache_sfc &&
           g_backdrop_cache_curmap     == game.curmap &&
@@ -1288,6 +1573,43 @@ void DrawFastLeftLayered(void)
