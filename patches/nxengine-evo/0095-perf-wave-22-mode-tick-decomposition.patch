+// DOS-PORT (patch 0095, Phase 9 wave 22 W22A mode_tick decomposition):
+// 4 sub-bracket RAII timers + residual derivation. Decomposes the
+// 23.94 ms mode_tick budget (W20B median = 91% of engine_tick) into
+// named sub-buckets so wave 23+ optimization picks the right lever.
+// Single generic naming covers both `game_tick_normal()` (GM_NORMAL
+// gameplay) AND `title_tick()` (GM_TITLE attract). Bracket names
+// describe **work type**, not mode-specific terms; sample sizes per
+// phase will not match across the two PLAYs because each mode hits a
+// different subset of buckets.
+//
+// Gated on SDL_HINT_DOSKUTSU_MODE_TICK_INSTR=1 (NEW; separate from
+// FINE_INSTR to preserve strict-"1" convention and independent layer
+// toggle — see docs/PHASE11-WAVE-22-CONTRACT.md § 2). Cached
+// static-const-bool semantics so -O2 hoists the per-tick guards.
+//
+// Sub-buckets (sibling, non-overlapping inside `tickfunctions[].OnTick()`
+// scope):
+//   ModeSimTimer       - non-render game-state mutation
+//                        (HandlePlayer + AI + physics + scroll for
+//                         GM_NORMAL; handle_input() for title)
+//   ModeDrawSceneTimer - primary scene drawcall pass
+//                        (DrawScene() for GM_NORMAL;
+//                         draw_title() for title)
+//   ModeDrawHudTimer   - secondary HUD drawcalls
+//                        (StatusBar + fade + niku for GM_NORMAL;
+//                         empty for title — bracket sees n=0)
+//   ModePostTimer      - post-render overlays + screen-effects
+//                        (textbox.Tick + ScreenEffects::Draw +
+//                         map_draw_map_name for GM_NORMAL;
+//                         conditional textbox.Tick on the
+//                         in_multiload branch for title)
+//
+// Residual = mode_tick_total - sum(sub-buckets), clamped at 0.
+// Reuses W20B's `g_eng_mode_tick_dt_this_tick` populated by
+// `ModeTickTimer` (patch 0090) as the parent total — NO new
+// SDL_GetTicksNS read needed at end-of-Game::tick because W20B already
+// captures the dispatch-call delta. The new residual block in
+// game.cpp gates separately on `mode_tick_instr_active()` so layered
+// gates stay independent.
+//
+// Self-validation: small mode_residual median (<1 ms) means brackets
+// are exhaustive for that scene; large residual means there's still
+// an unfound chunk in the OnTick() body that wave 23 candidate-
+// selection has to account for.
+//
+// Storage: 4 sample arrays + idxes + per-tick dt locals + 1 residual
+// array + idx, all extern-declared here, defined in Renderer.cpp where
+// the audit-flush emission lives. Same `g_eng_tick_block_size = 100`
+// cadence as W20B (NO new block_size constant introduced; per
+// contract § 3).
+
+// Forward-declare the env helper. Definition lives in Renderer.cpp's
+// ablation-flag cluster (alongside _abl_flip_instr / _abl_fine_instr /
+// _abl_mode_tick_instr / _abl_direct_vesa). Capturing as a free
+// function lets this header stay decoupled from the Renderer class —
+// mirrors the W20B `engine_tick_fine_instr_active()` precedent.
+bool mode_tick_instr_active();
+
+// Sample-array storage (extern; defined in Renderer.cpp). Sized at
+// `g_eng_tick_block_size` (= 100), shared with W20B per contract § 3.
+extern std::uint64_t g_mt_sim_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mt_draw_scene_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mt_draw_hud_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mt_post_samples[g_eng_tick_block_size];
+extern std::uint64_t g_mt_residual_samples[g_eng_tick_block_size];
+extern int g_mt_sim_idx;
+extern int g_mt_draw_scene_idx;
+extern int g_mt_draw_hud_idx;
+extern int g_mt_post_idx;
+extern int g_mt_residual_idx;
+
+// Per-tick dt locals — written by each timer's destructor, consumed
+// by the new residual block at end-of-Game::tick. Reset by caller at
+// Game::tick entry so leftover-from-prior-tick doesn't pollute the
+// residual subtraction (mirrors W20B's reset cluster at game.cpp:242).
+extern std::uint64_t g_mt_sim_dt_this_tick;
+extern std::uint64_t g_mt_draw_scene_dt_this_tick;
+extern std::uint64_t g_mt_draw_hud_dt_this_tick;
+extern std::uint64_t g_mt_post_dt_this_tick;
+
+// Sub-bucket RAII timers. Same destructor pattern as W20B: capture
+// dt, write to per-tick local, push to sample array (with bounds-
+// check + env gate). Cost when env unset: 1 SDL_GetTicksNS at
+// construction (always) + 1 at destruction + 1 branch-on-cached-bool.
+// Mirrors W20B's `ClearScreenTimer` etc. — same pattern, layered
+// independently behind the new `mode_tick_instr_active()` gate.
+struct ModeSimTimer
+{
+  std::uint64_t t0;
+  ModeSimTimer() : t0(SDL_GetTicksNS()) {}
+  ~ModeSimTimer()
+  {
+    if (!mode_tick_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
+    g_mt_sim_dt_this_tick = dt;
+    if (g_mt_sim_idx < g_eng_tick_block_size)
+      g_mt_sim_samples[g_mt_sim_idx++] = dt;
+  }
+};
+
+struct ModeDrawSceneTimer
+{
+  std::uint64_t t0;
+  ModeDrawSceneTimer() : t0(SDL_GetTicksNS()) {}
+  ~ModeDrawSceneTimer()
+  {
+    if (!mode_tick_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
+    g_mt_draw_scene_dt_this_tick = dt;
+    if (g_mt_draw_scene_idx < g_eng_tick_block_size)
+      g_mt_draw_scene_samples[g_mt_draw_scene_idx++] = dt;
+  }
+};
+
+struct ModeDrawHudTimer
+{
+  std::uint64_t t0;
+  ModeDrawHudTimer() : t0(SDL_GetTicksNS()) {}
+  ~ModeDrawHudTimer()
+  {
+    if (!mode_tick_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
+    g_mt_draw_hud_dt_this_tick = dt;
+    if (g_mt_draw_hud_idx < g_eng_tick_block_size)
+      g_mt_draw_hud_samples[g_mt_draw_hud_idx++] = dt;
+  }
+};
+
+struct ModePostTimer
+{
+  std::uint64_t t0;
+  ModePostTimer() : t0(SDL_GetTicksNS()) {}
+  ~ModePostTimer()
+  {
+    if (!mode_tick_instr_active()) return;
+    const std::uint64_t dt = SDL_GetTicksNS() - t0;
+    g_mt_post_dt_this_tick = dt;
+    if (g_mt_post_idx < g_eng_tick_block_size)
+      g_mt_post_samples[g_mt_post_idx++] = dt;
+  }
+};
+
 }  // namespace Diag
 }  // namespace NXE
 
