   // Capture engine-tick start; used for residual computation at the
   // very end of this function. Duplicates EngineTickTimer's t0 but
   // EngineTickTimer's destructor fires at scope-exit — we need the
@@ -307,6 +322,35 @@ void Game::tick(void)
     if (_res < 0) _res = 0;
     NXE::Diag::g_eng_residual_samples[NXE::Diag::g_eng_residual_idx++] = (Uint64)_res;
   }
+
+  // patch 0095 (wave 22 W22A): compute mode_tick residual. Reuses W20B's
+  // g_eng_mode_tick_dt_this_tick (populated by ModeTickTimer in patch
+  // 0090) as the parent total — NO new SDL_GetTicksNS read needed
+  // because W20B already captures the outer dispatch-call dt. Subtract
+  // the 4 W22A sub-bucket dts; signed math + clamp at 0 in case
+  // measurement noise produces a tiny negative.
+  //
+  // Self-validating: if the sum of the 4 sub-buckets ≈ the parent
+  // mode_tick total, residual is small; if a chunk in OnTick() body
+  // wasn't bracketed, residual surfaces it.
+  //
+  // Per contract § 4 / option α: separate gate from the W20B residual
+  // block above. Layered independently — when MODE_TICK_INSTR unset,
+  // 0 cost from this block. Note: this is residual within mode_tick,
+  // NOT residual within engine_tick (W20B's block above tells you
+  // that). Both layers stay independently meaningful.
+  if (NXE::Diag::mode_tick_instr_active()
+      && NXE::Diag::g_mt_residual_idx < NXE::Diag::g_eng_tick_block_size)
+  {
+    const Uint64 _mt_total = NXE::Diag::g_eng_mode_tick_dt_this_tick;
+    Sint64 _mt_res = (Sint64)_mt_total
+                   - (Sint64)NXE::Diag::g_mt_sim_dt_this_tick
+                   - (Sint64)NXE::Diag::g_mt_draw_scene_dt_this_tick
+                   - (Sint64)NXE::Diag::g_mt_draw_hud_dt_this_tick
+                   - (Sint64)NXE::Diag::g_mt_post_dt_this_tick;
+    if (_mt_res < 0) _mt_res = 0;
+    NXE::Diag::g_mt_residual_samples[NXE::Diag::g_mt_residual_idx++] = (Uint64)_mt_res;
+  }
 }
 
