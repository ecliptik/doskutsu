+// DOS-PORT (patch 0132, Phase 11 wave-35 mds_tilemap_bg drawTileFast
+// BG-extension). Sibling to drawTileFast that takes a target surface
+// override. Used during BG-tilemap cache-fill (slot 0097 Path B) to
+// blit tiles into the cache surface directly. Skips SDL_BlitSurface's
+// format-dispatch overhead by calling _blit_indexed INDEX8→INDEX8
+// hand-rolled primitive (same code path that makes drawTileFast
+// faster than drawTile).
+//
+// Renderer drain: NOT applicable here (target is the cache surface,
+// not the window surface). The cache surface holds the rendered
+// BG-tilemap layer for later cache→window blit (handled by
+// drawCachedTilemap). Queued slow-path renderer commands target
+// _renderer, not the cache surface, so cache-fill blits don't
+// interleave with renderer-queue dispatch order. Per slot 0097
+// path-B correctness invariant.
+//
+// Format fallback: if the destination's format != INDEX8 OR the
+// source's format != INDEX8, fall back to SDL_BlitSurface to maintain
+// correctness. _blit_indexed assumes INDEX8↔INDEX8 (per its dispatch-
+// table sibling _try_fast_blit). This fallback is essentially never
+// taken in normal indexed-mode operation (Wave-16 indexed-mode
+// invariant + tilesheet INDEX8 invariant), but defensive.
+void Renderer::drawTileFastToSurface(Surface *src, SDL_Surface *target,
+                                     int dstx, int dsty, int srcx, int srcy)
+{
+  if (!src || !target) return;
+  SDL_Surface *src_sfc = src->surfaceCpu();
+  if (!src_sfc) return;
+
+  SDL_Rect srcrect = {srcx, srcy, TILE_W, TILE_H};
+  SDL_Rect dstrect = {dstx, dsty, TILE_W, TILE_H};
+
+  if (src_sfc->format == SDL_PIXELFORMAT_INDEX8 &&
+      target->format  == SDL_PIXELFORMAT_INDEX8)
+  {
+    // INDEX8↔INDEX8 fast path — _blit_indexed inline.
+    _blit_indexed(target, src_sfc,
+                  srcrect, dstrect,
+                  (Uint8)src->colorkey(), src->hasColorkey());
+  }
+  else
+  {
+    // Defensive fallback: format mismatch (should not occur in
+    // normal indexed-mode operation). Use SDL_BlitSurface which
+    // handles arbitrary format conversion. Same behavior as
+    // Tileset::drawTileToSurface so correctness is preserved at
+    // the cost of foregoing the _blit_indexed speedup for this
+    // (rare) call.
+    if (!SDL_BlitSurface(src_sfc, &srcrect, target, &dstrect))
+    {
+      LOG_ERROR("Renderer::drawTileFastToSurface: SDL_BlitSurface fallback failed: {}",
+                SDL_GetError());
+    }
+  }
+}
