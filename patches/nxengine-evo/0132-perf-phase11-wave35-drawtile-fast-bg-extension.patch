+// DOS-PORT (patch 0132, Phase 11 wave-35 mds_tilemap_bg drawTileFast
+// BG-extension). Sibling to `drawTileToSurface` that bypasses
+// SDL_BlitSurface's format-dispatch overhead by calling
+// `Renderer::drawTileFastToSurface` which uses the INDEX8→INDEX8
+// hand-rolled `_blit_indexed` primitive directly. Same src-rect math
+// as drawTileToSurface (16 tiles per row).
+//
+// Defensive: NULL-checks _tileset (matches drawTileFast's pattern
+// per patch 0117). Renderer-side fallback to SDL_BlitSurface if
+// INDEX8↔INDEX8 format precondition fails (mirror of
+// drawTileFast's _blit_indexed fallback behavior).
+void Tileset::drawTileFastToSurface(SDL_Surface *target, int x, int y, int t)
+{
+  if (!_tileset) return;
+
+  // 16 tiles per row on all tilesheet
+  int srcx = (t % 16) * TILE_W;
+  int srcy = (t / 16) * TILE_H;
+
+  Renderer::getInstance()->drawTileFastToSurface(_tileset, target, x, y, srcx, srcy);
+}
