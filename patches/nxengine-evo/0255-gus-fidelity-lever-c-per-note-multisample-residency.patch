+// patch 0255 (GUS fidelity, lever c): convert a .pat frequency field (root /
+// low / high) to a MIDI note, robust to the milliHz-vs-Hz unit ambiguity (see
+// patch 0244's root_freq auto-detect). Returns `fallback` when the field is
+// zero/implausible -- callers pass 0 for low_freq (cover down to note 0), 127
+// for high_freq (cover up to note 127), 60 for root (nearest-mid-C default).
+// MAIN-LOOP context only (uses std::log/FPU) -- never the IRQ note path.
+static int pat_freq_to_note(std::int32_t raw, int fallback)
+{
+  const double milli = (raw > 0) ? (raw / 1000.0) : 0.0;
+  const double hz    = (raw > 0) ? (double)raw    : 0.0;
+  double f;
+  if (milli >= 8.0 && milli <= 12544.0)    f = milli;  // milliHz (canonical)
+  else if (hz >= 8.0 && hz <= 12544.0)     f = hz;      // stored as Hz
+  else                                     return fallback;
+  int n = (int)(69.0 + 12.0 * (std::log(f / 440.0) / std::log(2.0)) + 0.5);
+  if (n < 0)   n = 0;
+  if (n > 127) n = 127;
+  return n;
+}
