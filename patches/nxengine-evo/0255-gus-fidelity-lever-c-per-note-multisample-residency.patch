+const MidiBackendGus::SubSample *
+MidiBackendGus::_pick_subsample(const PatSample *ps, int note) const
+{
+  if (ps->nsub <= 1) return &ps->sub[0];
+  for (int k = 0; k < ps->nsub; ++k)
+  {
+    if (note >= (int)ps->sub[k].low_note && note <= (int)ps->sub[k].high_note)
+      return &ps->sub[k];
+  }
+  int best = 0, bestd = 1000;
+  for (int k = 0; k < ps->nsub; ++k)
+  {
+    int d = (int)ps->sub[k].root_note - note;
+    if (d < 0) d = -d;
+    if (d < bestd) { bestd = d; best = k; }
+  }
+  return &ps->sub[best];
