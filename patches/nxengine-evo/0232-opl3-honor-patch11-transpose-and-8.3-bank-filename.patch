+  // patch 0232 (DOPL3v1 transpose): honor patch[11] as a SIGNED int8
+  // semitone offset, applied to the played note before the (fnum, block)
+  // calc. This finishes the half-built contract the SDL helper already
+  // documents -- SDL_DOSOpl3VoiceWritePatch does `(void)patch[11]` with the
+  // comment "engine applies before NoteOn" but MidiBackendOpl3 never did.
+  // The runtime opl3bank.dat (DMXOPL-derived; DMX/GENMIDI convention
+  // playednote = midinote + offset) carries a -12 octave offset on ~110 of
+  // 128 GM programs; without this, those instruments play an octave too
+  // high (brighter/thinner). We transpose only the value passed to the
+  // frequency calc; _voices[voice].midi_note keeps the ORIGINAL note so
+  // note_off / _find_voice matching is unaffected. INERT for the 8-patch
+  // placeholder: every PATCH_* constexpr has [11]=0, so with no .dat the
+  // offset is 0 and behavior is byte-identical to pre-0232 (no killswitch).
+  const std::uint8_t *_xpatch =
+      (channel == DRUM_CHANNEL)
+          ? PATCH_DRUM
+          : _program_to_patch(_channel_program[channel & 0x0F]);
+  const int _play_note = note + (int)(std::int8_t)_xpatch[11];
+
