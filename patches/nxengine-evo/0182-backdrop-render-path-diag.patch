+                              bg_subregion_engaged, bg_top, bg_bot);  // patch 0182
           return;
         }
         // Else fall through to the live tile loop (cache blit failed
@@ -2317,6 +2446,13 @@ void map_draw_backdrop(void)
       Renderer::getInstance()->drawSurface(backdrop[map.backdrop], x - map.parscroll_x, y - map.parscroll_y);
     }
   }
+  // patch 0182: legacy fall-through (cache disabled / format mismatch /
+  // alloc or blit failure). Shared by BK_FIXED/FOLLOWFG/PARALLAX/
+  // FASTLEFT/default; the emit helper self-scopes to BK_PARALLAX. w/h
+  // are the backdrop dims computed above. Legacy draws full-screen (no
+  // bg_subregion clip) -> subrgn=false, full [0,sh-1] range.
+  _backdrop_diag_emit(BD_DIAG_PATH_LEGACY, w, h, false, 0,
+                      Renderer::getInstance()->screenHeight - 1);
 }
 
