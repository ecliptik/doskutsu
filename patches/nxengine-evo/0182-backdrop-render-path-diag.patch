+// DOS-PORT (patch 0182, v1.0.4 P1-DIAG2): opt-in backdrop render-path
+// diagnostic for the backdrop-black-on-motion bug (water caves esp.).
+// env SDL_HINT_DOSKUTSU_BACKDROP_DIAG=1 (strict "1"; default OFF). This
+// rides INDEPENDENTLY of the cache killswitch and of the (paused) 0181
+// fix lever -- it changes no behavior, it only logs. Per BK_PARALLAX
+// frame it records which render path ran, the scroll + parscroll_y, the
+// vertical coverage band the tile loop produces vs [0,screenHeight),
+// the thrash-detect state, and whether DrawScene skipped clearScreen
+// this frame -- the data needed to confirm/refute H4 (thrash-direct +
+// skip-redundant-clear coverage gap) without inferring from
+// screenshots. Throttled (log-on-state-change + a 1-per-8-frames
+// heartbeat during sustained motion) so it does not flood DEBUG.LOG;
+// per-line fsync (patch 0036) keeps it mid-run readable.
+enum {
+  BD_DIAG_PATH_HIT = 0,
+  BD_DIAG_PATH_WARM,
+  BD_DIAG_PATH_THRASH,
+  BD_DIAG_PATH_LEGACY,
+};
+
+// Cross-TU: set by game.cpp DrawScene (see map.h). 1 = clearScreen
+// skipped this frame, 0 = it ran.
+int g_backdrop_diag_clear_skipped = 0;
+
+static int _backdrop_diag_enabled()
+{
+  static int v = -1;
+  if (v < 0)
+  {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_BACKDROP_DIAG");
+    v = (e && e[0] == '1' && e[1] == 0) ? 1 : 0;
+    LOG_INFO("[bd-diag] backdrop render-path diag {} (set SDL_HINT_DOSKUTSU_BACKDROP_DIAG=1 to enable)",
+             v ? "ENABLED" : "disabled (default)");
+  }
+  return v;
+}
+
+// Emit one diagnostic line for the BK_PARALLAX backdrop pass. `path` is
+// one of BD_DIAG_PATH_*; h is the backdrop tile height (w accepted for
+// symmetry). `subrgn`/`sub_top`/`sub_bot` are the patch-0130
+// bg_subregion clip the cache HIT + THRASH paths apply this frame
+// (full screen for WARM-MISS + LEGACY -- callers pass subrgn=false).
+// No-op (single cached-bool test) when the diag env is off; scoped to
+// BK_PARALLAX per the P1-DIAG2 contract.
+static void _backdrop_diag_emit(int path, int w, int h,
+                                bool subrgn, int sub_top, int sub_bot)
+{
+  if (!_backdrop_diag_enabled())
+    return;
+  if (map.scrolltype != BK_PARALLAX)
+    return;
+  (void)w;
+
+  const int sh  = Renderer::getInstance()->screenHeight;
+  const int psy = map.parscroll_y;
+
+  // Tile-loop vertical coverage (the UNCLIPPED backdrop draw extent):
+  // y = 0,h,2h,... while y < sh+psy ; dst.y = y - psy. cover_top =
+  // first tile's dst.y, cover_bot = last tile's bottom edge. A positive
+  // cover_top OR cover_bot < sh is a tile-loop coverage gap (H2-class;
+  // expected absent now that min ysize=16 keeps psy>=0).
+  const int cover_top = -psy;
+  int cover_bot = cover_top;  // degenerate: loop body never runs
+  if (h > 0 && (sh + psy) > 0)
+  {
+    const int last_y = ((sh + psy - 1) / h) * h;
+    cover_bot = (last_y - psy) + h;
+  }
+  const int gap_top = (cover_top > 0) ? cover_top : 0;
+  const int gap_bot = (cover_bot < sh) ? (sh - cover_bot) : 0;
+
+  // bg_subregion clip (H5 surface): HIT uses drawCachedBackdropClipped,
+  // THRASH uses loop continue/break, both honoring [sub_top,sub_bot]
+  // when `subrgn`. The visible-Y cache (g_bg_visible_cache_mapy_tile) is
+  // keyed on mapy_tile ONLY -- not the sub-tile blit_y_off -- so the
+  // clip range can drift up to TILE_H stale during vertical motion;
+  // with skip-redundant-clear suppressing clearScreen the clipped-out
+  // top rows then show black. curmy vs cachemy + yoff expose that.
+  const bool clipped =
+      subrgn && (path == BD_DIAG_PATH_HIT || path == BD_DIAG_PATH_THRASH);
+  const int scroll_y   = (map.displayed_yscroll / CSFI);
+  const int cur_mapy   = scroll_y / TILE_H;
+  const int blit_y_off = -(scroll_y % TILE_H);
+
+  const bool ck = backdrop[map.backdrop] && backdrop[map.backdrop]->hasColorkey();
+
+  // Throttle: emit EVERY camera-motion frame (displayed scroll changed)
+  // so a 1-2 frame THRASH/clip window is never missed, PLUS on any
+  // state-key change, PLUS a slow heartbeat at rest.
+  static int last_dx  = INT_MIN;
+  static int last_dy  = INT_MIN;
+  static int last_sig = INT_MIN;
+  static int rest_ctr = 0;
+  const int sig = (path << 6)
+                  | ((g_backdrop_thrash_engaged ? 1 : 0) << 5)
+                  | ((g_backdrop_diag_clear_skipped ? 1 : 0) << 4)
+                  | ((subrgn ? 1 : 0) << 3)
+                  | ((clipped ? 1 : 0) << 2)
+                  | ((psy < 0 ? 1 : 0) << 1)
+                  | ((gap_top > 0 || gap_bot > 0) ? 1 : 0);
+  const bool moving = (map.displayed_xscroll != last_dx) ||
+                      (map.displayed_yscroll != last_dy);
+  bool emit = moving || (sig != last_sig);
+  if (!emit && ++rest_ctr >= 120)
+    emit = true;
+  if (!emit)
+    return;
+  last_dx  = map.displayed_xscroll;
+  last_dy  = map.displayed_yscroll;
+  last_sig = sig;
+  rest_ctr = 0;
+
+  static const char *const pn[] = {"HIT", "WARM-MISS", "THRASH", "LEGACY"};
+  LOG_INFO("[bd-diag] path={} bd={} ck={} dy={} psy={} cover=[{},{}) sh={} gap_top={} gap_bot={} thrash={} streak={} clearskip={} subrgn={} clip=[{},{}] variant={} curmy={} cachemy={} yoff={}",
+           pn[path], map.backdrop, ck ? 1 : 0,
+           map.displayed_yscroll, psy, cover_top, cover_bot, sh,
+           gap_top, gap_bot,
+           g_backdrop_thrash_engaged ? 1 : 0, g_backdrop_miss_streak,
+           g_backdrop_diag_clear_skipped,
+           subrgn ? 1 : 0, sub_top, sub_bot, clipped ? "clipped" : "full",
+           cur_mapy, g_bg_visible_cache_mapy_tile, blit_y_off);
+}
+
