 // DOS-PORT (patch 0111, Phase 11 wave-25 mds_tilemap_fg sub-decomposition
@@ -3367,2 +3431,104 @@ void _maybe_flush_sfx_stat_audit()
 
+// DOS-PORT (patch 0165, Pixtone multi-source probe). Per-100-flip
+// [pixtone-multi] emit. Sibling of _maybe_flush_sfx_stat_audit above.
+// Reads the 6-bucket g_pixtone_active_count histogram (single-writer
+// audio thread via SamplePixtoneActiveBucket; single-reader render
+// thread here) + the block-over-block deltas for g_pixtone_stoptrack_-
+// count + g_pixtone_polar_star_count (engine-thread counters) +
+// doskutsu_audio_silent_irq_count (SDL-side IRQ-thread counter from
+// patches/SDL/0069). Emit gated on pixtone_probe_active(). One
+// LOG_INFO line per block; counters / histogram reset after emit.
+//
+// Hypothesis discrimination targets from PIXTONE-MULTISOURCE-DESIGN.md:
+// - A (per-callback mix CPU): active_count p90 + stoptrack delta tell
+//   us the channel load during the block.
+// - B (track-state transition): stoptrack delta directly measures the
+//   preempt-and-replay rate (the suspected mechanism).
+// - C (scheduler starvation): silent_irq delta + active_count max tell
+//   us whether IRQs are firing into a drained ring.
+// - D (IRQ jitter): silent_irq delta combined with the existing
+//   [audio-block] irq_count delta narrates the IRQ cadence.
+// - E (re-diagnose): if none of A-D match the operator's reported
+//   stutter, the deltas constrain the next hypothesis.
+//
+// Block snapshot pattern matches the existing [audio-block] reader at
+// line ~3089 (delta = now - last; modular wrap-safe per C99 unsigned).
+void _maybe_flush_pixtone_multi_audit()
+{
+  if ((_flip_total % _dc_tally_every_flips) != 0) return;
+  if (!pixtone_probe_active())
+  {
+    // Reset histogram + counter snapshots even when emit is gated, so
+    // a mid-run SET of the killswitch starts from a clean slate at the
+    // next emit boundary (matches the [audio-block] anti-pattern #2
+    // discipline: counters always update, emit gates only).
+    for (int i = 0; i < 6; ++i) NXE::Diag::g_pix_hist_bucket[i] = 0;
+    return;
+  }
+
+  // Snapshot the 6 buckets atomically-as-32-bit (volatile read);
+  // race-tolerant against the single audio-thread writer.
+  std::uint32_t bk[6];
+  for (int i = 0; i < 6; ++i)
+    bk[i] = NXE::Diag::g_pix_hist_bucket[i];
+
+  // Percentile compute via cumulative bucket counts. Bucket midpoints
+  // used for the percentile value -- coarse but sufficient at probe
+  // resolution: 0/1/2/4/8/12. min = first non-empty bucket midpoint;
+  // max = last non-empty; med + p90 by cumulative threshold.
+  std::uint32_t total = 0;
+  for (int i = 0; i < 6; ++i) total += bk[i];
+
+  static const std::uint32_t bucket_mid[6] = {0, 1, 2, 4, 8, 12};
+  std::uint32_t mn = 0, md = 0, p90 = 0, mx = 0;
+  if (total > 0)
+  {
+    for (int i = 0; i < 6; ++i) if (bk[i]) { mn = bucket_mid[i]; break; }
+    for (int i = 5; i >= 0; --i) if (bk[i]) { mx = bucket_mid[i]; break; }
+    const std::uint32_t thr_med = total / 2;
+    const std::uint32_t thr_p90 = (total * 90) / 100;
+    std::uint32_t acc = 0;
+    bool set_md = false, set_p90 = false;
+    for (int i = 0; i < 6; ++i)
+    {
+      acc += bk[i];
+      if (!set_md  && acc >= thr_med) { md  = bucket_mid[i]; set_md  = true; }
+      if (!set_p90 && acc >= thr_p90) { p90 = bucket_mid[i]; set_p90 = true; }
+    }
+  }
+
+  // Block-over-block deltas via snapshot pattern (matches [audio-block]
+  // at line ~3089). Unsigned subtraction is wrap-safe per C99.
+  static std::uint32_t _last_stoptrack  = 0;
+  static std::uint32_t _last_polar_star = 0;
+  static std::uint32_t _last_silent_irq = 0;
+
+  const std::uint32_t now_stoptrack  = g_pixtone_stoptrack_count;
+  const std::uint32_t now_polar_star = g_pixtone_polar_star_count;
+  const std::uint32_t now_silent_irq = doskutsu_audio_silent_irq_count;
+
+  const std::uint32_t d_stoptrack  = now_stoptrack  - _last_stoptrack;
+  const std::uint32_t d_polar_star = now_polar_star - _last_polar_star;
+  const std::uint32_t d_silent_irq = now_silent_irq - _last_silent_irq;
+
+  _last_stoptrack  = now_stoptrack;
+  _last_polar_star = now_polar_star;
+  _last_silent_irq = now_silent_irq;
+
+  // Snapshot of the live g_pixtone_active_count (instantaneous, not
+  // delta) -- useful for ground-truth cross-check against the
+  // histogram's max bucket when SFX channels are mid-play at emit time.
+  const std::uint32_t live_active = g_pixtone_active_count;
+
+  LOG_INFO("[pixtone-multi block={} samples={} active min={} med={} p90={} "
+           "max={} live={} stoptrack={} polarstar={} silent_irq={}]",
+           _dc_block_idx, total,
+           mn, md, p90, mx, live_active,
+           d_stoptrack, d_polar_star, d_silent_irq);
+
+  // Reset histogram for the next block. Counter cumulative values are
+  // preserved (the next block reads delta vs the snapshot above).
+  for (int i = 0; i < 6; ++i) NXE::Diag::g_pix_hist_bucket[i] = 0;
+}
+
