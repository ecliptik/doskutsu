+  _maybe_flush_pixtone_multi_audit();
 
@@ -8192 +8364,36 @@ bool drawtile_fast_bg_active() { return ::NXE::Graphics::_abl_drawtile_fast_bg()
 }}
+
+// DOS-PORT (patch 0165, Pixtone multi-source probe): SamplePixtoneActiveBucket
+// definition. Same file-scope-after-both-namespace-closes placement as the
+// other NXE::Diag accessors. Forwards into NXE::Graphics for the probe
+// killswitch + bucket array. Reads g_pixtone_active_count via the extern
+// "C" decl in NXE::Graphics's extern block.
+//
+// Bucket boundaries: [0], [1], [2], [3-5], [6-10], [11+]. The five
+// comparisons form a single-pass if/else-if cascade (no loop, no
+// std::lower_bound -- DJGPP libstdc++ paths are heavier than the manual
+// cascade at this site). Cost when probe ON: 1 volatile read + up to 5
+// cmps + 1 volatile inc. Cost when probe OFF: 1 cached-int compare
+// (pixtone_probe_active short-circuits), early return.
+//
+// Called from Organya.cpp's organyaStreamCallback at audio-buffer-fill
+// cadence (~43 Hz Tier-2). The audio thread is the single writer; the
+// render thread reads the buckets at audit-flush. Volatile semantics
+// + 32-bit aligned single-word writes are race-tolerant per CLAUDE.md
+// threading-zero invariant.
+namespace NXE { namespace Diag {
+void SamplePixtoneActiveBucket()
+{
+  if (!::NXE::Graphics::pixtone_probe_active())
+    return;
+  const std::uint32_t n = g_pixtone_active_count;
+  int b;
+  if      (n == 0)  b = 0;
+  else if (n == 1)  b = 1;
+  else if (n == 2)  b = 2;
+  else if (n <= 5)  b = 3;
+  else if (n <= 10) b = 4;
+  else              b = 5;
+  ++g_pix_hist_bucket[b];  // same-namespace lookup; defined at line ~129
+}
+}}
