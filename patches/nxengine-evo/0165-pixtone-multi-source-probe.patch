@@ -672,2 +709,29 @@ inline bool _abl_p10_audio_instr()
 
+// DOS-PORT (patch 0165, Pixtone multi-source probe). Cached-int 3-state
+// helper -- mirrors the Leg A / Leg B / DATA_CACHE sentinel-cache idiom
+// from nxengine/0162-v2 / 0164 / 0163. First call reads SDL_HINT_DOSKUTSU_-
+// PIXTONE_PROBE via _strict_truthy_env (std::getenv-backed; same path
+// SDL3-DOS hint reads use for env var fallback) and emits the LOG_INFO
+// banner naming the active state. Subsequent calls return the cached
+// int without an env read. Gates only:
+//   - _maybe_flush_pixtone_multi_audit's LOG_INFO emit
+//   - SamplePixtoneActiveBucket's histogram bucket-inc (no-op when off)
+// Does NOT gate the counter increments themselves (g_pixtone_stoptrack_-
+// count + g_pixtone_polar_star_count) -- those run unconditionally so
+// both PLAY0 + PLAY1 cells have valid counter snapshots regardless of
+// the probe killswitch state. Cache-OFF byte-identical-at-rendered-
+// frame to pre-0165 (banner LOG_INFO line is the only side-effect on
+// first call when off; one line per process).
+inline bool pixtone_probe_active()
+{
+  static int decided = -1;
+  if (decided < 0)
+  {
+    decided = _strict_truthy_env("SDL_HINT_DOSKUTSU_PIXTONE_PROBE") ? 1 : 0;
+    LOG_INFO("pixtone multi-source probe: {}",
+             decided ? "ENABLED (opt-in)" : "DISABLED (default)");
+  }
+  return decided == 1;
+}
