+/* Cave Story port — Phase 10 Stage 2 (slot 0101). MidiBackendStub: a
+ * shippable no-op concrete backend that validates the parser + scheduler
+ * infrastructure without requiring real audio hardware (WaveBlaster /
+ * OPL3). Picked when SDL_HINT_DOSKUTSU_AUDIO_BACKEND=midi-stub.
+ *
+ * All dispatch methods log at LOG_DEBUG (silent in release builds per
+ * Logger.cpp:53 default level INFO) when SDL_HINT_DOSKUTSU_AUDIO_INSTR=1
+ * is set, so a developer running with both env vars can verify the event
+ * stream looks plausible. Otherwise truly no-op.
+ *
+ * Stage 3 (slot 0102+) and Stage 4 (slot 0103+) replace this stub with
+ * concrete WaveBlaster / OPL3 backends consuming SDL/0037+ helpers.
+ */
+
+#ifndef _MIDI_BACKEND_STUB_H
+#define _MIDI_BACKEND_STUB_H
+
+#include "MidiScheduler.h"
+
+namespace NXE
+{
+namespace Sound
+{
+
+class MidiBackendStub : public MidiBackend
+{
+public:
+  void note_on(int channel, int note, int velocity) override;
+  void note_off(int channel, int note, int velocity) override;
+  void control_change(int channel, int controller, int value) override;
+  void program_change(int channel, int program) override;
+  void on_song_start() override;
+  void on_song_stop() override;
+};
+
+}  // namespace Sound
+}  // namespace NXE
+
+#endif  // _MIDI_BACKEND_STUB_H
diff --git a/src/sound/MidiScheduler.cpp b/src/sound/MidiScheduler.cpp
new file mode 100644
index 0000000..480119d
--- /dev/null
+++ b/src/sound/MidiScheduler.cpp
@@ -0,0 +1,609 @@
+/* Cave Story port — Phase 10 Stage 2 (slot 0101). MidiScheduler
+ * implementation: SMF parser + tick-driven scheduler. See
+ * MidiScheduler.h for design + API contract. */
+
+#include "MidiScheduler.h"
+
+#include "../Utils/Logger.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace NXE
+{
+namespace Sound
+{
+
+MidiScheduler::MidiScheduler() = default;
+MidiScheduler::~MidiScheduler() = default;
+
+MidiScheduler *MidiScheduler::getInstance()
+{
+  return Singleton<MidiScheduler>::get();
+}
+
+// ----------------------------------------------------------------------
+// Backend binding
+// ----------------------------------------------------------------------
+
+void MidiScheduler::set_backend(std::unique_ptr<MidiBackend> backend)
+{
+  // If currently playing, stop the prior backend cleanly (it might
+  // have voice-state to release; our default no-op on_song_stop is safe
+  // if the backend has nothing to release).
+  if (_playing && _backend)
+  {
+    _backend->on_song_stop();
+  }
+  _backend = std::move(backend);
+}
+
+// ----------------------------------------------------------------------
+// SMF parsing — entry point
+// ----------------------------------------------------------------------
+
+bool MidiScheduler::load(const std::string &path)
+{
+  // Read file into in-memory buffer. SMF files are typically <50 KB
+  // for Cave Story tracks; entirely safe to slurp.
+  FILE *fp = std::fopen(path.c_str(), "rb");
+  if (!fp)
+  {
+    LOG_ERROR("MidiScheduler::load: cannot open '{}': errno {}", path, errno);
+    return false;
+  }
+  std::fseek(fp, 0, SEEK_END);
+  long sz = std::ftell(fp);
+  std::fseek(fp, 0, SEEK_SET);
+  if (sz <= 0 || sz > 4 * 1024 * 1024)  // 4 MB sanity cap
+  {
+    LOG_ERROR("MidiScheduler::load: '{}' has invalid size {}", path, (long long)sz);
+    std::fclose(fp);
+    return false;
+  }
+  std::vector<std::uint8_t> buf((std::size_t)sz);
+  if (std::fread(buf.data(), 1, (std::size_t)sz, fp) != (std::size_t)sz)
+  {
+    LOG_ERROR("MidiScheduler::load: short read for '{}'", path);
+    std::fclose(fp);
+    return false;
+  }
+  std::fclose(fp);
+
+  // Stop current playback (if any) before replacing event list, so the
+  // backend's on_song_stop fires while the old context is still valid.
+  if (_playing && _backend)
+  {
+    _backend->on_song_stop();
+  }
+  _playing = false;
+  _events.clear();
+  _next_event_idx = 0;
+  _current_tick = 0;
+  _position_us = 0;
+
+  if (!_parse_smf(buf))
+  {
+    LOG_ERROR("MidiScheduler::load: parse failed for '{}'", path);
+    _events.clear();
+    return false;
+  }
+
+  LOG_INFO("MidiScheduler::load: parsed '{}' = {} events at {} PPQ",
+           path, (unsigned)_events.size(), (unsigned)_division_ppq);
+  return true;
+}
+
+// ----------------------------------------------------------------------
+// Playback control
+// ----------------------------------------------------------------------
+
+void MidiScheduler::start()
+{
+  if (_events.empty())
+  {
+    LOG_WARN("MidiScheduler::start: no events loaded; nothing to play");
+    return;
+  }
+  // If already playing, signal stop first so backend can reset state,
+  // then re-arm from event 0.
+  if (_playing && _backend)
+  {
+    _backend->on_song_stop();
+  }
+  _next_event_idx = 0;
+  _current_tick = 0;
+  _position_us = 0;
+  _last_tick_now_ms = 0;  // first tick() sets this; treats first delta as 0
+  _tempo_us_per_quarter = 500000;  // reset to SMF default; tempo events re-set
+  _recompute_us_per_tick();
+  _playing = true;
+  if (_backend)
+  {
+    _backend->on_song_start();
+  }
+}
+
+void MidiScheduler::stop()
+{
+  if (!_playing)
+    return;
+  if (_backend)
+  {
+    _backend->on_song_stop();
+  }
+  _playing = false;
+}
+
+// ----------------------------------------------------------------------
+// Per-frame tick (driven from SoundManager::runFade)
+// ----------------------------------------------------------------------
+
+void MidiScheduler::tick(std::uint64_t now_ms)
+{
+  if (!_playing || _events.empty() || !_backend)
+    return;
+
+  // First tick() after start(): seed last_tick_now_ms; advance 0.
+  if (_last_tick_now_ms == 0)
+  {
+    _last_tick_now_ms = now_ms;
+    return;
+  }
+
+  // Compute elapsed wall-clock since prior tick. Defensive against
+  // clock wrap or pause/resume: clamp delta < 0 to 0; clamp delta
+  // implausibly large (>10 sec) to 10 sec to avoid runaway dispatch.
+  std::uint64_t delta_ms = (now_ms > _last_tick_now_ms) ? (now_ms - _last_tick_now_ms) : 0;
+  if (delta_ms > 10000) delta_ms = 10000;
+  _last_tick_now_ms = now_ms;
+
+  // Advance position by delta_ms (= 1000 * delta_us). Convert delta_us
+  // to MIDI-tick-equivalents using current us_per_tick.
+  const std::uint64_t delta_us = delta_ms * 1000ULL;
+  _position_us += delta_us;
+
+  // Dispatch all events whose abs_tick has been reached. Use position_us
+  // / us_per_tick rather than incrementing _current_tick directly, so
+  // tempo changes mid-block don't skew the tick→time mapping.
+  // (Accepting some imprecision here: tempo changes within a single
+  // tick() call use the OLD us_per_tick for the events before the change
+  // and the NEW us_per_tick for events after. For a 30 fps tick rate
+  // that's <33 ms quantization — negligible musically.)
+  for (;;)
+  {
+    if (_next_event_idx >= _events.size())
+    {
+      // End-of-song reached. Loop from start: reset position_us +
+      // current_tick + next_event_idx; tempo state retained (tempo
+      // events re-dispatch as second loop hits them). Backend not
+      // signaled (loop semantic; on_song_stop fires only on explicit
+      // stop()).
+      _next_event_idx = 0;
+      _current_tick = 0;
+      _position_us = 0;
+      // Do NOT clear _last_tick_now_ms; next tick computes a small
+      // delta from this tick's now_ms and starts the loop from there.
+      break;
+    }
+
+    const MidiEvent &ev = _events[_next_event_idx];
+    // Compute when ev.abs_tick should fire in microseconds-since-song-
+    // start. Compare to current position_us; if not yet reached, defer.
+    const std::uint64_t event_us = (std::uint64_t)((double)ev.abs_tick * _us_per_tick);
+    if (event_us > _position_us)
+      break;  // not yet time for this event; stop dispatching
+
+    // Dispatch the event.
+    switch (ev.type)
+    {
+      case EventType::NOTE_ON:
+        _backend->note_on(ev.channel, ev.data1, ev.data2);
+        break;
+      case EventType::NOTE_OFF:
+        _backend->note_off(ev.channel, ev.data1, ev.data2);
+        break;
+      case EventType::CONTROL_CHANGE:
+        _backend->control_change(ev.channel, ev.data1, ev.data2);
+        break;
+      case EventType::PROGRAM_CHANGE:
+        _backend->program_change(ev.channel, ev.data1);
+        break;
+      case EventType::TEMPO_CHANGE:
+      {
+        // tempo_us_per_quarter packed as (channel << 16) | (data1 << 8)
+        // | data2 — 24-bit value reassembled from the SMF event.
+        _tempo_us_per_quarter =
+            ((std::uint32_t)ev.channel << 16) |
+            ((std::uint32_t)ev.data1   <<  8) |
+            ((std::uint32_t)ev.data2);
+        if (_tempo_us_per_quarter == 0)  // defensive against malformed file
+          _tempo_us_per_quarter = 500000;
+        _recompute_us_per_tick();
+        break;
+      }
+      case EventType::END_OF_TRACK:
+        // For multi-track files, end-of-track on track N doesn't end
+        // the SONG (other tracks may continue). We coalesce all tracks
+        // at parse time, so this event only appears as the final event
+        // of the merged stream — handle as natural end-of-song. The
+        // for-loop's `_next_event_idx >= _events.size()` branch above
+        // catches the next iteration and triggers the loop-from-start.
+        ++_next_event_idx;
+        continue;
+    }
+    ++_next_event_idx;
+  }
+
+  _current_tick = (std::uint64_t)((double)_position_us / _us_per_tick);
+}
+
+void MidiScheduler::_recompute_us_per_tick()
+{
+  // Division is in PPQ (pulses per quarter note). us_per_tick =
+  // tempo_us_per_quarter / division_ppq.
+  if (_division_ppq == 0)
+  {
+    _us_per_tick = 500000.0 / 480.0;  // defensive default
+    return;
+  }
+  _us_per_tick = (double)_tempo_us_per_quarter / (double)_division_ppq;
+}
+
+// ----------------------------------------------------------------------
+// SMF parser — header
+// ----------------------------------------------------------------------
+
+bool MidiScheduler::_parse_smf(const std::vector<std::uint8_t> &buf)
+{
+  if (buf.size() < 14)
+  {
+    LOG_WARN("MidiScheduler: SMF too short ({} bytes)", buf.size());
+    return false;
+  }
+
+  std::size_t cursor = 0;
+
+  // MThd magic
+  if (buf[0] != 'M' || buf[1] != 'T' || buf[2] != 'h' || buf[3] != 'd')
+  {
+    LOG_WARN("MidiScheduler: missing MThd magic");
+    return false;
+  }
+  cursor = 4;
+
+  // Header chunk size (always 6 for SMF)
+  std::uint32_t header_size = _read_u32_be(buf, cursor);
+  if (header_size != 6)
+  {
+    LOG_WARN("MidiScheduler: unexpected header size {}", header_size);
+    return false;
+  }
+
+  // Format (0/1 supported; 2 unsupported)
+  std::uint16_t format = _read_u16_be(buf, cursor);
+  if (format > 1)
+  {
+    LOG_WARN("MidiScheduler: SMF format {} not supported (only 0/1)", format);
+    return false;
+  }
+
+  // Number of tracks
+  std::uint16_t ntracks = _read_u16_be(buf, cursor);
+  if (ntracks == 0 || ntracks > 64)
+  {
+    LOG_WARN("MidiScheduler: implausible ntracks {}", ntracks);
+    return false;
+  }
+
+  // Division. High bit set = SMPTE; we reject SMPTE.
+  std::uint16_t division = _read_u16_be(buf, cursor);
+  if ((division & 0x8000) != 0)
+  {
+    LOG_ERROR("MidiScheduler: SMPTE division 0x{:04x} not supported", division);
+    return false;
+  }
+  _division_ppq = division;
+  if (_division_ppq == 0)
+    _division_ppq = 480;  // defensive
+
+  // Parse each MTrk chunk and merge into _events sorted by abs_tick.
+  std::vector<MidiEvent> all_events;
+  for (int t = 0; t < ntracks; ++t)
+  {
+    if (cursor + 8 > buf.size())
+    {
+      LOG_WARN("MidiScheduler: truncated track chunk header at track {}", t);
+      return false;
+    }
+    if (buf[cursor] != 'M' || buf[cursor+1] != 'T' || buf[cursor+2] != 'r' || buf[cursor+3] != 'k')
+    {
+      LOG_WARN("MidiScheduler: missing MTrk magic at track {} (cursor=0x{:x})", t, (unsigned)cursor);
+      return false;
+    }
+    cursor += 4;
+    std::uint32_t track_size = _read_u32_be(buf, cursor);
+    if (cursor + track_size > buf.size())
+    {
+      LOG_WARN("MidiScheduler: track {} runs past EOF", t);
+      return false;
+    }
+    std::size_t track_end = cursor + track_size;
+    std::vector<MidiEvent> track_events;
+    if (!_parse_track(buf, cursor, track_end, track_events))
+    {
+      LOG_WARN("MidiScheduler: track {} parse failed", t);
+      return false;
+    }
+    cursor = track_end;
+    // Merge into all_events.
+    all_events.insert(all_events.end(), track_events.begin(), track_events.end());
+  }
+
+  // Stable sort by abs_tick so equal-tick events from different tracks
+  // dispatch in deterministic order.
+  std::stable_sort(all_events.begin(), all_events.end(),
+                   [](const MidiEvent &a, const MidiEvent &b) {
+                     return a.abs_tick < b.abs_tick;
+                   });
+
+  _events = std::move(all_events);
+  _recompute_us_per_tick();
+  return true;
+}
+
+// ----------------------------------------------------------------------
+// SMF parser — single track
+// ----------------------------------------------------------------------
+
+bool MidiScheduler::_parse_track(const std::vector<std::uint8_t> &buf,
+                                 std::size_t track_start, std::size_t track_end,
+                                 std::vector<MidiEvent> &out_events)
+{
+  std::size_t cursor = track_start;
+  std::uint64_t current_tick = 0;
+  std::uint8_t running_status = 0;
+  bool saw_end_of_track = false;
+
+  while (cursor < track_end)
+  {
+    // Delta-time VLQ.
+    std::uint32_t delta = 0;
+    if (!_read_vlq(buf, cursor, track_end, delta))
+    {
+      LOG_WARN("MidiScheduler: track delta-time VLQ truncated");
+      return false;
+    }
+    current_tick += delta;
+
+    if (cursor >= track_end)
+    {
+      LOG_WARN("MidiScheduler: track ended mid-event");
+      return false;
+    }
+
+    std::uint8_t status = buf[cursor];
+    if (status < 0x80)
+    {
+      // Running status: re-use prior status, current byte is data.
+      if (running_status == 0)
+      {
+        LOG_WARN("MidiScheduler: running status with no prior status byte");
+        return false;
+      }
+      status = running_status;
+      // cursor stays; first data byte is buf[cursor]
+    }
+    else
+    {
+      // New status byte; consume it.
+      ++cursor;
+      // Channel events: status byte caches as running status.
+      // System / meta events (0xF0-0xFF): clear running status.
+      if (status >= 0xF0)
+        running_status = 0;
+      else
+        running_status = status;
+    }
+
+    if ((status & 0xF0) == 0xF0)
+    {
+      // Meta or SysEx event.
+      if (status == 0xFF)
+      {
+        // Meta event: type byte + VLQ length + data
+        if (cursor >= track_end)
+        {
+          LOG_WARN("MidiScheduler: truncated meta event header");
+          return false;
+        }
+        std::uint8_t meta_type = buf[cursor++];
+        std::uint32_t meta_len = 0;
+        if (!_read_vlq(buf, cursor, track_end, meta_len))
+        {
+          LOG_WARN("MidiScheduler: meta event VLQ length truncated");
+          return false;
+        }
+        if (cursor + meta_len > track_end)
+        {
+          LOG_WARN("MidiScheduler: meta event payload runs past track end");
+          return false;
+        }
+
+        if (meta_type == 0x51 && meta_len == 3)
+        {
+          // Tempo change. 3-byte big-endian us-per-quarter.
+          std::uint32_t tempo =
+              ((std::uint32_t)buf[cursor]   << 16) |
+              ((std::uint32_t)buf[cursor+1] <<  8) |
+              ((std::uint32_t)buf[cursor+2]);
+          MidiEvent ev{};
+          ev.abs_tick = current_tick;
+          ev.type = EventType::TEMPO_CHANGE;
+          ev.channel = (std::uint8_t)((tempo >> 16) & 0xFF);
+          ev.data1   = (std::uint8_t)((tempo >>  8) & 0xFF);
+          ev.data2   = (std::uint8_t)( tempo        & 0xFF);
+          out_events.push_back(ev);
+        }
+        else if (meta_type == 0x2F)
+        {
+          // End-of-track marker. Always meta_len == 0.
+          MidiEvent ev{};
+          ev.abs_tick = current_tick;
+          ev.type = EventType::END_OF_TRACK;
+          out_events.push_back(ev);
+          saw_end_of_track = true;
+        }
+        // All other meta events (text, copyright, marker, time-sig,
+        // key-sig, sequencer-specific): parsed-and-skipped silently.
+        cursor += meta_len;
+      }
+      else if (status == 0xF0 || status == 0xF7)
+      {
+        // SysEx (or escape). VLQ length + data; skip.
+        std::uint32_t sysex_len = 0;
+        if (!_read_vlq(buf, cursor, track_end, sysex_len))
+        {
+          LOG_WARN("MidiScheduler: SysEx VLQ length truncated");
+          return false;
+        }
+        if (cursor + sysex_len > track_end)
+        {
+          LOG_WARN("MidiScheduler: SysEx payload runs past track end");
+          return false;
+        }
+        cursor += sysex_len;
+      }
+      else
+      {
+        LOG_WARN("MidiScheduler: unknown system status 0x{:02x}", status);
+        return false;
+      }
+    }
+    else
+    {
+      // Channel event. Determine arity (1 or 2 data bytes) by status nibble.
+      const std::uint8_t channel = status & 0x0F;
+      const std::uint8_t kind = status & 0xF0;
+      int arity;
+      switch (kind)
+      {
+        case 0x80: arity = 2; break;  // note off
+        case 0x90: arity = 2; break;  // note on
+        case 0xA0: arity = 2; break;  // poly aftertouch — skipped
+        case 0xB0: arity = 2; break;  // control change
+        case 0xC0: arity = 1; break;  // program change
+        case 0xD0: arity = 1; break;  // channel pressure — skipped
+        case 0xE0: arity = 2; break;  // pitch bend — skipped
+        default:
+          LOG_WARN("MidiScheduler: unknown channel status nibble 0x{:02x}", kind);
+          return false;
+      }
+      if (cursor + (std::size_t)arity > track_end)
+      {
+        LOG_WARN("MidiScheduler: truncated channel event payload");
+        return false;
+      }
+      std::uint8_t d1 = buf[cursor++];
+      std::uint8_t d2 = (arity == 2) ? buf[cursor++] : 0;
+
+      // Map to internal EventType. Skip aftertouch / pressure / pitch
+      // bend (Stage 2 simplification).
+      if (kind == 0x80 || (kind == 0x90 && d2 == 0))
+      {
+        MidiEvent ev{};
+        ev.abs_tick = current_tick;
+        ev.type = EventType::NOTE_OFF;
+        ev.channel = channel;
+        ev.data1 = d1;
+        ev.data2 = d2;
+        out_events.push_back(ev);
+      }
+      else if (kind == 0x90)
+      {
+        MidiEvent ev{};
+        ev.abs_tick = current_tick;
+        ev.type = EventType::NOTE_ON;
+        ev.channel = channel;
+        ev.data1 = d1;
+        ev.data2 = d2;
+        out_events.push_back(ev);
+      }
+      else if (kind == 0xB0)
+      {
+        MidiEvent ev{};
+        ev.abs_tick = current_tick;
+        ev.type = EventType::CONTROL_CHANGE;
+        ev.channel = channel;
+        ev.data1 = d1;
+        ev.data2 = d2;
+        out_events.push_back(ev);
+      }
+      else if (kind == 0xC0)
+      {
+        MidiEvent ev{};
+        ev.abs_tick = current_tick;
+        ev.type = EventType::PROGRAM_CHANGE;
+        ev.channel = channel;
+        ev.data1 = d1;
+        out_events.push_back(ev);
+      }
+      // else: 0xA0 / 0xD0 / 0xE0 — silently skipped per Stage 2 design.
+    }
+  }
+
+  if (!saw_end_of_track)
+  {
+    // Defensive: insert a synthetic end-of-track at last seen tick.
+    MidiEvent ev{};
+    ev.abs_tick = current_tick;
+    ev.type = EventType::END_OF_TRACK;
+    out_events.push_back(ev);
+  }
+
+  return true;
+}
+
+// ----------------------------------------------------------------------
+// VLQ + big-endian helpers
+// ----------------------------------------------------------------------
+
+bool MidiScheduler::_read_vlq(const std::vector<std::uint8_t> &buf,
+                              std::size_t &cursor, std::size_t end,
+                              std::uint32_t &out)
+{
+  out = 0;
+  for (int i = 0; i < 4; ++i)
+  {
+    if (cursor >= end)
+      return false;
+    std::uint8_t b = buf[cursor++];
+    out = (out << 7) | (b & 0x7F);
+    if ((b & 0x80) == 0)
+      return true;
+  }
+  return false;  // VLQ longer than 4 bytes is invalid per SMF spec
+}
+
+std::uint16_t MidiScheduler::_read_u16_be(const std::vector<std::uint8_t> &buf, std::size_t &cursor)
+{
+  std::uint16_t v = (std::uint16_t)((buf[cursor] << 8) | buf[cursor+1]);
+  cursor += 2;
+  return v;
+}
+
+std::uint32_t MidiScheduler::_read_u32_be(const std::vector<std::uint8_t> &buf, std::size_t &cursor)
+{
+  std::uint32_t v =
+      ((std::uint32_t)buf[cursor]   << 24) |
+      ((std::uint32_t)buf[cursor+1] << 16) |
+      ((std::uint32_t)buf[cursor+2] <<  8) |
+      ((std::uint32_t)buf[cursor+3]);
+  cursor += 4;
+  return v;
+}
+
+}  // namespace Sound
+}  // namespace NXE
