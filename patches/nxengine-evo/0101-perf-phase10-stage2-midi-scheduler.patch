+// patch 0101 (Phase 10 Stage 2 MidiScheduler): parallel to
+// _start_org_track / _start_ogg_track for the midi-stub / wb / opl3
+// backends. Resolves songno -> data/midi/<name>.mid via the existing
+// _music_names[] lookup (loaded from music.jsn at init); calls
+// MidiScheduler::load + start. The `resume` arg is reserved for future
+// Phase 10 work (resume from saved tick position); slot 0101 ignores
+// it (always starts from event 0). songno == 0 is the engine's "stop
+// music" signal — handled by stopping the scheduler.
+//
+// Path resolution: data/midi/<trackname>.mid via ResourceManager; the
+// 41 .mid files are deposited there by scripts/fetch-cs-midi.py (Phase
+// 10 Stage 1 + 1.5). If a .mid file is missing on disk (e.g., user
+// skipped Step 4.5 of docs/ASSETS.md, or the ORGMID step failed),
+// MidiScheduler::load returns false and we LOG_WARN — the music slot
+// stays silent for that song; SFX continues. Documented degradation.
+void SoundManager::_start_mid_track(int songno, bool resume)
+{
+  (void)resume;  // reserved; slot 0101 always starts from event 0
+  if (_music_names.size() < 2) return;
+
+  MidiScheduler::getInstance()->stop();
+  if (songno == 0)
+  {
+    // Engine "stop music" signal.
+    return;
+  }
+
+  const std::string path = ResourceManager::getInstance()->getPath(
+      "midi/" + _music_names[songno] + ".mid", false);
+  if (MidiScheduler::getInstance()->load(path))
+  {
+    MidiScheduler::getInstance()->start();
+  }
+  else
+  {
+    LOG_WARN("SoundManager::_start_mid_track: could not load '{}' "
+             "(songno={}); music slot stays silent. Verify "
+             "scripts/fetch-cs-midi.py was run + data/midi/ contains "
+             "the file.", path, songno);
+  }
+}
