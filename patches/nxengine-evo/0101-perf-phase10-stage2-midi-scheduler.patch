--- /dev/null
+++ b/src/sound/MidiScheduler.h
@@ -0,0 +1,213 @@
+/* Cave Story port — Phase 10 Stage 2 (slot 0101). Standard MIDI File
+ * parser + tick-driven event scheduler + abstract backend interface.
+ *
+ * Design (per docs/PHASE10-DESIGN.md § 4 + team-lead 2026-05-06 dispatch):
+ *
+ *   MidiScheduler  parses .mid files (SMF Format 0 / 1; tempo + time-sig
+ *                  meta events; ignores aftertouch / pitch-bend / SysEx)
+ *                  into a flat event list; tick() advances position +
+ *                  dispatches elapsed events to the bound backend.
+ *
+ *   MidiBackend    abstract base; per-event dispatch hooks (note_on,
+ *                  note_off, control_change, program_change). Concrete
+ *                  subclasses live in their own .h/.cpp:
+ *                    - MidiBackendStub   (slot 0101): no-op all dispatch;
+ *                                        shippable; validates parser +
+ *                                        scheduler infrastructure without
+ *                                        real audio hardware.
+ *                    - AudioBackendWB    (slot 0102+, Stage 3): consumes
+ *                                        SDL/0037+ MPU-401 helpers.
+ *                    - AudioBackendOPL3  (slot 0103+, Stage 4): consumes
+ *                                        SDL/0037+ OPL3 helpers.
+ *
+ * Threading-zero invariant per CLAUDE.md: tick() runs on main loop
+ * (called from SoundManager::runFade(), which is invoked per-frame from
+ * main.cpp's run_tick). Backend dispatch is synchronous on the same
+ * call stack. No worker threads.
+ *
+ * Memory: ~10-40 KB resident per song (one song at a time; load()
+ * replaces prior). Pre-parsed events flat-vector; no streaming-from-disk.
+ */
+
+#ifndef _MIDI_SCHEDULER_H
+#define _MIDI_SCHEDULER_H
+
+#include "../Singleton.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace NXE
+{
+namespace Sound
+{
+
+// ----------------------------------------------------------------------
+// MidiBackend — abstract per-event dispatch interface.
+// ----------------------------------------------------------------------
+//
+// MidiScheduler::tick() invokes these per dispatched MIDI event. Default
+// implementations are no-ops so concrete backends only need to override
+// the events they care about (e.g., a drum-only backend can ignore
+// note-on for non-drum channels).
+class MidiBackend
+{
+public:
+  virtual ~MidiBackend() = default;
+
+  // Channel events. Channel is 0-15 (MIDI's 4-bit channel field).
+  virtual void note_on(int channel, int note, int velocity)       { (void)channel; (void)note; (void)velocity; }
+  virtual void note_off(int channel, int note, int velocity)      { (void)channel; (void)note; (void)velocity; }
+  virtual void control_change(int channel, int controller, int value) { (void)channel; (void)controller; (void)value; }
+  virtual void program_change(int channel, int program)           { (void)channel; (void)program; }
+
+  // Lifecycle hooks (called by MidiScheduler at song load/start/stop).
+  // Default: no-op. Backends that need to (re)initialize per-song state
+  // (e.g., reset OPL3 voice allocator on song change) override these.
+  virtual void on_song_start() {}
+  virtual void on_song_stop()  {}
+};
+
+// ----------------------------------------------------------------------
+// MidiScheduler — SMF parser + tick-driven scheduler.
+// ----------------------------------------------------------------------
+//
+// Singleton. Owns a single in-memory pre-parsed event list (one song at a
+// time). load() parses an .mid file from disk; start() arms playback;
+// tick(now_ms) advances position + dispatches events.
+//
+// SMF features supported:
+//   - Format 0 (single track) and Format 1 (multi-track merged at parse).
+//   - PPQ (pulses-per-quarter) division. SMPTE division is rejected
+//     (negligible Cave Story usage; not worth the complexity).
+//   - Channel events: note on/off, control change, program change.
+//   - Meta events: tempo (0x51), end-of-track (0x2F). Other meta events
+//     (text, time-sig, key-sig, etc.) are parsed-and-skipped at load
+//     time (not stored in the event list).
+//   - Running-status decoding for compact event streams.
+//
+// SMF features NOT supported (intentional simplification for Stage 2):
+//   - Aftertouch (0xA0), channel pressure (0xD0), pitch bend (0xE0):
+//     parsed-and-skipped silently. Cave Story's WiiWare arrangements
+//     do use pitch bend in some tracks; future Stage 3+ may extend the
+//     backend interface to dispatch them. For Stage 2 stub validation,
+//     skipping is correct (silent stub anyway).
+//   - SysEx (0xF0 / 0xF7): parsed-and-skipped silently.
+//   - SMPTE-divided files: load() returns false with LOG_ERROR.
+//
+// Loop semantics: when tick() reaches end-of-song (last event
+// dispatched), MidiScheduler restarts from event 0 with current_tick
+// reset, position_us reset. Tempo state preserved (tempo meta-events
+// re-dispatch as the second loop hits them again). Cave Story's Organya
+// has explicit loop-point semantics; SMF format does not, so we use
+// loop-from-start which matches typical NXEngine-evo .org playback for
+// non-loop-point tracks.
+class MidiScheduler
+{
+public:
+  static MidiScheduler *getInstance();
+
+  // Replace the bound backend. Takes ownership. Pass nullptr to detach
+  // (e.g., during shutdown).
+  void set_backend(std::unique_ptr<MidiBackend> backend);
+
+  // Parse a .mid file from disk into the in-memory event list. Returns
+  // true on success, false on parse failure. LOG_ERROR / LOG_WARN
+  // narrate the failure mode. Replaces any previously-loaded song.
+  bool load(const std::string &path);
+
+  // Arm playback from event 0 with current_tick / position_us at zero.
+  // Idempotent: calling start() on an already-playing scheduler is a
+  // no-op-ish "rewind to zero" (it does fire on_song_stop() then
+  // on_song_start() on the backend so backend can reset per-song
+  // state).
+  void start();
+
+  // Disarm playback. tick() becomes a no-op until next start().
+  void stop();
+
+  // Advance playback position to now_ms. Dispatches all events whose
+  // absolute timing has elapsed since the previous tick. Backend's
+  // note_on / note_off / control_change / program_change fire
+  // synchronously on this call stack.
+  //
+  // If `now_ms` goes backwards (clock wrap or pause/resume), the
+  // delta is treated as 0 (no advance, no dispatch). Defensive.
+  void tick(std::uint64_t now_ms);
+
+  // True when start() has been called and stop() has NOT been called.
+  // Used by SoundManager to gate the per-frame tick call.
+  bool isPlaying() const { return _playing; }
+
+protected:
+  friend class Singleton<MidiScheduler>;
+
+  MidiScheduler();
+  ~MidiScheduler();
+  MidiScheduler(const MidiScheduler &) = delete;
+  MidiScheduler &operator=(const MidiScheduler &) = delete;
+
+private:
+  // ------------------------------------------------------------------
+  // In-memory event representation. One MidiEvent per channel-event
+  // dispatch + tempo-change marker. ~12 bytes per event; typical Cave
+  // Story song = 2000-5000 events = 24-60 KB resident.
+  // ------------------------------------------------------------------
+  enum class EventType : std::uint8_t
+  {
+    NOTE_ON = 0,
+    NOTE_OFF = 1,
+    CONTROL_CHANGE = 2,
+    PROGRAM_CHANGE = 3,
+    TEMPO_CHANGE = 4,  // tempo_us_per_quarter encoded in `data1`+`data2`+`channel` (24-bit)
+    END_OF_TRACK = 5,  // signals natural end; tick() loops at this point
+  };
+
+  struct MidiEvent
+  {
+    std::uint64_t abs_tick;     // absolute MIDI tick from song start
+    EventType type;
+    std::uint8_t channel;       // 0-15 for channel events; n/a for meta
+    std::uint8_t data1;         // note OR controller OR program
+    std::uint8_t data2;         // velocity OR cc-value; n/a for program_change
+  };
+
+  // Parse helpers. Each consumes from a moving cursor into the file
+  // buffer; returns false on parse error (with LOG_WARN narration).
+  bool _parse_smf(const std::vector<std::uint8_t> &buf);
+  bool _parse_track(const std::vector<std::uint8_t> &buf,
+                    std::size_t track_start, std::size_t track_end,
+                    std::vector<MidiEvent> &out_events);
+
+  // Variable-length quantity decoder (SMF VLQ).
+  static bool _read_vlq(const std::vector<std::uint8_t> &buf,
+                        std::size_t &cursor, std::size_t end,
+                        std::uint32_t &out);
+
+  // Big-endian uint16/uint32 decode (SMF native byte order).
+  static std::uint16_t _read_u16_be(const std::vector<std::uint8_t> &buf, std::size_t &cursor);
+  static std::uint32_t _read_u32_be(const std::vector<std::uint8_t> &buf, std::size_t &cursor);
+
+  // Compute microseconds-per-MIDI-tick from current tempo + division.
+  // Updated when a TEMPO_CHANGE event dispatches.
+  void _recompute_us_per_tick();
+
+  std::vector<MidiEvent> _events;       // sorted by abs_tick
+  std::unique_ptr<MidiBackend> _backend;
+  std::uint16_t _division_ppq          = 480;  // SMF default if header had 0
+  std::uint32_t _tempo_us_per_quarter  = 500000;  // SMF default = 120 BPM
+  double        _us_per_tick           = 500000.0 / 480.0;
+
+  std::size_t   _next_event_idx        = 0;
+  std::uint64_t _current_tick          = 0;
+  std::uint64_t _position_us           = 0;     // since song start (post-loop-resets)
+  std::uint64_t _last_tick_now_ms      = 0;
+  bool          _playing               = false;
+};
+
+}  // namespace Sound
+}  // namespace NXE
+
+#endif  // _MIDI_SCHEDULER_H
