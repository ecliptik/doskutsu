+// DOS-PORT (patch 0117, Phase 11 iter K Cand #1 -- drawTileFast inline).
+// Killswitch for the FG-tilemap drawcall fast-fast-path. Default ON;
+// set =0 to revert to Renderer::drawSurface for tilemap calls (preserves
+// all counter / dirty-rect / instrumentation pumps as-of-slot-0115).
+//
+// Polarity: only literal "0" disables (mirror of patch 0088 / 0093 /
+// 0115's killswitch convention). Any other value (unset, empty, "1",
+// "yes", garbage) keeps drawTileFast engaged. Cached lambda + static
+// const bool so the per-tile hot-path guard is hoisted out of the
+// loop body at -O2.
+//
+// Predicted savings: ~3-5 ms / flip per FPS-DEEPDIVE Cand #1
+// (data-backed by wave-25 dispatch_overhead_per_tile_us = 32.4 us x
+// 329 tiles = 10.7 ms / flip pure overhead). Iter K-1 is the load-
+// bearing measurement gate (real-HW PODP-OD-83); per
+// perf_predictions_unreliable.md predictions historically wrong 5-30x.
+inline bool _abl_drawtile_fast()
+{
+  static const bool v = []() {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_DRAWTILE_FAST");
+    return !(e && e[0] == '0' && e[1] == 0);
+  }();
+  return v;
+}
