+// DOS-PORT (patch 0117, Phase 11 iter K Cand #1 -- drawTileFast inline).
+// Same src-rect math as drawTile; delegates to Renderer::drawTileFast
+// instead of drawSurface. Callers (map.cpp's
+// _tilemap_render_uncached_full_loop) gate selection between drawTile
+// and drawTileFast on SDL_HINT_DOSKUTSU_DRAWTILE_FAST killswitch.
+//
+// NULL-tileset guard: drawTile delegates the guard to
+// Renderer::drawSurface's null-check; drawTileFast skips that check
+// (caller responsibility). We add the guard here at the Tileset
+// level so a missing tilesheet (e.g., reload race) does not trip
+// undefined behavior in Renderer::drawTileFast -> src->surfaceCpu()
+// dereferencing nullptr. This single guard at the Tileset entry is
+// cheap (one branch, predicted-not-taken in the steady state) and
+// preserves the drawSurface NULL-check semantics that drawTileFast
+// drops.
+void Tileset::drawTileFast(int x, int y, int t)
+{
+  if (!_tileset) return;
+
+  // 16 tiles per row on all tilesheet
+  int srcx = (t % 16) * TILE_W;
+  int srcy = (t / 16) * TILE_H;
+
+  Renderer::getInstance()->drawTileFast(_tileset, x, y, srcx, srcy);
+}
