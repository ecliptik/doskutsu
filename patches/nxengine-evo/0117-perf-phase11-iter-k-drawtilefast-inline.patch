+// DOS-PORT (patch 0117, Phase 11 iter K Cand #1 -- drawTileFast inline).
+// Fast-fast-path for the FG-tilemap drawcall hot path. See Renderer.h
+// for the full design comment + caller-precondition contract. Cost
+// reductions vs Renderer::drawSurface entry chain (per call):
+//   - 2x SDL_GetTicksNS reads (DrawcallTimer ctor + dtor) skipped
+//   - assert + NULL check skipped (caller responsibility)
+//   - 6x scale multiplies skipped (scale=1; coords passed through)
+//   - _need_clip / clipScaled skipped (tilemap loop never sets clip)
+//   - _bump_alpha_count skipped (alpha=255 invariant)
+//   - _try_fast_blit's 5-condition validation skipped (preconditions
+//     above guarantee they pass; we re-do only the queue-drain gate
+//     because that's correctness, not validation)
+//   - _bump_drawcall skipped (drawcall counters drift; tilemap-specific
+//     accounting lives in wave-25 instrumentation instead)
+//   - _record_dirty_rect skipped (default-config full-refresh fires
+//     every flip per slot 0085; partial-flush via prev-frame-diff
+//     uses per-scanline memcmp -- independent of _dirty_rects)
+//   - _bump_alpha drift on the per-tile path: tilesheet alpha is
+//     constant 255 across the run (tilesheet.alpha is never assigned
+//     except at construction); _alpha_total counter under-counts
+//     tilemap calls, but those are 100% alpha=255 anyway so the
+//     ratio (nonopaque / total) stays accurate.
+//
+// Wave-25 instrumentation behavior:
+//   _blit_indexed brackets gate on g_mds_tfg_loop_active flag (set by
+//   map.cpp's _tilemap_render_uncached_full_loop entry/exit when
+//   foreground == TA_FOREGROUND AND env set). drawTileFast still
+//   calls _blit_indexed, so blit_indexed_per_us / count counters
+//   continue to fire correctly. drawtile_per_us / count counters at
+//   the map.cpp call site also still fire (they're outside this
+//   function, wrapping the call). dispatch_overhead_per_tile_us =
+//   drawtile - blit_indexed should DROP toward 0 when drawTileFast
+//   engages -- that's the essential iter-K-1 measurement.
+void Renderer::drawTileFast(Surface *src, int dstx, int dsty, int srcx, int srcy)
+{
+  // Drain pending slow-path commands so our overlay lands AFTER them.
+  // Same gate as _try_fast_blit; correctness is non-negotiable.
+  if (_renderer_queue_dirty)
+  {
+    SDL_FlushRenderer(_renderer);
+    _renderer_queue_dirty = false;
+  }
+
+  // Pre-compute rects (16x16 fixed at TILE_W/TILE_H constants from
+  // Tileset.h; scale=1 invariant). No clipping done here -- the
+  // _blit_indexed primitive performs its own dst-bounds clamping
+  // (off-screen tiles produce zero-pixel early-return inside
+  // _blit_indexed; same correctness as drawSurface's clipScaled
+  // fall-through).
+  SDL_Rect srcrect = {srcx, srcy, TILE_W, TILE_H};
+  SDL_Rect dstrect = {dstx, dsty, TILE_W, TILE_H};
+
+  // Direct call to _blit_indexed (same primitive drawSurface's fast
+  // path eventually reaches via _try_fast_blit dispatch). Wave-25
+  // instrumentation continues to fire if g_mds_tfg_loop_active is
+  // set by the caller.
+  _blit_indexed(_cached_window_surface, src->surfaceCpu(),
+                srcrect, dstrect,
+                (Uint8)src->colorkey(), src->hasColorkey());
+}
+
 // blit the specified portion of the surface to the screen
