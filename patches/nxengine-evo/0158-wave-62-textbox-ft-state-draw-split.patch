@@ -252,6 +252,30 @@ void TextBox::Tick(void)
   Draw();
 }
 
+// DOS-PORT (patch 0158, Phase 11 wave-62): the drawcall-free state half
+// of Tick(). Under SDL_HINT_DOSKUTSU_FIXED_TIMESTEP the wave-57
+// accumulator multi-runs Game::tick_state() N times per displayed
+// frame; the textbox state (text scroll-in, the 3 menu sub-prompt
+// state machines) must advance at the fixed 50 Hz logic rate, so its
+// state work moves into tick_state via this method. It is the 4-way
+// split: TickState() calls each sub-prompt's TickState() (state only)
+// -- the trailing Draw() each sub-Tick() does is dropped here because
+// TextBox::Draw() (the render half) already draws all four sub-prompts.
+// Tick() above is left UNCHANGED so the FT=0 path and the title /
+// inventory callers stay byte-identical to wave-61.
+void TextBox::TickState(void)
+{
+  if (fVisible)
+  {
+    TickTextBox();
+
+//    ItemImage.Tick();
+    YesNoPrompt.TickState();
+    StageSelect.TickState();
+    SaveSelect.TickState();
+  }
+}
+
