@@ -495,6 +495,22 @@ void Game::tick_state(void)
   // in wave-56 (the if(!fixed_timestep_active()) guard in each Draw).
   if (fixed_timestep_active())
   {
+    // DOS-PORT (patch 0158, Phase 11 wave-62): the textbox subsystem
+    // state half. Under FIXED_TIMESTEP the textbox state (text scroll-in
