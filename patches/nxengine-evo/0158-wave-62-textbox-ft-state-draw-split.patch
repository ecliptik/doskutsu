+    // unchanged textbox.Tick() calls. TickState() is drawcall-free
+    // (wave-62 4-way split), so the accumulator multi-running it is safe.
+    if (_tick_dispatch == TD_GM_NORMAL_SPLIT)
+      textbox.TickState();
+
     fade.Tick();
     if (starflash.enabled)
       starflash.Tick();
@@ -856,7 +872,16 @@ void game_tick_normal_render(void)
 
   {
     NXE::Diag::ModePostTimer _mpt;
-    textbox.Tick();
+    // DOS-PORT (patch 0158, Phase 11 wave-62): under FIXED_TIMESTEP the
+    // textbox STATE half already ran in Game::tick_state() (via
+    // textbox.TickState()) at the 50 Hz logic rate -- so here, the
+    // render half, draw ONLY. A textbox.Tick() would advance the state
+    // a second time per displayed frame. FT=0: unchanged -- textbox.Tick()
+    // does state + draw exactly as in wave-61 (byte-identical).
+    if (fixed_timestep_active())
+      textbox.Draw();
+    else
+      textbox.Tick();
 
     ScreenEffects::Draw();
     map_draw_map_name(); // stage name overlay as on entry
