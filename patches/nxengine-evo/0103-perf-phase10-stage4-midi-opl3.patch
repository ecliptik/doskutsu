+// ============================================================================
+// Patch bank -- 8 representative OPL3 patches, public-domain-derived
+// ============================================================================
+//
+// Each patch is 12 bytes per the SDL_DOSOpl3VoiceWritePatch contract:
+//   patch[0..4]: op0 (modulator) -- AM/VIB/EG/KSR/MULT, KSL/TL, AR/DR,
+//                                  SL/RR, WS
+//   patch[5]:    channel -- feedback + connection + L/R panning (0xC0)
+//   patch[6..10]: op1 (carrier) -- same 5 op-level registers as op0
+//   patch[11]:   fine-tune -- engine-side, not written by helper
+//
+// Index by GM family bucket (programs 0-127 collapse into 7 buckets
+// covering ~85% of Cave Story's WiiWare arrangement palette).
+//
+// Reference encoding mnemonics:
+//   AM/VIB/EG/KSR/MULT byte: AM(7) | VIB(6) | EG(5) | KSR(4) | MULT(3..0)
+//   KSL/TL byte:             KSL(7..6) | TL(5..0)
+//   AR/DR byte:              AR(7..4) | DR(3..0)
+//   SL/RR byte:              SL(7..4) | RR(3..0)
+//   WS byte:                 WS(2..0) -- waveform 0=sine, 1=half-sine,
+//                                       2=abs-sine, 3=quarter-sine,
+//                                       4=alt-sine, 5=cam-sine,
+//                                       6=square, 7=logsaw
+//   FB/CONN byte:            CHA(7) | CHB(6) | CHC(5) | CHD(4) |
+//                            FB(3..1) | CONN(0)
+//                            (For 18x2-op mode in NXE port: CHA=CHB=
+//                             CHC=CHD=1 -> both stereo banks audible;
+//                             CONN=0 = AM modulation, CONN=1 = additive)
+//
+// PATCH_PIANO: bright, percussive -- for GM 0-7 (piano family).
+// PATCH_MALLET: short attack, long decay -- for GM 8-15 (chromatic perc).
+// PATCH_ORGAN: sustained, sine-like -- for GM 16-23, 92-95.
+// PATCH_GUITAR: bright pluck -- for GM 24-31, 80-87 (lead synth too).
+// PATCH_BRASS: harsh, edge-on -- for GM 56-63 (brass family).
+// PATCH_REED: reedy/woody -- for GM 64-79 (reeds + flutes).
+// PATCH_PAD: slow attack, long sustain -- for GM 88-103 (synth pad).
+// PATCH_DRUM: noise-burst envelope -- drum channel only.
+
+static constexpr uint8_t PATCH_PIANO[12] = {
+  // op0: tremolo off, vibrato off, EG sustain off, KSR off, MULT=1
+  0x01,
+  // KSL/TL: KSL=0, TL=8 (medium-loud)
+  0x08,
+  // AR/DR: AR=14 (fast), DR=6 (medium)
+  0xE6,
+  // SL/RR: SL=4, RR=8 (medium release)
+  0x48,
+  // WS: 0 = sine
+  0x00,
+  // FB/CONN: stereo both banks, FB=4, CONN=0 (AM modulation)
+  0xF8,
+  // op1: same envelope, MULT=1
+  0x01,
+  // KSL/TL: TL=0 (full-on; carrier; output level)
+  0x00,
+  // AR/DR: AR=15 (fastest), DR=4 (slow decay)
+  0xF4,
+  // SL/RR: SL=4, RR=8
+  0x48,
+  // WS: 0 = sine
+  0x00,
+  // fine-tune (engine-side)
+  0x00,
+};
+
+static constexpr uint8_t PATCH_MALLET[12] = {
+  0x01, 0x10, 0xF0, 0x80, 0x00,  // op0: very short attack/decay
+  0xF8,                          // FB/CONN: stereo + FB=4 + AM
+  0x01, 0x00, 0xF0, 0xC0, 0x00,  // op1: very short release
+  0x00,
+};
+
+static constexpr uint8_t PATCH_ORGAN[12] = {
+  0x01, 0x18, 0xF0, 0x00, 0x00,  // op0: sustained env
+  0xFE,                          // FB/CONN: stereo + FB=7 + CONN=0
+  0x01, 0x00, 0xF0, 0x00, 0x00,  // op1: sustained
+  0x00,
+};
+
+static constexpr uint8_t PATCH_GUITAR[12] = {
+  0x21, 0x10, 0xE2, 0x18, 0x00,  // op0: KSR on, MULT=1, fast attack
+  0xFA,                          // FB/CONN: stereo + FB=5 + AM
+  0x01, 0x00, 0xF1, 0x68, 0x00,  // op1: medium release
+  0x00,
+};
+
+static constexpr uint8_t PATCH_BRASS[12] = {
+  0x21, 0x18, 0x91, 0x18, 0x00,  // op0: medium attack
+  0xFC,                          // FB/CONN: stereo + FB=6 + AM
+  0x21, 0x00, 0x71, 0x18, 0x00,  // op1: with KSR
+  0x00,
+};
+
+static constexpr uint8_t PATCH_REED[12] = {
+  0x21, 0x10, 0x71, 0x18, 0x00,  // op0: slower attack than brass
+  0xF8,                          // FB/CONN: stereo + FB=4 + AM
+  0x21, 0x00, 0x91, 0x68, 0x00,  // op1: longer release
+  0x00,
+};
+
+static constexpr uint8_t PATCH_PAD[12] = {
+  0x21, 0x18, 0x71, 0x08, 0x01,  // op0: slow attack, half-sine WS
+  0xF6,                          // FB/CONN: stereo + FB=3 + AM
+  0x21, 0x00, 0x51, 0x08, 0x01,  // op1: half-sine WS
+  0x00,
+};
+
+static constexpr uint8_t PATCH_DRUM[12] = {
+  0x0F, 0x00, 0xFF, 0x0F, 0x07,  // op0: max MULT, noise WS=7
+  0xF0,                          // FB/CONN: stereo + FB=0 + AM
+  0x0F, 0x00, 0xFF, 0x0F, 0x07,  // op1: matched
+  0x00,
+};
+
+// GM program (0-127) -> patch family. Buckets per GM sec. standard:
+//   0-7   piano       -> PATCH_PIANO
+//   8-15  chrom perc  -> PATCH_MALLET
+//   16-23 organ       -> PATCH_ORGAN
+//   24-31 guitar      -> PATCH_GUITAR
+//   32-39 bass        -> PATCH_GUITAR (close enough on FM)
+//   40-47 strings     -> PATCH_PAD (sustained string sound)
+//   48-55 ensemble    -> PATCH_PAD
+//   56-63 brass       -> PATCH_BRASS
+//   64-71 reed        -> PATCH_REED
+//   72-79 pipe        -> PATCH_REED
+//   80-87 synth lead  -> PATCH_GUITAR
+//   88-95 synth pad   -> PATCH_PAD
+//   96-103 fx pad     -> PATCH_PAD
+//   104-111 ethnic    -> PATCH_GUITAR
+//   112-119 perc      -> PATCH_MALLET
+//   120-127 sfx       -> PATCH_PIANO (bell-like for sfx hits)
+static const uint8_t *_program_to_patch(int program)
+{
+  if (program < 0 || program > 127) return PATCH_PIANO;
+  const int bucket = program / 8;
+  switch (bucket)
+  {
+    case 0:  return PATCH_PIANO;
+    case 1:  return PATCH_MALLET;
+    case 2:  return PATCH_ORGAN;
+    case 3:  return PATCH_GUITAR;
+    case 4:  return PATCH_GUITAR;
+    case 5:  return PATCH_PAD;
+    case 6:  return PATCH_PAD;
+    case 7:  return PATCH_BRASS;
+    case 8:  return PATCH_REED;
+    case 9:  return PATCH_REED;
+    case 10: return PATCH_GUITAR;
+    case 11: return PATCH_PAD;
+    case 12: return PATCH_PAD;
+    case 13: return PATCH_GUITAR;
+    case 14: return PATCH_MALLET;
+    case 15: return PATCH_PIANO;
+    default: return PATCH_PIANO;
+  }
+}
+
+// ============================================================================
+// MIDI note -> OPL3 (fnum, block) lookup
+// ============================================================================
+//
+// Canonical AdLib formula: for OPL3 master clock 14.318 MHz, the
+// effective sample rate for F-num computation is 14.318e6 / 288 =
+// 49716 Hz. Frequency = (fnum * 49716) / (2^(20 - block)).
+//
+// Inverse: fnum = freq_hz * (2^(20 - block)) / 49716.
+//
+// We precompute a 12-entry table for one octave at a reference block,
+// then derive (fnum, block) for any MIDI note via octave count.
+
+// Base F-num table at block=4 (octave reference), 12 semitones starting
+// from C. Computed: freq = 440 * 2^((midi_note - 69) / 12) where
+// midi_note = 60 (C4) at block=4 yields fnum ~ 363.
+static const uint16_t _base_fnum_table[12] = {
+  363, 385, 408, 432, 458, 485,
+  514, 544, 577, 611, 647, 686,
+};
+
+void MidiBackendOpl3::_midi_note_to_fnum_block(int note,
+                                               std::uint16_t *out_fnum,
+                                               std::uint8_t *out_block)
+{
+  // Clamp to MIDI range (0-127); engine-side defensive (well-formed
+  // SMF should never send out-of-range notes).
+  if (note < 0)   note = 0;
+  if (note > 127) note = 127;
+
+  // MIDI note 60 = C4; reference block = 4.
+  // Octave delta = (note - 60) / 12; block = 4 + octave_delta.
+  // Semitone within octave = (note - 60) mod 12 (0-11).
+  //
+  // C++ modulo for negative: use a positive offset bias.
+  const int rel = note - 60;  // -60 to 67
+  // Floor-division across negative range:
+  int octave_delta;
+  int semitone;
+  if (rel >= 0)
+  {
+    octave_delta = rel / 12;
+    semitone     = rel % 12;
+  }
+  else
+  {
+    // For rel < 0: round toward -infinity.
+    octave_delta = -((-rel + 11) / 12);
+    semitone     = ((rel % 12) + 12) % 12;
+  }
+
+  int block = 4 + octave_delta;
+  if (block < 0) block = 0;
+  if (block > 7) block = 7;
+
+  *out_fnum  = _base_fnum_table[semitone];
+  *out_block = (std::uint8_t)block;
+}
+
+// ============================================================================
+// MidiBackendOpl3 implementation
+// ============================================================================
+
+MidiBackendOpl3::MidiBackendOpl3()
+{
+  LOG_INFO("opl3 backend probing for OPL3 chip (Adlib timer-1 sequence)...");
+
+  if (!SDL_DOSOpl3Detect())
+  {
+    _ready = false;
+    LOG_INFO("opl3 backend probe failed -- no OPL chip detected (timer "
+             "sequence did not produce expected status). Engine falls "
+             "back to organya per design's auto-detect-chain semantics. "
+             "This is expected on systems without SB16/Vibra16S/AdLib-"
+             "compatible OPL3 hardware.");
+    return;
+  }
+
+  // Detected. Initialize: enable OPL3 mode (4-op disabled = 18x2-op
+  // layout per sec. D.5), silence all voices.
+  SDL_DOSOpl3InitChip();
+  _ready = true;
+
+  // Initialize per-MIDI-channel state to GM defaults.
+  for (int ch = 0; ch < MIDI_CHANNELS; ++ch)
+  {
+    _channel_program[ch]    = 0;    // Acoustic Grand Piano
+    _channel_volume[ch]     = 100;  // GM default ("medium-loud")
+    _channel_expression[ch] = 127;  // GM default (full-on)
+  }
+
+  LOG_INFO("opl3 backend ready (OPL3 detected via Adlib timer-1; "
+           "InitChip applied 18 x 2-op layout; voice allocator armed). "
+           "Patch bank: 8-patch placeholder covering GM family "
+           "categories (piano/mallet/organ/guitar/strings/brass/reed/"
+           "pad). Aesthetic note: this placeholder will sound generic-"
+           "FM on real OPL3; Phase 10.5 may swap in a fuller community "
+           "bank via runtime data/opl3-patches.dat loader when "
+           "operator listening identifies tracks needing better timbre.");
+}
+
+MidiBackendOpl3::~MidiBackendOpl3()
+{
+  if (_ready)
+  {
+    // Silence all voices + restore Adlib OPL2 mode for any subsequent
+    // process that might use the chip. Idempotent.
+    for (int v = 0; v < VOICES; ++v)
+    {
+      if (_voices[v].active)
+        SDL_DOSOpl3VoiceNoteOff(v);
+    }
+    SDL_DOSOpl3Shutdown();
+    LOG_INFO("opl3 backend shutdown (all voices silenced; OPL2 mode "
+             "restored)");
+  }
+}
+
+int MidiBackendOpl3::_allocate_voice()
+{
+  ++_voice_alloc_count;
+
+  // Prefer free voice (active=false); among free, pick lowest ID for
+  // determinism. If all 18 are active, LRU-steal: voice with the
+  // smallest last_used.
+  int free_voice = -1;
+  int lru_voice  = 0;
+  for (int v = 0; v < VOICES; ++v)
+  {
+    if (!_voices[v].active)
+    {
+      if (free_voice < 0) free_voice = v;
+    }
+    if (_voices[v].last_used < _voices[lru_voice].last_used)
+    {
+      lru_voice = v;
+    }
+  }
+
+  const int chosen = (free_voice >= 0) ? free_voice : lru_voice;
+  if (free_voice < 0)
+  {
+    // LRU steal: silence the prior occupant before reassigning.
+    SDL_DOSOpl3VoiceNoteOff(chosen);
+  }
+  _voices[chosen].last_used = _voice_alloc_count;
+  return chosen;
+}
+
+int MidiBackendOpl3::_find_voice(int channel, int note)
+{
+  for (int v = 0; v < VOICES; ++v)
+  {
+    if (_voices[v].active &&
+        _voices[v].midi_channel == (std::uint8_t)channel &&
+        _voices[v].midi_note    == (std::uint8_t)note)
+    {
+      return v;
+    }
+  }
+  return -1;
+}
+
+void MidiBackendOpl3::_apply_patch(int voice_id, int channel, int program)
+{
+  const uint8_t *patch;
+  if (channel == DRUM_CHANNEL)
+  {
+    patch = PATCH_DRUM;
+  }
+  else
+  {
+    patch = _program_to_patch(program);
+  }
+  SDL_DOSOpl3VoiceWritePatch(voice_id, patch);
+}
+
+void MidiBackendOpl3::_silence_voice(int voice_id)
+{
+  if (voice_id < 0 || voice_id >= VOICES) return;
+  SDL_DOSOpl3VoiceNoteOff(voice_id);
+  _voices[voice_id].active = false;
+}
+
+void MidiBackendOpl3::note_on(int channel, int note, int velocity)
+{
+  if (!_ready) return;
+
+  // GM convention: note-on with velocity=0 is equivalent to note-off.
+  // SMF parser already converts those into NOTE_OFF events, but
+  // defensive check stays here in case the abstract dispatch is ever
+  // called from a different parser path.
+  if (velocity == 0)
+  {
+    note_off(channel, note, 0);
+    return;
+  }
+
+  // Allocate a voice; could LRU-steal a busy one if all 18 are active.
+  const int voice = _allocate_voice();
+  _voices[voice].active       = true;
+  _voices[voice].midi_channel = (std::uint8_t)(channel & 0x0F);
+  _voices[voice].midi_note    = (std::uint8_t)(note    & 0x7F);
+
+  // Apply the patch for this MIDI channel's current program (or drum
+  // patch on drum channel).
+  _apply_patch(voice, channel, _channel_program[channel & 0x0F]);
+
+  // Convert MIDI note to OPL3 (fnum, block) and trigger note-on.
+  std::uint16_t fnum  = 0;
+  std::uint8_t  block = 4;
+  _midi_note_to_fnum_block(note, &fnum, &block);
+  SDL_DOSOpl3VoiceNoteOn(voice, fnum, block);
+
+  // Velocity, channel volume, and channel expression scale total level
+  // (TL) on the carrier operator. Per OPL3 register layout: KSL/TL
+  // byte at op1 0x40 = patch[7]. We don't write it here in slot 0103
+  // (the patch's pre-set TL is used); a future slot can dynamically
+  // adjust TL based on velocity * volume * expression for proper
+  // dynamics. For now, the placeholder bank's pre-baked TL gives a
+  // flat-but-audible response.
+}
+
+void MidiBackendOpl3::note_off(int channel, int note, int velocity)
+{
+  (void)velocity;  // OPL3 note-off doesn't honor velocity (release env
+                   // is per-patch); MIDI velocity field unused here.
+  if (!_ready) return;
+
+  const int voice = _find_voice(channel, note);
+  if (voice >= 0)
+  {
+    _silence_voice(voice);
+  }
+  // If no matching voice: idempotent silent no-op. Common on SMFs
+  // where note-off velocity is sent for a note already silenced via
+  // LRU steal or All-Notes-Off CC.
+}
+
+void MidiBackendOpl3::control_change(int channel, int controller, int value)
+{
+  if (!_ready) return;
+  // Channel-level CC handling. Most CCs are per-channel state
+  // (volume, expression, pan); some affect all currently-active
+  // voices on that channel (sustain pedal, all-notes-off).
+  switch (controller)
+  {
+    case 7:    // Channel Volume MSB
+      _channel_volume[channel & 0x0F] = (std::uint8_t)(value & 0x7F);
+      break;
+    case 11:   // Expression MSB
+      _channel_expression[channel & 0x0F] = (std::uint8_t)(value & 0x7F);
+      break;
+    case 120:  // All Sound Off -- immediate silence for this channel
+    case 123:  // All Notes Off -- release-env-honoring (we collapse to
+               // immediate silence on OPL3 since per-voice envelopes
+               // handle release timing)
+    {
+      for (int v = 0; v < VOICES; ++v)
+      {
+        if (_voices[v].active &&
+            _voices[v].midi_channel == (std::uint8_t)(channel & 0x0F))
+        {
+          _silence_voice(v);
+        }
+      }
+      break;
+    }
+    // Other CCs (modulation, pan, sustain pedal, etc.) ignored for
+    // slot 0103. Phase 10.5 / Stage 4.5 may add more dispatch.
+    default:
+      break;
+  }
+}
+
+void MidiBackendOpl3::program_change(int channel, int program)
+{
+  if (!_ready) return;
+  _channel_program[channel & 0x0F] = (std::uint8_t)(program & 0x7F);
+  // Notes already playing on this channel keep their original patch
+  // (per GM spec: program change affects subsequent notes only,
+  // doesn't retroactively re-voice held notes).
+}
+
+void MidiBackendOpl3::on_song_start()
+{
+  if (!_ready) return;
+  // Silence all voices for clean state.
+  for (int v = 0; v < VOICES; ++v)
+  {
+    if (_voices[v].active)
+    {
+      SDL_DOSOpl3VoiceNoteOff(v);
+      _voices[v].active = false;
+    }
+  }
+  // Reset per-channel state to GM defaults.
+  for (int ch = 0; ch < MIDI_CHANNELS; ++ch)
+  {
+    _channel_program[ch]    = 0;
+    _channel_volume[ch]     = 100;
+    _channel_expression[ch] = 127;
+  }
+  LOG_INFO("opl3 backend: on_song_start");
+}
+
+void MidiBackendOpl3::on_song_stop()
+{
+  if (!_ready) return;
+  for (int v = 0; v < VOICES; ++v)
+  {
+    if (_voices[v].active)
+    {
+      SDL_DOSOpl3VoiceNoteOff(v);
+      _voices[v].active = false;
+    }
+  }
+  LOG_INFO("opl3 backend: on_song_stop");
+}
+
+}  // namespace Sound
+}  // namespace NXE
