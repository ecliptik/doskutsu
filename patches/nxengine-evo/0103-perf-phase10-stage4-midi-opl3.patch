@@ -0,0 +1,130 @@
+/* Cave Story port -- Phase 10 Stage 4 (slot 0103). MidiBackendOpl3:
+ * concrete MidiBackend implementation that routes MIDI events to OPL3
+ * (YMF262) FM synthesis via SDL/0037+'s OPL3 helpers (SDL_DOSOpl3*
+ * family). 18 x 2-op voice allocator with round-robin LRU steal; small
+ * inline GM patch bank; per-MIDI-channel program state.
+ *
+ * Selected when SDL_HINT_DOSKUTSU_AUDIO_BACKEND=opl3. SoundManager::init()
+ * probes OPL3 presence via SDL_DOSOpl3Detect (timer-1 sequence per
+ * AdLib-spec); on success, calls SDL_DOSOpl3InitChip (enables 18x2-op
+ * mode, silences all voices) + installs MidiBackendOpl3 on the singleton
+ * MidiScheduler. On probe failure, engine falls back to organya -- same
+ * graceful-degradation path as Stage 3's MidiBackendWaveBlaster.
+ *
+ * Threading-zero invariant per CLAUDE.md: dispatch synchronous on main
+ * loop. Per-event cost = 12 register writes for note-on (patch +
+ * fnum/block) ~ 75-100 us on PODP83 ISA bus. At 30 fps tick rate with
+ * Cave Story's typical ~5-10 events/frame: well under 1 ms / frame.
+ *
+ * Patch bank: small inline set covering GM family categories
+ * (piano, strings, brass, organ, lead, pad, etc.) -- community-sourced
+ * per design sec. D.8 + plan doc sec. 5 + team-lead 2026-05-06 dispatch.
+ * See MidiBackendOpl3.cpp for the inline bank + sourcing attribution.
+ * Stage 4.5 / Phase 10.5 follow-up may swap in a fuller bank (175
+ * patches = 128 melodic + 47 drum) via runtime data/opl3-patches.dat
+ * loader if the inline placeholder's aesthetics need improving on
+ * real-HW operator listening.
+ *
+ * Stage 5 wires up auto-detect chain at SoundManager::init: WB -> OPL3
+ * -> Organya. Slot 0103 only handles env-driven `opl3` selection.
+ */
+
+#ifndef _MIDI_BACKEND_OPL3_H
+#define _MIDI_BACKEND_OPL3_H
+
+#include "MidiScheduler.h"
+
+#include <cstdint>
+
+namespace NXE
+{
+namespace Sound
+{
+
+class MidiBackendOpl3 : public MidiBackend
+{
+public:
+  MidiBackendOpl3();
+  ~MidiBackendOpl3() override;
+
+  // True if SDL_DOSOpl3Detect succeeded in the constructor; backend is
+  // bound on success, fallback engaged on failure. Polled by
+  // SoundManager::init() to decide install-or-rollback.
+  bool isReady() const { return _ready; }
+
+  void note_on(int channel, int note, int velocity)               override;
+  void note_off(int channel, int note, int velocity)              override;
+  void control_change(int channel, int controller, int value)     override;
+  void program_change(int channel, int program)                   override;
+  void on_song_start()                                            override;
+  void on_song_stop()                                             override;
+
+private:
+  // Total OPL3 voices in 18x2-op mode (per design sec. D.5 + SDL/0037+
+  // SDL_DOSOpl3InitChip layout).
+  static constexpr int VOICES = 18;
+
+  // 16 MIDI channels (4-bit channel field per MIDI spec).
+  static constexpr int MIDI_CHANNELS = 16;
+
+  // Drum channel = MIDI channel 9 (0-indexed; per GM spec).
+  static constexpr int DRUM_CHANNEL = 9;
+
+  // Per-voice state. Used for note->voice tracking and LRU steal.
+  struct Voice
+  {
+    bool        active        = false;  // currently playing a note
+    std::uint8_t midi_channel = 0;      // 0-15
+    std::uint8_t midi_note    = 0;      // 0-127
+    std::uint64_t last_used   = 0;      // monotonic counter; LRU steal target
+  };
+
+  // Find a free voice or LRU-steal an active one. Returns voice ID 0-17.
+  // Updates last_used on the returned voice. Caller is responsible for
+  // setting active + midi_channel + midi_note + writing the patch +
+  // calling SDL_DOSOpl3VoiceNoteOn.
+  int  _allocate_voice();
+
+  // Reverse lookup: find the voice currently playing (channel, note).
+  // Returns -1 if no match (idempotent note-off; SMF arrangements
+  // sometimes send redundant note-offs).
+  int  _find_voice(int channel, int note);
+
+  // Apply the GM patch for `program` on `channel` to voice `voice_id`.
+  // Drum channel (channel 9) ignores program and uses a single drum
+  // patch; melody channels pick from the inline melody bank by program
+  // family (8-program groupings per GM spec).
+  void _apply_patch(int voice_id, int channel, int program);
+
+  // Convert MIDI note (0-127) to OPL3 (fnum, block) tuple. Uses
+  // precomputed 12-entry octave-base table; block = octave count
+  // clamped to 0-7. See impl for the canonical AdLib formula
+  // derivation.
+  void _midi_note_to_fnum_block(int note, std::uint16_t *out_fnum,
+                                std::uint8_t *out_block);
+
+  // Issue OPL3 silence for a single voice (clear key-on bit).
+  void _silence_voice(int voice_id);
+
+  bool          _ready             = false;
+  Voice         _voices[VOICES];
+  std::uint64_t _voice_alloc_count = 0;  // monotonic; increments on
+                                         // each allocate; voice's
+                                         // last_used = this at time
+                                         // of allocation
+  // Per-MIDI-channel current GM program (0-127). Default = 0 (Acoustic
+  // Grand Piano) per GM spec. Updated on program_change events.
+  std::uint8_t  _channel_program[MIDI_CHANNELS] = {0};
+  // Per-MIDI-channel volume (controller 7) -- applied at note-on as
+  // velocity scaler. Default 100 per GM spec ("medium-loud"). Stored
+  // as 0-127 from the CC value.
+  std::uint8_t  _channel_volume[MIDI_CHANNELS] = {0};
+  // Per-MIDI-channel expression (controller 11) -- secondary scaler.
+  // Default 127 (full-on) per GM spec.
+  std::uint8_t  _channel_expression[MIDI_CHANNELS] = {0};
+};
+
+}  // namespace Sound
+}  // namespace NXE
+
+#endif  // _MIDI_BACKEND_OPL3_H
