@@ -6740,11 +6754,139 @@ static inline bool _blit_indexed_mirrored(SDL_Surface *dst, SDL_Surface *src,
 //   called or SDL_RenderPresent fires. Either way the slow-path output
 //   composites on top of fast-path output exactly as it would if both
 //   went through the renderer.
+// DOS-PORT (patch 0297): clip a logical-space destination rect to the
+// 320x240 logical screen, carrying its source rect, then translate it
+// into a centred box at (ox,oy). Returns false when the rect lies wholly
+// outside the logical screen and nothing should be drawn.
+//
+// Every hand-rolled primitive below clamps against the destination
+// SURFACE, not against the logical screen -- correct while the surface IS
+// the logical screen, wrong once it is larger, because a sprite hanging
+// off the logical right or bottom edge would then spill into the cleared
+// margin instead of being cut. So the clip has to happen HERE, before the
+// translate, and the source rect has to travel with it or the surviving
+// pixels come from the wrong part of the sheet.
+//
+// This is patch 0296's drawTileFast logic lifted into one place. It was
+// open-coded there for a single caller; 0297 needs it at eight sites, and
+// eight hand-written copies of a clip-then-translate is how the margin
+// eventually gets a stray tile in it.
+//
+// ox/oy are zero whenever centring is inactive, which makes this an
+// identity transform plus a bounds check on every card that offers
+// 320x240 -- the configuration every banked benchmark cell was measured
+// in. `srcrect` may be null for primitives that have no source (fills,
+// lines, clears).
+static inline bool _dos_clip_xlate(SDL_Rect *srcrect, SDL_Rect &dstrect,
+                                   int ox, int oy)
+{
+  int cx = dstrect.x, cy = dstrect.y;
+  int cw = dstrect.w, ch = dstrect.h;
+  int sx = srcrect ? srcrect->x : 0;
+  int sy = srcrect ? srcrect->y : 0;
+
+  if (cx < 0) { cw += cx; sx -= cx; cx = 0; }
+  if (cy < 0) { ch += cy; sy -= cy; cy = 0; }
+  if (cx + cw > 320)  cw = 320  - cx;
+  if (cy + ch > 240) ch = 240 - cy;
+  if (cw <= 0 || ch <= 0) return false;
+
+  if (srcrect)
+  {
+    srcrect->x = sx;
+    srcrect->y = sy;
+    srcrect->w = cw;
+    srcrect->h = ch;
+  }
+  dstrect.x = cx + ox;
+  dstrect.y = cy + oy;
+  dstrect.w = cw;
+  dstrect.h = ch;
+  return true;
+}
+
+// DOS-PORT (patch 0297): mirrored sibling of _dos_clip_xlate. Under a
+// column-reversed blit destination column i reads source column
+// (w-1-i), so a clip off the destination LEFT edge must remove source
+// columns from the RIGHT (srcrect.x unchanged, width shrinks) and a clip
+// off the destination RIGHT edge must remove them from the LEFT
+// (srcrect.x advances). Getting this backwards does not crash and does
+// not corrupt the margin -- it silently draws the wrong slice of the
+// sprite sheet, which is exactly the kind of defect that survives a
+// smoke test, so it is kept separate from the unmirrored helper rather
+// than folded in behind a flag.
+//
+// Rows are not mirrored, so the vertical half matches _dos_clip_xlate.
+static inline bool _dos_clip_xlate_mirrored(SDL_Rect &srcrect, SDL_Rect &dstrect,
+                                            int ox, int oy)
+{
+  int cx = dstrect.x, cy = dstrect.y;
+  int cw = dstrect.w, ch = dstrect.h;
+  int sx = srcrect.x, sy = srcrect.y;
+
+  if (cx < 0) { cw += cx; cx = 0; }                    // left  -> src right
+  if (cy < 0) { ch += cy; sy -= cy; cy = 0; }
+  if (cx + cw > 320)
+  {
+    const int cut = (cx + cw) - 320;          // right -> src left
+    cw -= cut;
+    sx += cut;
+  }
+  if (cy + ch > 240) ch = 240 - cy;
+  if (cw <= 0 || ch <= 0) return false;
+
+  srcrect.x = sx;
+  srcrect.y = sy;
+  srcrect.w = cw;
+  srcrect.h = ch;
+  dstrect.x = cx + ox;
+  dstrect.y = cy + oy;
+  dstrect.w = cw;
+  dstrect.h = ch;
+  return true;
+}
+
+// DOS-PORT (patch 0297): shared surface gate for the hand-rolled paths.
+// Pre-0297 every one of these sites demanded a surface of exactly
+// 320x240 and bailed to the SDL software renderer otherwise, which is
+// why the ATI Mach64 -- whose smallest VBE mode exceeds the logical
+// screen -- ran 100% of its drawcalls through SDL_Blit_Slow and rendered
+// colour-modulated text through a path SDL has no indexed blitter for.
+// The requirement was never "exactly the logical screen"; it was "at
+// least the logical screen, so a 1:1 blit fits". Formats still must
+// match -- _blit_indexed assumes one byte per pixel and _blit_rgb565 two.
+//
+// THREE outcomes, and the middle one is the whole reason this is a
+// function rather than a comparison:
+//
+//   exactly 320x240        -> accept, offsets are zero. The literal
+//                             pre-patch path, which is what every banked
+//                             benchmark cell was measured on.
+//   larger + centring ON   -> accept, caller translates by the offsets.
+//                             The new behaviour, Mach64 only in this fleet.
+//   larger + centring OFF  -> REJECT, exactly as before 0297.
+//
+// That last case is not hypothetical: SDL_HINT_DOSKUTSU_CENTER_OVERSIZED=0
+// leaves the surface oversized while `_dos_center_active` stays false, and
+// the killswitch is meant to restore the scaled logical-presentation path.
+// Accepting it here would instead draw the game 1:1 in the top-left corner
+// -- a different picture from either arm, which would quietly poison the
+// A/B the killswitch exists to provide.
+static inline bool _dos_surface_fits(const SDL_Surface *win_surface,
+                                     bool center_active)
+{
+  if (!win_surface) return false;
+  if (win_surface->w == 320 && win_surface->h == 240) return true;
+  if (!center_active) return false;
+  return win_surface->w >= 320 && win_surface->h >= 240;
+}
+
