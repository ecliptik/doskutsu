                                   bool &renderer_queue_dirty,
                                   Surface *src, int srcx, int srcy,
-                                  const SDL_Rect &srcrect, const SDL_Rect &dstrect)
+                                  const SDL_Rect &srcrect, const SDL_Rect &dstrect,
+                                  int ox, int oy, bool center_active)
 {
   // Cheap precondition gates first.
   if (src->alpha != 255)
@@ -6775,12 +6917,10 @@ static inline bool _try_fast_blit(SDL_Renderer *renderer,
   if (src_surface->format != win_surface->format)
     return false;
 
-  // Logical-presentation gate: with letterboxing, dst coords need
-  // scaling/translating from 320x240 logical to the window surface
-  // dimensions. The simple "if window is 320x240 the math is identity"
-  // check covers the Cirrus + PIN_WINDOW_TO_NATIVE path. Mach64 with
-  // 640x480 window falls through here.
-  if (win_surface->w != 320 || win_surface->h != 240)
+  // Logical-presentation gate. Pre-0297 this demanded exactly 320x240 and
+  // sent everything else to the renderer; 0297 accepts a larger surface
+  // when centring is live and places the blit inside the centred box.
+  if (!_dos_surface_fits(win_surface, center_active))
     return false;
 
   // DOS-PORT (patch 0051, Phase 9 wave 8): drain queued slow-path
@@ -6818,13 +6958,27 @@ static inline bool _try_fast_blit(SDL_Renderer *renderer,
   //
   // DOS-PORT (patch 0073, Phase 9 wave 16 Lever 3): format dispatch.
   // INDEX8<->INDEX8 takes the byte-per-pixel sibling primitive.
+  //
+  // DOS-PORT (patch 0297): clip to the logical box and translate into the
+  // centred box before handing the rects to the primitive. Identity plus
+  // a bounds check when the surface is exactly 320x240. A rect wholly
+  // outside the logical screen returns TRUE, not false: the primitives
+  // already early-return on a zero-pixel clamp and report success, so the
+  // caller counts it as a taken fastpath and draws nothing. Returning
+  // false instead would push those calls onto the slow path and silently
+  // change the fastpath/slowpath counters that this patch is measured by.
+  SDL_Rect _s = srcrect;
+  SDL_Rect _d = dstrect;
+  if (!_dos_clip_xlate(&_s, _d, ox, oy))
+    return true;
+
   if (win_surface->format == SDL_PIXELFORMAT_INDEX8)
   {
-    return _blit_indexed(win_surface, src_surface, srcrect, dstrect,
+    return _blit_indexed(win_surface, src_surface, _s, _d,
                          (Uint8)src->colorkey(), src->hasColorkey(),
                          src->spanTable());
   }
-  return _blit_rgb565(win_surface, src_surface, srcrect, dstrect,
+  return _blit_rgb565(win_surface, src_surface, _s, _d,
                       (Uint16)src->colorkey(), src->hasColorkey());
 }
 
@@ -6840,7 +6994,8 @@ static inline bool _try_fast_blit_mirrored(SDL_Renderer *renderer,
                                            SDL_Surface *win_surface,
                                            bool &renderer_queue_dirty,
                                            Surface *src,
-                                           const SDL_Rect &srcrect, const SDL_Rect &dstrect)
+                                           const SDL_Rect &srcrect, const SDL_Rect &dstrect,
+                                           int ox, int oy, bool center_active)
 {
   if (src->alpha != 255)
     return false;
@@ -6861,7 +7016,7 @@ static inline bool _try_fast_blit_mirrored(SDL_Renderer *renderer,
   if (src_surface->format != win_surface->format)
     return false;
 
-  if (win_surface->w != 320 || win_surface->h != 240)
+  if (!_dos_surface_fits(win_surface, center_active))
     return false;
 
   // Drain queued slow-path commands so our overlay lands AFTER them --
@@ -6872,12 +7027,23 @@ static inline bool _try_fast_blit_mirrored(SDL_Renderer *renderer,
     renderer_queue_dirty = false;
   }
 
+  // DOS-PORT (patch 0297): mirrored clip-then-translate. Uses the
+  // mirrored helper, not the plain one -- a column-reversed blit maps a
+  // destination-left clip onto the source RIGHT edge. See the helper's
+  // comment; the plain version here would draw the wrong slice of the
+  // sheet without any other visible symptom. Wholly-outside returns true
