+  SDL_Rect _s = srcrect;
+  SDL_Rect _d = dstrect;
+  if (!_dos_clip_xlate_mirrored(_s, _d, ox, oy))
+    return true;
+
   if (win_surface->format == SDL_PIXELFORMAT_INDEX8)
   {
-    return _blit_indexed_mirrored(win_surface, src_surface, srcrect, dstrect,
+    return _blit_indexed_mirrored(win_surface, src_surface, _s, _d,
                                   (Uint8)src->colorkey(), src->hasColorkey());
   }
-  return _blit_rgb565_mirrored(win_surface, src_surface, srcrect, dstrect,
+  return _blit_rgb565_mirrored(win_surface, src_surface, _s, _d,
                                (Uint16)src->colorkey(), src->hasColorkey());
 }
 
