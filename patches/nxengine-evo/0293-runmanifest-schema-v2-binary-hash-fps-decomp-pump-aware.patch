diff --git a/src/graphics/Renderer.cpp b/src/graphics/Renderer.cpp
index b82ec001..17d6018e 100644
--- a/src/graphics/Renderer.cpp
+++ b/src/graphics/Renderer.cpp
@@ -8,6 +8,25 @@ unsigned long g_flip_count = 0;
 // patch 0290: wall-clock of the first flip, so the framerate window excludes
 // boot, cache load and the banner hold. One time() call for the whole run.
 std::time_t g_first_flip_time = 0;
+
+// patch 0293: whole-run inter_flip sample capture for the RUNMANIFEST fps_p50/
+// fps_p95 percentiles. The flip-probe already computes _inter_flip_ms every 10th
+// flip (ungated, ships default-on) and the campaign's awk parsed exactly those
+// log lines -- we just RETAIN the value into a bounded buffer so exit can sort
+// it. No new per-frame work, and NOT per-frame logging (append every 10th flip;
+// insertion sort happens once, after the reel). The buffer is lazily heap-alloc'd
+// so it never lands on .bss -- patch 0168-v2's lesson that a static array there
+// can displace layout and perturb TAS-replay determinism; a pointer is layout-
+// neutral, and this buffer is write-during-run / read-at-exit only and never
+// feeds game logic. g_timebase_was_active latches whether the SDL/0122 MODE-2
+// pump timebase was ever active, because SDL_DOSOplTimerTimebaseActive() is a
+// LIVE ch0-ownership query that reads false at emit (post SDL_Quit, pump stopped)
+// -- so validity of a pump cell's percentiles must be latched during the run.
+#define _IF_SAMPLE_CAP 1024   // every-10th-flip; 1024 covers ~10240 flips (reel ~5100)
+unsigned long *g_if_sample_ms      = nullptr;
+int            g_if_sample_n        = 0;
+int            g_if_sample_interval = 10;
+int            g_timebase_was_active = 0;
 // graphics routines
 #include "../ResourceManager.h"
 #include "../config.h"
@@ -30,6 +49,9 @@ std::time_t g_first_flip_time = 0;
 
 #include <SDL3/SDL.h>
 #include <SDL3_image/SDL_image.h>
+#ifdef NXE_DOS
+#  include <SDL3/SDL_dosopltimer.h>  // patch 0293: SDL_DOSOplTimerTimebaseActive (SDL/0122)
+#endif
 #include <climits>
 #include <cstdint>
 #include <cstdio>
@@ -5686,6 +5708,20 @@ void Renderer::flip()
     LOG_INFO("flip-probe: flip #{} ok={} present={}ms inter_flip_ms={} drawcalls-since-flip={} drawcalls-total={} fail-total={} null-skips-total={}",
              _flip_total, ok, (long long)_present_ms, (long long)_inter_flip_ms,
              _drawcalls_since_flip, _drawcalls_total, _flip_failed, _null_tex_total);
+
+    // patch 0293: retain the sample the probe just computed, for the RUNMANIFEST
+    // fps_p50/p95 percentiles (sorted once at exit). Lazily heap-alloc the buffer
+    // (0168-v2 .bss-layout / TAS-determinism lesson: keep it off .bss).
+    if (!g_if_sample_ms)
+      g_if_sample_ms =
+          (unsigned long *)std::malloc(sizeof(unsigned long) * _IF_SAMPLE_CAP);
+    if (g_if_sample_ms && g_if_sample_n < _IF_SAMPLE_CAP && _inter_flip_ms > 0)
+      g_if_sample_ms[g_if_sample_n++] = (unsigned long)_inter_flip_ms;
+#ifdef NXE_DOS
+    // Latch whether the SDL/0122 MODE-2 pump timebase was ever active -- read now
+    // (during the run) because the export reads false at emit once the pump stops.
+    g_timebase_was_active |= (SDL_DOSOplTimerTimebaseActive() ? 1 : 0);
+#endif
   }
   _drawcalls_since_flip = 0;
   if (_flip_body_instr_on) _fb_diag_logs_ns = SDL_GetTicksNS() - _fb_diag_logs_t0;
