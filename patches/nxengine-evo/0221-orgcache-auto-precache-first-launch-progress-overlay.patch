@@ -1184,6 +1184,124 @@ void InitNewGame(bool with_intro)
   fade.set_full(FADE_OUT);
 }
 
+// ===========================================================================
+// ORGCACHE-AUTO (slot TBD): engine-side progress UI for the organya cold-render.
+// Two deliverables share ONE mechanism (the per-beat callback Organya invokes
+// from inside _org_render_song):
+//   A. AUTO-PRECACHE ON FIRST LAUNCH -- render ALL songs (R1) to the cache behind
+//      a one-time progress screen, then write the per-tier READY sentinel. ESC
+//      skips (R2): proceed into the game WITHOUT the sentinel; unrendered songs
+//      cold-render on demand behind overlay B; the batch resumes next launch.
+//   B. IN-GAME COLD-RENDER OVERLAY -- the SAME progress bar on ANY individual
+//      cache-miss cold-render, so a miss is never again a silent black screen.
+// Drawing uses the showLoadingScreen idiom (already proven pre-game): the
+// Renderer is up + font loaded (Renderer::init), so clearScreen + font.draw +
+// fillRect/drawRect + flip all work here, before intro/title. No new asset dep
+// (black + headline + two bars; a Loading.pbm backdrop is trivial future polish).
+extern "C" void org_set_render_beat_cb(int (*cb)(uint32_t, uint32_t));
+extern "C" bool org_autocache_active(void);
+extern "C" bool org_cache_sentinel_present(void);
+extern "C" bool org_cache_sentinel_write(void);
+extern "C" long org_precache_one(const char *org_path); // 0215: render+cache one org
+
+static bool        g_oc_batch_active  = false; // true during the first-launch batch (draw coarse N/M bar)
+static bool        g_oc_abort         = false; // R2: ESC pressed -> abort the batch (no sentinel)
+static int         g_oc_song_idx      = 0;     // 1-based current song (batch)
+static int         g_oc_song_total    = 0;     // song count excluding the [0] sentinel (batch)
+static std::string g_oc_song_name;             // current song basename
+static int         g_oc_last_inner_px = -1;    // flip-throttle: last drawn intra-song bar pixel
+
+// Readable basename for the coarse line: strip dir + ".org" extension.
+static std::string _oc_basename(const std::string &path)
+{
+  size_t slash = path.find_last_of("/\\");
+  std::string b = (slash == std::string::npos) ? path : path.substr(slash + 1);
+  size_t dot = b.find_last_of('.');
+  if (dot != std::string::npos)
+    b = b.substr(0, dot);
+  return b;
+}
+
+// R2 ESC-skip: drain pending SDL key events; ESC-down sets the batch abort flag.
+// Self-contained (the engine input system is not yet initialized at this pre-game
+// hook); SDL3 keycode lives directly on evt.key.key (see input.cpp).
+static void _oc_poll_esc(void)
+{
+  SDL_Event evt;
+  while (SDL_PollEvent(&evt))
+    if (evt.type == SDL_EVENT_KEY_DOWN && evt.key.key == SDLK_ESCAPE)
+      g_oc_abort = true;
+}
+
+static void _oc_draw_progress(uint32_t cur_beat, uint32_t total_beats)
+{
+  Renderer *r = Renderer::getInstance();
+  const int W = r->screenWidth;
+  const int H = r->screenHeight;
+  r->clearScreen(0, 0, 0);
+
+  const char *line1 = "Rendering music (one time)...";
+  r->font.draw((W - (int)r->font.getWidth(line1)) / 2, H / 2 - 30, line1, 0xFFFFFF, true);
+
+  const int bx0 = 40;
+  const int bx1 = W - 40;
+
+  // coarse "song N/M" bar -- batch mode only (single in-game renders have no N/M)
+  if (g_oc_batch_active && g_oc_song_total > 0)
+  {
+    char buf[80];
+    snprintf(buf, sizeof buf, "song %d/%d  %s", g_oc_song_idx, g_oc_song_total,
+             g_oc_song_name.c_str());
+    r->font.draw((W - (int)r->font.getWidth(buf)) / 2, H / 2 - 14, buf, 0xC0C0C0, true);
+    const int cy = H / 2 + 2;
+    r->drawRect(bx0, cy, bx1, cy + 6, 0x80, 0x80, 0x80);
+    const int span = bx1 - bx0 - 2;
+    const int fillw = (span * g_oc_song_idx) / g_oc_song_total;
+    if (fillw > 0)
+      r->fillRect(bx0 + 1, cy + 1, bx0 + 1 + fillw, cy + 5, 0x40, 0xFF, 0x40);
+  }
+
+  // intra-song bar -- driven by the per-beat callback
+  const int iy = H / 2 + 16;
+  r->drawRect(bx0, iy, bx1, iy + 6, 0x80, 0x80, 0x80);
+  if (total_beats > 0)
+  {
+    const int span  = bx1 - bx0 - 2;
+    const int fillw = (int)(((uint64_t)span * cur_beat) / total_beats);
+    if (fillw > 0)
+      r->fillRect(bx0 + 1, iy + 1, bx0 + 1 + fillw, iy + 5, 0x40, 0xC0, 0xFF);
+  }
+
+  r->flip();
+}
+
+// The per-beat callback Organya invokes from inside _org_render_song. Returns
+// nonzero to ABORT the render (R2 ESC-skip) -- ONLY during the first-launch batch
+// (g_oc_batch_active); in-game cold-renders (overlay B) always return 0 so ESC
+// stays the gameplay pause key, never a music-skip. Self-throttles the present:
+// only flips when the intra-song bar pixel advances (a cold render is hundreds of
+// beats -> ~one flip per bar pixel, not per beat). cur_beat dropping to 0 at the
+// start of a NEW render naturally differs from the prior high pixel -> auto-reset.
+static int _oc_progress_beat_cb(uint32_t cur_beat, uint32_t total_beats)
+{
+  if (g_oc_batch_active)
+  {
+    _oc_poll_esc();
+    if (g_oc_abort)
+      return 1; // abort now; _org_render_song discards the partial buffer
+  }
+  const int span = (Renderer::getInstance()->screenWidth - 80) - 2;
+  const int px   = (total_beats > 0)
+                       ? (int)(((uint64_t)span * cur_beat) / total_beats)
+                       : 0;
+  if (px != g_oc_last_inner_px)
+  {
+    g_oc_last_inner_px = px;
+    _oc_draw_progress(cur_beat, total_beats);
+  }
+  return 0;
+}
+
 int main(int argc, char *argv[])
 {
   // Patch 0138 (wave 43 RUNMANIFEST): capture boot wall-clock at the very
@@ -1544,6 +1662,90 @@ int main(int argc, char *argv[])
     }
   }
 
+  // ORGCACHE-AUTO (slot TBD): auto-precache-on-first-launch + in-game cold-render
+  // progress overlay. Organya backend ONLY (OPL3/WB dispatch to their chip in
+  // real-time and never cold-render). Default-ON killswitch
+  // SDL_HINT_DOSKUTSU_ORG_AUTOCACHE. Placed AFTER the headless host-batch block
+  // above so that batch renders with no beat cb registered = byte-identical. The
+  // Renderer is already up (init ~L1475, showLoadingScreen ~L1487) and the backend
+  // enum + tier are resolved (SoundManager::init above), so the progress screen
+  // can draw here, before any intro/title.
+  if (NXE::Diag::g_p10_audio_backend_active == NXE::Diag::AudioBackend::organya
+      && org_autocache_active())
+  {
+    // Deliverable B: register the overlay cb persistently so ANY in-game
+    // cold-render (the 0206 entry render / the 0209 deferred-cache drain on a
+    // cache miss) draws a moving progress bar instead of a silent black screen.
+    g_oc_batch_active  = false;
+    g_oc_abort         = false;
+    g_oc_last_inner_px = -1;
+    org_set_render_beat_cb(_oc_progress_beat_cb);
+
+    // Deliverable A (R1 = ALL songs at first launch): if this binary+tier's cache
+    // is not marked complete (no READY sentinel), render every song to the cache
+    // behind the progress screen. R2 = ESC skips: _oc_progress_beat_cb sets
+    // g_oc_abort on ESC and aborts the in-flight render (partial discarded), the
+    // loop stops, and NO sentinel is written -> the remaining songs cold-render on
+    // demand behind overlay B and the batch resumes on the next launch. The
+    // sentinel is written ONLY on a full, unaborted pass.
+    if (::AUDIO_CHANNELS != 1)
+    {
+      // Mono-only, mirroring SoundManager::precacheAllOrgs' stereo guard: the
+      // pre-render path (_org_render_song) downmixes to mono, so rendering a
+      // STEREO tier would write mono content tagged channels=2 + falsely mark it
+      // complete. Skip the batch (no sentinel) until the stereo render follow-on
+      // lands; overlay B stays armed. The 486 production tier is 11025 mono.
+      LOG_INFO("organya auto-precache: stereo tier (channels={}) -- batch skipped "
+               "(pre-render path is mono-only; HQ stereo cache is a follow-on); "
+               "overlay armed, no sentinel written.", (unsigned)::AUDIO_CHANNELS);
+    }
+    else if (!org_cache_sentinel_present())
+    {
+      LOG_INFO("organya auto-precache: cache not marked complete for this "
+               "binary/tier -- rendering all songs to CACHE now (one-time; press "
+               "ESC to skip and let songs render on demand instead).");
+      g_oc_batch_active = true;
+      const int n = SoundManager::getInstance()->orgMusicCount();
+      g_oc_song_total = n - 1; // [0] is the "" stop sentinel entry
+      int rendered = 0, skipped = 0, failed = 0;
+      for (int i = 1; i < n && !g_oc_abort; ++i)
+      {
+        const std::string path = SoundManager::getInstance()->orgMusicPath(i);
+        if (path.empty())
+          continue;
+        g_oc_song_idx      = i;
+        g_oc_song_name     = _oc_basename(path);
+        g_oc_last_inner_px = -1;          // reset the intra-song bar for the new song
+        _oc_draw_progress(0, 0);          // coarse N/M update + empty inner bar + flip
+        _oc_poll_esc();                   // catch ESC pressed between songs
+        if (g_oc_abort)
+          break;
+        const long b = org_precache_one(path.c_str()); // beat cb fires inside
+        if (b > 0)       ++rendered;
+        else if (b == 0) ++skipped;       // already cached, or aborted (empty buffer)
+        else             ++failed;
+      }
+      g_oc_batch_active = false;
+      if (g_oc_abort)
+        LOG_INFO("organya auto-precache: ESC -- batch skipped (rendered={} "
+                 "skipped={} failed={}); remaining songs cold-render on demand "
+                 "behind the overlay; batch resumes next launch (no sentinel).",
+                 rendered, skipped, failed);
+      else
+      {
+        org_cache_sentinel_write();
+        LOG_INFO("organya auto-precache: COMPLETE (rendered={} skipped={} "
+                 "failed={}); READY sentinel written -- subsequent boots skip "
+                 "straight to title.", rendered, skipped, failed);
+      }
+    }
+    else
+    {
+      LOG_INFO("organya auto-precache: cache complete (sentinel present) -- "
+               "skipping batch; in-game overlay armed for any stray cache miss.");
+    }
+  }
+
   if (trig_init())
   {
     fatal("Failed trig module init.");
