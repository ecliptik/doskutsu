+// ===========================================================================
+// ORGCACHE-AUTO (slot TBD): per-beat progress callback. Threaded INTO
+// _org_render_song's synth loop so the multi-second cold-render (the title is
+// ~57 s on the DX2-66) can drive a moving progress bar instead of a black
+// screen. The callback is a file-scope function pointer (NULL default), set by
+// the engine-side progress UI (main.cpp) AFTER the headless host batch
+// (DOSKUTSU_ORG_PRECACHE_ALL) has already run + exited -- so the host batch
+// renders with cb==NULL = BYTE-IDENTICAL headless path. Organya stays decoupled
+// from the Renderer: it only knows an int(*)(uint32_t cur_beat, uint32_t total).
+// RETURN: nonzero == ABORT this render (R2 ESC-skip during the first-launch
+// batch; in-game renders never abort -- the UI returns 0 there). On abort
+// _org_render_song discards the PARTIAL buffer so the caller never caches a
+// truncated song. Whether main.cpp registers a cb at all is gated by the
+// default-ON killswitch SDL_HINT_DOSKUTSU_ORG_AUTOCACHE (org_autocache_active,
+// below); this layer is only the mechanism.
+typedef int (*org_render_beat_cb_t)(uint32_t cur_beat, uint32_t total_beats);
+static org_render_beat_cb_t g_org_render_beat_cb = nullptr;
+extern "C" void org_set_render_beat_cb(org_render_beat_cb_t cb) { g_org_render_beat_cb = cb; }
+
 static bool org_prerender_active()
 {
   if (g_org_prerender_decided < 0)
@@ -455,6 +474,18 @@ static void _org_render_song(Song &song, uint32_t H, int decim,
   int    acc_n = 0;
   for (uint32_t b = 0; b < song.loop_end; ++b)
   {
+    // ORGCACHE-AUTO (slot TBD): drive the progress overlay per beat. NULL on the
+    // headless host batch (cb is registered by main.cpp only AFTER that batch has
+    // exited) -> single null compare, byte-identical. The cb self-throttles flips
+    // and returns nonzero to ABORT (R2 ESC-skip, batch only). On abort, discard
+    // the partial buffer so the caller's _org_cache_store (buf.empty() guard)
+    // no-ops -- never a truncated cache.
+    if (g_org_render_beat_cb && g_org_render_beat_cb(b, song.loop_end))
+    {
+      outbuf.clear();
+      out_loopstart = 0;
+      break;
+    }
     if (b == song.loop_start)
       out_loopstart = outbuf.size();   // exact wrap target
     song.Synth();                      // fills song.samples (stereo float @ H)
@@ -556,6 +587,55 @@ static std::string _org_cache_path(const std::string &name)
   return _org_cache_dir() + "/" + name + ".PCM";
 }
 
+// ORGCACHE-AUTO (slot TBD): per-tier "cache is complete for THIS binary" sentinel
+// = CACHE\<rate>_<channels>\READY.OK. Written ONLY after a fully-successful
+// auto-precache batch. The build key is the FULL DOSKUTSU_BUILD_SHA12 stored in
+// the FILE CONTENT, NOT the filename: g2k is MS-DOS 6.22 (no LFN) and plain 8.3
+// FAT truncates an extension to 3 chars, so keying the sha in the NAME
+// (READY.<sha>) would collapse it to 3 hex on disk (a weak key + a ~1/4096
+// cross-build false-match that would silently skip the first-boot batch). The
+// fixed 8.3 name READY.OK + content-keying sidesteps truncation entirely and keys
+// on the full 12 chars. present() READS the stored sha and string-compares it to
+// THIS binary's DOSKUTSU_BUILD_SHA12 (a mere fopen-exists would NOT reject a stale
+// old-build sentinel) -> any mismatch reads as absent -> rebuild. The tier dir
+// keys rate+channels. Playback-side per-song header validation (_org_cache_try_load
+// / _org_cache_valid) remains the real trust guard, so even a falsely-present
+// sentinel serves no bad PCM (a changed song misses + cold-renders once in-game).
+static std::string _org_cache_sentinel_path()
+{
+  return _org_cache_dir() + "/READY.OK"; // fixed 8.3 name; build key is in CONTENT
+}
+
+extern "C" bool org_cache_sentinel_present(void)
+{
+  FILE *fp = fopen(_org_cache_sentinel_path().c_str(), "rb");
+  if (!fp)
+    return false;
+  const char  *sha  = _DOSKUTSU_ORGCACHE_STR(DOSKUTSU_BUILD_SHA12);
+  const size_t slen = strlen(sha);
+  char         buf[24];
+  const size_t n = fread(buf, 1, sizeof buf - 1, fp);
+  fclose(fp);
+  buf[n] = '\0';
+  // present + VALID only if the stored sha matches THIS binary exactly; a stale
+  // old-build sentinel mismatches -> reads as absent -> the batch re-renders.
+  return n >= slen && strncmp(buf, sha, slen) == 0;
+}
+
+extern "C" bool org_cache_sentinel_write(void)
+{
+  // nested mkdir (CACHE then CACHE\<tier>); mkdir makes no parents. EEXIST is fine.
+  mkdir(_org_cache_base_dir().c_str(), 0777);
+  mkdir(_org_cache_dir().c_str(), 0777);
+  FILE *fp = fopen(_org_cache_sentinel_path().c_str(), "wb");
+  if (!fp)
+    return false;
+  const char *sha = _DOSKUTSU_ORGCACHE_STR(DOSKUTSU_BUILD_SHA12);
+  const bool  ok  = (fwrite(sha, 1, strlen(sha), fp) == strlen(sha));
+  fclose(fp);
+  return ok;
+}
+
 // Fast-load + validate into g_org_prerender_buf. Returns true on a validated
 // hit; false (buffer cleared) on miss/stale/short-read so the caller renders.
 static bool _org_cache_try_load(const std::string &name, uint32_t native, uint32_t H,
@@ -717,6 +797,28 @@ static bool org_render_quiesce_active()
   return g_org_render_quiesce_decided == 1;
 }
 
+// ORGCACHE-AUTO (slot TBD): default-ON killswitch for auto-precache-on-first-
+// launch + the in-game cold-render progress overlay. Gates whether main.cpp runs
+// the first-boot batch AND registers the per-beat overlay cb. Only the literal
+// "0" disables (reverts to the v1.1.0 cold-render-with-black-screen behavior).
+// Mirrors org_render_quiesce_active's inline pattern (no shared helper). extern
+// "C" so main.cpp reads it without a header.
+static int g_org_autocache_decided = -1;
+extern "C" bool org_autocache_active(void)
+{
+  if (g_org_autocache_decided < 0)
+  {
+    const char *e = SDL_GetHint("SDL_HINT_DOSKUTSU_ORG_AUTOCACHE");
+    g_org_autocache_decided = (e && e[0] == '0' && e[1] == '\0') ? 0 : 1;
+    LOG_INFO("organya auto-precache: {} (first-launch precache + in-game cold-"
+             "render progress overlay; set SDL_HINT_DOSKUTSU_ORG_AUTOCACHE=0 to "
+             "disable -> v1.1.0 black-screen cold-render)",
+             g_org_autocache_decided ? "ENABLED (default)"
+                                      : "DISABLED (killswitch =0)");
+  }
+  return g_org_autocache_decided == 1;
+}
+
