+// DOS-PORT (patch 0126, Phase 11 wave-30 Option 2 — backdrop miss-streak
+// direct-to-window). Two-phase helper for map.cpp's thrashing-bypass
+// path: when the patch-0080 backdrop cache has been missing every frame
+// for ≥4 frames (operator continuously moving in heavy-music gameplay
+// per `keyboard_held_key_works.md`), map.cpp routes the backdrop tile
+// loop DIRECTLY into the window surface and skips the cache-fill +
+// cache→window-blit double-step. Saves ~3-4 ms / flip per the patch-
+// 0080 cost decomposition (the cache→window blit is bandwidth-bound on
+// PODP83+Cirrus at ~17 MB/s for the 76 KB transfer).
+//
+// Same drain + dirty-rect-record + drawcall-bump accounting as
+// drawCachedBackdrop, just split across two calls (caller writes tiles
+// between them).
+void Renderer::prepareDirectBackdropWrite()
+{
+  // Drain any queued slow-path renderer commands so they reach the
+  // window surface BEFORE we overwrite the bg layer beneath them.
+  // Mirrors drawCachedBackdrop's drain step.
+  if (_renderer_queue_dirty)
+  {
+    SDL_FlushRenderer(_renderer);
+    _renderer_queue_dirty = false;
+  }
+}
+
+void Renderer::commitDirectBackdropWrite()
+{
+  // Mirror drawCachedBackdrop's tail accounting. The bg layer was
+  // unconditionally repainted across the full screen by the caller's
+  // tile writes; record one full-screen dirty rect + bump drawcall.
+  _bump_drawcall();
+  _record_dirty_rect(0, 0, screenWidth * scale, screenHeight * scale);
+}
