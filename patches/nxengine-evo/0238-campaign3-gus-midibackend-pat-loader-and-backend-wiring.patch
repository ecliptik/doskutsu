index 1cd24869..ba0f23b8 100644
--- a/src/sound/MidiScheduler.cpp
+++ b/src/sound/MidiScheduler.cpp
@@ -373,6 +373,32 @@ void MidiScheduler::stop()
   _playing = false;
 }
 
+void MidiScheduler::collect_song_instruments(std::uint8_t mel_used[128],
+                                             std::uint8_t drum_used[128]) const
+{
+  // patch 0238 (Campaign 3 GUS): read-only walk of the loaded event list to
+  // discover which GM programs + percussion notes the current song uses, so a
+  // wavetable backend (MidiBackendGus) can pre-upload exactly those .pat
+  // samples at on_song_start (main-loop) and keep the IRQ note path free of
+  // file I/O. Percussion is MIDI channel 9 (0-indexed).
+  std::memset(mel_used, 0, 128);
+  std::memset(drum_used, 0, 128);
+  for (std::size_t i = 0; i < _events.size(); ++i)
+  {
+    const MidiEvent &ev = _events[i];
+    if (ev.type == EventType::PROGRAM_CHANGE)
+    {
+      if (ev.channel != 9 && ev.data1 < 128) mel_used[ev.data1] = 1;
+    }
+    else if (ev.type == EventType::NOTE_ON)
