+/* Cave Story port -- Campaign 3 (native Gravis Ultrasound / GF1, patch 0238).
+ * MidiBackendGus implementation. See MidiBackendGus.h for the design + the
+ * IRQ-context discipline, and docs/internal/GUS-PAT-PARSER-DESIGN.md for the
+ * .pat byte layout + the GM filename table provenance.
+ *
+ * The GF1 transport is the SDL/0112 out-of-band export surface
+ * (SDL3/SDL_dosgus.h): Init/Shutdown/GetState/UploadSample/ResetDram +
+ * AllocVoice/StartVoice/StopVoice/SetVoiceFreq/Vol/Pan. The driver owns every
+ * GF1 register/fixed-point/log conversion; this backend hands friendly units
+ * (Hz, 0..255 vol, 0..255 pan) + native-format sample bytes (8-bit unsigned /
+ * 16-bit signed -- the .pat signed->unsigned flip is done here).
+ */
+
+#include "MidiBackendGus.h"
+
+#include "../Utils/Logger.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_dosgus.h>        // SDL/0112 GF1 export surface
+#include <SDL3/SDL_dosmidi_tick.h>  // SDL_DOSMidiIsrAnyActive (DPMI-lock gate)
+
+#ifdef __DJGPP__
+#include <dpmi.h>  // _go32_dpmi_lock_data for the IRQ-touched instance
+#endif
+
+namespace NXE
+{
+namespace Sound
+{
+
+// ============================================================================
+// GM program / drum-note -> Gravis stock .pat base filename.
+//
+// This is the canonical Gravis Ultrasound default-patchset name table (the
+// de-facto standard shared by every GUS GM config; transcribed from the
+// TiMidity-compatible gravis.cfg for the GUS default patchset). It matches the
+// operator's stock C:\ULTRASND\MIDI\*.pat set. Every name is DOS 8.3-safe
+// (<=8 chars). const char* rodata -- read only in on_song_start (main-loop
+// context), never from the IRQ note path, so no DPMI lock needed.
+// ============================================================================
+
+static const char *const MELODIC_NAMES[128] = {
+  "acpiano",  "britepno", "synpiano", "honky",    "epiano1",  "epiano2",
+  "hrpschrd", "clavinet", "celeste",  "glocken",  "musicbox", "vibes",
+  "marimba",  "xylophon", "tubebell", "santur",   "homeorg",  "percorg",
+  "rockorg",  "church",   "reedorg",  "accordn",  "harmonca", "concrtna",
+  "nyguitar", "acguitar", "jazzgtr",  "cleangtr", "mutegtr",  "odguitar",
+  "distgtr",  "gtrharm",  "acbass",   "fngrbass", "pickbass", "fretless",
+  "slapbas1", "slapbas2", "synbass1", "synbass2", "violin",   "viola",
+  "cello",    "contraba", "tremstr",  "pizzcato", "harp",     "timpani",
+  "marcato",  "slowstr",  "synstr1",  "synstr2",  "choir",    "doo",
+  "voices",   "orchhit",  "trumpet",  "trombone", "tuba",     "mutetrum",
+  "frenchrn", "hitbrass", "synbras1", "synbras2", "sprnosax", "altosax",
+  "tenorsax", "barisax",  "oboe",     "englhorn", "bassoon",  "clarinet",
+  "piccolo",  "flute",    "recorder", "woodflut", "bottle",   "shakazul",
+  "whistle",  "ocarina",  "sqrwave",  "sawwave",  "calliope", "chiflead",
+  "charang",  "voxlead",  "lead5th",  "basslead", "fantasia", "warmpad",
+  "polysyn",  "ghostie",  "bowglass", "metalpad", "halopad",  "sweeper",
+  "aurora",   "soundtrk", "crystal",  "atmosphr", "freshair", "unicorn",
+  "echovox",  "startrak", "sitar",    "banjo",    "shamisen", "koto",
+  "kalimba",  "bagpipes", "fiddle",   "shannai",  "carillon", "agogo",
+  "steeldrm", "woodblk",  "taiko",    "toms",     "syntom",   "revcym",
+  "fx-fret",  "fx-blow",  "seashore", "jungle",   "telephon", "helicptr",
+  "applause", "pistol",
+};
+
+// Percussion: GM note 27..87 -> drum .pat. Index by (note - 27).
+static const char *const DRUM_NAMES[61] = {
+  "highq",    "slap",     "scratch1", "scratch2", "sticks",   "sqrclick", // 27-32
+  "metclick", "metbell",  "kick1",    "kick2",    "stickrim", "snare1",   // 33-38
+  "claps",    "snare2",   "tomlo2",   "hihatcl",  "tomlo1",   "hihatpd",  // 39-44
+  "tommid2",  "hihatop",  "tommid1",  "tomhi2",   "cymcrsh1", "tomhi1",   // 45-50
+  "cymride1", "cymchina", "cymbell",  "tamborin", "cymsplsh", "cowbell",  // 51-56
+  "cymcrsh2", "vibslap",  "cymride2", "bongohi",  "bongolo",  "congahi1", // 57-62
+  "congahi2", "congalo",  "timbaleh", "timbalel", "agogohi",  "agogolo",  // 63-68
+  "cabasa",   "maracas",  "whistle1", "whistle2", "guiro1",   "guiro2",   // 69-74
+  "clave",    "woodblk1", "woodblk2", "cuica1",   "cuica2",   "triangl1", // 75-80
+  "triangl2", "shaker",   "jingles",  "belltree", "castinet", "surdo1",   // 81-86
+  "surdo2",                                                               // 87
+};
+
+const char *MidiBackendGus::_melodic_patch_name(int program)
+{
+  if (program < 0 || program > 127) return nullptr;
+  return MELODIC_NAMES[program];
+}
+
+const char *MidiBackendGus::_drum_patch_name(int note)
+{
+  if (note < 27 || note > 87) return nullptr;
+  return DRUM_NAMES[note - 27];
+}
+
+// ============================================================================
+// Little-endian byte readers (the .pat wire format packs multi-byte ints at
+// unaligned offsets; explicit readers avoid struct-packing assumptions).
+// ============================================================================
+
+static std::uint16_t rd_u16le(const std::uint8_t *p)
+{
+  return (std::uint16_t)(p[0] | (p[1] << 8));
+}
+static std::uint32_t rd_u32le(const std::uint8_t *p)
+{
+  return (std::uint32_t)p[0] | ((std::uint32_t)p[1] << 8) |
+         ((std::uint32_t)p[2] << 16) | ((std::uint32_t)p[3] << 24);
+}
+static std::int32_t rd_s32le(const std::uint8_t *p)
+{
+  return (std::int32_t)rd_u32le(p);
+}
+
+// ============================================================================
+// MidiBackendGus lifecycle
+// ============================================================================
+
+MidiBackendGus::MidiBackendGus()
+{
+  LOG_INFO("gus backend: bringing up the GF1 (SDL_DOSGusInit -- parses "
+           "ULTRASND, GF1 reset, DRAM sizing, voice/rate program, IRQ hook)...");
+
+  // Equal-tempered MIDI frequency table (FPU is fine here -- ctor runs in
+  // main-loop init context, NOT the IRQ note path).
+  for (int n = 0; n < 128; ++n)
+  {
+    _note_freq[n] =
+        (std::uint32_t)(440.0 * std::pow(2.0, (n - 69) / 12.0) + 0.5);
+  }
+
+  std::memset(_voices, 0, sizeof(_voices));
+  std::memset(_mel, 0, sizeof(_mel));
+  std::memset(_drum, 0, sizeof(_drum));
+  for (int ch = 0; ch < MIDI_CHANNELS; ++ch)
+  {
+    _channel_program[ch]    = 0;
+    _channel_volume[ch]     = 100;  // GM default
+    _channel_expression[ch] = 127;  // GM default
+    _channel_pan[ch]        = 64;   // GM center
+  }
+
+  if (!SDL_DOSGusInit())
+  {
+    _ready = false;
+    LOG_INFO("gus backend: SDL_DOSGusInit failed -- no GF1 detected (check "
+             "ULTRASND, or set SDL_HINT_DOSKUTSU_GUS_SKIP_DETECTION=1 for "
+             "bring-up under emulation). Music will be SILENT this run; the "
+             "game still runs.");
+    return;
+  }
+
+  SDL_DOSGusState st;
+  if (SDL_DOSGusGetState(&st) && st.valid)
+  {
+    _num_voices  = (st.num_voices > 0 && st.num_voices <= MAX_VOICES)
+                       ? st.num_voices
+                       : 28;
+    _output_rate = st.output_rate ? st.output_rate : 22050;
+    _dram_size   = st.dram_size;
+  }
+
+  // Clean DRAM slate (no persistent region yet -- #28's SFX bank is the future
+  // keep-region; for #27 music-only the whole DRAM is the per-song pool).
+  SDL_DOSGusResetDram(0);
+
+  _ready = true;
+
+  LOG_INFO("gus backend ready: GF1 detected, {} voices @ {} Hz, {} KB DRAM. "
+           "Clock = PIT/IRQ-0 pump (SDL/0110), NOT SB IRQ-5. GM instruments "
+           "load lazily per song from ULTRADIR .pat (Gravis stock set). "
+           "MUSIC ONLY this phase (#27); GF1 SFX = #28.",
+           _num_voices, (unsigned)_output_rate, (unsigned)(_dram_size / 1024));
+
+  // DPMI-lock the whole instance: under the PIT pump the IRQ-0 ISR's
+  // tick_isr -> note_on/off reads _voices / _mel / _drum / _note_freq /
+  // channel arrays. Gate on the SHARED pump predicate, mirroring
+  // MidiBackendOpl2's ctor (SDL/0110). (CWSDPMI locks all memory by default,
+  // so this is belt-and-braces -- but it keeps the IRQ-context contract
+  // explicit and matches the shipped AdLib backend.)
+#ifdef __DJGPP__
+  if (SDL_DOSMidiIsrAnyActive())
+  {
+    _go32_dpmi_lock_data((void *)this, (unsigned long)sizeof(*this));
+  }
+#endif
+}
+
+MidiBackendGus::~MidiBackendGus()
+{
+  if (_ready)
+  {
+    for (int v = 0; v < _num_voices; ++v)
+    {
+      SDL_DOSGusStopVoice(v);
+    }
+    // Idempotent: stops + silences all voices, unhooks the GF1 IRQ, parks the
+    // chip in reset. Safe even though SoundManager::shutdown may also call it.
+    SDL_DOSGusShutdown();
+    LOG_INFO("gus backend shutdown (all voices stopped; GF1 in reset).");
+  }
+}
+
+// ============================================================================
+// .pat upload (MAIN-LOOP context only -- file I/O + FPU)
+// ============================================================================
+
+bool MidiBackendGus::_upload_pat(const char *base_name, bool is_drum,
+                                 PatSample *out)
+{
+  if (!base_name || !out) return false;
+
+  const char *ultradir = SDL_GetHint("SDL_HINT_DOSKUTSU_GUS_ULTRADIR");
+  if (!ultradir || ultradir[0] == '\0') ultradir = "C:\\ULTRASND";
+
+  // Try <ULTRADIR>\<name>.pat then <ULTRADIR>\MIDI\<name>.pat (the operator's
+  // stock layout is the MIDI subdir). fopen "rb" -- DJGPP text-mode would
+  // corrupt the binary .pat (CRLF translation).
+  char path[256];
+  std::FILE *fp = nullptr;
+  std::snprintf(path, sizeof(path), "%s\\%s.pat", ultradir, base_name);
+  fp = std::fopen(path, "rb");
+  if (!fp)
+  {
+    std::snprintf(path, sizeof(path), "%s\\MIDI\\%s.pat", ultradir, base_name);
+    fp = std::fopen(path, "rb");
+  }
+  if (!fp)
+  {
+    LOG_WARN("gus backend: .pat '{}' not found under '{}' (tried both "
+             "<dir>\\ and <dir>\\MIDI\\); instrument silent.", base_name,
+             ultradir);
+    return false;
+  }
+
+  std::uint8_t hdr[129];
+  std::uint8_t ihdr[63];
+  std::uint8_t lhdr[47];
+  std::uint8_t srec[96];
+  if (std::fread(hdr, 1, sizeof(hdr), fp) != sizeof(hdr) ||
+      std::memcmp(hdr, "GF1PATCH1", 9) != 0)
+  {
+    LOG_WARN("gus backend: '{}.pat' bad/short GF1 header; instrument silent.",
+             base_name);
+    std::fclose(fp);
+    return false;
+  }
+  if (std::fread(ihdr, 1, sizeof(ihdr), fp) != sizeof(ihdr) ||
+      std::fread(lhdr, 1, sizeof(lhdr), fp) != sizeof(lhdr) ||
+      std::fread(srec, 1, sizeof(srec), fp) != sizeof(srec))
+  {
+    LOG_WARN("gus backend: '{}.pat' truncated instrument/layer/sample header; "
+             "instrument silent.", base_name);
+    std::fclose(fp);
+    return false;
+  }
+
+  // Sample-record fields (offsets per GUS-PAT-PARSER-DESIGN.md sec 1.4).
+  const std::uint32_t data_size = rd_u32le(srec + 8);
+  std::uint32_t       loop_start = rd_u32le(srec + 12);
+  std::uint32_t       loop_end   = rd_u32le(srec + 16);
+  const std::uint32_t sample_rate = rd_u16le(srec + 20);
+  const std::int32_t  root_freq   = rd_s32le(srec + 30);  // milliHz
+  const std::uint8_t  modes       = srec[55];
+
+  const bool fmt16       = (modes & 0x01) != 0;
+  const bool is_unsigned = (modes & 0x02) != 0;
+  const bool loop_on     = (modes & 0x04) != 0;
+  const bool bidi        = (modes & 0x08) != 0;
+
+  // Sanity-guard the size before allocating (defensive against a corrupt
+  // header; the io-audit discipline). data_size must be > 0 and fit DRAM.
+  if (data_size == 0 || (_dram_size && data_size > _dram_size) ||
+      data_size > (2u * 1024u * 1024u))
+  {
+    LOG_WARN("gus backend: '{}.pat' implausible data_size={} (dram={}); "
+             "instrument silent.", base_name, (unsigned)data_size,
+             (unsigned)_dram_size);
+    std::fclose(fp);
+    return false;
+  }
+
+  std::uint8_t *pcm = (std::uint8_t *)std::malloc(data_size);
+  if (!pcm)
+  {
+    LOG_WARN("gus backend: '{}.pat' OOM allocating {} bytes; instrument "
+             "silent.", base_name, (unsigned)data_size);
+    std::fclose(fp);
+    return false;
+  }
+  if (std::fread(pcm, 1, data_size, fp) != data_size)
+  {
+    LOG_WARN("gus backend: '{}.pat' truncated PCM data ({} bytes); instrument "
+             "silent.", base_name, (unsigned)data_size);
+    std::free(pcm);
+    std::fclose(fp);
+    return false;
+  }
+  std::fclose(fp);
+
+  // Normalize to native GF1 DRAM format: 8-bit UNSIGNED / 16-bit SIGNED. The
+  // driver uploads verbatim (R4), so the engine owns the sign flip. .pat is
+  // most commonly 8-bit signed -> xor 0x80; 16-bit is usually already signed.
+  if (!fmt16)
+  {
+    if (!is_unsigned)
+      for (std::uint32_t i = 0; i < data_size; ++i) pcm[i] ^= 0x80;
+  }
+  else
+  {
+    if (is_unsigned)
+      for (std::uint32_t i = 1; i < data_size; i += 2) pcm[i] ^= 0x80;  // hi byte
+  }
+
+  const std::uint32_t addr = SDL_DOSGusUploadSample(pcm, data_size, fmt16 ? 1 : 0);
+  std::free(pcm);
+  if (addr == SDL_DOSGUS_BAD_ADDR)
+  {
+    LOG_WARN("gus backend: '{}.pat' DRAM upload failed (full?); instrument "
+             "silent. dram_size={} bytes.", base_name, (unsigned)_dram_size);
+    return false;
+  }
+
+  // Resolve loop/end byte offsets. Drums are one-shot regardless of the .pat
+  // loop flag (a looping drum would ring forever on note-selected percussion).
+  const bool use_loop = loop_on && !is_drum;
+  if (loop_end == 0 || loop_end > data_size) loop_end = data_size;
+  if (loop_start > data_size) loop_start = 0;
+
+  // Pitch scaler g_fp = (sample_rate / root_hz) << 16, integer fixed-point.
+  // root_hz = root_freq (milliHz) / 1000. FPU OK here (main-loop). note_on
+  // then does playback_hz = (g_fp * _note_freq[note]) >> 16 with pure ints.
+  double root_hz = (root_freq > 0) ? (root_freq / 1000.0) : 440.0;
+  if (root_hz < 1.0) root_hz = 440.0;
+  const double g = (double)sample_rate / root_hz;
+  std::uint32_t g_fp = (std::uint32_t)(g * 65536.0 + 0.5);
+  if (g_fp == 0) g_fp = 65536;  // identity guard
+
+  out->resident    = true;
+  out->dram_addr   = addr;
+  out->data_size   = data_size;
+  out->loop_start  = loop_start;
+  out->loop_end    = loop_end;
+  out->sample_rate = sample_rate ? sample_rate : 22050;
+  out->g_fp        = g_fp;
+  out->flags       = (std::uint16_t)((use_loop ? SDL_DOSGUS_LOOP : 0) |
+                                     (fmt16 ? SDL_DOSGUS_16BIT : 0) |
+                                     (use_loop && bidi ? SDL_DOSGUS_BIDI : 0));
+  return true;
+}
+
+// ============================================================================
+// Voice pool (engine owns lifecycle; driver pool via Alloc/StopVoice)
+// ============================================================================
+
+void MidiBackendGus::_reap_finished_voices()
+{
+  // Read live hardware status; any voice the mirror thinks is active but the
+  // hardware reports stopped (a one-shot drum/sample that ran to its end) is
+  // returned to the pool so it can be reused + _find_voice stays correct.
+  SDL_DOSGusState st;
+  if (!SDL_DOSGusGetState(&st) || !st.valid) return;
+  for (int v = 0; v < _num_voices; ++v)
+  {
+    if (_voices[v].active && ((st.voice_active_mask >> v) & 1u) == 0u)
+    {
+      SDL_DOSGusStopVoice(v);
+      _voices[v].active = false;
+    }
+  }
+}
+
+int MidiBackendGus::_allocate_voice()
+{
+  _reap_finished_voices();
+  ++_voice_alloc_count;
+
+  // Prefer the driver's free-list; it tracks the real hardware pool.
+  int v = SDL_DOSGusAllocVoice();
+  if (v < 0 || v >= _num_voices)
+  {
+    // Pool exhausted -> engine LRU steal of the oldest active mirror voice.
+    int lru = 0;
+    for (int i = 1; i < _num_voices; ++i)
+    {
+      if (_voices[i].last_used < _voices[lru].last_used) lru = i;
+    }
+    SDL_DOSGusStopVoice(lru);
+    _voices[lru].active = false;
+    v = SDL_DOSGusAllocVoice();
+    if (v < 0 || v >= _num_voices) v = lru;  // last resort: reuse the slot id
+  }
+  _voices[v].last_used = _voice_alloc_count;
+  return v;
+}
+
+int MidiBackendGus::_find_voice(int channel, int note)
+{
+  for (int v = 0; v < _num_voices; ++v)
+  {
+    if (_voices[v].active &&
+        _voices[v].midi_channel == (std::uint8_t)channel &&
+        _voices[v].midi_note    == (std::uint8_t)note)
+    {
+      return v;
+    }
+  }
+  return -1;
+}
+
+// ============================================================================
+// MidiBackend dispatch (note_on/off/cc/pc run in IRQ-0 context -- int only)
+// ============================================================================
+
+void MidiBackendGus::note_on(int channel, int note, int velocity)
+{
+  if (!_ready) return;
+  if (velocity == 0)
+  {
+    note_off(channel, note, 0);
+    return;
+  }
+  const int ch = channel & 0x0F;
+  note &= 0x7F;
+
+  const bool is_drum = (ch == DRUM_CHANNEL);
+  const PatSample *ps =
+      is_drum ? &_drum[note] : &_mel[_channel_program[ch] & 0x7F];
+  if (!ps->resident) return;  // not pre-uploaded at on_song_start -> silent.
+                              // (No file I/O in IRQ context, by design.)
+
+  const int v = _allocate_voice();
+  _voices[v].active       = true;
+  _voices[v].midi_channel = (std::uint8_t)ch;
+  _voices[v].midi_note    = (std::uint8_t)note;
+
+  // Pitch. Drums play at the sample's native rate (the note selects the drum,
+  // it does not transpose it). Melodic voices pitch via the fixed-point scaler.
+  std::uint32_t hz;
+  if (is_drum)
+  {
+    hz = ps->sample_rate;
+  }
+  else
+  {
+    hz = (std::uint32_t)(((std::uint64_t)ps->g_fp * _note_freq[note]) >> 16);
+  }
+  if (hz == 0) hz = ps->sample_rate;
+
+  // Volume: velocity * channel-volume(CC7) * expression(CC11), 0..255 linear.
+  int lin = velocity;                                  // 0..127
+  lin = (lin * _channel_volume[ch]) / 127;             // apply CC7
+  lin = (lin * _channel_expression[ch]) / 127;         // apply CC11
+  int vol255 = (lin * 255) / 127;                      // 0..127 -> 0..255
+  if (vol255 > 255) vol255 = 255;
+
+  int pan255 = (int)_channel_pan[ch] << 1;             // CC10 0..127 -> 0..255
+  if (pan255 > 255) pan255 = 255;
+
+  const std::uint32_t start     = ps->dram_addr;
+  const std::uint32_t end       = ps->dram_addr + ps->loop_end;
+  const std::uint32_t loopstart = ps->dram_addr + ps->loop_start;
+
+  SDL_DOSGusSetVoiceFreq(v, hz);
+  SDL_DOSGusSetVoiceVol(v, vol255);
+  SDL_DOSGusSetVoicePan(v, pan255);
+  SDL_DOSGusStartVoice(v, start, end, loopstart, ps->flags);
+}
+
+void MidiBackendGus::note_off(int channel, int note, int velocity)
+{
+  (void)velocity;
+  if (!_ready) return;
+  const int v = _find_voice(channel & 0x0F, note & 0x7F);
+  if (v >= 0)
+  {
+    // No hardware release ramp is exported; stop immediately (matches the
+    // shipped OPL2/OPL3 backends, which KEY-OFF on note_off). A software
+    // release ramp is a deferred polish item (GUS-PAT-PARSER-DESIGN sec 7).
+    SDL_DOSGusStopVoice(v);
+    _voices[v].active = false;
+  }
+}
+
+void MidiBackendGus::control_change(int channel, int controller, int value)
+{
+  if (!_ready) return;
+  const int ch = channel & 0x0F;
+  switch (controller)
+  {
+    case 7:   _channel_volume[ch]     = (std::uint8_t)(value & 0x7F); break;
+    case 10:  _channel_pan[ch]        = (std::uint8_t)(value & 0x7F); break;
+    case 11:  _channel_expression[ch] = (std::uint8_t)(value & 0x7F); break;
+    case 120:  // All Sound Off
+    case 123:  // All Notes Off
+    {
+      for (int v = 0; v < _num_voices; ++v)
+      {
+        if (_voices[v].active && _voices[v].midi_channel == (std::uint8_t)ch)
+        {
+          SDL_DOSGusStopVoice(v);
+          _voices[v].active = false;
+        }
+      }
+      break;
+    }
+    default:
+      break;
+  }
+}
+
+void MidiBackendGus::program_change(int channel, int program)
+{
+  if (!_ready) return;
+  // IRQ context: record only. The .pat was pre-uploaded at on_song_start; the
+  // upload itself never happens here (no file I/O in the ISR).
+  _channel_program[channel & 0x0F] = (std::uint8_t)(program & 0x7F);
+}
+
+void MidiBackendGus::on_song_start()
+{
+  if (!_ready) return;
+
+  // MAIN-LOOP context (the loop-restart does NOT re-fire this -- see
+  // MidiScheduler.cpp:472). Safe for file I/O + FPU. Tear down the prior
+  // song's voices, free its DRAM, then pre-upload exactly the instruments the
+  // new song references so the IRQ note path only ever touches resident DRAM.
+
+  for (int v = 0; v < _num_voices; ++v)
+  {
+    SDL_DOSGusStopVoice(v);
+    _voices[v].active = false;
+  }
+  // Free the previous song's .pat region (no persistent #28 SFX region yet ->
+  // keep 0). Stop voices FIRST (above) so none reads the freed DRAM (R3).
+  SDL_DOSGusResetDram(0);
+  for (int i = 0; i < 128; ++i) { _mel[i].resident = false; _drum[i].resident = false; }
+
+  for (int ch = 0; ch < MIDI_CHANNELS; ++ch)
+  {
+    _channel_program[ch]    = 0;
+    _channel_volume[ch]     = 100;
+    _channel_expression[ch] = 127;
+    _channel_pan[ch]        = 64;
+  }
+
+  // Pre-scan the loaded song for its melodic programs + drum notes.
+  std::uint8_t mel_used[128];
+  std::uint8_t drum_used[128];
+  MidiScheduler::getInstance()->collect_song_instruments(mel_used, drum_used);
+  mel_used[0] = 1;  // program 0 (piano) is the GM default for un-programmed
+                    // channels; always have it resident.
+
+  int loaded = 0, missing = 0;
+  for (int p = 0; p < 128; ++p)
+  {
+    if (!mel_used[p]) continue;
+    if (_upload_pat(_melodic_patch_name(p), /*is_drum=*/false, &_mel[p]))
+      ++loaded;
+    else
+      ++missing;
+  }
+  for (int n = 0; n < 128; ++n)
+  {
+    if (!drum_used[n]) continue;
+    const char *nm = _drum_patch_name(n);
+    if (nm && _upload_pat(nm, /*is_drum=*/true, &_drum[n]))
+      ++loaded;
+    else
+      ++missing;
+  }
+
+  SDL_DOSGusState st;
+  const unsigned used_kb =
+      (SDL_DOSGusGetState(&st) && st.valid) ? (unsigned)(st.dram_used / 1024) : 0;
+  LOG_INFO("gus backend: on_song_start -- uploaded {} instruments ({} "
+           "missing/silent) into {} KB DRAM for this song.",
+           loaded, missing, used_kb);
+}
+
+void MidiBackendGus::on_song_stop()
+{
+  if (!_ready) return;
+  for (int v = 0; v < _num_voices; ++v)
+  {
+    SDL_DOSGusStopVoice(v);
+    _voices[v].active = false;
+  }
+  LOG_INFO("gus backend: on_song_stop (all voices stopped).");
+}
+
+void MidiBackendGus::silence_for_shutdown()
+{
+  if (!_ready) return;
+  for (int v = 0; v < _num_voices; ++v)
+  {
+    SDL_DOSGusStopVoice(v);
+    _voices[v].active = false;
+  }
+}
+
+}  // namespace Sound
+}  // namespace NXE
