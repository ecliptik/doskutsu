--- /dev/null
+++ b/src/sound/MidiBackendGus.h
@@ -0,0 +1,139 @@
+/* Cave Story port -- Campaign 3 (native Gravis Ultrasound / GF1, patch 0238).
+ * MidiBackendGus: concrete MidiBackend that renders GM MIDI music on the GF1
+ * wavetable engine. Out-of-band, exactly like the AdLib path (MidiBackendOpl2):
+ * there is NO SDL audio device and NO SDL3_mixer. The card is brought up via
+ * SDL_DOSGusInit() (SDL/0112), GM instruments are uploaded into the card's
+ * on-board DRAM as GUS .pat samples, and per-note GF1 hardware voices are
+ * commanded through the SDL_DOSGus* exports. The GF1 mixes up to 28 voices in
+ * hardware straight to its DAC; the host CPU only allocates + dispatches.
+ *
+ * Selected when SDL_HINT_DOSKUTSU_AUDIO_BACKEND=gus. The music clock is the
+ * PIT/IRQ-0 pump (SDL/0110, shared with the AdLib path), NOT the SB IRQ-5 --
+ * a GUS-only box has no Sound Blaster. MUSIC ONLY for Phase 1 (#27); Pixtone
+ * SFX on GF1 voices lands in #28.
+ *
+ * IRQ-CONTEXT DISCIPLINE (critical): under the PIT pump, note_on / note_off /
+ * control_change / program_change are dispatched from MidiScheduler::tick_isr
+ * in IRQ-0 context. Those paths therefore do NO file I/O, NO malloc/free, and
+ * NO FPU (the DOS ISR does not save FPU state). All .pat loading + the float
+ * pitch precompute happen in on_song_start (main-loop context -- the loop-
+ * restart does NOT re-fire on_song_start, MidiScheduler.cpp:472). note_on uses
+ * integer-only pitch math against a per-program fixed-point scaler computed at
+ * upload time.
+ *
+ * .pat residency: lazy per song. on_song_start pre-scans the loaded song's
+ * instruments (MidiScheduler::collect_song_instruments) + uploads exactly the
+ * GM programs / drum notes it uses, bounded by the card's <=1MB DRAM. Per-song
+ * swap rewinds the DRAM bump allocator (SDL_DOSGusResetDram). BRING-UP reads
+ * the Gravis stock .pat from ULTRADIR (operator CF: C:\ULTRASND\MIDI). FreePats
+ * bundling for ship is a separate later task.
+ *
+ * See docs/internal/GUS-NATIVE-DESIGN.md (sec 3a) + GUS-PAT-PARSER-DESIGN.md.
+ */
+
+#ifndef _MIDI_BACKEND_GUS_H
+#define _MIDI_BACKEND_GUS_H
+
+#include "MidiScheduler.h"
+
+#include <cstdint>
+
+namespace NXE
+{
+namespace Sound
+{
+
+class MidiBackendGus : public MidiBackend
+{
+public:
+  MidiBackendGus();
+  ~MidiBackendGus() override;
+
+  // True if SDL_DOSGusInit succeeded in the ctor. Polled by SoundManager::init
+  // to decide install-or-skip (same contract as MidiBackendOpl2::isReady).
+  bool isReady() const { return _ready; }
+
+  void note_on(int channel, int note, int velocity)               override;
+  void note_off(int channel, int note, int velocity)              override;
+  void control_change(int channel, int controller, int value)     override;
+  void program_change(int channel, int program)                   override;
+  void on_song_start()                                            override;
+  void on_song_stop()                                             override;
+  void silence_for_shutdown()                                     override;
+
+private:
+  // GF1 supports up to 32 hardware voices; we cap our mirror at 32 and use the
+  // driver-reported active count (SDL_DOSGusGetState().num_voices, e.g. 28).
+  static constexpr int MAX_VOICES    = 32;
+  static constexpr int MIDI_CHANNELS = 16;
+  static constexpr int DRUM_CHANNEL  = 9;   // GM percussion channel (0-indexed)
+
+  // A resident DRAM sample (one GM program, or one drum note). POD so the
+  // whole instance can be DPMI-locked for IRQ-context note_on reads. Byte
+  // addresses/offsets are in the DRAM space SDL_DOSGusUploadSample returns.
+  struct PatSample
+  {
+    bool          resident;     // uploaded + ready
+    std::uint32_t dram_addr;    // DRAM byte address of the sample's first byte
+    std::uint32_t data_size;    // bytes
+    std::uint32_t loop_start;   // byte offset into the sample (loop point)
+    std::uint32_t loop_end;     // byte offset (== data_size if no loop)
+    std::uint32_t sample_rate;  // native Hz (drum playback rate; pitch base)
+    std::uint32_t g_fp;         // (sample_rate/root_hz) << 16, fixed-point.
+                                // playback_hz(note) = (g_fp*_note_freq[note])>>16
+    std::uint16_t flags;        // SDL_DOSGUS_LOOP / _16BIT / _BIDI
+  };
+
+  // Per-voice mirror. The driver owns the hardware pool (AllocVoice/StopVoice);
+  // this mirror tracks channel/note for note_off matching + LRU steal + reap.
+  struct Voice
+  {
+    bool          active;
+    std::uint8_t  midi_channel;
+    std::uint8_t  midi_note;
+    std::uint64_t last_used;    // monotonic; LRU steal target
+  };
+
+  // Resolve a GM program (0-127) / drum note (0-127) to its Gravis .pat base
+  // filename (no extension). Returns nullptr for an out-of-range index.
+  static const char *_melodic_patch_name(int program);
+  static const char *_drum_patch_name(int note);
+
+  // Load + upload one .pat into DRAM (MAIN-LOOP context only -- file I/O). On
+  // success fills *out and returns true; on miss/OOM logs + returns false.
+  // `is_drum` selects the drum vs melodic name table + pitch handling.
+  bool _upload_pat(const char *base_name, bool is_drum, PatSample *out);
+
+  // Reap one-shot voices the hardware finished (voice_active_mask), then return
+  // a free voice, else LRU-steal. Returns a voice id in [0,_num_voices).
+  int  _allocate_voice();
+  int  _find_voice(int channel, int note);
+  void _reap_finished_voices();
+
+  bool          _ready        = false;
+  int           _num_voices   = 28;    // from SDL_DOSGusGetState
+  std::uint32_t _output_rate  = 22050; // GF1 DAC rate (informational)
+  std::uint32_t _dram_size    = 0;
+
+  Voice         _voices[MAX_VOICES];
+  std::uint64_t _voice_alloc_count = 0;
+
+  // Residency tables (indexed by GM program / MIDI note). Lazy per song.
+  PatSample     _mel[128];   // melodic programs
+  PatSample     _drum[128];  // percussion notes (GM 27..87 used)
+
+  // Per-channel MIDI controller state.
+  std::uint8_t  _channel_program[MIDI_CHANNELS]    = {0};
+  std::uint8_t  _channel_volume[MIDI_CHANNELS]     = {0};
+  std::uint8_t  _channel_expression[MIDI_CHANNELS] = {0};
+  std::uint8_t  _channel_pan[MIDI_CHANNELS]        = {0};
+
+  // Equal-tempered MIDI note frequencies (Hz, rounded), note 0..127. Computed
+  // once in the ctor (FPU OK there); read in note_on with integer math only.
+  std::uint32_t _note_freq[128] = {0};
+};
+
+}  // namespace Sound
+}  // namespace NXE
+
+#endif  // _MIDI_BACKEND_GUS_H
