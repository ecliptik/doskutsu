diff --git a/src/main.cpp b/src/main.cpp
index 6650d8b8..cecc8501 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -1628,11 +1628,36 @@ int main(int argc, char *argv[])
   // come up. Read via getenv (SDL_GetHint needs SDL_Init, not yet run -- same
   // pattern as the AUDIO_OFF check). See docs/internal/ADLIB-NATIVE-DESIGN.md.
   bool _adlib_mode = false;
+  // patch 0238 (Campaign 3 GUS): FOURTH boot mode. AUDIO_BACKEND=gus runs music
+  // natively on a no-Sound-Blaster Gravis Ultrasound (GF1), driven out-of-band
+  // by the SDL/0112 exports + clocked by the PIT/IRQ-0 pump. Like AUDIO_OFF /
+  // adlib it must OMIT SDL_INIT_AUDIO (there is no SB device to open), but like
+  // adlib it KEEPS SoundManager::init() so the GF1 backend + pump come up.
+  bool _gus_mode = false;
   {
     const char *e = std::getenv("SDL_HINT_DOSKUTSU_AUDIO_OFF");
     _audio_off = e && e[0] == '1' && e[1] == 0;
     const char *b = std::getenv("SDL_HINT_DOSKUTSU_AUDIO_BACKEND");
     _adlib_mode = b && std::strcmp(b, "adlib") == 0;
+    _gus_mode   = b && std::strcmp(b, "gus") == 0;
+  }
+  // patch 0238 (Campaign 3 GUS): bridge the operator's real ULTRASND / ULTRADIR
+  // env vars into the SDL hints the GF1 driver reads (SDL is getenv-forbidden;
+  // it reads ONLY SDL_GetHint). Must run BEFORE SDL_Init / SDL_DOSGusInit. The
+  // operator box uses e.g. ULTRASND=240,3,3,7,7 + ULTRADIR=C:\ULTRASND -- do NOT
+  // assume IRQ5/DMA1 (that is the coexisting Vibra16). Only bridged for the GUS
+  // path so non-GUS configs are byte-untouched.
+  if (_gus_mode)
+  {
+    const char *us = std::getenv("ULTRASND");
+    if (us && us[0] != '\0')
+      SDL_SetHintWithPriority("SDL_HINT_DOSKUTSU_GUS_ULTRASND", us, SDL_HINT_OVERRIDE);
+    const char *ud = std::getenv("ULTRADIR");
+    if (ud && ud[0] != '\0')
+      SDL_SetHintWithPriority("SDL_HINT_DOSKUTSU_GUS_ULTRADIR", ud, SDL_HINT_OVERRIDE);
+    LOG_INFO("AUDIO_BACKEND=gus -- bridged ULTRASND='{}' ULTRADIR='{}' from env "
+             "into the GUS SDL hints (SDL reads hints, not env).",
+             us ? us : "(unset)", ud ? ud : "(unset)");
   }
   // patch 0236 (#20): AUDIO_BACKEND=adlib takes PRECEDENCE over AUDIO_OFF.
   // adlib is an EXPLICIT request for OPL music and needs the synth path
@@ -1642,19 +1667,30 @@ int main(int argc, char *argv[])
   // AUDIO_OFF bypassed init). Clear _audio_off so adlib wins -- the
   // SDL_INIT_AUDIO omission still happens via the `|| _adlib_mode` test
   // below, and SoundManager::init now runs.
-  if (_adlib_mode && _audio_off)
+  // patch 0238 (Campaign 3 GUS): same precedence rule as adlib (#20) -- an
+  // explicit GUS-music request needs the synth path, so AUDIO_BACKEND=gus wins
+  // over AUDIO_OFF (else AUDIO_OFF would bypass SoundManager::init and leave the
+  // GF1 silent -- the g2k first-run footgun).
+  if ((_adlib_mode || _gus_mode) && _audio_off)
   {
-    LOG_WARN("Both SDL_HINT_DOSKUTSU_AUDIO_BACKEND=adlib and "
-             "SDL_HINT_DOSKUTSU_AUDIO_OFF=1 are set -- adlib WINS (an "
-             "explicit OPL-music request needs the synth path). Ignoring "
-             "AUDIO_OFF's SoundManager::init bypass; OPL2 + the PIT pump "
-             "will come up. Unset one to silence this warning.");
+    LOG_WARN("Both SDL_HINT_DOSKUTSU_AUDIO_BACKEND={} and "
+             "SDL_HINT_DOSKUTSU_AUDIO_OFF=1 are set -- {} WINS (an explicit "
+             "music request needs the synth path). Ignoring AUDIO_OFF's "
+             "SoundManager::init bypass; the backend + PIT pump will come up. "
+             "Unset one to silence this warning.",
+             _gus_mode ? "gus" : "adlib", _gus_mode ? "gus" : "adlib");
     _audio_off = false;
   }
-  if (_audio_off || _adlib_mode)
+  if (_audio_off || _adlib_mode || _gus_mode)
   {
     _sdl_init_flags &= ~SDL_INIT_AUDIO;
-    if (_adlib_mode)
+    if (_gus_mode)
+      LOG_INFO("AUDIO_BACKEND=gus -- omitting SDL_INIT_AUDIO (no Sound Blaster "
+               "on a Gravis Ultrasound config; the GF1 is driven out-of-band "
+               "via the SDL/0112 exports + the PIT/IRQ-0 music pump). "
+               "SoundManager::init() STILL RUNS (unlike AUDIO_OFF) to bring up "
+               "the GF1 backend. MUSIC ONLY this phase (#27) -- GF1 SFX = #28.");
+    else if (_adlib_mode)
       LOG_INFO("AUDIO_BACKEND=adlib -- omitting SDL_INIT_AUDIO (no Sound "
                "Blaster on a native-AdLib config; the OPL chip is driven by "
                "direct port I/O + the PIT/IRQ-0 music pump). SoundManager::"
@@ -1679,7 +1715,9 @@ int main(int argc, char *argv[])
   // atexit too so an abnormal exit (fatal(), etc.) still restores PIT ch0.
   // SDL_DOSOplTimerPumpStop is idempotent + a no-op if the pump never started,
   // so registering it only in adlib mode is sufficient + harmless.
-  if (_adlib_mode)
+  // patch 0238 (Campaign 3 GUS): the GUS path uses the SAME PIT pump as the
+  // music clock, so it needs the same belt-and-braces PIT-restore atexit.
+  if (_adlib_mode || _gus_mode)
   {
     std::atexit(SDL_DOSOplTimerPumpStop);
   }
