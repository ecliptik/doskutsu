From 6ff1ef84307a9fbf78c1c112bc35fde74f14dbf7 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Thu, 28 May 2026 17:43:08 -0700
Subject: [PATCH 185/185] patch 0185 -- FIX-2 preload stage entry music (P2,
 default-ON)

---
 src/map.cpp | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/src/map.cpp b/src/map.cpp
index 8dc3d151..eecdebc7 100644
--- a/src/map.cpp
+++ b/src/map.cpp
@@ -1264,7 +1264,10 @@ struct IoAuditPhaseGuard
 // SFXPAUSE class). When ON, load_stage peeks the entry event for its
 // first <CMU song# and starts it DURING the load band; music() caches
 // via _currentSong so the frame-1 <CMU same-song> returns early -> zero
-// gameplay-phase .org load. Strict "1", default OFF; sentinel-cached.
+// gameplay-phase .org load. Default ON since the v1.0.4 P2 io-gate A/B
+// confirmed it (build-qa #6: Shelter access.org moved gameplay->
+// load_stage); killswitch SDL_HINT_DOSKUTSU_PRELOAD_STAGE_MUSIC=0
+// restores the legacy frame-1 <CMU> gameplay load. Sentinel-cached.
 // (Mid-stage / boss <CMU> changes are out of scope -- they stay
 // allowlisted; preloading all music is infeasible.)
 static bool _preload_stage_music()
@@ -1273,9 +1276,9 @@ static bool _preload_stage_music()
   if (v < 0)
   {
     const char *e = std::getenv("SDL_HINT_DOSKUTSU_PRELOAD_STAGE_MUSIC");
-    v = (e && e[0] == '1' && e[1] == 0) ? 1 : 0;
-    LOG_INFO("load_stage: entry-music preload {} (set SDL_HINT_DOSKUTSU_PRELOAD_STAGE_MUSIC=1 to enable)",
-             v ? "ENABLED" : "disabled (default)");
+    v = (e && e[0] == '0' && e[1] == 0) ? 0 : 1;
+    LOG_INFO("load_stage: entry-music preload {} (set SDL_HINT_DOSKUTSU_PRELOAD_STAGE_MUSIC=0 to disable)",
+             v ? "ENABLED (default)" : "DISABLED (killswitch)");
   }
   return v == 1;
 }
