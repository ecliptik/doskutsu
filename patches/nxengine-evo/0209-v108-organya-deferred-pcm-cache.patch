index 92084aaf..04bb3fec 100644
--- a/src/map.cpp
+++ b/src/map.cpp
@@ -1253,6 +1253,8 @@ struct FtAccumulatorGuard
 extern "C" void io_audit_set_phase(int phase);
 // patch 0206 (#31 v1.0.8): organya pre-render post-load window arm (Organya.cpp).
 extern "C" void org_arm_postload_window(void);
+// patch 0209 (#31 v1.0.8): drain the 1-deep deferred organya cache (Organya.cpp).
+extern "C" void org_drain_pending_cache(void);
 struct IoAuditPhaseGuard
 {
   IoAuditPhaseGuard()  { io_audit_set_phase(1); }
@@ -1352,6 +1354,13 @@ bool load_stage(int stage_no)
   // Organya::start). extern "C" defined in Organya.cpp.
   org_arm_postload_window();
 
+  // patch 0209 (#31 v1.0.8): drain the 1-deep deferred organya cache. If a
+  // boss/event song played live-synth on a mid-gameplay <CMU (cache miss outside
+  // the post-load window), it is rendered + cached HERE, during this load pause
+  // (phase=load_stage), so a re-encounter is an instant cache HIT. No-op when the
+  // slot is empty / pre-render killswitched. extern "C" defined in Organya.cpp.
+  org_drain_pending_cache();
