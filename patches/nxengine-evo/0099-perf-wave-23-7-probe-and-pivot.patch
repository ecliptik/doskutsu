+        NXE::Diag::g_w237_drawtile_total_ns    = _t1 - _t0;
+        NXE::Diag::g_w237_raw_blit_total_ns    = _t3 - _t2;
+        NXE::Diag::g_w237_speedup_sample_count = kSpeedupBenchIters;
+        NXE::Diag::g_w237_speedup_measured     = true;
+
+        // Emit one-shot per docs/PHASE11-WAVE-23-7-CONTRACT.md § 4.2.
+        // µs precision (per-tile costs ~1-10 µs range; ms with .2f
+        // would lose resolution).
+        const double _drawtile_us =
+            (double)NXE::Diag::g_w237_drawtile_total_ns / 1000.0 /
+            (double)kSpeedupBenchIters;
+        const double _raw_blit_us =
+            (double)NXE::Diag::g_w237_raw_blit_total_ns / 1000.0 /
+            (double)kSpeedupBenchIters;
+        const double _ratio = (_raw_blit_us > 0.0)
+            ? (_drawtile_us / _raw_blit_us)
+            : 0.0;
+        LOG_INFO("[tile-speedup-stat n={} drawtile_us={:.2f} raw_blit_us={:.2f} ratio={:.2f}]",
+                 (unsigned)kSpeedupBenchIters,
+                 _drawtile_us, _raw_blit_us, _ratio);
+      }
+    }
+  }
 }
 
