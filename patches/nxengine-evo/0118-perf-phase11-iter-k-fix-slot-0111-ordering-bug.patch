-    // mds_tilemap_fg_total_ms readily aggregated here at block-flush
-    // time, compute by summing the W22.5 sample array.
-    double mds_fg_total_ms = 0.0;
-    {
-      const int n = NXE::Diag::g_mds_tilemap_fg_idx;
-      for (int i = 0; i < n; ++i)
