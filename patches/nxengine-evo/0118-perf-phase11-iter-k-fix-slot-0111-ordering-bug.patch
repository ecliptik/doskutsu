-        mds_fg_total_ms += (double)NXE::Diag::g_mds_tilemap_fg_samples[i] / 1.0e6;
-      }
-    }
+    // patch 0118 (Phase 11 iter K, slot 0111 ordering bug fix):
+    // consume the pre-reset snapshot computed above (BEFORE the
+    // W22.5 reset cluster zeroes g_mds_tilemap_fg_idx). Original
