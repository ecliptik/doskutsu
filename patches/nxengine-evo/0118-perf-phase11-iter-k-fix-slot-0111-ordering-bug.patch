     const double iter_overhead_ms = mds_fg_total_ms - dt_ms;
     const double visit_overhead_per_tile_us =
         (g_mds_tfg_tiles_visited > 0)
@@ -2286,6 +2324,13 @@ void _maybe_flush_phase_timing_audit()
     }
   }
 
+  // patch 0118 (Phase 11 iter K, slot 0111 ordering bug fix): reset
