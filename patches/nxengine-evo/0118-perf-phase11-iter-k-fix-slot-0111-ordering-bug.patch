 // docs/PHASE10-CONTRACT.md § 1. Storage sits alongside the W20B /
@@ -1858,6 +1868,44 @@ void _maybe_flush_phase_timing_audit()
     LOG_INFO("[mode-draw-scene-stat n={} phase=mds_residual               min={:.2f} med={:.2f} mean={:.2f} p95={:.2f} max={:.2f} ms]",
              n_res, st_res.min_ms, st_res.med_ms, st_res.mean_ms, st_res.p95_ms, st_res.max_ms);
   }
+  // patch 0118 (Phase 11 iter K, slot 0111 ordering bug fix). Slot
+  // 0111's emit block (further below) reads `g_mds_tilemap_fg_idx` +
+  // `g_mds_tilemap_fg_samples[]` to compute `mds_fg_total_ms` —
+  // the parent W22.5 bracket total used to derive
+  // `iter_overhead_ms = mds_fg_total_ms - dt_ms` and
+  // `visit_overhead_per_tile_us`. But the original slot 0111 emit
+  // ran AFTER the W22.5 sample-array reset just below (line moved
+  // here; was at the spot below this fix). Result: the slot 0111
+  // emit always saw `g_mds_tilemap_fg_idx == 0` → mds_fg_total_ms
+  // computed as 0 → iter_overhead_ms = 0 - dt_ms = NEGATIVE →
+  // visit_overhead_per_tile_us NEGATIVE every block (operator
+  // observed -58.03 µs / tile in iter J real-HW; smoke baseline
+  // -1.26 µs).
+  //
+  // Fix: snapshot mds_fg_total_ms NOW, before the reset zeroes out
+  // the sample idx. Function-scope local persists across the reset;
+  // slot 0111 emit block consumes the snapshotted value via
+  // g_slot_0118_mds_fg_total_ms_snapshot (file-scope static, written
+  // here, read by emit block, reset back to 0.0 at end of audit-flush
+  // alongside slot 0111's counter reset cluster).
+  //
+  // Why file-scope-static instead of function-scope local: the slot
+  // 0111 emit block lives 4 if-blocks deeper in this same function;
+  // a function-scope local would be in scope but the patch surface
+  // is cleaner with a named file-scope variable. Same lifetime
+  // discipline as the existing ABL counters; single writer (this
+  // function); no concurrency.
+  NXE::Diag::g_slot_0118_mds_fg_total_ms_snapshot = 0.0;
+  if (_abl_mds_tfg_instr())
+  {
+    const int n_pre_reset = NXE::Diag::g_mds_tilemap_fg_idx;
+    for (int i = 0; i < n_pre_reset; ++i)
+    {
+      NXE::Diag::g_slot_0118_mds_fg_total_ms_snapshot +=
+          (double)NXE::Diag::g_mds_tilemap_fg_samples[i] / 1.0e6;
+    }
+  }
