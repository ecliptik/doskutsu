@@ -5,7 +5,10 @@
 
 #include "../Utils/Logger.h"
 
+#include <SDL3/SDL.h>
+
 #include <cstdint>
+#include <cstring>
 
 // Cross-vendor extern declarations for SDL/0037+ MPU-401 helpers.
 // Public header lives at `vendor/SDL/src/core/dos/SDL_dos_audio_synth.h`
@@ -24,6 +27,12 @@ extern "C" {
   // reaches the dtor, so on a wedge the surviving witnesses are the flip()-side
   // first-nonzero + periodic emits (Renderer.cpp), not this total.
   extern volatile uint32_t doskutsu_mpu_write_count;
+  // patch 0219 (T48 iter-8): bounded-DRR-poll cap-hit counter (sdl-engine
+  // SDL/0097), bumped when the per-byte bit-6 poll reaches its cap without DRR
+  // going ready. The GS-reset witness reads its DELTA across the reset SysEx
+  // emit (R) -- R~0 = the multi-byte reset landed cleanly (Lever B creditable);
+  // R high = the reset itself overran (INVALID-for-B). Combined-build symbol.
+  extern volatile uint32_t doskutsu_mpu_drr_cap_hits;
 }
 
 namespace NXE
@@ -42,6 +51,31 @@ static constexpr uint8_t MIDI_PROGRAM_CHANGE = 0xC0;
 static constexpr uint8_t CC_ALL_SOUND_OFF = 0x78;  // 120 -- immediate cut
 static constexpr uint8_t CC_ALL_NOTES_OFF = 0x7B;  // 123 -- graceful release
 
+// patch 0219 (T48 iter-8): reset SysEx literals (from WBTEST-001-FINDINGS rev
+// sections). Synthesized at song-start to switch the Dream SAM2695 off its
+// non-GM power-up voice map. GS is the lead candidate (Dream chips honor the
+// Roland GS-mode engagement -> program 0 = acoustic grand piano, ch9 = GS drum
+// kit). All three were "ignored" in WBTEST-003 -- but under the no-poll OVERRUN
+// regime, where multi-byte messages corrupted; SDL/0097's per-byte DRR poll
+// removes the overrun, so these may now LAND. Opt-in A/B lever decides.
+static const uint8_t WB_SYSEX_GM[] = { 0xF0, 0x7E, 0x7F, 0x09, 0x01, 0xF7 };
+static const uint8_t WB_SYSEX_GS[] = { 0xF0, 0x41, 0x10, 0x42, 0x12, 0x40,
+                                       0x00, 0x7F, 0x00, 0x41, 0xF7 };
+static const uint8_t WB_SYSEX_XG[] = { 0xF0, 0x43, 0x10, 0x4C, 0x00, 0x00,
+                                       0x7E, 0x00, 0xF7 };
+
+// patch 0219: resolve the opt-in reset mode from the env hint (strict match;
+// default OFF). 0=none 1=gm 2=gs 3=xg.
+static int _resolve_wb_reset_mode()
+{
+  const char *v = SDL_GetHint("SDL_HINT_DOSKUTSU_AUDIO_WB_VOICE_RESET");
+  if (v == nullptr) return 0;
+  if (std::strcmp(v, "gm") == 0) return 1;
+  if (std::strcmp(v, "gs") == 0) return 2;
+  if (std::strcmp(v, "xg") == 0) return 3;
+  return 0; // "none", empty, or unrecognized -> OFF
+}
+
 MidiBackendWaveBlaster::MidiBackendWaveBlaster()
 {
   // Resolve the MPU-401 port from the BLASTER env var's Pxxxx field
@@ -79,6 +113,18 @@ MidiBackendWaveBlaster::MidiBackendWaveBlaster()
              "header.",
              _port_base);
   }
+
+  // patch 0219 (T48 iter-8): resolve the opt-in song-start reset mode once.
+  _reset_mode = _resolve_wb_reset_mode();
+  if (_reset_mode != 0)
+  {
+    static const char *const names[] = { "none", "GM", "GS", "XG" };
+    LOG_INFO("wb backend: song-start reset = {} (SDL_HINT_DOSKUTSU_AUDIO_WB_"
+             "VOICE_RESET; synthesizes a reset SysEx at each song-start to switch "
+             "the Dream SAM2695 voice map, since the scheduler discards stream "
+             "SysEx). Opt-in A/B lever; SDL/0097's DRR poll paces the bytes.",
+             names[_reset_mode]);
+  }
 }
 
 MidiBackendWaveBlaster::~MidiBackendWaveBlaster()
@@ -163,6 +209,37 @@ void MidiBackendWaveBlaster::program_change(int channel, int program)
 void MidiBackendWaveBlaster::on_song_start()
 {
   if (!_ready) return;
+  // patch 0219 (T48 iter-8): synthesize the opt-in reset SysEx FIRST -- the
+  // .mid's own SysEx is discarded by the scheduler, so this is the only way a
+  // GM/GS/XG reset reaches the Dream SAM2695. Emitted before the all-notes-off
+  // and before the song's first program_change events, so the chip is on the
+  // requested voice map when those program-changes land. Default OFF (mode 0).
+  if (_reset_mode != 0)
+  {
+    const uint8_t *sx = nullptr;
+    int k = 0;
+    switch (_reset_mode)
+    {
+      case 1: sx = WB_SYSEX_GM; k = (int)sizeof(WB_SYSEX_GM); break;
+      case 2: sx = WB_SYSEX_GS; k = (int)sizeof(WB_SYSEX_GS); break;
+      case 3: sx = WB_SYSEX_XG; k = (int)sizeof(WB_SYSEX_XG); break;
+      default: break;
+    }
+    if (sx)
+    {
+      // R = drr_cap_hits delta ACROSS the reset emit -- the Lever B landed-
+      // witness (CONTRACT 2.2). P=0: the lever sends only the reset SysEx; the
+      // song's own program-changes follow via normal dispatch and select voices
+      // on the now-reset voice map (no source for "correct" PCs at song-start).
+      const uint32_t cap0 = doskutsu_mpu_drr_cap_hits;
+      _send_sysex(sx, k);
+      const uint32_t r = doskutsu_mpu_drr_cap_hits - cap0;
+      LOG_INFO("WB GS-reset: {} bytes SysEx + {} program-changes sent to 0x330, "
+               "drr_cap_hits_during_reset={} (R~0 = reset landed cleanly, Lever B "
+               "creditable; R high = reset overran -> INVALID-for-B)",
+               k, 0, (unsigned long)r);
+    }
+  }
   // Clean state for the new song: silence any sustaining voices left
   // over from a prior song or from the engine's prior boot state.
   // GM program defaults (channel 0-15 = piano on most GM synths) are
@@ -173,6 +250,19 @@ void MidiBackendWaveBlaster::on_song_start()
   LOG_INFO("wb backend: on_song_start");
 }
 
+// patch 0219 (T48 iter-8): emit a raw SysEx byte stream to the MPU-401. Each
+// byte goes through SDL_DOSMpu401WriteByte, so under SDL/0097 the per-byte DRR
+// poll paces the stream and the chip does not overrun mid-message (the cause of
+// WBTEST-003's dropped resets). No 7-bit masking -- SysEx framing bytes 0xF0 /
+// 0xF7 are above 0x7F by design, and the manufacturer/data bytes are already
+// in-range in the canonical reset literals.
+void MidiBackendWaveBlaster::_send_sysex(const uint8_t *bytes, int n)
+{
+  if (!_ready) return;
+  for (int i = 0; i < n; ++i)
+    SDL_DOSMpu401WriteByte(bytes[i]);
+}
+
 void MidiBackendWaveBlaster::on_song_stop()
 {
   if (!_ready) return;
@@ -226,9 +316,15 @@ void MidiBackendWaveBlaster::silence_for_shutdown()
     SDL_DOSMpu401WriteByte(CC_ALL_NOTES_OFF);
     SDL_DOSMpu401WriteByte(0x00);
   }
-  LOG_INFO("wb backend: silence_for_shutdown (CC 123 on all 16 ch via "
-           "DSP cmd 0x38; pre-SoundManager-teardown coverage for "
-           "wave-41 hanging-note bug)");
+  // patch 0219 (T48 iter-8): corrected the stale transport claim. This CC123
+  // goes through SDL_DOSMpu401WriteByte, which on the cold-init path routes via
+  // the DIRECT-PORT transport -- the SAME one the play path used (s_mpu401_use_
+  // dsp stays false through teardown; sdl-engine confirmed). The wave-41 hanging
+  // note was NOT a transport mismatch but the H20 blind-write overrun of the
+  // CC123 triples; iter-8's per-byte DRR poll lands them = fixed.
+  LOG_INFO("wb backend: silence_for_shutdown (CC 123 on all 16 ch via the active "
+           "play transport (direct-port on the cold-init path); teardown silence "
+           "coverage)");
 }
 
 }  // namespace Sound
