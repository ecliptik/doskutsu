+++ b/src/graphics/Renderer.cpp
@@ -2044,6 +2044,14 @@ extern "C" {
   // symbol: a standalone nxengine link fails until sdl-engine's SDL patch
   // exporting it lands alongside (W22A combined-review pattern).
   extern volatile std::uint32_t doskutsu_mpu_write_count;
+  // patch 0219 (T48 iter-8): bounded bit-6 DRR-poll cap-hit counter + the cap
+  // value itself (sdl-engine SDL/0097). Appended to the periodic dispatch line
+  // as the Lever-A pacing-health signal (CONTRACT 2.1): ~0% of bytes capped =
+  // the restored poll is pacing cleanly; ~100% = chip persistently busy =
+  // latency-drag (music drags / audio starves; looks like a hang without being
+  // a true wedge). Combined-build symbols (resolve when SDL/0097 lands).
+  extern volatile std::uint32_t doskutsu_mpu_drr_cap_hits;
+  extern volatile std::uint32_t doskutsu_mpu_drr_cap;
 }
 
 // patch 0218 (T48): main-line WB MPU-dispatch-count witness. flush-instr's
@@ -2080,11 +2088,17 @@ void _maybe_flush_wb_dispatch_witness()
              (unsigned long)n, (unsigned long long)SDL_GetTicks(), _flip_total);
   }
   if ((_flip_total % _wb_dispatch_every_flips) != 0) return;
+  // patch 0219: append the Lever-A pacing-health tail (drr_cap_hits + pct + cap).
+  const std::uint32_t caps = doskutsu_mpu_drr_cap_hits;
+  const unsigned pct = (n > 0)
+      ? (unsigned)(((std::uint64_t)caps * 100ull) / n) : 0u;
   LOG_INFO("WB MPU dispatch: {} bytes written to 0x330 (cumulative, main-line, "
            "every {} flips, t={}ms flip={}) -- CLIMBING across blocks = sustained "
            "wavetable note traffic; frozen = cold-init cleared then wedged/silent "
-           "at first hot note", (unsigned long)n, _wb_dispatch_every_flips,
-           (unsigned long long)SDL_GetTicks(), _flip_total);
+           "at first hot note; drr_cap_hits={} ({}% of bytes capped, cap={})",
+           (unsigned long)n, _wb_dispatch_every_flips,
+           (unsigned long long)SDL_GetTicks(), _flip_total,
+           (unsigned long)caps, pct, (unsigned long)doskutsu_mpu_drr_cap);
 }
 
