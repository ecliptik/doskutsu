+  // power-up voice map is not GM-grand-piano; a GS/XG reset switches it.
+  void _send_sysex(const uint8_t *bytes, int n);
+
   bool _ready = false;
   uint16_t _port_base = 0;
+  // patch 0219: resolved once in the ctor from SDL_HINT_DOSKUTSU_AUDIO_WB_VOICE_RESET
+  // (gs|xg|gm|none; default none = OFF, opt-in A/B lever). 0=none 1=gm 2=gs 3=xg.
+  int _reset_mode = 0;
 };
 
