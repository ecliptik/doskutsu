+      // on real HW + DOSBox-X with lfn=false). New name "orgmid"
+      // (6 chars; clean; mirrors data/org/ parent pattern). Team-
+      // lead 2026-05-07 also moved data/midi-orgmid/ → data/orgmid/
+      // on disk + updated scripts/build-cs-midi-orgmid.py default
+      // output dir. Caught by my additional smoke after team-lead
+      // confirmed the dir was in tree (errno 22 not ENOENT was the
+      // diagnostic clue per dos_filename_8_3.md memory).
+      _midi_source_dir = "orgmid";
       LOG_INFO("MidiScheduler: MIDI source = 'orgmid' "
-               "(resolves to data/midi-orgmid/<name>.mid; literal ORGMID "
+               "(resolves to data/orgmid/<name>.mid; literal ORGMID "
                "transcription set generated by scripts/build-cs-midi-"
                "orgmid.py — alternative to the WiiWare arrangements for "
                "W22-WB-E A/B comparison; transposed +12 to match Cave "
