 namespace NXE
@@ -128,6 +129,29 @@ public:
   // Disarm playback. tick() becomes a no-op until next start().
   void stop();
 
+  // patch 0112 (Phase 11 iter H opt #1: front-load MIDI parsing).
+  // Parse `path` and store the resulting event list under `cache_key`
+  // in the in-memory preload cache. Idempotent re-call replaces the
+  // entry. Memory cost ~50 KB per typical Cave Story track × 41
+  // tracks ≈ 2 MB total resident. Used at SoundManager::init time
+  // to avoid the ~446 ms mid-gameplay file-parse spike per
+  // W22-WB-D PAUSE measurement (operator-perceived "studder during
+  // disk write" on song change).
+  //
+  // Returns true on parse success, false on parse failure (LOG_ERROR
+  // narrates which file failed; missing entry from cache means
+  // load_from_preload_cache returns false for that key + caller
+  // falls back to file-parse path).
+  bool add_to_preload_cache(const std::string &path,
+                            const std::string &cache_key);
+
+  // patch 0112: try to populate _events from the preload cache (lookup
+  // by `cache_key`). Returns true if found in cache (events copied,
+  // playback ready to start); false if not found (caller falls back
+  // to load(path) which reads + parses the file). Resets playback
+  // state same as load() does.
+  bool load_from_preload_cache(const std::string &cache_key);
+
   // Tear down the scheduler: stop any active playback (which fires
   // on_song_stop on the backend, propagating per-backend cleanup
   // like MidiBackendWaveBlaster's All-Notes-Off + MidiBackendOpl3's
@@ -214,6 +238,14 @@ private:
 
   std::vector<MidiEvent> _events;       // sorted by abs_tick
   std::unique_ptr<MidiBackend> _backend;
+
+  // patch 0112 (Phase 11 iter H opt #1: front-load MIDI parsing).
+  // In-memory cache of pre-parsed event lists, keyed by track name
+  // (e.g., "curly", "white", "gravity"). Populated at init via
+  // add_to_preload_cache; consulted at play-time via
+  // load_from_preload_cache. Empty by default (env unset → no
+  // preload). Resident size ~2 MB max (41 tracks × ~50 KB each).
+  std::unordered_map<std::string, std::vector<MidiEvent>> _preload_cache;
   std::uint16_t _division_ppq          = 480;  // SMF default if header had 0
   std::uint32_t _tempo_us_per_quarter  = 500000;  // SMF default = 120 BPM
   double        _us_per_tick           = 500000.0 / 480.0;
diff --git a/src/sound/SoundManager.cpp b/src/sound/SoundManager.cpp
index 5303442..b9af0da 100644
--- a/src/sound/SoundManager.cpp
+++ b/src/sound/SoundManager.cpp
@@ -544,6 +544,72 @@ bool SoundManager::init()
 
   _reloadTrackList();
 
+  // DOS-PORT (patch 0112, Phase 11 iter H opt #1: front-load MIDI
+  // parsing). When SDL_HINT_DOSKUTSU_PRELOAD_MIDI=1 AND backend is a
+  // MIDI-routed one (midi_stub / wb / opl3), pre-parse all .mid
+  // files in _midi_source_dir into MidiScheduler's preload cache.
+  // Eliminates the ~446ms mid-gameplay file-parse spike on song
+  // change (W22-WB-D measurement; operator-perceived as "studder
+  // during disk write" on PAUSE-equivalent runs).
+  //
+  // Memory cost: 41 tracks × ~50 KB each ≈ 2 MB resident; fits
+  // comfortably in 48 MB Tier-1 g2k.
+  // Init-time cost: 41 × ~10ms parse ≈ ~400 ms additional init delay.
+  // Acceptable since one-time at startup; eliminated mid-gameplay
+  // spike is the win.
+  //
+  // Only runs when env=1 AND a MIDI backend is selected — preload
+  // for organya-only runs is wasted work since _start_mid_track is
+  // never called.
+  {
+    const char *prl = SDL_GetHint("SDL_HINT_DOSKUTSU_PRELOAD_MIDI");
+    const bool prl_env =
+        prl && prl[0] == '1' && prl[1] == 0;
+    const bool midi_active =
+        (NXE::Diag::g_p10_audio_backend_active == NXE::Diag::AudioBackend::midi_stub) ||
+        (NXE::Diag::g_p10_audio_backend_active == NXE::Diag::AudioBackend::wb) ||
+        (NXE::Diag::g_p10_audio_backend_active == NXE::Diag::AudioBackend::opl3);
+    if (prl_env && midi_active)
+    {
+      _preload_midi_active = true;
+      int preloaded = 0;
+      int failed = 0;
+      LOG_INFO("MidiScheduler: preloading all tracks in data/{}/ to "
+               "in-memory cache (SDL_HINT_DOSKUTSU_PRELOAD_MIDI=1; "
+               "eliminates mid-gameplay file-parse spike at cost of "
+               "~400 ms init delay + ~2 MB resident memory)",
+               _midi_source_dir);
+      // _music_names[0] is "" (placeholder for songno=0 = stop).
+      // Skip it; iterate from index 1 onward.
+      for (size_t i = 1; i < _music_names.size(); ++i)
+      {
+        const std::string &name = _music_names[i];
+        if (name.empty()) continue;
+        const std::string path = ResourceManager::getInstance()->getPath(
+            _midi_source_dir + "/" + name + ".mid", false);
+        if (MidiScheduler::getInstance()->add_to_preload_cache(path, name))
+        {
+          ++preloaded;
+        }
+        else
+        {
+          ++failed;
+        }
+      }
+      LOG_INFO("MidiScheduler: preload complete — {} tracks cached, {} "
+               "failed (failed tracks will fall through to runtime "
+               "file-parse path on demand)",
+               preloaded, failed);
+    }
+    else if (prl_env)
+    {
+      LOG_INFO("MidiScheduler: SDL_HINT_DOSKUTSU_PRELOAD_MIDI=1 but no "
+               "MIDI backend selected (active={}); preload skipped to "
+               "save init time + memory",
+               NXE::Diag::backend_to_string(NXE::Diag::g_p10_audio_backend_active));
+    }
+  }
+
   Pixtone::getInstance()->init();
   Organya::getInstance()->init();
 
@@ -882,19 +948,33 @@ void SoundManager::_start_mid_track(int songno, bool resume)
 
   // patch 0107: use _midi_source_dir resolved at init from SDL_HINT_-
   // DOSKUTSU_AUDIO_MIDI_SOURCE. Default = "midi" (data/midi/);
-  // "orgmid" → "midi-orgmid" (data/midi-orgmid/).
-  const std::string path = ResourceManager::getInstance()->getPath(
-      _midi_source_dir + "/" + _music_names[songno] + ".mid", false);
-  if (MidiScheduler::getInstance()->load(path))
+  // "orgmid" → "data/orgmid/".
+  // patch 0112: when _preload_midi_active, try preload cache first
+  // (avoids ~446ms mid-gameplay file-parse spike). Fallback to
+  // file-parse on cache miss (e.g., track that failed to preload at
+  // init). Cache key is the track name (e.g., "curly").
+  const std::string &track_name = _music_names[songno];
+  bool loaded = false;
+  if (_preload_midi_active)
   {
-    MidiScheduler::getInstance()->start();
+    loaded = MidiScheduler::getInstance()->load_from_preload_cache(track_name);
   }
-  else
+  if (!loaded)
   {
-    LOG_WARN("SoundManager::_start_mid_track: could not load '{}' "
-             "(songno={}); music slot stays silent. Verify "
-             "scripts/fetch-cs-midi.py was run + data/{}/ contains "
-             "the file.", path, songno, _midi_source_dir);
+    const std::string path = ResourceManager::getInstance()->getPath(
+        _midi_source_dir + "/" + track_name + ".mid", false);
+    loaded = MidiScheduler::getInstance()->load(path);
+    if (!loaded)
+    {
+      LOG_WARN("SoundManager::_start_mid_track: could not load '{}' "
+               "(songno={}); music slot stays silent. Verify "
+               "scripts/fetch-cs-midi.py was run + data/{}/ contains "
+               "the file.", path, songno, _midi_source_dir);
+    }
+  }
+  if (loaded)
+  {
+    MidiScheduler::getInstance()->start();
   }
 }
 
