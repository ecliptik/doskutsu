diff --git a/src/sound/MidiScheduler.cpp b/src/sound/MidiScheduler.cpp
index 49ee670..8da53df 100644
--- a/src/sound/MidiScheduler.cpp
+++ b/src/sound/MidiScheduler.cpp
@@ -96,6 +96,101 @@ bool MidiScheduler::load(const std::string &path)
   return true;
 }
 
+// ----------------------------------------------------------------------
+// Preload cache (patch 0112 — Phase 11 iter H opt #1)
+// ----------------------------------------------------------------------
+
+bool MidiScheduler::add_to_preload_cache(const std::string &path,
+                                         const std::string &cache_key)
+{
+  // Reuse the existing file-read + SMF-parse path. Stash the resulting
+  // events vector in _preload_cache[cache_key] before swapping back to
+  // empty (so subsequent load() calls don't accidentally replay this
+  // file's events on the wrong track).
+  //
+  // Implementation reads file → parses → swaps _events into cache →
+  // resets _events to empty. The parse leaves _division_ppq and tempo
+  // state populated; we let load_from_preload_cache restore state from
+  // cache hit by re-reading defaults (tempo/division currently are
+  // global, not per-track — a future refinement could cache them too).
+  //
+  // For now: division is the ONLY per-track parsed state we store in
+  // the cache; tempo state (default 500000 us/quarter = 120 BPM) gets
+  // reset at start() so subsequent tempo events in cached event list
+  // re-establish per-track tempo correctly.
+  //
+  // Memory: events copied via std::vector::operator= (allocates new
+  // backing buffer for cache entry; original _events buffer gets
+  // freed). One copy at init; zero allocations at play-time after
+  // a cache hit.
+
+  // First clear _events so this preload doesn't pollute subsequent
+  // playback if no track is loaded between init-preload-loop and
+  // first music() call.
+  std::vector<MidiEvent> saved_events;
+  saved_events.swap(_events);
+
+  // Parse — reuses existing load() machinery. Note: load() also calls
+  // backend->on_song_stop if _playing, but at init time _playing is
+  // false → no spurious backend lifecycle calls.
+  const bool ok = load(path);
+
+  // Capture the parsed event list (whether ok or not — empty events
+  // for parse failures still get cached so we know not to retry on
+  // the same key).
+  if (ok)
+  {
+    _preload_cache[cache_key] = std::move(_events);
+  }
+
+  // Restore prior _events (currently empty unless a track was somehow
+  // loaded between init steps — defensive).
+  _events = std::move(saved_events);
+
+  return ok;
+}
+
+bool MidiScheduler::load_from_preload_cache(const std::string &cache_key)
+{
+  auto it = _preload_cache.find(cache_key);
+  if (it == _preload_cache.end())
+  {
+    return false;  // cache miss; caller falls back to load(path)
+  }
+
+  // Cache hit. Stop any current playback (mirrors load()'s prior-
+  // playback teardown so backend's on_song_stop fires for the prior
+  // track before we replace the event list).
+  if (_playing && _backend)
+  {
+    _backend->on_song_stop();
+  }
+  _playing = false;
+
+  // Copy from cache. ~5000 events × 12 bytes = ~60 KB; fast (sub-ms
+  // memcpy) vs 446 ms file-parse spike. The cache retains its own
+  // copy so subsequent loads of the same track don't re-parse.
+  _events = it->second;
+
+  // Reset playback position (same as load() does on parse success).
+  _next_event_idx = 0;
+  _current_tick = 0;
+  _position_us = 0;
+
+  // _division_ppq is preserved across cache hits because it's set by
+  // _parse_smf at preload time AND not reset by start(). For multiple
+  // tracks with different divisions, the most-recently-cached track's
+  // division wins — Cave Story tracks all use either 480 PPQ
+  // (WiiWare) or 24 PPQ (ORGMID) within the same source dir; first
+  // track preloaded establishes the active division for the run.
+  // (Robust fix would cache division per-key; deferred to wave-N+1
+  // if real-HW W26-A iter shows mistuned playback for some tracks.)
+
+  LOG_INFO("MidiScheduler::load_from_preload_cache: hit '{}' = {} events",
+           cache_key, (unsigned)_events.size());
+  return true;
+}
+
 // ----------------------------------------------------------------------
 // Playback control
 // ----------------------------------------------------------------------
