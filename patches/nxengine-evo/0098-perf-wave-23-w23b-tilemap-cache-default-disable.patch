 src/graphics/Renderer.cpp | 40 ++++++++++++++++++++++++++++++---------
 1 file changed, 31 insertions(+), 9 deletions(-)

diff --git a/src/graphics/Renderer.cpp b/src/graphics/Renderer.cpp
index e88364d..ca51089 100644
--- a/src/graphics/Renderer.cpp
+++ b/src/graphics/Renderer.cpp
@@ -344,17 +344,39 @@ inline bool _abl_mode_draw_scene_instr()
 }
 
 // DOS-PORT (patch 0097, Phase 9 wave 23 W23A Path B): tilemap-cache
-// killswitch. Strict-"0" match per contract sec. 3.2 -- default-ON cache
-// requires opt-OUT semantics. Setting SDL_HINT_DOSKUTSU_TILEMAP_CACHE=0
-// disables the cache (reverts to per-tile rendering for both BG and
-// FG layers); any other value (unset, "1", empty) keeps cache ENABLED.
-// Cache architecture in map.cpp short-circuits on this -- when true,
-// bypass cache check + render directly. Counter emission still gates
-// on MODE_DRAW_SCENE_INSTR; killswitch only affects cache architecture.
-// Cached static-const-bool -- -O2 hoists per-frame guards.
+// killswitch. Originally strict-"0" match (default-ON cache, opt-OUT
+// via "0") per wave-23 contract sec. 3.2.
+//
+// DOS-PORT (patch 0098, Phase 9 wave 23 W23B regression mitigation):
+// **DEFAULT FLIPPED to OFF** (= killswitch active by default; opt-IN
+// via "1"). Wave-23 W23A real-HW measurement found the cache is a
+// NET REGRESSION on real HW (Mimiga heavy-music +11.23 ms vs wave-22
+// baseline) per docs/PHASE11-WAVE-23-FINDINGS.md sec. 11. Mechanism:
+// cache miss path costs ~2x uncached render (render-INTO-cache +
+// blit-cache-TO-window are BOTH bandwidth-bound on PODP83); break-
+// even hit rate is 92% but real-HW gameplay aggregate is 44.7%.
+// Adaptive-alpha has two blind spots that prevented detection.
+//
+// Patch 0098 preserves the cache architecture + adaptive-alpha state
+// machine + 13-counter instrumentation + kbd diagnostic intact. ONLY
+// the default flips. Opt-IN via SDL_HINT_DOSKUTSU_TILEMAP_CACHE=1
+// for cache-on ablation iters. Wave-24 architectural redesign will
+// either remove the cache entirely or restructure to fix the 92%
+// break-even threshold (most likely: cache the rendered RESULT not
+// the per-tile inputs, so miss path becomes 1x not 2x the bandwidth
+// cost).
+//
+// Returns true (= killswitch active = cache disabled) UNLESS env is
+// strict-set to "1". Inverts the previous strict-falsy semantics.
+// Cached static-const-bool -- -O2 hoists per-frame guards. Counter
+// emission still gates on MODE_DRAW_SCENE_INSTR; killswitch only
+// affects cache architecture (counter-emission shows
+// `bg_state=D fg_state=D bg_h=0 bg_m=0 fg_h=0 fg_m=0` from block 1
+// per contract sec. 3.2's "killswitch-disabled (no transition history)"
+// distinguishability semantic -- unchanged by this default-flip).
 inline bool _abl_tilemap_cache_killswitch()
 {
-  static const bool v = _strict_falsy_env("SDL_HINT_DOSKUTSU_TILEMAP_CACHE");
+  static const bool v = !_strict_truthy_env("SDL_HINT_DOSKUTSU_TILEMAP_CACHE");
   return v;
 }
 
