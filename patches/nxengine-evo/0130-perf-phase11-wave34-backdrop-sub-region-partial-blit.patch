+// DOS-PORT (patch 0130, Phase 11 wave-34 backdrop sub-region partial
+// blit). Clipped variant of drawCachedBackdrop. Caller supplies the
+// inclusive screen-Y range [y_start, y_end_inclusive] (in unscaled
+// 320x240-base screen-pixel coordinates) where the backdrop should be
+// blitted from the cache surface to the window. Rows outside that
+// range are left untouched in the window (the FG layers will overwrite
+// them — they're fully FG-opaque per the FG-occlusion scan that
+// computed the range).
+//
+// Bandwidth savings = (1 - (y_end_inclusive - y_start + 1)/screenHeight)
+// of the full-screen drawCachedBackdrop's INDEX8 transfer cost. On
+// Mimiga Village BK_PARALLAX heavy-music the visible range is roughly
+// the upper ~50% of screen → ~50% bandwidth savings ≈ ~2 ms / flip on
+// PODP83+Cirrus (17 MB/s sysmem per `wave_19_path_b_dead.md`).
+//
+// Correctness: only safe to call when the caller has computed
+// (y_start, y_end_inclusive) from a sound visibility analysis. If
+// the range is wrong (e.g. claims FG-opaque rows are larger than
+// reality), the un-blitted rows will show stale framebuffer content
+// (last frame's pixels OR junk if frame 0). The wave-34 killswitch
+// `SDL_HINT_DOSKUTSU_BG_SUBREGION_BLIT=0` is the recovery path if
+// visual regression surfaces in real-HW smoke.
+//
+// Defensive clipping: clamps y_start to [0, src->h-1] and
+// y_end_inclusive to [y_start, src->h-1]. Returns true on a
+// zero-row range (no-op success) so callers don't error-handle the
+// degenerate case.
+bool Renderer::drawCachedBackdropClipped(SDL_Surface *src, int y_start, int y_end_inclusive)
+{
+  _DrawcallTimer _dct;
+  if (!src || !_cached_window_surface) return false;
+  if (src->format != _cached_window_surface->format) return false;
+  if (src->w != _cached_window_surface->w ||
+      src->h != _cached_window_surface->h) return false;
+
+  // Clamp to source bounds; empty range is a successful no-op.
+  if (y_start < 0) y_start = 0;
+  if (y_end_inclusive >= src->h) y_end_inclusive = src->h - 1;
+  if (y_start > y_end_inclusive) return true;
+
+  // Drain queued slow-path commands so they hit the window surface
+  // before we overwrite the bg layer beneath them (same rationale as
+  // drawCachedBackdrop above).
+  if (_renderer_queue_dirty)
+  {
+    SDL_FlushRenderer(_renderer);
+    _renderer_queue_dirty = false;
+  }
+
+  const int rows = (y_end_inclusive - y_start + 1);
+  SDL_Rect srect;
+  srect.x = 0;
+  srect.y = y_start * scale;
+  srect.w = src->w;
+  srect.h = rows * scale;
+  SDL_Rect drect;
+  drect.x = 0;
+  drect.y = y_start * scale;
+  drect.w = _cached_window_surface->w;
+  drect.h = rows * scale;
+
+  if (!SDL_BlitSurface(src, &srect, _cached_window_surface, &drect))
+  {
+    LOG_ERROR("Renderer::drawCachedBackdropClipped: SDL_BlitSurface failed: {}",
+              SDL_GetError());
+    return false;
+  }
+
+  _bump_drawcall();
+  _record_dirty_rect(0, y_start * scale, screenWidth * scale, rows * scale);
+  return true;
+}
+
