diff --git a/src/sound/MidiBackendWB.cpp b/src/sound/MidiBackendWB.cpp
new file mode 100644
index 0000000..63bd495
--- /dev/null
+++ b/src/sound/MidiBackendWB.cpp
@@ -0,0 +1,170 @@
+/* Cave Story port — Phase 10 Stage 3 (slot 0102). MidiBackendWaveBlaster
+ * implementation. See MidiBackendWB.h for design + API contract. */
+
+#include "MidiBackendWB.h"
+
+#include "../Utils/Logger.h"
+
+#include <cstdint>
+
+// Cross-vendor extern declarations for SDL/0037+ MPU-401 helpers.
+// Public header lives at `vendor/SDL/src/core/dos/SDL_dos_audio_synth.h`
+// (sdl-engine's lane) but is not part of SDL's public install include
+// path; engine-side references it here at file scope with C linkage so
+// the cross-vendor symbol resolution is mangling-agnostic. Same pattern
+// as slot 0100's `doskutsu_audio_*` extern decls.
+extern "C" {
+  bool SDL_DOSMpu401Init(uint16_t port_base);
+  void SDL_DOSMpu401WriteByte(uint8_t byte);
+  void SDL_DOSMpu401Shutdown(void);
+  uint16_t SDL_DOSMpu401GetBLASTERPort(void);
+}
+
+namespace NXE
+{
+namespace Sound
+{
+
+// MIDI message status nibble constants (high nibble = event type;
+// low nibble = channel 0-15).
+static constexpr uint8_t MIDI_NOTE_OFF       = 0x80;
+static constexpr uint8_t MIDI_NOTE_ON        = 0x90;
+static constexpr uint8_t MIDI_CONTROL_CHANGE = 0xB0;
+static constexpr uint8_t MIDI_PROGRAM_CHANGE = 0xC0;
+
+// MIDI Control Change numbers used by the song-boundary cleanup path.
+static constexpr uint8_t CC_ALL_SOUND_OFF = 0x78;  // 120 — immediate cut
+static constexpr uint8_t CC_ALL_NOTES_OFF = 0x7B;  // 123 — graceful release
+
+MidiBackendWaveBlaster::MidiBackendWaveBlaster()
+{
+  // Resolve the MPU-401 port from the BLASTER env var's Pxxxx field
+  // (defaults to 0x330 if BLASTER unset or P-field absent — the
+  // canonical MPU-401 port shared with most SB16-class hardware
+  // including the g2k Vibra16S CT2490).
+  _port_base = SDL_DOSMpu401GetBLASTERPort();
+  LOG_INFO("wb backend probing port 0x{:04x} for MPU-401...", _port_base);
+
+  // SDL_DOSMpu401Init returns true on probe success (sends MPU-401
+  // reset 0xFF, waits for ACK 0xFE, sends UART-mode entry 0x3F).
+  // Per SDL_dos_audio_synth.c implementation: ~10 ms wall-clock
+  // worst case if the chip is absent (init bails after status timeout).
+  _ready = SDL_DOSMpu401Init(_port_base);
+  if (_ready)
+  {
+    LOG_INFO("wb backend ready (MPU-401 at 0x{:04x}, UART mode active)",
+             _port_base);
+  }
+  else
+  {
+    LOG_INFO("wb backend probe failed at port 0x{:04x} — no MPU-401 "
+             "present (or chip did not ACK reset within timeout). Engine "
+             "falls back to organya per design's auto-detect-chain "
+             "semantics. This is expected under DOSBox-X (no MPU-401 "
+             "emulation in default config) and on g2k machines without a "
+             "DreamBlaster S2 daughterboard installed in the WaveBlaster "
+             "header.",
+             _port_base);
+  }
+}
+
+MidiBackendWaveBlaster::~MidiBackendWaveBlaster()
+{
+  if (_ready)
+  {
+    // Graceful shutdown: silence any sustaining notes, then send
+    // MPU-401 reset to restore BIOS-default state for any subsequent
+    // application that touches the chip.
+    _all_notes_off_all_channels();
+    SDL_DOSMpu401Shutdown();
+    LOG_INFO("wb backend shutdown (MPU-401 reset issued)");
+  }
+}
+
+void MidiBackendWaveBlaster::_send3(uint8_t status, uint8_t data1, uint8_t data2)
+{
+  if (!_ready) return;
+  // Defensive masking of data bytes to MIDI's 7-bit range. Status
+  // byte stays as caller passed it (status range 0x80-0xEF; all
+  // values legal). Mask data bytes to 0x7F so a malformed event from
+  // the parser cannot accidentally inject a status-byte-like value
+  // into the MPU-401 data stream and confuse the synth.
+  SDL_DOSMpu401WriteByte(status);
+  SDL_DOSMpu401WriteByte((uint8_t)(data1 & 0x7F));
+  SDL_DOSMpu401WriteByte((uint8_t)(data2 & 0x7F));
+}
+
+void MidiBackendWaveBlaster::_all_notes_off_all_channels()
+{
+  if (!_ready) return;
+  // Iterate channels 0-15. CC 120 (All Sound Off) cuts notes
+  // immediately ignoring release envelope — useful at song-stop /
+  // song-start to prevent drift. CC 123 (All Notes Off) is the
+  // graceful release-envelope-honoring alternative; we send both for
+  // hardware-quirk robustness (some GM synths handle 120 better; some
+  // handle 123 better).
+  for (int ch = 0; ch < 16; ++ch)
+  {
+    SDL_DOSMpu401WriteByte((uint8_t)(MIDI_CONTROL_CHANGE | ch));
+    SDL_DOSMpu401WriteByte(CC_ALL_SOUND_OFF);
+    SDL_DOSMpu401WriteByte(0x00);
+    SDL_DOSMpu401WriteByte((uint8_t)(MIDI_CONTROL_CHANGE | ch));
+    SDL_DOSMpu401WriteByte(CC_ALL_NOTES_OFF);
+    SDL_DOSMpu401WriteByte(0x00);
+  }
+}
+
+void MidiBackendWaveBlaster::note_on(int channel, int note, int velocity)
+{
+  _send3((uint8_t)(MIDI_NOTE_ON | (channel & 0x0F)),
+         (uint8_t)note, (uint8_t)velocity);
+}
+
+void MidiBackendWaveBlaster::note_off(int channel, int note, int velocity)
+{
+  _send3((uint8_t)(MIDI_NOTE_OFF | (channel & 0x0F)),
+         (uint8_t)note, (uint8_t)velocity);
+}
+
+void MidiBackendWaveBlaster::control_change(int channel, int controller, int value)
+{
+  _send3((uint8_t)(MIDI_CONTROL_CHANGE | (channel & 0x0F)),
+         (uint8_t)controller, (uint8_t)value);
+}
+
+void MidiBackendWaveBlaster::program_change(int channel, int program)
+{
+  // Program-change is a 2-byte MIDI message (status + program; no
+  // second data byte). Cannot use _send3 — write directly.
+  if (!_ready) return;
+  SDL_DOSMpu401WriteByte((uint8_t)(MIDI_PROGRAM_CHANGE | (channel & 0x0F)));
+  SDL_DOSMpu401WriteByte((uint8_t)(program & 0x7F));
+}
+
+void MidiBackendWaveBlaster::on_song_start()
+{
+  if (!_ready) return;
+  // Clean state for the new song: silence any sustaining voices left
+  // over from a prior song or from the engine's prior boot state.
+  // GM program defaults (channel 0-15 = piano on most GM synths) are
+  // restored by the synth's own GM reset; the .mid file's own
+  // program_change events will set the intended programs immediately
+  // after this on_song_start hook returns.
+  _all_notes_off_all_channels();
+  LOG_INFO("wb backend: on_song_start");
+}
+
+void MidiBackendWaveBlaster::on_song_stop()
+{
+  if (!_ready) return;
+  // Silence everything; the next on_song_start will re-clean before
+  // the new song's events fire. Without this, a song change mid-note
+  // would leave the prior note ringing on the WaveBlaster until
+  // either its release envelope fully decayed or a new note on the
+  // same channel/key clobbered it.
+  _all_notes_off_all_channels();
+  LOG_INFO("wb backend: on_song_stop");
+}
+
+}  // namespace Sound
+}  // namespace NXE
