--- /dev/null
+++ b/src/sound/MidiBackendWB.h
@@ -0,0 +1,82 @@
+/* Cave Story port — Phase 10 Stage 3 (slot 0102). MidiBackendWaveBlaster:
+ * concrete MidiBackend implementation that routes MIDI events to a
+ * WaveBlaster header / DreamBlaster S2 daughterboard via SDL/0037+'s
+ * MPU-401 helpers (SDL_DOSMpu401* family).
+ *
+ * Selected when SDL_HINT_DOSKUTSU_AUDIO_BACKEND=wb. SoundManager::init()
+ * probes via SDL_DOSMpu401Init at the port returned by
+ * SDL_DOSMpu401GetBLASTERPort (parses BLASTER env var Pxxxx field;
+ * defaults to 0x330 — the canonical MPU-401 port shared with most
+ * SB16-class hardware). On probe success, MidiBackendWB is installed on
+ * the singleton MidiScheduler. On probe failure (no MPU-401 present;
+ * common under DOSBox-X which does not emulate MPU-401), the engine
+ * falls back to organya with a clear LOG_INFO line — graceful
+ * degradation per the design's auto-detect-chain framing.
+ *
+ * Threading-zero invariant per CLAUDE.md: dispatch runs synchronously on
+ * the main loop's call stack (MidiScheduler::tick, called from
+ * SoundManager::runFade, called from main.cpp's run_tick). No worker
+ * threads; SDL_DOSMpu401WriteByte polls the MPU-401 status port
+ * inline. Per-write polling latency is sub-µs typical on real HW + a
+ * few µs worst case under DPMI; per-event cost (3-byte MIDI message)
+ * is ~10 µs total — effectively free at 30 fps tick rate.
+ *
+ * Stage 4 (slot 0103+) replaces the WB backend with OPL3 fallback for
+ * systems without WaveBlaster header but with SB16/Vibra16S OPL3 chip.
+ * Stage 5 wires up auto-detect chain: WB available → use WB; else
+ * OPL3 available → use OPL3; else organya.
+ */
+
+#ifndef _MIDI_BACKEND_WB_H
+#define _MIDI_BACKEND_WB_H
+
+#include "MidiScheduler.h"
+
+namespace NXE
+{
+namespace Sound
+{
+
+class MidiBackendWaveBlaster : public MidiBackend
+{
+public:
+  MidiBackendWaveBlaster();
+  ~MidiBackendWaveBlaster() override;
+
+  // True if SDL_DOSMpu401Init succeeded in the constructor; backend
+  // is bound on success, fallback engaged on failure. Polled by
+  // SoundManager::init() to decide whether to install on MidiScheduler
+  // or roll the active backend back to organya.
+  bool isReady() const { return _ready; }
+
+  void note_on(int channel, int note, int velocity)               override;
+  void note_off(int channel, int note, int velocity)              override;
+  void control_change(int channel, int controller, int value)     override;
+  void program_change(int channel, int program)                   override;
+  void on_song_start()                                            override;
+  void on_song_stop()                                             override;
+
+private:
+  // Send a 3-byte MIDI message via SDL_DOSMpu401WriteByte. Inline-friendly
+  // for the hot dispatch path; arguments masked to MIDI's 7-bit data
+  // ranges (0x00-0x7F) defensively in case malformed events slip
+  // through the parser (defensive belt-and-braces; well-formed SMF
+  // never violates this).
+  void _send3(uint8_t status, uint8_t data1, uint8_t data2);
+
+  // Send All-Notes-Off + All-Sound-Off CCs on every channel — used at
+  // song-start / song-stop boundaries to ensure no stuck notes carry
+  // over between songs (e.g., a note-on at the end of one .mid that
+  // never received its note-off, OR the loop-from-start in
+  // MidiScheduler triggering a re-dispatch with the prior note still
+  // sounding on the WaveBlaster).
+  void _all_notes_off_all_channels();
+
+  bool _ready = false;
+  uint16_t _port_base = 0;
+};
+
+}  // namespace Sound
+}  // namespace NXE
+
+#endif  // _MIDI_BACKEND_WB_H
