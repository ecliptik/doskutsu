+// (compares + branches in inner loop); NOT bandwidth-bound -- survives
+// wave-31's bandwidth-bound architectural finding per
+// `wave_17_4_partial_flush_regression.md`.
+inline bool _abl_tile_bounds_skip()
+{
+  static const bool v = []() {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_TILE_BOUNDS_SKIP");
+    return !(e && e[0] == '0' && e[1] == 0);
+  }();
+  return v;
+}
