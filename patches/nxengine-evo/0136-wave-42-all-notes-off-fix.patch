+void MidiScheduler::silence_for_shutdown()
+{
+  // Patch 0136 (wave 42): pre-SoundManager-teardown explicit silence.
+  // Delegates to backend; no scheduler state mutation. See
+  // MidiBackend::silence_for_shutdown header doc for the wave-41
+  // hanging-MIDI-note-on-quit root cause + flush-instr's analysis.
+  if (_backend)
+  {
+    _backend->silence_for_shutdown();
+  }
+}
+
 void MidiScheduler::shutdown()
 {
   // patch 0106 (Phase 10 OPL3 hanging-note fix): explicit teardown
diff --git a/src/sound/MidiScheduler.h b/src/sound/MidiScheduler.h
