 }
 
+void MidiBackendWaveBlaster::silence_for_shutdown()
+{
+  // Patch 0136 (wave 42; flush-instr WAVE-41-LOG-ANALYSIS.md sec. 4):
+  // emergency CC 123 (All Notes Off) emit on all 16 MIDI channels,
+  // called from SoundManager::shutdown() at the VERY START -- BEFORE
+  // any other DSP-touching teardown step.
+  //
+  // Wave-41 real-HW observation (operator-reported PLAY3/PLAY4):
+  // music note rings indefinitely after engine quit on g2k Vibra16S
+  // CT2490 + DreamBlaster S2. Note persists until reboot. Root cause
+  // (flush-instr WAVE-41-LOG-ANALYSIS sec. 4.2): the existing on_song_stop
+  // / dtor all-notes-off path was running (per captured log lines
+  // "wb backend: on_song_stop" + "wb backend shutdown") but the
+  // silence dispatch was failing to reach the daughterboard for one
+  // of three hypothesized reasons:
+  //   (a) WB backend's dtor logic bug under DSP cmd 0x38 dispatch
+  //       (some subtle state interaction with the SDL audio backend's
+  //       in-flight DSP DMA programming)
+  //   (b) MidiScheduler::stop not always firing on_song_stop at
+  //       shutdown (only at song-change)
+  //   (c) DreamBlaster S2 firmware-quirk ignoring CC 123 in some mode
+  //
+  // Mitigation: add an EARLIER explicit emit at the engine-shutdown
+  // boundary, well before the SDL audio backend's DSP DMA stops
+  // (which is the most plausible trigger for (a)/(b)). The existing
+  // on_song_stop + dtor all-notes-off path stays in place as belt-
+  // and-suspenders -- this is ADDITIONAL coverage, not a replacement.
+  //
+  // Tighter dispatch than _all_notes_off_all_channels: emit ONLY
+  // CC 123 (graceful release), not both CC 120 (immediate cut) and
+  // CC 123 like the existing helper. flush-instr's specific
+  // recommendation per LOG-ANALYSIS sec. 4.2 final paragraph.
+  // Reduces total byte count from 96 to 48; lower interleave risk
+  // with concurrent SDL audio teardown.
+  if (!_ready) return;
+  for (int ch = 0; ch < 16; ++ch)
+  {
+    SDL_DOSMpu401WriteByte((uint8_t)(MIDI_CONTROL_CHANGE | ch));
+    SDL_DOSMpu401WriteByte(CC_ALL_NOTES_OFF);
+    SDL_DOSMpu401WriteByte(0x00);
+  }
+  LOG_INFO("wb backend: silence_for_shutdown (CC 123 on all 16 ch via "
+           "DSP cmd 0x38; pre-SoundManager-teardown coverage for "
+           "wave-41 hanging-note bug)");
+}
+
 }  // namespace Sound
 }  // namespace NXE
