@@ -69,6 +69,20 @@ public:
   // (e.g., reset OPL3 voice allocator on song change) override these.
   virtual void on_song_start() {}
   virtual void on_song_stop()  {}
+
+  // Patch 0136 (wave 42; flush-instr's wave-41 LOG-ANALYSIS sec. 4):
+  // explicit emergency-silence hook called BEFORE SoundManager teardown
+  // touches the DSP. Independent of on_song_stop. Belt-and-suspenders
+  // for the wave-41-observed hanging-note bug on real DreamBlaster S2:
+  // SDL/0047's claim that DSP cmd 0xD3 (speaker off at audio CloseDevice)
+  // silences the WaveBlaster header was empirically refuted -- the
+  // WB header is MIDI-bus driven, not DAC-driven, so 0xD3 doesn't reach
+  // it. WB backend overrides this to emit CC 123 (All Notes Off) on all
+  // 16 MIDI channels via the DSP-mediated path while the chip is still
+  // in MIDI-UART mode. Other backends default no-op (OPL3's existing
+  // on_song_stop + dtor 18-voice KEY-OFF is correctness-complete; Stub
+  // has nothing to silence).
+  virtual void silence_for_shutdown() {}
 };
 
