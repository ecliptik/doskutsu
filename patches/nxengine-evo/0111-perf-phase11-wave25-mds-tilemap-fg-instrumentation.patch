@@ -507,6 +528,20 @@ inline bool _abl_p10_audio_instr()
   return v;
 }
 
+// DOS-PORT (patch 0111, Phase 11 wave-25 mds_tilemap_fg sub-decomposition
+// per docs/PHASE11-WAVE-25-CONTRACT.md): single env-var gate for the
+// 11-counter wave-25 instrumentation set. Strict-1 match per the
+// existing W22A/W22.5/W23 family pattern. Cached static-const-bool;
+// -O2 hoists per-tile guards in map.cpp's FG-loop. Default OFF;
+// counter overhead ~0.23 ms/flip when ENABLED (1.9% measurement
+// distortion at 12.36 ms baseline; acceptable for sub-bracket
+// fidelity per contract § 6).
+inline bool _abl_mds_tfg_instr()
+{
+  static const bool v = _strict_truthy_env("SDL_HINT_DOSKUTSU_MDS_TFG_INSTR");
+  return v;
+}
+
 // drawSurface NULL-texture diagnostic (Phase 7 black-screen bug, task #14).
 // Track which Surface objects produce NULL textures so we log each origin
 // once + a periodic running count, instead of hundreds of identical lines
@@ -2079,6 +2114,152 @@ void _maybe_flush_phase_timing_audit()
     NXE::Diag::g_p10_audio_idle_pause_us_block     = 0;
     NXE::Diag::g_p10_sfx_active_count_block        = 0;
   }
+
+  // patch 0111 (Phase 11 wave-25 mds_tilemap_fg sub-decomposition per
+  // docs/PHASE11-WAVE-25-CONTRACT.md): two-line emit per § 3 + 11-
+  // counter per-block reset. Distinct prefixes [mds-tfg-stat] +
+  // [mds-tfg-tiles] from existing [mode-draw-scene-stat] / [mds-
+  // tilemap-cache] (per § 3 + silent_narrow_pattern.md). Self-checks
+  // at emit time per § 6: tiles_visited == sum of buckets;
+  // drawtile_count + drawsprite_count == drawn_normal + drawn_special.
+  // Both checks are observational (logged delta if mismatch); not
+  // assertions (graceful fail-quiet for production builds; flush-instr
+  // analysis treats mismatch as red flag per § 8).
+  if (_abl_mds_tfg_instr())
+  {
+    using NXE::Diag::g_mds_tfg_drawtile_total_ns;
+    using NXE::Diag::g_mds_tfg_drawtile_count;
+    using NXE::Diag::g_mds_tfg_drawsprite_total_ns;
+    using NXE::Diag::g_mds_tfg_drawsprite_count;
+    using NXE::Diag::g_mds_tfg_blit_indexed_total_ns;
+    using NXE::Diag::g_mds_tfg_blit_indexed_count;
+    using NXE::Diag::g_mds_tfg_tiles_visited;
+    using NXE::Diag::g_mds_tfg_tiles_drawn_normal;
+    using NXE::Diag::g_mds_tfg_tiles_drawn_special;
+    using NXE::Diag::g_mds_tfg_tiles_skipped_attr;
+    using NXE::Diag::g_mds_tfg_tiles_skipped_oob;
+
+    const double drawtile_per_us =
+        (g_mds_tfg_drawtile_count > 0)
+            ? (double)g_mds_tfg_drawtile_total_ns / 1000.0 / (double)g_mds_tfg_drawtile_count
+            : 0.0;
+    const double drawsprite_per_us =
+        (g_mds_tfg_drawsprite_count > 0)
+            ? (double)g_mds_tfg_drawsprite_total_ns / 1000.0 / (double)g_mds_tfg_drawsprite_count
+            : 0.0;
+    const double blit_indexed_per_us =
+        (g_mds_tfg_blit_indexed_count > 0)
+            ? (double)g_mds_tfg_blit_indexed_total_ns / 1000.0 / (double)g_mds_tfg_blit_indexed_count
+            : 0.0;
+    const double drawtile_total_ms =
+        (double)g_mds_tfg_drawtile_total_ns / 1.0e6;
+    const double drawsprite_total_ms =
+        (double)g_mds_tfg_drawsprite_total_ns / 1.0e6;
+    // dt_ms = total wall-clock spent inside drawTile + drawSprite
+    // calls (the leaf calls inside the FG loop). Iter-overhead +
+    // mds_tilemap_fg total minus this gives loop-iteration cost.
+    const double dt_ms = drawtile_total_ms + drawsprite_total_ms;
+
+    // visit_overhead_per_tile_us = (mds_tilemap_fg_total_ms - dt_ms) /
+    // tiles_visited × 1000. mds_tilemap_fg_total_ms is the parent W22.5
+    // bracket total — accessed via g_mds_tilemap_fg_dt_this_tick? No,
+    // wait: the W22.5 dt_this_tick value is per-TICK not per-block;
+    // the BLOCK aggregate is in g_mds_tilemap_fg_samples[]. Computing
+    // a per-block sum from the samples is straightforward. Per § 3
+    // derived metrics: iter_overhead_ms = mds_tilemap_fg_total_ms -
+    // drawtile_total_ms - drawsprite_total_ms. Since we don't have
+    // mds_tilemap_fg_total_ms readily aggregated here at block-flush
+    // time, compute by summing the W22.5 sample array.
+    double mds_fg_total_ms = 0.0;
+    {
+      const int n = NXE::Diag::g_mds_tilemap_fg_idx;
+      for (int i = 0; i < n; ++i)
+      {
+        mds_fg_total_ms += (double)NXE::Diag::g_mds_tilemap_fg_samples[i] / 1.0e6;
+      }
+    }
+    const double iter_overhead_ms = mds_fg_total_ms - dt_ms;
+    const double visit_overhead_per_tile_us =
+        (g_mds_tfg_tiles_visited > 0)
+            ? (iter_overhead_ms * 1000.0 / (double)g_mds_tfg_tiles_visited)
+            : 0.0;
+    const double dispatch_overhead_per_tile_us =
+        (drawtile_per_us > blit_indexed_per_us)
+            ? (drawtile_per_us - blit_indexed_per_us)
+            : 0.0;
+
+    LOG_INFO("[mds-tfg-stat n={} phase=tilemap_fg dt_ms={:.2f} "
+             "drawtile_calls={} drawsprite_calls={} blit_indexed_calls={} "
+             "drawtile_per_us={:.2f} drawsprite_per_us={:.2f} "
+             "blit_indexed_per_us={:.2f}]",
+             _dc_tally_every_flips,
+             dt_ms,
+             g_mds_tfg_drawtile_count,
+             g_mds_tfg_drawsprite_count,
+             g_mds_tfg_blit_indexed_count,
+             drawtile_per_us,
+             drawsprite_per_us,
+             blit_indexed_per_us);
+
+    LOG_INFO("[mds-tfg-tiles n={} visited={} drawn_normal={} "
+             "drawn_special={} skipped_attr={} skipped_oob={} "
+             "visit_overhead_per_tile_us={:.2f} "
+             "dispatch_overhead_per_tile_us={:.2f}]",
+             _dc_tally_every_flips,
+             g_mds_tfg_tiles_visited,
+             g_mds_tfg_tiles_drawn_normal,
+             g_mds_tfg_tiles_drawn_special,
+             g_mds_tfg_tiles_skipped_attr,
+             g_mds_tfg_tiles_skipped_oob,
+             visit_overhead_per_tile_us,
+             dispatch_overhead_per_tile_us);
+
+    // Self-check (per § 6 + § 8 anti-narrative red flags). Mismatch
+    // logged for flush-instr's analysis. Not an assertion — production
+    // builds keep running; mismatch is a measurement-distortion red
+    // flag, not a correctness bug.
+    const std::uint32_t tiles_sum = g_mds_tfg_tiles_drawn_normal +
+                                    g_mds_tfg_tiles_drawn_special +
+                                    g_mds_tfg_tiles_skipped_attr +
+                                    g_mds_tfg_tiles_skipped_oob;
+    if (tiles_sum != g_mds_tfg_tiles_visited)
+    {
+      LOG_INFO("[mds-tfg-selfcheck WARN] tiles_visited={} != sum={} "
+               "(drawn_normal+drawn_special+skipped_attr+skipped_oob); "
+               "instrumentation drift — investigate per contract § 8 "
+               "anti-narrative red flags.",
+               g_mds_tfg_tiles_visited, tiles_sum);
+    }
+    const std::uint32_t draw_count_sum =
+        g_mds_tfg_drawtile_count + g_mds_tfg_drawsprite_count;
+    const std::uint32_t draw_buckets_sum =
+        g_mds_tfg_tiles_drawn_normal + g_mds_tfg_tiles_drawn_special;
+    if (draw_count_sum != draw_buckets_sum)
+    {
+      LOG_INFO("[mds-tfg-selfcheck WARN] drawtile+drawsprite counts={} "
+               "!= drawn_normal+drawn_special={}; call-count vs bucket "
+               "drift — investigate per contract § 8.",
+               draw_count_sum, draw_buckets_sum);
+    }
+  }
+
+  // Per-block reset of all 11 wave-25 counters regardless of env-var
+  // state (matches existing audit-flush family pattern; counters
+  // accumulate per-tick + reset per-block). The g_mds_tfg_loop_active
+  // flag is NOT reset here — it's set/cleared per-call by map.cpp's
