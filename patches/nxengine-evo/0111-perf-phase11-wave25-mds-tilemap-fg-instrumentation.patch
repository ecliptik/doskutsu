+// DOS-PORT (patch 0111, Phase 11 wave-25 mds_tilemap_fg sub-decomposition
+// per docs/PHASE11-WAVE-25-CONTRACT.md): 11 storage vars + 1 active
+// flag for instrumenting the 12.36-ms-per-flip FG-tilemap render hot
+// path under PAUSE-equivalent state. Decomposes into:
+//   - 3 sub-bracket timers (drawtile / drawsprite / blit_indexed)
+//   - 5 tile-category counts (visited / drawn_normal / drawn_special /
+//     skipped_attr / skipped_oob)
+// Plus 1 active flag (g_mds_tfg_loop_active) so _blit_indexed only
+// times when called from the FG-tilemap loop (not when called from
+// other drawcall paths like sprites or HUD).
+//
+// Per § 6 self-checks at emit time:
+//   tiles_visited == drawn_normal + drawn_special + skipped_attr + skipped_oob
+//   drawtile_count + drawsprite_count == drawn_normal + drawn_special
+//
+// Gated on SDL_HINT_DOSKUTSU_MDS_TFG_INSTR=1 (NEW; strict-1 per
+// `env_vars_document_in_user_docs.md`). Forward decl
+// `mds_tfg_instr_active()` definition lives at file-scope-after-both-
+// namespace-closes in Renderer.cpp per the W20B/W22A/W22.5/W23 build-
+// fix amendment pattern.
+//
+// Per § 6: counter overhead budget ~0.23 ms/flip (1.9% measurement
+// distortion at 12.36 ms baseline; acceptable for sub-bracket
+// fidelity). Single writer (engine main loop); not IRQ-context;
+// torn-read not a concern (uint64_t reads happen at audit-flush time
+// from the same thread).
+extern std::uint64_t g_mds_tfg_drawtile_total_ns;
+extern std::uint32_t g_mds_tfg_drawtile_count;
+extern std::uint64_t g_mds_tfg_drawsprite_total_ns;
+extern std::uint32_t g_mds_tfg_drawsprite_count;
+extern std::uint64_t g_mds_tfg_blit_indexed_total_ns;
+extern std::uint32_t g_mds_tfg_blit_indexed_count;
+extern std::uint32_t g_mds_tfg_tiles_visited;
+extern std::uint32_t g_mds_tfg_tiles_drawn_normal;
+extern std::uint32_t g_mds_tfg_tiles_drawn_special;
+extern std::uint32_t g_mds_tfg_tiles_skipped_attr;
+extern std::uint32_t g_mds_tfg_tiles_skipped_oob;
+
+// Set true by map.cpp's _tilemap_render_uncached_full_loop at entry
+// when foreground == TA_FOREGROUND AND env var is set; cleared at
+// exit. Gates _blit_indexed's RDTSC bracket so it only times calls
+// dispatched FROM the FG-tilemap loop (not from sprite / HUD / other
+// non-tilemap render paths).
+extern bool g_mds_tfg_loop_active;
+
+// Forward-decl env helper. Definition at Renderer.cpp's anonymous-
+// namespace ablation cluster (alongside _abl_flip_instr / _abl_-
+// fine_instr / _abl_mode_tick_instr / _abl_mode_draw_scene_instr);
+// forwarded via file-scope wrapper at end-of-Renderer.cpp per W20B
+// build-fix amendment pattern. Strict-1 match for
+// SDL_HINT_DOSKUTSU_MDS_TFG_INSTR.
+bool mds_tfg_instr_active();
+
