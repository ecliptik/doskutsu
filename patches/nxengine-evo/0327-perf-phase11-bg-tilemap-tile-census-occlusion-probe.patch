 // patch 0118 (Phase 11 iter K, slot 0111 ordering bug fix). Snapshot
 // of the W22.5 mds_tilemap_fg sample-sum (in ms). Written by
 // _maybe_flush_phase_timing_audit BEFORE the W22.5 reset cluster
@@ -522,6 +542,10 @@ bool p10_audio_instr_active();
 // mds_tfg_instr_active() forward-decl joins the family. Same file-
 // scope-after-both-namespace-closes definition pattern.
 bool mds_tfg_instr_active();
+// patch 0327 (BG-tilemap tile census + occlusion headroom probe):
+// mds_tbg_instr_active() forward-decl joins the family. Same file-
+// scope-after-both-namespace-closes definition pattern.
+bool mds_tbg_instr_active();
 // patch 0113 (Phase 11 iter H opt #2: off-screen tile bbox skip):
 // tile_bbox_skip_active() forward-decl. Same pattern.
 bool tile_bbox_skip_active();
@@ -846,6 +870,19 @@ inline bool _abl_mds_tfg_instr()
   return v;
 }
 
+// DOS-PORT (patch 0327: BG-tilemap tile census + occlusion headroom
+// probe). BG-pass sibling of _abl_mds_tfg_instr. Default OFF; strict-1
+// match. When set, map.cpp's _tilemap_render_uncached_full_loop counts
+// the BG pass (foreground == 0) into the g_mds_tbg_* counters and this
+// file's audit-flush emits [mds-tbg-tiles] / [mds-tbg-stat]. Cached
+// static-const-bool; -O2 hoists the per-call guard. Zero cost when
+// unset (BG-pass instr_on stays false).
+inline bool _abl_mds_tbg_instr()
+{
+  static const bool v = _strict_truthy_env("SDL_HINT_DOSKUTSU_MDS_TBG_INSTR");
+  return v;
+}
+
 // DOS-PORT (patch 0125, Phase 11 wave-29 mds_tilemap_bg sub-decomposition
 // per docs/PHASE11-WAVE-29-CONTRACT.md): env-var gate for the 3 sub-
 // bucket RAII timers + 1 derived residual sub-decomposing W22.5's
@@ -3795,6 +3832,117 @@ void _maybe_flush_phase_timing_audit()
   NXE::Diag::g_mds_tfg_tiles_drawn_special      = 0;
   NXE::Diag::g_mds_tfg_tiles_skipped_attr       = 0;
   NXE::Diag::g_mds_tfg_tiles_skipped_oob        = 0;
+
+  // patch 0327 (BG-tilemap tile census + occlusion headroom probe):
+  // two-line emit for the BG pass -- [mds-tbg-stat] (timing) +
+  // [mds-tbg-tiles] (counts + occlusion) -- mirroring the wave-25 tfg
+  // block above, plus drawn_tile0 and player_occluded. Distinct prefix
+  // mds-tbg (vs patch 0125's mds-bg timing) so grep stays clean.
+  // Self-check identical in shape to tfg's: observational, not an
+  // assertion.
+  if (_abl_mds_tbg_instr())
+  {
+    using NXE::Diag::g_mds_tbg_drawtile_total_ns;
+    using NXE::Diag::g_mds_tbg_drawtile_count;
+    using NXE::Diag::g_mds_tbg_drawsprite_total_ns;
+    using NXE::Diag::g_mds_tbg_drawsprite_count;
+    using NXE::Diag::g_mds_tbg_tiles_visited;
+    using NXE::Diag::g_mds_tbg_tiles_drawn_normal;
+    using NXE::Diag::g_mds_tbg_tiles_drawn_special;
+    using NXE::Diag::g_mds_tbg_tiles_skipped_attr;
+    using NXE::Diag::g_mds_tbg_tiles_skipped_oob;
+    using NXE::Diag::g_mds_tbg_tiles_drawn_tile0;
+    using NXE::Diag::g_mds_tbg_tiles_player_occluded;
+
+    const double bg_drawtile_per_us =
+        (g_mds_tbg_drawtile_count > 0)
+            ? (double)g_mds_tbg_drawtile_total_ns / 1000.0 / (double)g_mds_tbg_drawtile_count
+            : 0.0;
+    const double bg_drawsprite_per_us =
+        (g_mds_tbg_drawsprite_count > 0)
+            ? (double)g_mds_tbg_drawsprite_total_ns / 1000.0 / (double)g_mds_tbg_drawsprite_count
+            : 0.0;
+    const double bg_drawtile_total_ms =
+        (double)g_mds_tbg_drawtile_total_ns / 1.0e6;
+    const double bg_drawsprite_total_ms =
+        (double)g_mds_tbg_drawsprite_total_ns / 1.0e6;
+    const double bg_dt_ms = bg_drawtile_total_ms + bg_drawsprite_total_ms;
+
+    // Fraction of blitted BG tiles that are candidates to skip. The
+    // two occlusion buckets can overlap (a tile-0 cell can also sit
+    // under the player), so they are NOT summed -- reported separately.
+    const double tile0_pct_x10 =
+        (g_mds_tbg_tiles_drawn_normal > 0)
+            ? (double)(g_mds_tbg_tiles_drawn_tile0 * 1000u) / (double)g_mds_tbg_tiles_drawn_normal
+            : 0.0;
+    const double player_occ_pct_x10 =
+        (g_mds_tbg_tiles_drawn_normal > 0)
+            ? (double)(g_mds_tbg_tiles_player_occluded * 1000u) / (double)g_mds_tbg_tiles_drawn_normal
+            : 0.0;
+
+    LOG_INFO("[mds-tbg-stat n={} phase=tilemap_bg dt_ms={:.2f} "
+             "drawtile_calls={} drawsprite_calls={} "
+             "drawtile_per_us={:.2f} drawsprite_per_us={:.2f}]",
+             _dc_tally_every_flips,
+             bg_dt_ms,
+             g_mds_tbg_drawtile_count,
+             g_mds_tbg_drawsprite_count,
+             bg_drawtile_per_us,
+             bg_drawsprite_per_us);
+
+    LOG_INFO("[mds-tbg-tiles n={} visited={} drawn_normal={} "
+             "drawn_special={} skipped_attr={} skipped_oob={} "
+             "drawn_tile0={} player_occluded={} "
+             "tile0_pct_x10={:.0f} player_occ_pct_x10={:.0f}]",
+             _dc_tally_every_flips,
+             g_mds_tbg_tiles_visited,
+             g_mds_tbg_tiles_drawn_normal,
+             g_mds_tbg_tiles_drawn_special,
+             g_mds_tbg_tiles_skipped_attr,
+             g_mds_tbg_tiles_skipped_oob,
+             g_mds_tbg_tiles_drawn_tile0,
+             g_mds_tbg_tiles_player_occluded,
+             tile0_pct_x10,
+             player_occ_pct_x10);
+
+    // Self-check (mirror of the tfg block): visited == sum of the four
+    // disposition buckets. drawn_tile0 / player_occluded are SUBSETS of
+    // drawn_normal, so they are deliberately NOT part of this equality.
+    const std::uint32_t bg_tiles_sum = g_mds_tbg_tiles_drawn_normal +
+                                       g_mds_tbg_tiles_drawn_special +
+                                       g_mds_tbg_tiles_skipped_attr +
+                                       g_mds_tbg_tiles_skipped_oob;
+    if (bg_tiles_sum != g_mds_tbg_tiles_visited)
+    {
+      LOG_INFO("[mds-tbg-selfcheck WARN] tiles_visited={} != sum={} "
+               "(drawn_normal+drawn_special+skipped_attr+skipped_oob); "
+               "instrumentation drift.",
+               g_mds_tbg_tiles_visited, bg_tiles_sum);
+    }
+    if (g_mds_tbg_tiles_drawn_tile0 > g_mds_tbg_tiles_drawn_normal ||
+        g_mds_tbg_tiles_player_occluded > g_mds_tbg_tiles_drawn_normal)
+    {
+      LOG_INFO("[mds-tbg-selfcheck WARN] subset counter exceeds "
+               "drawn_normal={} (tile0={} player_occluded={}); a subset "
+               "bucket must be <= its parent.",
+               g_mds_tbg_tiles_drawn_normal,
+               g_mds_tbg_tiles_drawn_tile0,
+               g_mds_tbg_tiles_player_occluded);
+    }
+  }
+  // patch 0327: per-block reset of all 11 BG-census counters regardless
+  // of env-var state (matches the tfg cluster pattern).
+  NXE::Diag::g_mds_tbg_drawtile_total_ns        = 0;
+  NXE::Diag::g_mds_tbg_drawtile_count           = 0;
+  NXE::Diag::g_mds_tbg_drawsprite_total_ns      = 0;
+  NXE::Diag::g_mds_tbg_drawsprite_count         = 0;
+  NXE::Diag::g_mds_tbg_tiles_visited            = 0;
+  NXE::Diag::g_mds_tbg_tiles_drawn_normal       = 0;
+  NXE::Diag::g_mds_tbg_tiles_drawn_special      = 0;
+  NXE::Diag::g_mds_tbg_tiles_skipped_attr       = 0;
+  NXE::Diag::g_mds_tbg_tiles_skipped_oob        = 0;
+  NXE::Diag::g_mds_tbg_tiles_drawn_tile0        = 0;
+  NXE::Diag::g_mds_tbg_tiles_player_occluded    = 0;
 }
 
