 // SDL_HINT_DOSKUTSU_MDS_TFG_INSTR.
 bool mds_tfg_instr_active();
 
+// patch 0327 (Phase 11 backdrop-thrash follow-up: BG-tilemap tile
+// census + occlusion headroom probe). The wave-25 patch 0111 counters
+// above instrument ONLY the FG pass (foreground == TA_FOREGROUND); the
+// BG tile pass (map_draw(false), the ~9 ms "mdt_bg_tilelayer" bucket
+// that MDS_BG_INSTR times but does not decompose by tile) had no
+// per-tile census. This block mirrors the tfg counter set for the BG
+// pass and adds two occlusion-headroom counters.
+//
+// Distinct from patch 0125's SDL_HINT_DOSKUTSU_MDS_BG_INSTR, which
+// emits [mds-bg-stat] TIMING only (backdrop / tilelayer / tintscreen /
+// residual ms). This instrument emits [mds-tbg-tiles] / [mds-tbg-stat]
+// COUNTS: how many tiles the 9 ms represents, and how much of it is
+// potentially skippable. It is the BG sibling of MDS_TFG_INSTR
+// ([mds-tfg-tiles]); the one-letter prefix gap (mds-bg vs mds-tbg) is
+// intentional and greppable-distinct.
+//
+// Occlusion semantics (why only these two occluders exist). Each map
+// cell holds exactly one tile, routed to exactly one pass by
+// `(tileattr[t] & TA_FOREGROUND) == foreground`, so FG tiles and BG
+// tiles are never at the same cell -- an FG tile can never occlude a
+// BG tile. The BG tile layer's only real occluders are therefore:
+//   drawn_tile0        -- BG tiles drawn with tile index 0 (the empty
+//                         tile). Over a backdrop map these blits may
+//                         produce no visible pixels -> a cheap,
+//                         free-to-exploit skip candidate (a t==0 test
+//                         is already available in the hot loop).
+//   tiles_player_occluded
+//                      -- BG tiles whose 16x16 screen rect sits FULLY
+//                         inside the player sprite's on-screen rect.
+//                         A CONSERVATIVE UPPER bound on player-sprite
+//                         occlusion (the bbox is a superset of opaque
+//                         pixels). Player-only by design (approved
+//                         scope): the player is the single most
+//                         consistent on-screen sprite. Quote's sprite
+//                         is ~16x16, so this is expected SMALL (0-2);
+//                         a large value would be surprising and worth
+//                         a note. Full per-object occlusion is
+//                         deliberately NOT measured here -- O(tiles x
+//                         objects) coupling, and even a found headroom
+//                         is not cheaply exploitable (a runtime skip
+//                         would need a per-frame coverage map, whose
+//                         maintenance cost risks the same
+//                         cost-eats-the-win trap as patch 0127).
+//
+// Gated on SDL_HINT_DOSKUTSU_MDS_TBG_INSTR=1 (strict-1; default OFF,
+// so production is byte-unchanged -- the BG-pass instr_on stays false
+// and no counter/timer site runs). Single writer (engine main loop),
+// not IRQ-context; same torn-read reasoning as the tfg block.
+extern std::uint64_t g_mds_tbg_drawtile_total_ns;
+extern std::uint32_t g_mds_tbg_drawtile_count;
+extern std::uint64_t g_mds_tbg_drawsprite_total_ns;
+extern std::uint32_t g_mds_tbg_drawsprite_count;
+extern std::uint32_t g_mds_tbg_tiles_visited;
+extern std::uint32_t g_mds_tbg_tiles_drawn_normal;
+extern std::uint32_t g_mds_tbg_tiles_drawn_special;
+extern std::uint32_t g_mds_tbg_tiles_skipped_attr;
+extern std::uint32_t g_mds_tbg_tiles_skipped_oob;
+extern std::uint32_t g_mds_tbg_tiles_drawn_tile0;
+extern std::uint32_t g_mds_tbg_tiles_player_occluded;
+
+// Forward-decl env helper. Definition in Renderer.cpp's anonymous-
+// namespace ablation cluster; forwarded via file-scope wrapper at
+// end-of-Renderer.cpp per the W20B build-fix amendment pattern.
+// Strict-1 match for SDL_HINT_DOSKUTSU_MDS_TBG_INSTR.
+bool mds_tbg_instr_active();
+
 // patch 0113 (Phase 11 iter H opt #2: off-screen tile bbox skip).
 // Forward-decl env helper for the killswitch. When ENABLED, the
 // FG-tilemap loop pre-computes a clipped (mapx, mapy)-rectangle
