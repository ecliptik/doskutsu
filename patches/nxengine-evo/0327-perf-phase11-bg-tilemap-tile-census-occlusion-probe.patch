+std::uint64_t g_mds_tbg_drawtile_total_ns         = 0;
+std::uint32_t g_mds_tbg_drawtile_count            = 0;
+std::uint64_t g_mds_tbg_drawsprite_total_ns       = 0;
+std::uint32_t g_mds_tbg_drawsprite_count          = 0;
+std::uint32_t g_mds_tbg_tiles_visited             = 0;
+std::uint32_t g_mds_tbg_tiles_drawn_normal        = 0;
+std::uint32_t g_mds_tbg_tiles_drawn_special       = 0;
+std::uint32_t g_mds_tbg_tiles_skipped_attr        = 0;
+std::uint32_t g_mds_tbg_tiles_skipped_oob         = 0;
+std::uint32_t g_mds_tbg_tiles_drawn_tile0         = 0;
+std::uint32_t g_mds_tbg_tiles_player_occluded     = 0;
