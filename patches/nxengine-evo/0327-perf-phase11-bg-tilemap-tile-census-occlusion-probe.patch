@@ -356,6 +356,26 @@ std::uint32_t g_mds_tfg_tiles_skipped_attr        = 0;
 std::uint32_t g_mds_tfg_tiles_skipped_oob         = 0;
 bool          g_mds_tfg_loop_active               = false;
 
+// patch 0327 (Phase 11 backdrop-thrash follow-up: BG-tilemap tile
+// census + occlusion headroom probe). BG-pass sibling of the wave-25
