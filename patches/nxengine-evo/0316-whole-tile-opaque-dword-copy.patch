+// DOS-PORT (patch 0316): whole-tile opaque dispatch.
+//
+// Cached-at-boot gate. True when the operator opted in with
+// SDL_HINT_DOSKUTSU_TILE_DWORD_COPY=1. Deliberately NOT named
+// OPAQUE_TILE_FASTPATH: that literal is carried in the gameplay-smoke
+// gate at severity `forbidden` and its reappearance FAILS the gate. The
+// wave-38 lever of that name was reverted as part of a batch rollback --
+// never judged on merit -- and the name is retained purely as a
+// revert-detector. See the BOOT.md entry.
+bool tile_dword_copy_enabled();
+
+// Scan an INDEX8 tilesheet and return a byte per 16x16 tile cell: 1 when
+// the cell contains NO colorkey pixel, 0 otherwise. Row-major over the
+// sheet's tile grid, (s->w / 16) entries per row. Caller owns the pointer
+// (delete[] it). Returns nullptr if the surface is unusable or its
+// dimensions are not whole tiles.
+//
+// Tile opacity is a property of tile CONTENT, so this table never needs
+// per-frame invalidation: camera motion does not change it, and a
+// destructible tile changes the tile INDEX, not the pixels behind an
+// index. It is rebuilt on surface reload via Surface::cleanup(), which
+// is the only event that can change the pixels.
+unsigned char *build_opaque_tile_table(SDL_Surface *s, std::uint8_t colorkey);
+
 }; // namespace Graphics
 }; // namespace NXE
 
