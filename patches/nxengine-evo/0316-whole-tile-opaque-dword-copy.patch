--- a/src/graphics/Surface.cpp
+++ b/src/graphics/Surface.cpp
@@ -664,6 +664,29 @@ const BlitSpanTable *Surface::spanTable()
   return _span_table;
 }
 
+// DOS-PORT (patch 0316): whole-tile opacity accessor. Mirrors spanTable()
+// exactly -- probe once, cache for the surface's lifetime, return nullptr
+// at zero cost thereafter for a non-candidate surface (lever off,
+// non-INDEX8, or no colorkey). The scan and the gate both live in
+// Renderer.cpp beside the blit primitives that consume them.
+//
+// The colorkey handed to the builder is the surface's OWN _colorkey, not
+// an assumed index. Getting that wrong would silently strip transparency
+// from tiles that have it -- a visible artifact rather than a crash.
+const unsigned char *Surface::opaqueTileTable()
+{
+  if (!_opaque_tile_table_built)
+  {
+    _opaque_tile_table_built = true;
+    if (tile_dword_copy_enabled() && _surface_cpu && _has_colorkey &&
+        _surface_cpu->format == SDL_PIXELFORMAT_INDEX8)
+    {
+      _opaque_tile_table = build_opaque_tile_table(_surface_cpu, (Uint8)_colorkey);
+    }
+  }
+  return _opaque_tile_table;
+}
+
 void Surface::cleanup()
 {
   if (_texture)
@@ -686,6 +709,10 @@ void Surface::cleanup()
   delete _span_table;
   _span_table = nullptr;
   _span_table_built = false;
+  // DOS-PORT (patch 0316): same lifetime as the span table.
+  delete[] _opaque_tile_table;
+  _opaque_tile_table = nullptr;
+  _opaque_tile_table_built = false;
   _has_colorkey = false;
   _colorkey = 0;
 }
