+// DOS-PORT (patch 0180, SFXPAUSE-013): phase-tagged gameplay-IO-audit
+// hook -- the permanent lazy-IO landmine detector that powers the
+// no-gameplay-IO dev gate. Every instrumented filesystem-IO entry
+// point emits its CURRENT game phase, so a DOSBox-X run maps each IO
+// op to WHEN it happens. phase=gameplay IO = a latent real-HW stall
+// (the actionable subset); phase=boot / phase=load_stage IO is
+// expected. Phase enum: 0 boot / 1 load_stage / 2 gameplay; the
+// load_stage RAII guard (map.cpp) sets load_stage on all return
+// paths, restoring gameplay on exit (boot -> gameplay implicit on
+// the first load_stage's guard dtor). Default OFF; opt-in via strict
+// "1" on SDL_HINT_DOSKUTSU_IO_AUDIT.
+static int g_io_audit_phase   = 0;   // 0 boot / 1 load_stage / 2 gameplay
+static int g_io_audit_decided = -1;
+static bool io_audit_active_main()
+{
+  if (g_io_audit_decided < 0)
+  {
+    const char *e = SDL_GetHint("SDL_HINT_DOSKUTSU_IO_AUDIT");
+    g_io_audit_decided = (e && e[0] == '1' && e[1] == '\0') ? 1 : 0;
+    if (g_io_audit_decided)
+    {
+      LOG_INFO("IO audit: ENABLED (opt-in via SDL_HINT_DOSKUTSU_IO_AUDIT=1; "
+               "emits one [io-audit] line per filesystem-IO op tagged with "
+               "the current game phase; phase=gameplay is the actionable "
+               "lazy-IO-landmine subset; default OFF)");
+    }
+  }
+  return g_io_audit_decided == 1;
+}
+
+// patch 0180 extern accessors for the instrumented IO sites in
+// graphics/Surface.cpp, tsc.cpp, sound/Organya.cpp, sound/Ogg.cpp,
+// profile.cpp + the phase guard in map.cpp.
+extern "C" bool io_audit_enabled(void) { return io_audit_active_main(); }
+extern "C" void io_audit_set_phase(int phase) { g_io_audit_phase = phase; }
+extern "C" int  io_audit_get_phase(void) { return g_io_audit_phase; }
+extern "C" void io_audit_emit(const char *op, const char *path,
+                              long bytes, unsigned long long wall_us)
+{
+  if (!io_audit_active_main())
+    return;
+  static const char *const _phase_names[] = {"boot", "load_stage", "gameplay"};
+  int p = g_io_audit_phase;
+  if (p < 0 || p > 2) p = 0;
+  // Reduce the path to its basename so the log line stays short on
+  // DOS-length paths. Handle both '/' and '\\' separators.
+  const char *base = path ? path : "(null)";
+  if (path)
+  {
+    const char *s1 = SDL_strrchr(path, '/');
+    const char *s2 = SDL_strrchr(path, '\\');
+    const char *s  = (s1 > s2) ? s1 : s2;
+    if (s) base = s + 1;
+  }
+  LOG_INFO("[io-audit] phase={} op={} file={} bytes={} wall_us={}",
+           _phase_names[p], op ? op : "(null)", base, bytes, wall_us);
+}
