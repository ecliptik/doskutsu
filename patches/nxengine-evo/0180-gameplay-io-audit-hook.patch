+// patch 0180 (SFXPAUSE-013) IO-audit phase setter (body in main.cpp)
+// + RAII guard that sets phase=load_stage(1) at load_stage entry and
+// restores gameplay(2) on every return path. boot(0) -> gameplay is
+// implicit on the first load_stage's dtor. So IO ops inside
+// load_stage tag phase=load_stage; main-loop IO tags phase=gameplay;
+// pre-first-stage IO (Sprites::init, title) tags phase=boot.
+extern "C" void io_audit_set_phase(int phase);
+struct IoAuditPhaseGuard
+{
+  IoAuditPhaseGuard()  { io_audit_set_phase(1); }
+  ~IoAuditPhaseGuard() { io_audit_set_phase(2); }
+};
