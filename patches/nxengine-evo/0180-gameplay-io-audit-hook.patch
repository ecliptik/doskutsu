@@ -333,17 +338,32 @@ void Song::Synth()
 
 bool Organya::load(const std::string &fname)
 {
+  // patch 0180 (SFXPAUSE-013) IO-audit bracket. Organya .org load +
+  // synth-table setup. A mid-gameplay <CMU (boss music) tags
+  // phase=gameplay -- a candidate lazy-IO landmine if .org decode is
+  // slow on CF.
+  const bool _ioa = io_audit_enabled();
+  const Uint64 _ioa_t0 = _ioa ? SDL_GetTicksNS() : 0;
+
   song.loaded  = false;
   song.playing = false;
 
   if (!song.Load(fname))
+  {
+    if (_ioa)
+      io_audit_emit("music_org_load", fname.c_str(), 0,
+                    (unsigned long long)((SDL_GetTicksNS() - _ioa_t0) / 1000ull));
     return false;
+  }
   // Reset position
   _setPlayPosition(0);
 
   // Set as loaded
   song.loaded = true;
 
+  if (_ioa)
+    io_audit_emit("music_org_load", fname.c_str(), 0,
+                  (unsigned long long)((SDL_GetTicksNS() - _ioa_t0) / 1000ull));
   return true;
 }
 
