+Uint64 _mdsd_samples_residual[_flip_phase_block_size]      = {};
+Uint64 _mdsd_samples_bd_cache_blit[_flip_phase_block_size] = {};
+Uint64 _mdsd_samples_bd_full_redraw[_flip_phase_block_size]= {};
+int    _mdsd_sample_idx = 0;
+// per-block derived backdrop-route counters (sec.3.2 -- the double-pay
+// check). Derived at record time from bd_cache_blit vs backdrop total;
+// no map.cpp instrumentation needed.
+Uint32 _mdsd_bd_route_cache = 0, _mdsd_bd_route_direct = 0, _mdsd_bd_paid_both = 0;
+// per-block scroll-frame classification (sec.3.5)
+Uint32 _mdsd_static_frames = 0, _mdsd_scroll_frames = 0;
+// per-block per-layer framebuffer-write byte sums (sec.3.4). clear +
+// backdrop are full opaque writes (exact bytes WRITTEN); bg + fg are
+// colorkey blits (rect-area = bytes SCANNED/addressed, upper bound on
+// written -- named "_scan_" per flush-instr's contract).
+Uint64 _mdsd_pass_clear_bytes = 0, _mdsd_pass_backdrop_bytes = 0;
+Uint64 _mdsd_pass_bg_scan_bytes = 0, _mdsd_pass_fg_scan_bytes = 0;
+// per-SCENE-DRAW accumulators (snapshotted into per-block sums + zeroed
+// each scene-draw). Indexed by NXE::Diag::MdsDecompPass.
+Uint64 _mdsd_pass_bytes_this_scene[NXE::Diag::MDS_PASS_COUNT] = {};
+Uint64 _mdsd_bd_cache_blit_ns_this_scene = 0;
+// scroll-tag: previous scene-draw's camera scroll, for delta classify.
+int _mdsd_last_xscroll = INT_MIN, _mdsd_last_yscroll = INT_MIN;
+
+// Emit one per-100-scene-draws block to the engine <TAG>.LOG, then
+// reset all per-block accumulators. Reuses _compute_flip_phase_stats.
+void _mds_decomp_emit_block()
+{
+  const int n = _mdsd_sample_idx;
+  if (n <= 0) return;
+  // Block header -- honest labelling for the analysis side. n is in
+  // SCENE-DRAWS (not flips). bd_full_redraw is derived per-tick as
+  // (mdt_bg_backdrop_dt - bd_cache_blit) so it is a real per-frame
+  // STAT, and it ABSORBS the dropped sub-us bd_cache_decision residual
+  // -- it is redraw+decision-residual, not a pure-redraw bracket.
+  // pass_bg/fg are SCAN bytes (colorkey-blit rect area), not written.
+  LOG_INFO("[mds-decomp-block n={} unit=scene-draws "
+           "bd_full_redraw=redraw_plus_decision_residual]", n);
+  _FlipPhaseStats st;
+#define MDSD_STAT(arr, nm)                                                    \
+  _compute_flip_phase_stats(arr, n, st);                                      \
+  LOG_INFO("[mds-decomp-stat n={} phase=" nm " min={:.2f} med={:.2f} "        \
+           "mean={:.2f} p95={:.2f} max={:.2f} ms]",                           \
+           n, st.min_ms, st.med_ms, st.mean_ms, st.p95_ms, st.max_ms)
+  MDSD_STAT(_mdsd_samples_draw_scene,    "mode_draw_scene");
+  MDSD_STAT(_mdsd_samples_clear,         "mds_clear");
+  MDSD_STAT(_mdsd_samples_tilemap_bg,    "mds_tilemap_bg");
+  MDSD_STAT(_mdsd_samples_bg_backdrop,   "mdt_bg_backdrop");
+  MDSD_STAT(_mdsd_samples_bg_tilelayer,  "mdt_bg_tilelayer");
+  MDSD_STAT(_mdsd_samples_object_loop,   "mds_object_loop");
+  MDSD_STAT(_mdsd_samples_player,        "mds_player");
+  MDSD_STAT(_mdsd_samples_tilemap_fg,    "mds_tilemap_fg");
+  MDSD_STAT(_mdsd_samples_carets,        "mds_carets_water_floats");
+  MDSD_STAT(_mdsd_samples_residual,      "mds_residual");
+  MDSD_STAT(_mdsd_samples_bd_cache_blit, "bd_cache_blit");
+  MDSD_STAT(_mdsd_samples_bd_full_redraw,"bd_full_redraw");
+#undef MDSD_STAT
+  // backdrop + tilemap route counters. tm_* derived: the tilemap cache
+  // is killswitch-default-OFF, so route=direct for every scene-draw
+  // when the killswitch is active.
+  const bool tm_off = NXE::Diag::tilemap_cache_killswitch_active();
+  LOG_INFO("[mds-decomp-route n={} bd_route_cache={} bd_route_direct={} "
+           "bd_paid_both={} tm_route_cache={} tm_route_direct={} tm_cache_miss={}]",
+           n, (unsigned long)_mdsd_bd_route_cache,
+           (unsigned long)_mdsd_bd_route_direct,
+           (unsigned long)_mdsd_bd_paid_both,
+           (unsigned long)0,
+           (unsigned long)(tm_off ? (Uint32)n : 0),
+           (unsigned long)0);
+  // per-layer framebuffer-write bytes. clear/backdrop = bytes WRITTEN
+  // (full opaque); bg/fg = bytes SCANNED (colorkey-blit rect area,
+  // upper bound). total_passes_x10 = derived full-screen-pass count.
+  const Uint64 total_bytes = _mdsd_pass_clear_bytes + _mdsd_pass_backdrop_bytes
+                           + _mdsd_pass_bg_scan_bytes + _mdsd_pass_fg_scan_bytes;
+  const unsigned long passes_x10 = (n > 0)
+      ? (unsigned long)((total_bytes * 10ull) / (76800ull * (Uint64)n))
+      : 0;
+  LOG_INFO("[mds-decomp-pass n={} pass_clear_bytes={} pass_backdrop_bytes={} "
+           "pass_bg_tile_scan_bytes={} pass_fg_sprite_scan_bytes={} "
+           "avg_passes_per_scene_x10={}]",
+           n, (unsigned long long)_mdsd_pass_clear_bytes,
+           (unsigned long long)_mdsd_pass_backdrop_bytes,
+           (unsigned long long)_mdsd_pass_bg_scan_bytes,
+           (unsigned long long)_mdsd_pass_fg_scan_bytes,
+           passes_x10);
+  LOG_INFO("[mds-decomp-frames n={} static_frames={} scroll_frames={}]",
+           n, (unsigned long)_mdsd_static_frames,
+           (unsigned long)_mdsd_scroll_frames);
+  // reset per-block state (sample arrays are overwritten next block).
+  _mdsd_sample_idx = 0;
+  _mdsd_bd_route_cache = _mdsd_bd_route_direct = _mdsd_bd_paid_both = 0;
+  _mdsd_static_frames = _mdsd_scroll_frames = 0;
+  _mdsd_pass_clear_bytes = _mdsd_pass_backdrop_bytes = 0;
+  _mdsd_pass_bg_scan_bytes = _mdsd_pass_fg_scan_bytes = 0;
+}
