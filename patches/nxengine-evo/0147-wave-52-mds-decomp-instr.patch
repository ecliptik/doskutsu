+// Called once per DrawScene() from game_tick_normal(), AFTER the
+// ModeDrawSceneTimer scope closes (every g_*_dt_this_tick is fresh).
+// Snapshots this scene-draw, derives the route + residual, and emits
+// every 100 scene-draws. Cost: ~12 array stores + a handful of ops --
+// no pixel loop.
+void _mds_decomp_on_scene_draw()
+{
+  using namespace NXE::Diag;
+  // scroll-frame classification from the camera delta.
+  const int xs = map.displayed_xscroll;
+  const int ys = map.displayed_yscroll;
+  const bool is_scroll = (_mdsd_last_xscroll != INT_MIN) &&
+                         ((xs != _mdsd_last_xscroll) || (ys != _mdsd_last_yscroll));
+  _mdsd_last_xscroll = xs;
+  _mdsd_last_yscroll = ys;
+  if (is_scroll) ++_mdsd_scroll_frames; else ++_mdsd_static_frames;
+
+  // re-read this scene-draw's W22A/W22.5/W29 per-tick dt values.
+  const Uint64 dt_draw_scene  = g_mt_draw_scene_dt_this_tick;
+  const Uint64 dt_clear       = g_mds_clear_dt_this_tick;
+  const Uint64 dt_tilemap_bg  = g_mds_tilemap_bg_dt_this_tick;
+  const Uint64 dt_bg_backdrop = g_mdt_bg_backdrop_dt_this_tick;
+  const Uint64 dt_bg_tilelyr  = g_mdt_bg_tilelayer_dt_this_tick;
+  const Uint64 dt_object_loop = g_mds_object_loop_dt_this_tick;
+  const Uint64 dt_player      = g_mds_player_dt_this_tick;
+  const Uint64 dt_tilemap_fg  = g_mds_tilemap_fg_dt_this_tick;
+  const Uint64 dt_carets      = g_mds_carets_water_floats_dt_this_tick;
+  // mds_residual = parent - sum(6 W22.5 sub-buckets); same math as the
+  // existing W22.5 residual block at game.cpp.
+  Sint64 mds_res = (Sint64)dt_draw_scene - (Sint64)dt_clear
+                 - (Sint64)dt_tilemap_bg - (Sint64)dt_object_loop
+                 - (Sint64)dt_player - (Sint64)dt_tilemap_fg
+                 - (Sint64)dt_carets;
+  if (mds_res < 0) mds_res = 0;
+  // bd_cache_blit accumulated by drawCachedBackdrop[/Clipped] during
+  // this scene-draw; bd_full_redraw derived = backdrop total - blit.
+  const Uint64 bd_cache_blit = _mdsd_bd_cache_blit_ns_this_scene;
+  Sint64 bd_full = (Sint64)dt_bg_backdrop - (Sint64)bd_cache_blit;
+  if (bd_full < 0) bd_full = 0;
+
+  const int i = _mdsd_sample_idx;
+  if (i < _flip_phase_block_size)
+  {
+    _mdsd_samples_draw_scene[i]     = dt_draw_scene;
+    _mdsd_samples_clear[i]          = dt_clear;
+    _mdsd_samples_tilemap_bg[i]     = dt_tilemap_bg;
+    _mdsd_samples_bg_backdrop[i]    = dt_bg_backdrop;
+    _mdsd_samples_bg_tilelayer[i]   = dt_bg_tilelyr;
+    _mdsd_samples_object_loop[i]    = dt_object_loop;
+    _mdsd_samples_player[i]         = dt_player;
+    _mdsd_samples_tilemap_fg[i]     = dt_tilemap_fg;
+    _mdsd_samples_carets[i]         = dt_carets;
+    _mdsd_samples_residual[i]       = (Uint64)mds_res;
+    _mdsd_samples_bd_cache_blit[i]  = bd_cache_blit;
+    _mdsd_samples_bd_full_redraw[i] = (Uint64)bd_full;
+    ++_mdsd_sample_idx;
+  }
+
+  // derive the backdrop route (sec.3.2 double-pay check) -- no map.cpp
+  // instrumentation. route_cache: a cache->window blit served this
+  // frame. route_direct: backdrop drawn with no cache blit. paid_both:
+  // a cache blit AND a substantial fresh redraw in the same frame.
+  const Uint64 BD_REDRAW_EPS = 100000;  // 0.1 ms noise floor
+  if (bd_cache_blit > 0)
+  {
+    ++_mdsd_bd_route_cache;
+    if ((Uint64)bd_full > BD_REDRAW_EPS) ++_mdsd_bd_paid_both;
+  }
+  else if (dt_bg_backdrop > 0)
+  {
+    ++_mdsd_bd_route_direct;
+  }
+
+  // snapshot per-scene pass bytes into per-block sums, then zero.
+  _mdsd_pass_clear_bytes    += _mdsd_pass_bytes_this_scene[MDS_PASS_CLEAR];
+  _mdsd_pass_backdrop_bytes += _mdsd_pass_bytes_this_scene[MDS_PASS_BACKDROP];
+  _mdsd_pass_bg_scan_bytes  += _mdsd_pass_bytes_this_scene[MDS_PASS_BG];
+  _mdsd_pass_fg_scan_bytes  += _mdsd_pass_bytes_this_scene[MDS_PASS_FG];
+  for (int p = 0; p < MDS_PASS_COUNT; ++p) _mdsd_pass_bytes_this_scene[p] = 0;
+  _mdsd_bd_cache_blit_ns_this_scene = 0;
+  g_mds_decomp_pass = MDS_PASS_OTHER;
+
+  if (_mdsd_sample_idx >= _flip_phase_block_size)
+    _mds_decomp_emit_block();
+}
