From 4749a905f7213719987a35024cc7b763a5e97c0d Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Tue, 7 Jul 2026 13:35:26 -0700
Subject: [PATCH] patch 0265 -- #B2: cave-transition music pause fix
 (load_stage mid-gap pump default-ON + intra-loop pumps)

Cave/stage transitions drop music for ~1-2s. Root cause: load_stage runs a band
of blocking reads (tileset .pbm, .pxm map, .pxa attrs, .pxe entities) with no
audio service in between, so the SB-served audio ring (Organya / OPL3 / WB /
SB16) drains to silence during the load. (The AdLib PIT/IRQ-0 pump path survives
autonomously and is unaffected.)

The Leg A mid-gap pump (patch 0162-v2) already exists but shipped OPT-IN
(default-OFF) and was DESIGNED-to-fix, never g2k-CONFIRMED. v1.6.2 graduates it
to the production default and extends it:

1. Flip midgap_pump_active() to DEFAULT-ON via a strict-"0" killswitch on the
   existing hint SDL_HINT_DOSKUTSU_AUDIO_MIDGAP_PUMP (=0 reverts to the
   byte-identical pre-Leg-A blocking baseline). The banner now reads
   "audio mid-gap pump: ENABLED (default)" / "DISABLED (killswitch =0)".
   This flip also arms Leg A FIX 2 (the FtAccumulatorGuard freeze/thaw) by
   default, since both the pump and the guard gate on this same predicate.

2. Add intra-loop pumps INSIDE the two big chunkable read bands: load_map's
   .pxm tile loop (every 16 rows) and load_entities' .pxe loop (every 32
   entities). The existing seam pumps only fire BETWEEN sub-loaders; a single
   large map/entity read is itself long enough to starve the ring.

FREEZE-WINDOW CONSTRAINT (why this does not reintroduce the v1 TAS-desync
regression): both load_map and load_entities are called ONLY from load_stage,
whose FtAccumulatorGuard (_ftg, declared at load_stage entry) freezes the
FIXED_TIMESTEP accumulator for the entire call and thaws ONLY at its dtor (every
return path). So the new intra-loop pumps execute inside that frozen window --
their wall-clock is masked from the accumulator's next delta exactly like the
seam pumps, so no extra catch-up tick_state is generated. The guard is never
thawed early; verified there is no other caller of load_map/load_entities.

The heaviest single item (tileset .pbm PNG decode via Surface::fromFile) is
inside SDL3_image and NOT a chunkable fread from the engine side; it stays
bracketed by the existing seam pumps. Chunking stb_image is out of scope (an
SDL3_image / sdl-engine follow-up if the decode alone still blips).

g2k CAVE cell (production SB/WB path): must show the curmap=1005 entry spike
gone + no new gameplay-timing hitch (FIX 2 holding). BOOT.md updated for the new
default. Killswitch =0 is the A/B baseline.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 src/map.cpp | 35 +++++++++++++++++++++++++++++++++--
 1 file changed, 33 insertions(+), 2 deletions(-)

diff --git a/src/map.cpp b/src/map.cpp
index 1de7701b..e864e7f9 100644
--- a/src/map.cpp
+++ b/src/map.cpp
@@ -1171,10 +1171,19 @@ static bool midgap_pump_active()
 {
   if (g_midgap_pump_decided < 0)
   {
+    // DOS-PORT (patch 0265, #B2 / v1.6.2): FLIPPED to DEFAULT-ON. The Leg A
+    // audio mid-gap pump (patch 0162-v2) shipped opt-in and was DESIGNED-to-fix
+    // but never g2k-CONFIRMED; v1.6.2 graduates it to the production default to
+    // fix the cave-transition ~1-2s music pause (a long blocking fread band in
+    // load_stage starves the SB-served audio ring -- Organya/OPL3/WB/SB; the
+    // AdLib PIT-pump path survives autonomously). Strict-"0" killswitch:
+    // SDL_HINT_DOSKUTSU_AUDIO_MIDGAP_PUMP=0 reverts to the byte-identical
+    // pre-Leg-A blocking baseline (both the seam pumps AND the patch-0265
+    // intra-loop pumps go away, and FtAccumulatorGuard becomes a no-op pair).
     const char *e = SDL_GetHint("SDL_HINT_DOSKUTSU_AUDIO_MIDGAP_PUMP");
-    g_midgap_pump_decided = (e && e[0] == '1' && e[1] == '\0') ? 1 : 0;
+    g_midgap_pump_decided = (e && e[0] == '0' && e[1] == '\0') ? 0 : 1;
     LOG_INFO("audio mid-gap pump: {}",
-             g_midgap_pump_decided ? "ENABLED (opt-in)" : "DISABLED (default)");
+             g_midgap_pump_decided ? "ENABLED (default)" : "DISABLED (killswitch =0)");
   }
   return g_midgap_pump_decided == 1;
 }
@@ -1583,6 +1592,7 @@ bool load_map(const std::string &fname)
   }
 
   for (y = 0; y < map.ysize; y++)
+  {
     for (x = 0; x < map.xsize; x++)
     {
       map.tiles[x][y] = fgetc(fp);
@@ -1591,6 +1601,17 @@ bool load_map(const std::string &fname)
         map.tiles[x][y] = 0xF; // block up/down in Main Artery
       }
     }
+    // DOS-PORT (patch 0265, #B2 / v1.6.2): intra-loop audio pump. A big .pxm
+    // (xsize*ysize fgetc) is one blocking read band inside load_stage that
+    // starves the SB-served audio ring for ~1-2s; service the ring every 16
+    // rows so music does not drop mid-load. No-op when the killswitch is off.
+    // This runs INSIDE load_stage's FtAccumulatorGuard frozen window (load_map
+    // is only ever called from load_stage, whose guard thaws at return), so the
+    // pump wall-clock stays masked from the FIXED_TIMESTEP catch-up count
+    // (closes the v1 TAS-desync regression). See load_stage() FtAccumulatorGuard.
+    if ((y & 15) == 0)
+      MIDGAP_PUMP();
+  }
 
   fclose(fp);
 
@@ -1706,6 +1727,16 @@ bool load_entities(const std::string &fname)
 
   for (i = 0; i < nEntities; i++)
   {
+    // DOS-PORT (patch 0265, #B2 / v1.6.2): intra-loop audio pump. A big .pxe
+    // entity read + spawn band inside load_stage starves the SB-served audio
+    // ring; service it every 32 entities so music does not drop mid-load. No-op
+    // when the killswitch is off. Runs INSIDE load_stage's FtAccumulatorGuard
+    // frozen window (load_entities is only called from load_stage, whose guard
+    // thaws at return) so the pump wall-clock stays masked from the
+    // FIXED_TIMESTEP catch-up count. See load_stage() FtAccumulatorGuard.
+    if ((i & 31) == 0)
+      MIDGAP_PUMP();
+
     int x     = fgeti(fp);
     int y     = fgeti(fp);
     int id1   = fgeti(fp);
-- 
