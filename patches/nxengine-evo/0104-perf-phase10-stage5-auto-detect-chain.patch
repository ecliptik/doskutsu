+// DOS-PORT (patch 0104, Phase 10 Stage 5 auto-detect chain): file-
+// scope helpers for per-backend install. Called from SoundManager::
+// init(); split out here so the auto-detect chain can call them in
+// sequence without duplicating each backend's install logic.
+//
+// Each helper:
+//   - Probes / instantiates the concrete backend
+//   - On success: installs on MidiScheduler, sets the sticky enum to
+//     the resolved backend value, logs the install banner, returns true
+//   - On failure: returns false (caller decides whether to fall back
+//     in chain mode or roll the explicit-selection enum back to organya)
+//
+// Helpers are static (file-scope, internal linkage) — no class state
+// needed since MidiScheduler is a singleton and g_p10_audio_backend_-
+// active is a global. Keep them near the top of the TU so init() finds
+// them via in-TU lookup.
+
+static bool _try_install_wb_backend()
+{
+  auto wb = std::unique_ptr<MidiBackendWaveBlaster>(new MidiBackendWaveBlaster());
+  if (!wb->isReady())
+  {
+    // Probe failed; unique_ptr unwinds → MidiBackendWaveBlaster dtor
+    // calls SDL_DOSMpu401Shutdown which is idempotent (no-op when
+    // _ready was false). No state to clean.
+    return false;
+  }
+  MidiScheduler::getInstance()->set_backend(std::move(wb));
+  NXE::Diag::g_p10_audio_backend_active = NXE::Diag::AudioBackend::wb;
+  LOG_INFO("Sound system: MidiScheduler armed with MidiBackendWaveBlaster "
+           "(patch 0102 Phase 10 Stage 3). Music dispatch routes via "
+           "SMF parser + hardware-MIDI on the WaveBlaster header / "
+           "DreamBlaster S2; Pixtone SFX still active on SB16 DAC.");
+  return true;
+}
+
+static bool _try_install_opl3_backend()
+{
+  auto opl3 = std::unique_ptr<MidiBackendOpl3>(new MidiBackendOpl3());
+  if (!opl3->isReady())
+  {
+    // Probe failed; unique_ptr unwinds → MidiBackendOpl3 dtor calls
+    // SDL_DOSOpl3Shutdown which is idempotent when _ready was false.
+    return false;
+  }
+  MidiScheduler::getInstance()->set_backend(std::move(opl3));
+  NXE::Diag::g_p10_audio_backend_active = NXE::Diag::AudioBackend::opl3;
+  LOG_INFO("Sound system: MidiScheduler armed with MidiBackendOpl3 "
+           "(patch 0103 Phase 10 Stage 4). Music dispatch routes via "
+           "SMF parser + 18 x 2-op OPL3 voice allocator + small "
+           "inline patch bank (community-sourced from Apogee Sound "
+           "System / AdLib SBI public-domain refs). Pixtone SFX "
+           "still active on SB16 DAC.");
+  return true;
+}
+
+static void _install_midi_stub_backend()
+{
+  MidiScheduler::getInstance()->set_backend(
+      std::unique_ptr<MidiBackend>(new MidiBackendStub()));
+  // midi_stub is never the result of auto-detect (auto chain only
+  // tries wb / opl3); it's only set explicitly via env. Sticky enum
+  // already matches; no mutation needed.
+  LOG_INFO("Sound system: MidiScheduler armed with MidiBackendStub "
+           "(patch 0101 Phase 10 Stage 2). Music dispatch routes via "
+           "SMF parser + no-op concrete backend; Pixtone SFX still "
+           "active on SB16 DAC.");
+}
+
+static void _narrate_organya_fallback(const char *which)
+{
+  // Roll the sticky enum to organya so the engine's existing music
+  // dispatch path (settings->new_music = 0 → Organya) takes over.
+  // Pixtone SFX is unaffected (independent dispatch path on SB16
+  // DAC). The which arg distinguishes WB vs OPL3 vs auto-detect-
+  // exhausted in the log — operator can see at a glance which probe
+  // path failed.
+  NXE::Diag::g_p10_audio_backend_active = NXE::Diag::AudioBackend::organya;
+  LOG_INFO("Sound system: {} probe failed; falling back to organya. "
+           "Music dispatch reverts to the SDL3_mixer + Organya "
+           "synthesizer path. Phase 10 audio offload not engaged for "
+           "this run.", which);
+}
+
 SoundManager::SoundManager() {}
 SoundManager::~SoundManager() {}
 
