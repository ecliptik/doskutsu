+  // X8 cell (a genuine SB16 forced onto the 8-bit path) records is_sb16=1,
+  // force_8bit=1, dma_path=8bit-low, which is the whole reason that cell exists.
+  runmanifest_emit_kv_int(fp, "video_vram_kb", (int)SDL_DOSVideoGetVRAMKB());
+  runmanifest_emit_kv_str(fp, "video_lfb_or_banked",
+      SDL_DOSVideoIsBankedMode() ? "banked" : "lfb");
+  {
+    const int _dmaj = SDL_DOSAudioGetDSPVersionMajor();
+    const int _dmin = SDL_DOSAudioGetDSPVersionMinor();
+    // identity = DSP major >= 4 (the standard SB16 detection; SDL/0124 has no
+    // dedicated IsSB16 getter by design -- identity comes from the DSP version).
+    runmanifest_emit_kv_str(fp, "audio_is_sb16", (_dmaj >= 4) ? "1" : "0");
+    if (_dmaj >= 0)
+      std::fprintf(fp, "audio_dsp_ver=%d.%02d\n", _dmaj, (_dmin >= 0 ? _dmin : 0));
+    else
+      runmanifest_emit_kv_str(fp, "audio_dsp_ver", "NA");
+  }
+  runmanifest_emit_kv_str(fp, "audio_dma_path",
+      SDL_DOSAudioIsHighDMAPath() ? "16bit-high" : "8bit-low");
+  runmanifest_emit_kv_str(fp, "audio_force_8bit",
+      SDL_DOSAudioIsForced8Bit() ? "1" : "0");
+  runmanifest_emit_kv_int(fp, "audio_dma_channel", SDL_DOSAudioGetResolvedDMAChannel());
   // fps_p50/p95 (patch 0293): real percentiles, computed at exit from the flip-
   // probe's inter_flip samples retained every 10th flip in Renderer.cpp (the exact
   // lines the campaign's awk used), so NO new per-frame instrumentation is added.
@@ -1988,6 +2179,12 @@ int main(int argc, char *argv[])
