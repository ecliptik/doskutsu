+  // Hardware identity the engine reliably knows in-lane (patch 0294).
+  runmanifest_emit_kv_str(fp, "audio_backend",
+      NXE::Diag::backend_to_string(NXE::Diag::g_p10_audio_backend_active));
+  runmanifest_emit_kv_str(fp, "video_logical_wxh", "320x240");
+  runmanifest_emit_kv_int(fp, "video_logical_bpp", 8);
+  // SDL-probe card-identity witnesses, folded in via SDL/0124 (patch 0294). These
+  // read PERSISTENT probe statics (vram size at mode-set, DSP version + resolved
+  // DMA at audio probe), so unlike the live timebase query they are valid at emit
+  // even post SDL_Quit. Live in-process reads, not echoed values -> no provenance
+  // tag. Identity, override and outcome are SEPARATE fields (is_sb16 vs force_8bit
