diff --git a/src/map.cpp b/src/map.cpp
index 21ddde86..7915e60b 100644
--- a/src/map.cpp
+++ b/src/map.cpp
@@ -3612,6 +3612,87 @@ static unsigned g_world_cache_declined_block  = 0;
 static unsigned g_world_cache_bytes         = 0;
 static bool     g_world_cache_first_logged  = false;
 
+// DOS-PORT (patch 0315, stage 3b): the tile-aligned key.
+//
+// Stage 3a composited unconditionally every frame, which is correct but pure
+// cost. 3b consults a key so a frame whose cached content is unchanged can
+// skip the composite entirely and go straight to the read-out blit. This is
+// where the saving actually arrives.
+//
+// The key is TILE-ALIGNED, which is the whole point and the specific fix for
+// patch 0097. 0097 keyed on pixel scroll (map.cpp:3052-3053) and therefore
+// missed on every single pixel of camera motion; break-even for it was a 0.92
+// hit rate, which it never came close to. Keying on the tile-aligned origin
+// means a hit survives 15 of every 16 pixels of camera travel, because the
+// sub-tile remainder is applied at read-out instead of being baked in.
+//
+// Gated SEPARATELY from the 3a hint so one binary carries all three arms:
+// neither hint = uncached baseline, WORLD_CACHE=1 = 3a unconditional
+// composite, WORLD_CACHE=1 + WORLD_CACHE_KEY=1 = 3b keyed. Three arms on one
+// reel makes the attribution a within-binary comparison rather than a
+// cross-binary one, which this campaign has repeatedly found unreliable.
+//
+// What the key must cover, and why each field is here:
+//   curmap        -- a different map is different content, and reloads tilesets
+//   mapx/mapy     -- the tile-aligned origin; the sub-tile part is NOT keyed
+//   tile_mutation -- destroyed/scripted tiles (see map_note_tile_mutation)
+//   win_ptr       -- window surface re-fetch invalidates the blit target
+//   sw/sh         -- a mode change resizes the read-out
+// Animated tiles (TA_CURRENT) and destroyables (tilecode 0x43) are excluded
+// from the composite entirely and render live, so animation must NOT and does
+// not invalidate. The backdrop is not cached under variant B, so nothing about
+// backdrop scroll or parallax phase belongs in this key.
+struct WorldCacheKey
+{
+  int      curmap;
+  int      mapx;
+  int      mapy;
+  unsigned tile_mutation;
+  void    *win_ptr;
+  int      sw;
+  int      sh;
+};
+
+static WorldCacheKey g_world_cache_key;
+static bool     g_world_cache_key_valid   = false;
+static int      g_world_cache_key_decided = -1;
+static unsigned g_world_cache_hit_block   = 0;
+
+static bool _world_cache_keys_equal(const WorldCacheKey &a, const WorldCacheKey &b)
+{
+  return a.curmap        == b.curmap
+      && a.mapx          == b.mapx
+      && a.mapy          == b.mapy
+      && a.tile_mutation == b.tile_mutation
+      && a.win_ptr       == b.win_ptr
+      && a.sw            == b.sw
+      && a.sh            == b.sh;
+}
+
+static bool world_cache_key_enabled()
+{
+  if (g_world_cache_key_decided < 0)
+  {
+    const char *e = std::getenv("SDL_HINT_DOSKUTSU_WORLD_CACHE_KEY");
+    g_world_cache_key_decided = (e && e[0] == '1' && e[1] == 0) ? 1 : 0;
+    LOG_INFO("world-cache-key: {} -- stage 3b tile-aligned key (patch 0315; "
+             "opt-in SDL_HINT_DOSKUTSU_WORLD_CACHE_KEY=1, default OFF; "
+             "requires SDL_HINT_DOSKUTSU_WORLD_CACHE=1). OFF reproduces "
+             "stage 3a's unconditional composite, so one binary carries the "
+             "uncached, 3a and 3b arms.",
+             g_world_cache_key_decided ? "ENABLED (opt-in)" : "DISABLED (default)");
+  }
+  return g_world_cache_key_decided == 1;
+}
+
+// DOS-PORT (patch 0315, stage 3b): see map.h. Every site that writes
+// map.tiles at runtime must call this or the world cache serves stale tiles.
+void map_note_tile_mutation(void)
+{
+  ++g_tile_mutation_counter;
+  g_world_cache_key_valid = false;
+}
+
 static bool world_cache_enabled()
 {
   if (g_world_cache_decided < 0)
@@ -3722,6 +3803,8 @@ bool world_cache_draw_tiles()
     SDL_SetSurfaceColorKey(g_world_cache_sfc, true, TILEMAP_FG_COLORKEY);
     g_world_cache_w = cw;
     g_world_cache_h = ch;
+    // A fresh surface holds no composite yet.
+    g_world_cache_key_valid = false;
     // Count the allocation rather than hand-waving it: the RAM floor is a
     // measured 16 MB and this rides on top of the existing caches.
     g_world_cache_bytes = (unsigned)(g_world_cache_sfc->pitch * ch);
@@ -3731,15 +3814,39 @@ bool world_cache_draw_tiles()
              r->screenWidth, r->screenHeight);
   }
 
-  // STAGE 3a: unconditional miss. Rebuild every frame. No key is consulted
-  // and no hit is possible -- that is 3b's job. The counter below is a REAL
-  // counter, not a literal: sec. 1.1 of the plan found `tm_route_cache` was
-  // hard-coded to 0 and it misled every reader of those logs, including this
-  // author. Do not reintroduce that pattern.
-  ++g_world_cache_composite_block;
-  SDL_FillSurfaceRect(g_world_cache_sfc, NULL, TILEMAP_FG_COLORKEY);
-  _world_cache_render_layer(g_world_cache_sfc, 0);
-  _world_cache_render_layer(g_world_cache_sfc, 1);
+  // STAGE 3b: consult the tile-aligned key. With the key hint OFF this
+  // reproduces 3a exactly -- composite every frame, no hit possible.
+  //
+  // These are REAL counters. The plan's sec. 1.1 found `tm_route_cache` was a
+  // hard-coded literal that carried only the killswitch state, and it misled
+  // every reader of the Round N logs including this author. A hit rate that
+  // cannot be read from the log is not a measurement.
+  WorldCacheKey cur;
+  cur.curmap        = game.curmap;
+  cur.mapx          = scroll_x / TILE_W;
+  cur.mapy          = scroll_y / TILE_H;
+  cur.tile_mutation = g_tile_mutation_counter;
+  cur.win_ptr       = (void *)win;
+  cur.sw            = r->screenWidth;
+  cur.sh            = r->screenHeight;
+
+  const bool keyed = world_cache_key_enabled();
+  const bool hit   = keyed && g_world_cache_key_valid
+                     && _world_cache_keys_equal(g_world_cache_key, cur);
+
+  if (hit)
+  {
+    ++g_world_cache_hit_block;
+  }
+  else
+  {
+    ++g_world_cache_composite_block;
+    SDL_FillSurfaceRect(g_world_cache_sfc, NULL, TILEMAP_FG_COLORKEY);
+    _world_cache_render_layer(g_world_cache_sfc, 0);
+    _world_cache_render_layer(g_world_cache_sfc, 1);
+    g_world_cache_key       = cur;
+    g_world_cache_key_valid = true;
+  }
 
   SDL_Rect src;
   src.x = scroll_x % TILE_W;
@@ -3762,12 +3869,19 @@ bool world_cache_draw_tiles()
   }
   if ((g_world_cache_frames_block % 100) == 0)
   {
-    LOG_INFO("[world-cache n={} composites={} declined={} bytes={}]",
-             g_world_cache_frames_block, g_world_cache_composite_block,
-             g_world_cache_declined_block, g_world_cache_bytes);
+    LOG_INFO("[world-cache n={} hits={} composites={} declined={} "
+             "hit_pct_x10={} bytes={}]",
+             g_world_cache_frames_block, g_world_cache_hit_block,
+             g_world_cache_composite_block, g_world_cache_declined_block,
+             g_world_cache_frames_block
+                 ? (unsigned)((g_world_cache_hit_block * 1000u)
+                              / g_world_cache_frames_block)
+                 : 0u,
+             g_world_cache_bytes);
     g_world_cache_frames_block    = 0;
     g_world_cache_composite_block = 0;
     g_world_cache_declined_block  = 0;
+    g_world_cache_hit_block       = 0;
   }
   return true;
 }
