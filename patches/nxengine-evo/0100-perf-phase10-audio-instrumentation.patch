 }  // namespace Diag
 }  // namespace NXE
 
+// DOS-PORT (patch 0100, Phase 10 audio offload — instrumentation
+// scaffolding): idle-pause callback. Registered once at SoundManager::
+// init() via SDL_DOSAudioRegisterIdlePauseCallback (sdl-engine's
+// slot-0037+ helper API). The SDL-side DSP-pause primitive invokes
+// this callback on each pause→resume transition, passing the duration
+// the DSP was paused in nanoseconds.
+//
+// Engine-side storage at NXE::Diag scope. C linkage so cross-vendor
+// ABI matches the SDL-side typedef SDL_DOSIdlePauseCallback_t.
+//
+// Per docs/PHASE10-CONTRACT.md § 1.4 idle-pause counter wiring: count
+// transitions in `audio_idle_pause_count_block`; sum durations
+// (converted ns → µs) in `audio_idle_pause_us_block`. Both reset per
+// audit-flush block alongside the 3 IRQ-scope counters.
+//
+// Cooperative-scheduler-safe per CLAUDE.md threading-zero invariant.
+// The callback fires on the SDL ISR side at pause→resume transition;
+// the writes are to NXE::Diag uint32_t storage that the engine-side
+// reads at audit-flush time. Single-volatile-uint write/read pattern
+// without atomics matches the existing g_audio_mix_accum_ns_block
+// precedent (W13.1-D2 patch 0062). Defensive: callback only mutates
+// counters; no other side effects.
+extern "C" void p10_audio_idle_pause_callback(std::uint64_t paused_ns)
+{
+  ++NXE::Diag::g_p10_audio_idle_pause_count_block;
+  NXE::Diag::g_p10_audio_idle_pause_us_block += (std::uint32_t)(paused_ns / 1000);
+}
+
