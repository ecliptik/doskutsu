+/* Cave Story port — Phase 10 audio offload, slot 0100 (instrumentation
+ * scaffolding). Engine-side audio-backend selection.
+ *
+ * See AudioBackend.h for the per-stage scope discussion. Slot 0100
+ * implements ONLY the env-var-to-enum translation; backend dispatch
+ * lands in patches 0101+ (Stage 2 MidiScheduler + Stage 3 WaveBlaster
+ * + Stage 4 OPL3).
+ */
+
+#include "AudioBackend.h"
+
+#include "../Utils/Logger.h"
+#include "../Utils/diagnostic_timers.h"
+
+#include <SDL3/SDL.h>
+#include <cstring>
+
+namespace NXE
+{
+namespace Sound
+{
+
+void selectBackendFromEnv()
+{
+  // SDL_GetHint reads via SDL3's env-var lookup chain (SDL_SetHint
+  // overrides → process env → default). Returns NULL if unset.
+  const char *value = SDL_GetHint("SDL_HINT_DOSKUTSU_AUDIO_BACKEND");
+
+  // Default (env unset OR `auto`) → for slot 0100 resolves to
+  // `organya` (Phase 10 baseline; only backend currently implemented).
+  // The auto-detect chain (WB available → use WB; else OPL3 → use
+  // OPL3; else Organya) lands in patches 0101+ once SDL-side detect
+  // probes exist (per design § 7).
+  NXE::Diag::AudioBackend selected = NXE::Diag::AudioBackend::organya;
+
+  if (value == nullptr || std::strcmp(value, "auto") == 0)
+  {
+    selected = NXE::Diag::AudioBackend::organya;
+    LOG_INFO("audio backend: auto → organya (Phase 10 slot-0100 baseline; "
+             "auto-detect chain WB → OPL3 → Organya lands with backend "
+             "implementations in patches 0101+)");
+  }
+  else if (std::strcmp(value, "organya") == 0)
+  {
+    selected = NXE::Diag::AudioBackend::organya;
+    LOG_INFO("audio backend: organya (forced; Phase 10 baseline)");
+  }
+  else if (std::strcmp(value, "wb") == 0)
+  {
+    // Slot 0100 has no WB backend impl; flag as requested-but-unavailable
+    // and fall back to organya. Stage 3 (patches 0102+) will implement
+    // the actual WaveBlaster backend; until then this records the user's
+    // intent in the instrumentation field while the audio subsystem
+    // continues with Organya.
+    selected = NXE::Diag::AudioBackend::organya;
+    LOG_INFO("audio backend: WB requested but not available "
+             "(Stage 3 not yet shipped at slot 0100); falling back to organya. "
+             "WB backend implementation lands in patches 0102+.");
+  }
+  else if (std::strcmp(value, "opl3") == 0)
+  {
+    selected = NXE::Diag::AudioBackend::organya;
+    LOG_INFO("audio backend: OPL3 requested but not available "
+             "(Stage 4 not yet shipped at slot 0100); falling back to organya. "
+             "OPL3 backend implementation lands in patches 0103+.");
+  }
+  else if (std::strcmp(value, "tracker") == 0)
+  {
+    selected = NXE::Diag::AudioBackend::organya;
+    LOG_INFO("audio backend: tracker requested but not available "
+             "(Stage 5 reserved per design § 8; not currently planned); "
+             "falling back to organya.");
+  }
+  else
+  {
+    selected = NXE::Diag::AudioBackend::organya;
+    LOG_INFO("audio backend: unrecognized value '{}' for "
+             "SDL_HINT_DOSKUTSU_AUDIO_BACKEND; falling back to organya. "
+             "Recognized values: auto | organya | wb | opl3 | tracker.",
+             value);
+  }
+
+  // Sticky write — only changes on backend swap (rare; Stage 5+ when
+  // auto-detect chain succession fires). Per PHASE10-CONTRACT.md § 1.2:
+  // backend_active is NOT reset per audit-flush block.
+  NXE::Diag::g_p10_audio_backend_active = selected;
+}
+
+}  // namespace Sound
+}  // namespace NXE
