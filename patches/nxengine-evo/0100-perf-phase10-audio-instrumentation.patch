+/* Cave Story port — Phase 10 audio offload, slot 0100 (instrumentation
+ * scaffolding). Engine-side audio-backend selection scaffold.
+ *
+ * Stage 1 (slot 0100, this patch): the AudioBackend enum lives in
+ * `Utils/diagnostic_timers.h` (because it is also an instrumentation
+ * field via `g_p10_audio_backend_active`). This header declares the
+ * one Stage-1 entry point — `selectBackendFromEnv()` — that translates
+ * the user-facing `SDL_HINT_DOSKUTSU_AUDIO_BACKEND` env var into the
+ * sticky `g_p10_audio_backend_active` value. NO backend dispatch
+ * logic: the actual MIDI scheduler / WaveBlaster / OPL3 implementations
+ * land in patches 0101+ (Stage 2 / 3 / 4 deliverables per
+ * docs/PHASE10-DESIGN.md § 4-7).
+ *
+ * Stage 2+ will extend this header with an abstract `class AudioBackend`
+ * interface (init / shutdown / playMusic / pauseMusic / etc.) and
+ * concrete subclasses (`AudioBackendOrganya`, `AudioBackendWB`,
+ * `AudioBackendOPL3`) that route per-song calls to the appropriate
+ * synthesis path. Slot 0100 keeps the file minimal so Phase 10's
+ * instrumentation scaffolding lands cleanly without architectural
+ * commitment.
+ */
+
+#ifndef _AUDIO_BACKEND_H
+#define _AUDIO_BACKEND_H
+
+namespace NXE
+{
+namespace Sound
+{
+
+// Translate the `SDL_HINT_DOSKUTSU_AUDIO_BACKEND` env var value (auto |
+// organya | wb | opl3 | tracker) to the corresponding
+// NXE::Diag::AudioBackend enum and write it to
+// `g_p10_audio_backend_active`. Default (env unset) = `auto`, which
+// for slot 0100 resolves to `organya` (Phase 10 baseline; the only
+// backend currently implemented). Auto-detect chain (WB → OPL3 →
+// Organya) lands with the actual backend implementations in patches
+// 0101+ once detect probes exist on the SDL side.
+//
+// Called once from SoundManager::init() at game-init, AFTER
+// MIX_CreateMixerDevice succeeds (so the audio subsystem state is
+// usable for any backend-specific init that lands in Stage 2+).
+//
+// Strict-string-enum match per `env_vars_document_in_user_docs.md`
+// user-facing convention; case-sensitive lowercase. Any unrecognized
+// value logs a warning and falls back to `organya`.
+void selectBackendFromEnv();
+
+}  // namespace Sound
+}  // namespace NXE
+
+#endif  // _AUDIO_BACKEND_H
