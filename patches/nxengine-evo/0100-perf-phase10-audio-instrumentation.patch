+// DOS-PORT (patch 0100, Phase 10 audio offload — instrumentation
+// scaffolding): 5 per-block reset counters + 1 sticky enum field per
+// docs/PHASE10-CONTRACT.md § 1. Distinct field set from the existing
+// `g_audio_mix_accum_ns_block` (W13.1-D2 patch 0062) — that one
+// measures music-DMA-mix wall-clock (~1.5 ms / flip subset). Phase 10
+// adds full-IRQ-scope wall-clock + idle-pause savings + SFX-active
+// counter so the W22-WB-A iter can decompose:
+//
+//   ~13.5 ms total IRQ overhead = ~1.5 ms music-mix    (existing audio_mix bracket)
+//                               + ~12.0 ms IRQ-entry/exit (NEW: irq_wall_us - audio_mix)
+//                               + variable SFX windows   (NEW: sfx_active_count × per-IRQ)
+//
+// The load-bearing finding from sdl-engine's W20A2 reanalysis
+// (memorialized in memory/audio_mix_zero_is_not_audio_off.md): the
+// ~12 ms is IRQ ENTRY/EXIT overhead, not mix work. Phase 10's idle-
+// pause mechanism removes that slice; this instrumentation captures
+// the savings in real-HW measurements.
+//
+// All counters use uint32_t µs (atomicity-discipline-driven; matches
+// the kbd-counter precedent from patches 0023 + 0025; sized large
+// enough that 100-flip block accumulation cannot overflow at any
+// realistic IRQ rate). Per-block reset cadence matches existing
+// audio/engine split-block emission.
+//
+// Sticky `g_p10_audio_backend_active` enum is set once at game-init by
+// AudioBackend::selectBackendFromEnv() per the SDL_HINT_DOSKUTSU_AUDIO_-
+// BACKEND env-var; only flips on backend swap (rare; auto-detect chain
+// succession in Stage 5 — not currently triggered).
+//
+// Cross-vendor sourcing: 3 of 5 numerics (`audio_irq_count`,
+// `audio_irq_wall_us`, `sfx_active_count`) are populated by the SDL-
+// side IRQ-5 ISR via `doskutsu_audio_*` C-linkage externs declared in
+// SDL's `SDL_dos_audio_synth.h` (sdl-engine's slots 0037+). The
+// engine-side reads cumulative values at `_maybe_flush_phase_timing_-
+// audit()` entry, computes deltas vs the prior block-flush snapshot,
+// and surfaces the deltas in the [audio-block ...] emit. Modular
+// uint32_t arithmetic is wrap-safe per the C99 unsigned-overflow rule.
+//
+// Idle-pause counters (2 of 5: `audio_idle_pause_count`,
+// `audio_idle_pause_us`) are populated by the engine-side callback
+// registered at SoundManager::init() — `p10_audio_idle_pause_callback()`
+// — that the SDL-side DSP-pause primitive invokes on each pause→resume
+// transition with the paused-duration in ns.
+
+// Sticky enum — currently-active audio backend per SDL_HINT_DOSKUTSU_
+// AUDIO_BACKEND. Default `none` until AudioBackend::selectBackendFromEnv()
+// runs at SoundManager::init(); after init, one of organya / wb / opl3
+// / tracker.
+enum class AudioBackend : std::uint8_t
+{
+  organya = 0,
+  wb      = 1,
+  opl3    = 2,
+  tracker = 3,
+  none    = 4,
+};
+
+extern AudioBackend g_p10_audio_backend_active;
+
+// Stringify for the `backend=...` field in [audio-block] emit. Defined
+// in Renderer.cpp's NXE::Diag block alongside the storage.
+const char *backend_to_string(AudioBackend b);
+
+// 5 per-block reset counters — engine-side delta-derived from
+// `doskutsu_audio_*` SDL-side cumulative externs (3) + populated by
+// idle-pause callback (2). All written from the audit-flush path in
+// Renderer.cpp; reset to 0 after [audio-block ...] emit on each flush.
+extern std::uint32_t g_p10_audio_irq_count_block;
+extern std::uint32_t g_p10_audio_irq_wall_us_block;
+extern std::uint32_t g_p10_audio_idle_pause_count_block;
+extern std::uint32_t g_p10_audio_idle_pause_us_block;
+extern std::uint32_t g_p10_sfx_active_count_block;
+
+// Forward-decl env helper. Definition in Renderer.cpp's anonymous-
+// namespace ablation cluster (alongside _abl_flip_instr / _abl_fine_-
+// instr / _abl_mode_tick_instr / _abl_mode_draw_scene_instr / _abl_-
+// direct_vesa / _abl_tilemap_cache_killswitch); forwarded via the
+// file-scope wrapper at end-of-Renderer.cpp per the W20B build-fix
+// amendment about avoiding the nested NXE::Graphics::NXE::Diag trap.
+//
+// Strict-"1" match per CLAUDE.md convention (dev-only opt-in
+// instrumentation; default OFF). Cached static-const-bool — -O2
+// hoists the per-flush guard.
+bool p10_audio_instr_active();
+
 }  // namespace Diag
 }  // namespace NXE
 
