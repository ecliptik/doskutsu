 // drawSurface NULL-texture diagnostic (Phase 7 black-screen bug, task #14).
 // Track which Surface objects produce NULL textures so we log each origin
 // once + a periodic running count, instead of hundreds of identical lines
@@ -1887,6 +1998,85 @@ void _maybe_flush_phase_timing_audit()
       }
     }
   }
+
+  // patch 0100 (Phase 10 audio offload — instrumentation scaffolding):
+  // [audio-block ...] emit per docs/PHASE10-CONTRACT.md § 3.1 + delta-
+  // compute per § 1.4 + per-block reset per § 1.1. Distinct prefix
+  // from the existing `kbd/audio block` (kbd-diagnostic) and
+  // `audio/engine split block` (W13.1-D2 audio_mix bracket) so the
+  // 6-layer grep stays clean: [flip-stat] → [engine-tick-stat] →
+  // [mode-tick-stat] → [mode-draw-scene-stat] → [mds-tilemap-cache] →
+  // [tile-speedup-stat] (one-shot) → kbd/audio block → audio/engine
+  // split block → **[audio-block ...]** → counters/closers.
+  //
+  // Delta-compute pattern (per flush-instr's locked spec 2026-05-06):
+  // SDL-side IRQ-5 ISR maintains cumulative counters
+  // (`doskutsu_audio_irq_count`, `doskutsu_audio_irq_wall_us`,
+  // `doskutsu_audio_sfx_active_count`); engine-side reads cumulative
+  // values at each audit-flush, computes deltas vs the prior-snapshot
+  // last-read values (file-scope statics), writes deltas into the
+  // per-block storage. Modular uint32_t arithmetic is wrap-safe per
+  // C99 unsigned-overflow semantics. Idle-pause counters are direct-
+  // populated by p10_audio_idle_pause_callback (defined above).
+  //
+  // Per anti-pattern #2: this block runs unconditionally; the env
+  // gate _abl_p10_audio_instr() controls EMIT only, not counter
+  // updates. Counter updates must be unconditional so values are
+  // ready at emit time on whichever block the operator first sets
+  // AUDIO_INSTR=1.
+  {
+    static std::uint32_t _last_doskutsu_audio_irq_count = 0;
+    static std::uint32_t _last_doskutsu_audio_irq_wall_us = 0;
+    static std::uint32_t _last_doskutsu_audio_sfx_active_count = 0;
+
+    const std::uint32_t now_irq_count   = doskutsu_audio_irq_count;
+    const std::uint32_t now_irq_wall_us = doskutsu_audio_irq_wall_us;
+    const std::uint32_t now_sfx_active  = doskutsu_audio_sfx_active_count;
+
+    // Modular wrap-safe per C99: unsigned subtraction is well-defined
+    // even when current < last (e.g., SDL-side counters reset on
+    // backend swap or atomic 32-bit wrap after ~71 minutes at any
+    // realistic IRQ rate). The delta represents "change since prior
+    // block-flush"; wrap produces a small positive delta which is
+    // correct for the rolling-sum semantic.
+    NXE::Diag::g_p10_audio_irq_count_block   = now_irq_count   - _last_doskutsu_audio_irq_count;
+    NXE::Diag::g_p10_audio_irq_wall_us_block = now_irq_wall_us - _last_doskutsu_audio_irq_wall_us;
+    NXE::Diag::g_p10_sfx_active_count_block  = now_sfx_active  - _last_doskutsu_audio_sfx_active_count;
+
+    _last_doskutsu_audio_irq_count          = now_irq_count;
+    _last_doskutsu_audio_irq_wall_us        = now_irq_wall_us;
+    _last_doskutsu_audio_sfx_active_count   = now_sfx_active;
+
+    // Emit gated on AUDIO_INSTR=1. Counter values are set above
+    // unconditionally; gate prevents log noise when env unset.
+    // Per § 3.5 emission cadence: per audit-flush block (matches
+    // existing _flip_phase_block_size = 100 cadence). Defensive
+    // empty-block placeholder per § 3.5: if irq_count=0 (block had
+    // zero IRQs — defensive for very early in the run before any
+    // audio init), still emit with backend=current (sticky).
+    if (_abl_p10_audio_instr())
+    {
+      LOG_INFO("[audio-block n={} irq_count={} irq_wall_us={} idle_count={} idle_us={} backend={} sfx={}]",
+               _dc_tally_every_flips,
+               NXE::Diag::g_p10_audio_irq_count_block,
+               NXE::Diag::g_p10_audio_irq_wall_us_block,
+               NXE::Diag::g_p10_audio_idle_pause_count_block,
+               NXE::Diag::g_p10_audio_idle_pause_us_block,
+               NXE::Diag::backend_to_string(NXE::Diag::g_p10_audio_backend_active),
+               NXE::Diag::g_p10_sfx_active_count_block);
+    }
+
