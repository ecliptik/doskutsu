+// patch 0168 (Lever 2b MIDI-tick-from-IRQ): refresh g_midi_isr_events
+// from _events. Called from main thread under cli/sti so the ISR
+// doesn't observe a partial copy. Truncates to MIDI_ISR_EVENTS_MAX
+// with LOG_WARN. Idempotent. No-op when L2b is OFF (cache-OFF cost is
+// one cached-bool query); under L2b ON, called at every _events
+// mutation (load / load_from_preload_cache / SMF parse path) so the
+// ISR's view stays in sync.
+//
+// DPMI lock the buffer + count on first refresh (after which the lock
+// is dormant -- single lock-table entry maintained by CWSDPMI).
+void MidiScheduler::_refresh_isr_buffer()
+{
+  if (!SDL_DOSMidiIsrTickActive())
+    return;  // L2b off; no need to refresh ISR buffer
+
+  // patch 0168-v2 (TAS-replay .bss-layout fix per team-lead #139 +
+  // flush-instr re-audit): lazy-alloc g_midi_isr_events on first
+  // refresh-under-L2b-ON. Under L2b OFF the early-return above ensures
+  // this alloc never fires; binary's .bss footprint stays byte-
+  // identical to pre-0168 modulo the pointer slot. Under L2b ON, alloc
+  // is ~196 KB (sizeof(MidiEvent) ~12 bytes x 16384) -- sub-ms on
+  // DX2-66; process-lifetime; DPMI-locked immediately. Alloc failure
+  // is handled gracefully: LOG_ERROR + force count = 0 + return;
+  // tick_isr's count gate prevents dispatch so the engine doesn't
+  // crash (song stalls under L2b ON until killswitch is unset).
+  if (!g_midi_isr_events)
+  {
+    g_midi_isr_events = (MidiEvent *)std::malloc(
+        sizeof(MidiEvent) * MIDI_ISR_EVENTS_MAX);
+    if (!g_midi_isr_events)
+    {
+      LOG_ERROR("MidiScheduler::_refresh_isr_buffer: malloc({} bytes) "
+                "FAILED; L2b ISR-tick path disabled for this session. "
+                "System free heap insufficient for the locked-down "
+                "events buffer. tick_isr will see event_count=0 and "
+                "dispatch nothing; song stalls but engine doesn't crash. "
+                "Run with L2b OFF (unset SDL_HINT_DOSKUTSU_MIDI_ISR_"
+                "TICK) to restore main-loop tick path.",
+                (unsigned)(sizeof(MidiEvent) * MIDI_ISR_EVENTS_MAX));
+      g_midi_isr_event_count = 0;
+      return;
+    }
+    // Zero-init the freshly-malloc'd region defensively. The cli/sti
+    // memcpy below covers the steady-state race; the zero-init covers
+    // the gap between alloc and the first cli/sti window.
+    std::memset(g_midi_isr_events, 0,
+                sizeof(MidiEvent) * MIDI_ISR_EVENTS_MAX);
+  }
+
+  const std::size_t n_total = _events.size();
+  const std::size_t n_copy  = (n_total > MIDI_ISR_EVENTS_MAX)
+                                  ? MIDI_ISR_EVENTS_MAX
+                                  : n_total;
+  if (n_total > MIDI_ISR_EVENTS_MAX)
+  {
+    LOG_WARN("MidiScheduler::_refresh_isr_buffer: track has {} events; "
+             "ISR buffer is {} (truncated; events after {} will not "
+             "dispatch under L2b ON -- the engine-thread tick() path "
+             "still uses _events directly under L2b OFF)",
+             n_total, (std::size_t)MIDI_ISR_EVENTS_MAX,
+             (std::size_t)MIDI_ISR_EVENTS_MAX);
+  }
+
+  // First-time DPMI lock the buffer + count. Idempotent in CWSDPMI's
+  // lock-table; calling _go32_dpmi_lock_data on already-locked memory
+  // is a no-op. We guard on g_midi_isr_buffer_locked anyway to skip
+  // the syscall on subsequent refreshes.
+#ifdef __DJGPP__
+  if (!g_midi_isr_buffer_locked)
+  {
+    // patch 0168-v2: lock the malloc'd region with explicit byte count.
+    // sizeof(g_midi_isr_events) under v2's pointer layout returns
+    // sizeof(MidiEvent *) = 4 bytes which would only lock the pointer
+    // itself, not the buffer it points to -- pass the explicit
+    // sizeof(MidiEvent) * MIDI_ISR_EVENTS_MAX instead.
+    _go32_dpmi_lock_data(g_midi_isr_events,
+                         (unsigned long)(sizeof(MidiEvent) * MIDI_ISR_EVENTS_MAX));
+    _go32_dpmi_lock_data((void *)&g_midi_isr_event_count,
+                         sizeof(g_midi_isr_event_count));
+    g_midi_isr_buffer_locked = true;
+  }
+#endif
+
+  // cli/sti around the memcpy + count publish. ISR cannot observe a
+  // partial copy: either old count + buffer or new count + buffer.
+  // Window is ~ n_copy * 12 bytes ~= 60-200 KB memcpy -- bounded; on a
+  // DX2-66 with ~10 MB/s memory bandwidth ~= 6-20 ms. Larger than
+  // ideal for an IRQ-mask window, but load() is rare (~once per stage
+  // transition) and the alternative (a publish-old / write-new /
+  // publish-new sequence with double-buffering) is more complex.
+  {
+    MidiIsrCriticalSection _cs;
+    std::memcpy(g_midi_isr_events, _events.data(), n_copy * sizeof(MidiEvent));
+    g_midi_isr_event_count = n_copy;
+  }
+}
+
+// patch 0168 (Lever 2b): ISR-context-safe tick variant. Called from the
+// SB16 IRQ-5 ISR via the midi_scheduler_tick_isr_thunk extern "C" shim,
+// registered with SDL/0072's SDL_DOSMidiTickRegister. Strict IRQ-context
+// discipline:
+//
+// - No malloc/free. No FPU. No SDL API calls beyond what's strictly
+//   needed (no LOG_*, no SDL_GetTicksNS).
+// - Reads g_midi_isr_events + g_midi_isr_event_count instead of _events
+//   (the std::vector backing can reallocate mid-run; the fixed-size
+//   buffer is DPMI-locked + populated by _refresh_isr_buffer under
+//   cli/sti).
+// - Uses _us_per_tick_x256 (fixed-point int64) instead of _us_per_tick
+//   (double). Computation: event_us = (abs_tick * us_per_tick_x256)
+//   >> 8. Quantization error <0.5 us per tick stored; accumulated
+//   drift <0.1 ms over a 4-minute song -- well below MIDI tolerance.
+//
+// Backend dispatch_event call: OPL3 / WB backends do outportb only
+// (verified ISR-safe by sdl-engine per L2b-Q3 contract). MidiBackendStub
+// has a runtime guard at the top of its dispatch_event body that
+// short-circuits when SDL_DOSMidiIsrTickActive returns true; the
+// MidiBackendStub's LOG_DEBUG call is NOT ISR-safe (printf-family +
+// SDL log subsystem).
