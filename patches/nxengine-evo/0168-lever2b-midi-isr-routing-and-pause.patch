+// DOS-PORT (patch 0168, Lever 2b MIDI-tick-from-IRQ). ISR-context-safe
+// fixed-size event buffer. Populated by main-thread load() under cli/sti
+// guard; read by the IRQ-5 ISR via tick_isr(). Replaces direct iteration
+// over the std::vector<MidiEvent> _events because vector storage can
+// reallocate during ::resize / push_back, leaving a stale data() pointer
+// that the ISR might dereference. Fixed-size buffer eliminates that
+// failure class entirely. See LEVER2B-MIDI-ISR-TICK-DESIGN.md sec.2.3 +
+// sec.2.5 + STOP-and-ack Q3 closure.
+//
+// Size budget: 16384 events x sizeof(MidiEvent) (16 bytes with default
+// padding) = 256 KB. Cave Story's coalesced track sizes are 5K-10K
+// events typical; 16K is ~2x headroom. Buffer heap-allocated + DPMI-
+// locked on the first SDL_DOSMidiIsrTickActive()-true _refresh_isr_-
+// buffer() so the ISR can read it without paging concerns; load
+// attempts with event count > 16384 are truncated with LOG_WARN (the
+// ISR-tick path simply doesn't dispatch the overflow events; the
+// engine-thread tick() path still uses _events directly under L2b OFF).
+//
+// Volatile count: written by main thread under cli/sti, read by ISR via
+// plain volatile load (atomic on aligned x86). cli/sti ensures the ISR
+// doesn't observe a partial copy: load() does cli, memcpy, set count,
+// sti -- so the ISR either sees the old count (with the old buffer
+// contents still consistent) or the new count (with the new buffer
+// contents fully copied).
+namespace
+{
+constexpr std::size_t MIDI_ISR_EVENTS_MAX = 16384;
+// patch 0168-v2 (LAZY-ALLOC amend): heap pointer + lazy alloc instead of
+// 256 KB file-scope static array. v1 deterministically displaced .bss
+// layout vs pre-0168 binaries -> TAS replay state evolution broke even
+// under L2b OFF (cross-binary regression, same-binary deterministic ==
+// verdict (C) pattern from back-to-back PLAY0+PLAY1 determinism
+// diagnostic). v2 keeps the pointer nullptr until first L2b-engaged
+// _refresh_isr_buffer() call, at which point 256 KB is heap-allocated
+// and DPMI-locked once. L2b-OFF path never allocates (zero bytes on
+// the heap, 8-byte pointer slot in .bss).
+MidiScheduler::MidiEvent *g_midi_isr_events       = nullptr;
+volatile std::size_t      g_midi_isr_event_count    = 0;
+volatile bool             g_midi_isr_buffer_locked  = false;
+
+// patch 0168 (Lever 2b): scoped cli/sti RAII gated on
+// SDL_DOSMidiIsrTickActive(). Use in main-thread MidiScheduler bodies
+// that mutate state the ISR reads (start/stop/set_backend/load). When
+// L2b OFF, ctor/dtor are no-op + cost is just the cached-bool query.
+// When L2b ON, cli/sti masks IRQ-5 for the critical-section duration --
+// brief (~few us); acceptable per LEVER2B-MIDI-ISR-TICK-DESIGN.md
+// sec.2.5. Mirrors the FtAccumulatorGuard RAII pattern from
+// nxengine/0162-v2's load_stage.
+struct MidiIsrCriticalSection
+{
+  bool active;
+  MidiIsrCriticalSection() : active(SDL_DOSMidiIsrTickActive())
+  {
+#ifdef __DJGPP__
+    if (active) __asm__ __volatile__("cli\n");
+#else
+    (void)active;
+#endif
+  }
+  ~MidiIsrCriticalSection()
+  {
+#ifdef __DJGPP__
+    if (active) __asm__ __volatile__("sti\n");
+#endif
+  }
+};
+}  // anonymous namespace
+
+}  // namespace Sound
+}  // namespace NXE
+
+// patch 0168 (Lever 2b): extern "C" thunk for SDL_DOSMidiTickRegister.
+// Lives at file scope with EXTERNAL linkage so SoundManager.cpp can take
+// its address. The SDL/0072 SoundBlasterIRQHandler invokes this from
+// IRQ-5 context with now_ms; the thunk forwards to the MidiScheduler
+// singleton's tick_isr method.
+//
+// IRQ-context discipline: the call chain is thunk -> MidiScheduler::
+// getInstance() (returns a cached pointer; no allocation) -> tick_isr
+// (ISR-safe by construction per tick_isr's body). No FPU, no SDL API
+// calls, no DPMI thunks beyond the locked-data reads tick_isr makes.
+extern "C" void midi_scheduler_tick_isr_thunk(Uint64 now_ms)
+{
+  NXE::Sound::MidiScheduler::getInstance()->tick_isr((std::uint64_t)now_ms);
+}
