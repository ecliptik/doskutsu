+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -28,6 +28,7 @@
 #include "../../video/dos/SDL_dosdbg.h" /* DOSKUTSU patch 0041: doskutsu_dbg_log routing */
 #include "SDL_dosaudio_sb.h"
 #include <SDL3/SDL_dosaudio_shutdown.h> /* DOSKUTSU patch 0053: engine-callable SDL_DOSAudioBeginShutdown export */
+#include <SDL3/SDL_dosaudio_pump.h>     /* DOSKUTSU patch 0067: engine-callable SDL_DOSAudioPump export (audio mid-gap-service) */
 
 /* DOSKUTSU patch (Phase 10 patch 0038): IRQ-5 instrumentation +
    idle-pause coordination state. The public-API state vars are defined
@@ -259,6 +260,23 @@ static Uint32 g_c_audiocb_block = 0;       /* emitted-block counter */
 static bool g_dos_audio_shutdown_park_disabled = false;
 static volatile bool g_dos_audio_hard_park = false;
 
+/* DOSKUTSU patch (Phase 11 patch 0067): captured SDL_AudioDevice pointer
