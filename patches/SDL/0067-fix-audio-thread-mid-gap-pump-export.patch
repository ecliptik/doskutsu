+                     "engine-callback re-entry bounded to scalar slot bookkeeping)");
+
     /* DOSKUTSU patch (Phase 11 patch 0050): resolve quiescence-gate
        killswitch once at OpenDevice time. Strict-"0" match per CLAUDE.md
        env-var convention. Cached at module scope; read by
@@ -1553,6 +1581,153 @@ void SDL_DOSAudioBeginShutdown(void)
     }
 }
 
+/* DOSKUTSU patch (Phase 11 patch 0067, v2): engine-callable audio-
+   mid-gap pump. Runs ONE SDL_PlaybackAudioThreadIterate cycle on the
+   open SDL3-DOS audio device, from the calling (engine main) thread,
+   and returns a bool indicating whether the caller may call again to
+   top up further. The engine calls this from Leg A (stage-load freads;
+   v2 wraps the call in `while (SDL_DOSAudioPump()) { }` per
+   nxengine-evo/0162) and, later, Leg B (mid-Renderer-phase seams)
+   per docs/internal/AUDIO-MID-GAP-SERVICE-DESIGN.md, to pre-empt SB16
+   ring underruns during long single-flip render gaps on slow CPUs
+   (486-class campaign Bug 1 / flush-instr #75 sec.16.3 -- the SFX
+   stutter is gap-driven, not rate-driven; v1's one-iterate-per-call
+   gave ~10% coverage over 400-1400 ms load_stage windows, so v2 tops
+   up the ring to full per seam).
+
+   Return contract:
+   - true  = the iterate did meaningful work AND the ring is not yet
+             full. The caller MAY call again to top up further.
+   - false = either the iterate was a no-op (TryLock+timeout backstop
+             tripped per SDL/0068; device->shutdown observed; NULL
+             device), or the cap-trip defense-in-depth fired, or the
+             ring is now full (audio thread will drain naturally;
+             further pumps waste CPU). The caller's `while`-loop exits.
+
+   The three safety properties (see SDL3/SDL_dosaudio_pump.h for the
+   full design rationale + the engine call-site dependence):
+
+   (1) Does NOT touch the SDL renderer. SDL_PlaybackAudioThreadIterate
+       (SDL_audio.c:1175) -> DOSSOUNDBLASTER_GetDeviceBuf -> SDL3 core
+       mix loop -> SDL3_mixer MixerCallback (SDL_mixer.c:533) -> per-
+       track get-callback (SDL_mixer.c:~340-470) -> DOSSOUNDBLASTER_
+       PlayDevice -- nothing in this chain touches video / surface /
+       palette / cursor / drawcall state.
+
+   (2) Does NOT run any SDL event handlers. The iterate path does not
+       call SDL_PumpEvents and does not synchronously dispatch event-
+       watch callbacks. The one event-adjacent path,
+       SDL_AudioDeviceDisconnected (SDL_audio.c:823), defers via
+       SDL_RunOnMainThread and only fires on failure (the DOS backend
+       returns true on every Iterate/WaitDevice path so it does not
+       fire in normal operation).
+
+   (3) Does NOT re-enter engine code via callback beyond scalar slot
+       bookkeeping. The one synchronous engine-callback re-entry is the
+       MIX_TrackStoppedCallback chain (SDL_mixer.c:466 -> :228) ->
+       Pixtone's mySfxCallback (Pixtone.cpp:279) -> Pixtone::pxtSoundDone
+       (Pixtone.cpp:725-743), which is two scalar writes
+       (`_sound_fx[slot].channel = -1` + `--g_pixtone_active_count`)
+       -- no renderer, no events, no engine-state mutation. This is
+       the "marks a slot free" carve-out the design's sec.3.1
+       explicitly allows.
+
+   The v2 while-loop pattern (caller-side `while (SDL_DOSAudioPump()) { }`)
+   repeats the Iterate path N times serially; each individual iteration
+   honors all three safety properties; the loop introduces no new
+   touch points.
+
+   The pump is unconditional from SDL's side -- the export always
+   attempts one iterate when called. The decision whether to call it
+   lives engine-side and is gated by the engine's reading of
+   SDL_HINT_DOSKUTSU_AUDIO_MIDGAP_PUMP -- default-ON, strict-"0"
+   disables (killswitch shape, same as SDL/0066's SHUTDOWN_PARK).
+   Absent the killswitch, the engine calls SDL_DOSAudioPump in a
+   top-up loop at each of the 6 load_stage seams (per
+   nxengine-evo/0162), iterating until the ring is full. With the
+   killswitch set to "0", the engine short-circuits before
+   SDL_DOSAudioPump -- this export is unaffected (it stays
+   unconditional) but no engine call-site invokes it. Set "0" only
+   to A/B-confirm the Leg A pump against the pre-0162 freeze on real
+   DX2-66 hardware.
+
+   Iter cap (defense-in-depth, v2): a static counter tracks
+   consecutive true-returns within one call-sequence and force-returns
+   false if the count exceeds 32 (~ 750 ms audio, ~ 2x typical 16-
+   chunk ring depth). Catches caller-side `while`-loop bugs (lost
+   return check, off-by-one) before they spin forever. The counter
+   resets on every false-return path so the next call-sequence (next
+   seam) starts fresh. Won't false-trigger in normal play (a 16-chunk
+   ring needs ~16 iterates to fill, well under 32).
+
+   Threading: callable from the engine main thread. Not safe to call
+   from an interrupt context (the iterate takes locks and may yield via
+   the cooperative scheduler). Not safe to call from the SDL audio
+   playback thread itself (would self-deadlock on the device lock --
+   SDL mutexes are recursive only for the same tid; the audio thread's
+   re-entry would not deadlock per se but the semantic is undefined). */
+bool SDL_DOSAudioPump(void)
+{
+    static Uint32 calls_since_false_return = 0;
+
+    SDL_AudioDevice *device = g_dos_audio_device;
+    if (!device) {
+        calls_since_false_return = 0;
+        return false;  /* no-op: device not open or already closed */
+    }
+
+    /* Defense-in-depth iter cap. Caller-side
+       `while (SDL_DOSAudioPump()) { }` bugs (lost return check,
+       off-by-one) could spin forever; this caps cumulative true-
+       returns per call-sequence at 32 (~ 750 ms audio, ~ 2x typical
+       16-chunk ring depth). On trip: log a one-line diagnostic,
+       reset counter, return false (caller's loop exits; next
+       call-sequence starts fresh). */
+    if (calls_since_false_return >= 32) {
+        doskutsu_dbg_log("audio: SDL/0067 SDL_DOSAudioPump cap tripped "
+                         "(>32 calls in one sequence; possible runaway "
+                         "caller); forcing false-return");
+        calls_since_false_return = 0;
+        return false;
+    }
+
+    /* Acquire outer device->lock. This 0067 patch uses a blocking
+       SDL_LockMutex -- which under DOSBox-X / 86Box SB16 emulation is
+       wedge-prone via cooperative-scheduler starvation (build-qa #84
+       bisect). The SDL/0068 hunk above amends this acquisition to a
+       TryLock+timeout backstop with a strict-"0" killswitch
+       (SDL_HINT_DOSKUTSU_DOS_AUDIO_PUMP_TIMEOUT) that reverts to this
+       blocking path for the operator's A/B reproducer cell. */
+    SDL_LockMutex(device->lock);
+
+    /* Iterate runs with the outer lock held. Iterate's own SDL_LockMutex
+       recurses (same tid; SDL mutexes are recursive on DOS); its matching
+       SDL_UnlockMutex inside Iterate decrements the recursion counter
+       back to 1 -- so we still hold the lock when Iterate returns. That
+       lets us read the ring-room snapshot INSIDE the outer lock, for
+       consistency with WaitDevice's own room check (line 720-721 of
+       this file) -- same definition of "room" = same predicate
+       boundary. */
+    bool iter_ok = SDL_PlaybackAudioThreadIterate(device);
+    bool has_room = false;
+
+    if (iter_ok) {
+        struct SDL_PrivateAudioData *hidden = device->hidden;
+        const int used = hidden->ring_write - isr_ring_read;
+        has_room = (hidden->ring_size - used) >= hidden->chunk_size;
+    }
+
+    SDL_UnlockMutex(device->lock);
+
+    if (has_room) {
+        calls_since_false_return++;
+        return true;  /* iterate did work; ring not yet full */
+    }
+
+    calls_since_false_return = 0;
+    return false;  /* iter no-op (shutdown) OR ring full -- caller's loop exits */
+}
