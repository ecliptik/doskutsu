+   DOSSOUNDBLASTER_OpenDevice entry; cleared to NULL at the end of
+   DOSSOUNDBLASTER_CloseDevice. SDL_DOSAudioPump reads this pointer to
+   know which device's SDL_PlaybackAudioThreadIterate cycle to run from
+   the calling (engine main) thread. NULL == device not open ==
+   SDL_DOSAudioPump returns harmlessly without iterating (no-op).
+
+   Volatile so the audio thread's view of NULL/non-NULL is not
+   compiler-reordered relative to the device's own open/close lifecycle
+   (aligned pointer stores on x86 are atomic; no barrier needed beyond
+   the volatile-prevents-reorder semantics, matching the existing
+   g_dos_audio_hard_park pattern). Same-process single audio device
+   (no per-thread captures); SDL3-DOS only supports one device open at
+   a time anyway. */
+static SDL_AudioDevice * volatile g_dos_audio_device = NULL;
+
 /* DOSKUTSU patch (Phase 11 patch 0058): Shape A mechanism-histogram
    instrumentation state. Diagnostic backstop for wave-36 PLAY6 Shape
    D fps lever per `pressure_test_tidy_narratives.md` discipline: if
@@ -940,6 +958,16 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
 {
     const bool is_sb16 = soundblaster_is_sb16;
 
+    /* DOSKUTSU patch (Phase 11 patch 0067): capture the device pointer
+       so the engine-callable SDL_DOSAudioPump() (declared in
