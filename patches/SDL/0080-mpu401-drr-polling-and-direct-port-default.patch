+                         "default since patch 0080 is direct-port + bit-6 DRR "
+                         "polling per WBTEST-006 H20 confirmation; DSP cmd 0x34 "
+                         "UART entry)",
                          (unsigned)port_base);
         SDL_DOSAudioSB_DSPMidiEnterUART();
         s_mpu401_port_base = (int)port_base;  /* sentinel = "ready"; not used for I/O */
@@ -121,11 +140,57 @@ bool SDL_DOSMpu401Init(uint16_t port_base)
         return true;
     }
 
-    /* === Opt-in path: direct-port MPU-401 (Option A; legacy 0044 default) === */
+    /* === Default path: direct-port MPU-401 + bit-6 DRR polling (patch 0080) === */
