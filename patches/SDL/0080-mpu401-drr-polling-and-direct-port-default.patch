+/* DOSKUTSU patch (Phase 11 patch 0080): bounded bit-6 DRR poll helper.
+
+   Mirrors DOSMID source (github.com/Tronix286/DOSMID, MPU401.C,
+   mpu401_waitwrite + mpu401_uart): poll bit 6 (DRR, mask 0x40) of the
+   MPU status register at port_base+1 until it CLEARS (chip ready to
+   receive); bounded iteration cap so a chip variant that never clears
+   DRR cannot hang the IRQ-5 ISR. Returns true if DRR cleared in time,
+   false if the cap was hit; callers fail-soft (write the byte anyway
+   so a chip with stuck-high bit 6 still gets the data, mirroring the
+   patch-0044 / patch-0047 "blind write" fallback policy).
+
+   Iter cap = 10000. Empirical max from WBTEST-006 probe on g2k
+   Vibra16S CT2490 (POD-83): iters_max=238 across calls=51 with
+   cap_hits=0 -- ~1 us per inportb on P54C, so 10000 iters ~= 10 ms
+   worst-case wallclock if a chip variant stalls; well outside the
+   per-write IRQ-5 service budget but bounded enough that one stuck
+   write does not freeze the system. The 40x headroom above the
+   observed maximum is the design margin against per-chip variation.
+
+   One-shot cap-warn so the log isn't spammed if a chip variant has
+   stuck-high DRR; the warn message names the killswitch path so the
+   operator has a clear next step. Per docs/internal/WBTEST-001-FINDINGS.md
+   rev-8 (H20 confirmation chain). */
+static bool s_mpu401_drr_cap_warned = false;
+static bool SDL_DOSMpu401WaitDRR(uint16_t port_base)
+{
+    const Uint16 status_port = (Uint16)(port_base + 1);
+    for (int iter = 0; iter < 10000; iter++) {
+        if ((inportb(status_port) & 0x40) == 0) {
+            return true;
+        }
+    }
+    if (!s_mpu401_drr_cap_warned) {
+        doskutsu_dbg_log("mpu401: DRR poll cap hit at port_base=0x%04x "
+                         "(bit 6 stuck high after 10000 iter ~= 10 ms; "
+                         "chip variant may have stuck DRR; fail-soft "
+                         "blind write follows -- direct-port path may be "
+                         "unreliable on this hardware; set "
+                         "SDL_HINT_DOSKUTSU_AUDIO_WB_DIRECT_PORT=0 to "
+                         "fall back to DSP-mediated path)",
+                         (unsigned)port_base);
+        s_mpu401_drr_cap_warned = true;
+    }
+    return false;
+}
+
 /* DOSKUTSU patch (Phase 10 patch 0047): direct-port path extracted from
    the patch-0044 SDL_DOSMpu401Init body. Entry guarded behind the
    SDL_HINT_DOSKUTSU_AUDIO_WB_DIRECT_PORT=1 hint. Body unchanged from
@@ -170,15 +235,26 @@ static bool SDL_DOSMpu401Init_DirectPort(uint16_t port_base)
     const bool do_probe = (probe_env && probe_env[0] == '1' && probe_env[1] == 0);
 
     if (!do_probe) {
-        doskutsu_dbg_log("mpu401: blind init at port_base=0x%04x "
-                         "(probe disabled — patch 0044 default; set "
-                         "SDL_HINT_DOSKUTSU_AUDIO_PROBE_MPU401=1 to enable "
-                         "probe path with LOCKUP RISK on real Vibra16S+S2)",
+        doskutsu_dbg_log("mpu401: direct-port init at port_base=0x%04x "
+                         "(default since patch 0080; bit-6 DRR polling "
+                         "before UART entry + every byte write per "
+                         "WBTEST-006 H20 confirmation; probe path "
+                         "disabled, set SDL_HINT_DOSKUTSU_AUDIO_PROBE_MPU401=1 "
+                         "to enable it with LOCKUP RISK on real Vibra16S+S2; "
+                         "set SDL_HINT_DOSKUTSU_AUDIO_WB_DIRECT_PORT=0 "
+                         "to fall back to DSP-mediated path)",
                          (unsigned)port_base);
-        /* UART mode entry. After this, all writes to data port pass
-           directly to MIDI bus; status bit 6 (0x40) = DRR (data ready
-           to receive; must be 0 before each write — but we never read
-           it on this path; chip clocks data out on its own). */
+        /* DOSKUTSU patch (Phase 11 patch 0080): bit-6 DRR poll before
+           UART entry write. A capped-out poll at init is a strong "this
+           chip variant does not honor bit 6" signal -- the helper logs
+           it once-per-process; we fail-soft and write the byte anyway
+           so chips that work without polling still get the same blind
+           init the patch-0044 path provided. */
+        (void)SDL_DOSMpu401WaitDRR(port_base);
+        /* UART mode entry. After this, all writes to the data port pass
+           directly to the MIDI bus. Status bit 6 (0x40) = DRR (Data
+           Ready to Receive); the helper above gates this write on it
+           per DOSMID source (mpu401_uart in MPU401.C). */
         outportb((Uint16)(port_base + 1), 0x3F);
         s_mpu401_port_base = (int)port_base;
         return true;
@@ -255,15 +331,21 @@ void SDL_DOSMpu401WriteByte(uint8_t byte)
         return;
     }
 
-    /* Direct-port path (Option A; legacy 0044 default). Per W22-WB-F
-       analysis hard-no #1: do NOT poll MPU status bit 7 (TX-READY)
-       before writing — it never clears on SB16 PnP CTL0026. The
-       previous implementation's `while ((inportb(base+1) & 0x40) != 0)`
-       happened to work only because bit 6 (DRR) is a different bit
-       than bit 7 (TX-READY); but on chips where bit 6 also lies, this
-       would hang. Removing the poll altogether per analysis Option A
-       step 5 — "BLIND write; do not poll status". */
+    /* Direct-port path (default since patch 0080). DOSKUTSU patch
+       (Phase 11 patch 0080): bit-6 DRR poll before every byte write
+       per DOSMID source (github.com/Tronix286/DOSMID, MPU401.C,
+       mpu401_waitwrite). WBTEST-006 H20 confirmed on g2k Vibra16S
+       CT2490 that polling bit 6 -- NOT the patch-0042/0047-era
+       conjecture about bit 7 TX-READY -- is the prerequisite that
+       lets non-note MIDI events through. The previous "BLIND write;
+       do not poll status" comment (patch 0044/0047) was correct that
+       bit 7 lies on SB16 PnP CTL0026, but incorrect to extend that
+       to ALL status bits: bit 6 (DRR) is reliable on this hardware
+       and is the per-byte gate the chip expects. cap_hits=0 in the
+       reference probe; fail-soft writes the byte anyway if a stuck
+       chip variant ever caps out. */
     const Uint16 base = (Uint16)s_mpu401_port_base;
+    (void)SDL_DOSMpu401WaitDRR(base);
     outportb(base, byte);
 }
 
@@ -297,7 +379,16 @@ void SDL_DOSMpu401Shutdown(void)
         outportb((Uint16)(s_mpu401_port_base + 1), 0xFF);
     }
     s_mpu401_port_base = -1;
-    s_mpu401_use_dsp = true; /* reset to default for next init cycle */
+    /* DOSKUTSU patch (Phase 11 patch 0080): reset to default for next
+       init cycle. The patch-0047-era default was DSP-mediated (true);
+       patch 0080 flips the default to direct-port (false). Functionally
+       cosmetic -- SDL_DOSMpu401Init's env dispatch overwrites this on
+       every entry -- but kept consistent with the new default. */
+    s_mpu401_use_dsp = false;
+    /* Clear the DRR cap-warn one-shot too: a re-init may target
+       different hardware (or DOSBox-X smoke between iters), and a
+       prior cap-hit on one chip should not silence a future warn. */
+    s_mpu401_drr_cap_warned = false;
 }
 
