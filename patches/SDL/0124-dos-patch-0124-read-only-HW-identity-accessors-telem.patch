 include/SDL3/SDL_dosident.h     | 151 ++++++++++++++++++++++++++++++++
 src/audio/dos/SDL_dosaudio_sb.c |  43 +++++++++
 src/video/dos/SDL_dosmodes.c    |  22 +++++
