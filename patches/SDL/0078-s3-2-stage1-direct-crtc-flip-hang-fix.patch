 }
 
-// DOSKUTSU patch 0077 (S3-2 Stage 1) -- display-start page-flip via VBE
-// 0x4F07, replacing wave-50's Cirrus-specific direct-CRTC programming
-// (CRTC[0x0C/0x0D]+[0x1B]+[0x1D]). 0x4F07 is chip-agnostic and the same
-// BIOS call the slow path already uses for LFB page-flips, so it works on
-// the S3 ViRGE/DX without an S3-specific CRTC register map. The origin is
-// addressed in SCANLINES (DX) -- byte_offset / pitch -- where pitch is
-// cached in _vram_resident_pitch by the snapshot-holding callers.
+// DOSKUTSU patch 0078 (S3-2 Stage 1 HANG FIX) -- display-start page-flip
+// via DIRECT S3 CRTC register write, replacing patch 0077's per-frame VBE
+// 0x4F07 __dpmi_int(0x10). The 0x4F07 PM->RM transition deadlocked the
+// machine when the SB16 IRQ-5 audio ISR + an INT 21h SFX disk-load
+// contended for the single non-re-entrant DPMI real-mode state (the
+// Mimiga polar-star hang). This path is PURE PROTECTED-MODE PORT I/O --
+// NO real-mode INT -> the re-entrancy window is gone entirely.
+//
+// S3 ViRGE/DX display-start is in WORD units (byte_offset >> 1),
+// crtcswap-probe-verified on the g2k S3+UNIVBE (chip 0x8A01): the
+// operator confirmed the WORD hold turns page 1 visible (byte/dword stay
+// on page 0). 320x240x8 page-1 byte offset 0x12C00 -> word 0x9600 ->
+// CR0C=0x96, CR0D=0x00, CR69=0x00. Streams mode is OFF (CR67=0x00,
+// gated at engage) so the CRTC start path is in effect.
 //
-// Uses BX=0x0000 (set display start IMMEDIATELY, no BIOS retrace-wait) so
-// the call cannot spin on a missing retrace, then a BOUNDED vblank wait
-// AFTER programming. Waiting AFTER (not before) is the wave-50 flicker
-// fix: the CRTC start-address latches at vsync, so returning only after
-// that vsync guarantees the just-presented page is actually visible
-// before the engine draws into the other page. The wait is bounded so a
-// stuck retrace bit degrades to a finite stall, never a hang.
+// Bounded vblank AFTER the program (flicker fix, unchanged from 0077):
+// the CRTC start-address latches at vsync, so returning only after that
+// vsync guarantees the just-presented page is visible before the engine
+// draws the other page. The wait runs with interrupts enabled (audio
+// flows) and is bounded (a stuck retrace bit degrades to a finite stall,
+// never a hang). No pitch needed -- WORD address = byte_offset >> 1.
 static void _crtc_set_display_start_byte(Uint32 byte_offset)
 {
-    const int pitch = (_vram_resident_pitch > 0) ? _vram_resident_pitch : 1;
-    const Uint16 scanline = (Uint16)(byte_offset / (Uint32)pitch);
-
-    __dpmi_regs r;
-    SDL_zero(r);
-    r.x.ax = 0x4F07;
-    r.x.bx = 0x0000;   // set display start, immediate (no BIOS retrace wait)
-    r.x.cx = 0;        // first displayed pixel in scan line (x = 0)
-    r.x.dx = scanline; // first displayed scan line (page origin / pitch)
-    __dpmi_int(0x10, &r);
-
-    // Flicker fix: wait one vblank AFTER programming so the start-address
-    // latch has taken effect before we return. Bounded -- HW-IO safe.
+    _vram_resident_write_crtc_start_word(byte_offset >> 1); // WORD units
     _vram_resident_wait_vblank_bounded();
 }
 
