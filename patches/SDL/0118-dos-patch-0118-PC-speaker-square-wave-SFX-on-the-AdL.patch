+    DOS_DisableInterrupts();
+    if (flush) {
+        /* PREEMPT: drop the queue + any sounding note, start THIS note now. */
+        s_beep_rd = s_beep_wr = 0;
+        BeepStartNote(div, (uint16_t)ticks);
+    } else {
