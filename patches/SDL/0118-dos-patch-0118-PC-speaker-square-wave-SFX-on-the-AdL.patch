+        const int queued = s_beep_wr - s_beep_rd;
+        if (queued < PCSPK_NOTE_RING) {
+            const int i = s_beep_wr & PCSPK_NOTE_MASK;
+            s_beep_ring[i].div   = div;
+            s_beep_ring[i].ticks = (uint16_t)ticks;
+            s_beep_wr++;
+        }
+        if (!s_beep_playing && s_beep_rd != s_beep_wr) {
+            const int i = s_beep_rd & PCSPK_NOTE_MASK;
+            const uint16_t d = s_beep_ring[i].div;
+            const uint16_t t = s_beep_ring[i].ticks;
+            s_beep_rd++;
+            BeepStartNote(d, t);
+        }
+    }
+    DOS_EnableInterrupts();
