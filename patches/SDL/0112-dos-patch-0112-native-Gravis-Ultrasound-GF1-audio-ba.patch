+/*
+ * SDL_dosgus.h -- DOSKUTSU local patch SDL/0112 (Campaign 3, native Gravis
+ * Ultrasound / GF1 wavetable engine). NOT upstream SDL.
+ *
+ * Engine-facing export surface for the native GF1 audio backend
+ * (src/audio/dos/SDL_dosaudio_gus.c). The GF1 is driven OUT-OF-BAND, exactly
+ * like the shipped AdLib/OPL path (SDL/0110's PIT/OPL exports): it is NOT an
+ * SDL streaming audio device. There is no SDL audio device opened for GUS, no
+ * SDL_INIT_AUDIO involvement, and no SDL3_mixer PCM sink. The engine brings the
+ * card up via SDL_DOSGusInit() (mirroring how the AdLib path uses
+ * SDL_DOSOpl2Detect + the pump start), then uploads samples into the card's
+ * on-board DRAM and commands GF1 hardware voices through the calls below. The
+ * GF1 mixes in hardware straight to its DAC; the host CPU does allocation +
+ * event dispatch only.
+ *
+ * Export-pattern mirrors SDL3/SDL_dosvesa_directaccess.h (DOSKUTSU patch
+ * SDL/0034): SDL_DECLSPEC + SDLCALL, extern "C", thin snapshot struct.
+ *
+ * Division of labor (deliberate): the CALLER passes friendly engine units
+ * (playback Hz, 0..255 linear volume, 0..255 pan) and native-format sample
+ * bytes; the DRIVER owns every GF1 fixed-point / logarithmic / 4-bit register
+ * conversion so the engine never touches a raw GF1 register.
+ *
+ * Ownership: the ENGINE owns the voice pool lifecycle. AllocVoice hands out a
+ * voice; the driver NEVER auto-returns a wave-ended voice. The engine polls
+ * SDL_DOSGusGetState().voice_active_mask to learn a one-shot voice finished,
+ * then calls SDL_DOSGusStopVoice to free it (single-owner = no note desync).
+ *
+ * See docs/internal/GUS-NATIVE-DESIGN.md (model B amendment).
+ */
+
+#ifndef SDL_dosgus_h_
+#define SDL_dosgus_h_
+
+#include <SDL3/SDL_stdinc.h>
+#include <SDL3/SDL_begin_code.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Sentinel returned by SDL_DOSGusUploadSample on failure (OOM in card DRAM,
+   no active GF1 device). A valid DRAM byte address is always < dram_size
+   (<= 1 MB), so 0xFFFFFFFF can never be a real address. */
+#define SDL_DOSGUS_BAD_ADDR ((Uint32)0xFFFFFFFFu)
+
+/* Flags for SDL_DOSGusStartVoice(). */
+#define SDL_DOSGUS_LOOP   0x01u /* loop start..end (else one-shot, stop at end) */
+#define SDL_DOSGUS_16BIT  0x02u /* sample is 16-bit signed (else 8-bit unsigned) */
+#define SDL_DOSGUS_BIDI   0x04u /* bidirectional (ping-pong) loop */
+#define SDL_DOSGUS_IRQ    0x08u /* accepted but NO-OP: the IRQ-independent driver never enables wave-end IRQs (poll voice_active_mask instead) */
+
+/* Snapshot of the active GF1 device state. Cheap struct copy + a per-voice
+   hardware status poll; safe to call once per MIDI tick. */
+typedef struct SDL_DOSGusState
+{
+    bool   valid;             /* GF1 detected AND SDL_DOSGusInit succeeded */
+    Uint16 base_port;         /* GF1 base I/O port (e.g. 0x240) */
+    Uint8  gf1_irq;           /* GF1 IRQ (ULTRASND field 4) */
+    Uint8  play_dma;          /* playback DMA channel (ULTRASND field 2) */
+    Uint8  num_voices;        /* active-voice count programmed (e.g. 28) */
+    Uint8  pad0;
+    Uint32 output_rate;       /* resulting DAC sample rate (e.g. 22050 @ 28 voices) */
+    Uint32 dram_size;         /* detected on-board DRAM, bytes (256K..1MB) */
+    Uint32 dram_used;         /* bump-allocator high-water (bytes uploaded so far) */
+    Uint32 voice_active_mask; /* bit N set = voice N is still sounding (hardware) */
+    Uint32 abi_version;       /* export ABI version, currently 1 */
+} SDL_DOSGusState;
+
+/**
+ * Bring up the native GF1 card.
+ *
+ * Parses the GUS hints (SDL_HINT_DOSKUTSU_GUS_ULTRASND / _ULTRADIR / _VOICES,
+ * which the engine bridges from the real ULTRASND/ULTRADIR env vars), resets
+ * the GF1, runs DRAM peek/poke detection + sizing, programs the active-voice
+ * count (rate), enables the DAC, and hooks + locks the GF1 IRQ. Emits the
+ * SDL/0112 detect banner. Out-of-band: no SDL audio device is opened.
+ *
+ * \returns true if a GF1 was detected and initialized (then
+ *          SDL_DOSGusGetState().valid==true); false if absent (honors
+ *          SDL_HINT_DOSKUTSU_GUS_SKIP_DETECTION=1 as a bring-up bypass).
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSGusInit(void);
+
+/**
+ * Tear down the native GF1 card.
+ *
+ * Stops + silences all voices, unhooks the GF1 IRQ, and parks the chip in
+ * reset. Idempotent and safe to call unconditionally (a no-op if Init was
+ * never called or already torn down).
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSGusShutdown(void);
+
+/**
+ * Snapshot the native GF1 device state.
+ *
+ * \param out caller-allocated struct that receives the snapshot. The
+ *            voice_active_mask field is refreshed from the GF1 hardware
+ *            voice-stopped status on each call.
+ * \returns true when the GF1 device is active (out->valid==true); false
+ *          otherwise (out fully zeroed).
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSGusGetState(SDL_DOSGusState *out);
+
+/**
+ * Upload a sample block into the card's on-board DRAM, VERBATIM.
+ *
+ * The bytes are written to DRAM exactly as supplied -- no sign conversion. The
+ * caller hands native GF1 format: 8-bit UNSIGNED, or 16-bit SIGNED when
+ * is16bit!=0 (the caller owns any .pat/.pxt signed->unsigned flip). The driver
+ * bump-allocates DRAM; 16-bit samples are aligned so they never straddle a
+ * 256K bank boundary.
+ *
+ * \param data source sample bytes. May be a protected-mode (>1MB) pointer.
+ * \param len  length in BYTES.
+ * \param is16bit non-zero if `data` is 16-bit signed PCM.
+ * \returns the DRAM byte address the sample now lives at (use it for the
+ *          start/end/loopstart arguments of SDL_DOSGusStartVoice), or
+ *          SDL_DOSGUS_BAD_ADDR on failure.
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC Uint32 SDLCALL SDL_DOSGusUploadSample(const void *data, Uint32 len, int is16bit);
+
+/**
+ * Rewind the DRAM bump allocator, preserving a low keep region.
+ *
+ * Sets the allocator high-water back to `keep_bytes`: subsequent uploads
+ * reuse DRAM above it, while [0, keep_bytes) is preserved. Intended for
+ * per-song .pat residency swaps that must NOT wipe a persistent low region
+ * (e.g. the resident Pixtone SFX bank). Pass 0 to drop everything.
+ *
+ * Does NOT stop voices: the caller must first stop any voice still reading
+ * the region being freed (the engine owns voice lifecycle).
+ *
+ * \param keep_bytes number of low DRAM bytes to preserve.
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSGusResetDram(Uint32 keep_bytes);
+
+/**
+ * Allocate a hardware voice from the shared pool.
+ *
+ * \returns a voice index in [0, num_voices), or -1 if the pool is exhausted.
+ *          The voice stays allocated until the caller releases it with
+ *          SDL_DOSGusStopVoice -- the driver never auto-frees it, even after
+ *          a one-shot sample reaches its end (poll voice_active_mask to learn
+ *          it finished, then StopVoice).
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC int SDLCALL SDL_DOSGusAllocVoice(void);
+
+/**
+ * Start a hardware voice playing a resident DRAM sample.
+ *
+ * \param voice      a voice index from SDL_DOSGusAllocVoice.
+ * \param start      DRAM byte address of the sample's first byte.
+ * \param end        DRAM byte address of the sample's last byte (loop/stop).
+ * \param loopstart  DRAM byte address of the loop point (used when
+ *                   SDL_DOSGUS_LOOP is set; ignored otherwise).
+ * \param flags      SDL_DOSGUS_LOOP / _16BIT / _BIDI / _IRQ, OR'd.
+ *
+ * Addresses are plain DRAM byte addresses (the space UploadSample returns);
+ * the driver applies the GF1 fixed-point split and the 16-bit address quirk.
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSGusStartVoice(int voice, Uint32 start, Uint32 end, Uint32 loopstart, Uint32 flags);
+
+/**
+ * Stop a voice and return it to the pool.
+ *
+ * The engine calls this both on note_off (after its software release ramp)
+ * and to reap a one-shot voice that voice_active_mask reported finished.
+ *
+ * \param voice a voice index previously returned by SDL_DOSGusAllocVoice.
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSGusStopVoice(int voice);
+
+/**
+ * Stop and free EVERY voice in one pass (song-boundary quiesce).
+ *
+ * Stops + silences all hardware voices and returns them all to the pool inside
+ * a single critical section, so no voice is left reading card DRAM. Intended
+ * for SONG .pat-residency boundaries ONLY (call it before swapping the .pat
+ * bank + uploading the new song's instruments) -- never per-SFX. Idempotent and
+ * safe when no voices are active.
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSGusStopAllVoices(void);
+
+/**
+ * Set a voice's playback frequency.
+ *
+ * \param voice       a voice index.
+ * \param playback_hz the desired sample-playback rate in Hz. For a MIDI note:
+ *                    sample_native_rate * 2^((note - patch_root_key)/12).
+ *                    The driver converts Hz -> GF1 frequency-control value.
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSGusSetVoiceFreq(int voice, Uint32 playback_hz);
+
+/**
+ * Set a voice's volume (instantaneous).
+ *
+ * There is no hardware ramp export; the caller does software release ramps by
+ * stepping this across ticks, then SDL_DOSGusStopVoice.
+ *
+ * \param voice      a voice index.
+ * \param linear_vol 0..255 linear amplitude. The driver converts to the GF1
+ *                   4.8 logarithmic volume format.
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSGusSetVoiceVol(int voice, int linear_vol);
+
+/**
+ * Set a voice's stereo pan.
+ *
+ * \param voice a voice index.
+ * \param pan   0..255 (0 = hard left, 128 = center, 255 = hard right). The
+ *              driver maps to the GF1 4-bit pan register.
+ *
+ * \since DOSKUTSU patch SDL/0112.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSGusSetVoicePan(int voice, int pan);
+
+#ifdef __cplusplus
+}
+#endif
+
+#include <SDL3/SDL_close_code.h>
+
+#endif /* SDL_dosgus_h_ */
