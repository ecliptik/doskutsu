@@ -221,6 +221,39 @@ extern SDL_DECLSPEC void SDLCALL SDL_DOSMidiTickRegister(SDL_DOSMidiTickCallback
  */
 extern SDL_DECLSPEC bool SDLCALL SDL_DOSMidiIsrTickActive(void);
 
+/*
+ * DOSKUTSU patch (SDL/0110, Campaign 2 AdLib): shared ISR-active predicate.
+ *
+ * Returns true if EITHER the SB16 IRQ-5 MIDI tick (SDL_DOSMidiIsrTickActive())
+ * OR the AdLib PIT/IRQ-0 OPL music pump (SDL_DOSOplTimerPumpActive(),
+ * SDL_dosopltimer.h) is currently driving MidiScheduler::tick_isr from a
+ * hardware ISR.
+ *
+ * The engine's MidiScheduler reentrancy guards -- the MidiIsrCriticalSection
+ * cli/sti, the _refresh_isr_buffer early-return, the OPL/OPL2 backend instance
+ * DPMI-lock, and the runFade per-frame-tick skip -- must be gated on THIS
+ * predicate (not the SB-only SDL_DOSMidiIsrTickActive()) so they engage under
+ * either clock. Under the AdLib path there is no SB, so the SB-only predicate
+ * is false while a REAL IRQ-0 ISR reads the scheduler data -- gating on the
+ * SB-only predicate there would leave cli/sti + DPMI-locks disengaged during
+ * live ISR reads (a freeze/corruption hazard). This predicate closes that gap.
+ *
+ * \returns true if either the SB-IRQ MIDI tick or the PIT OPL pump is active.
+ * \since SDL 3 -- doskutsu workspace-local patch 0110, 2026-06-22.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSMidiIsrAnyActive(void);
+
+/*
+ * DOSKUTSU patch (SDL/0110): accessor for the MIDI tick callback registered
+ * via SDL_DOSMidiTickRegister. The AdLib PIT pump (SDL_dosopltimer.h) snapshots
+ * this at SDL_DOSOplTimerPumpStart so it can drive the SAME engine
+ * MidiScheduler tick the SB path drives. Returns NULL if none is registered.
+ *
+ * \returns the registered SDL_DOSMidiTickCallback, or NULL.
+ * \since SDL 3 -- doskutsu workspace-local patch 0110, 2026-06-22.
+ */
+extern SDL_DECLSPEC SDL_DOSMidiTickCallback SDLCALL SDL_DOSMidiTickGetRegistered(void);
+
 /* Ends C function definitions when using C++ */
 #ifdef __cplusplus
 }
