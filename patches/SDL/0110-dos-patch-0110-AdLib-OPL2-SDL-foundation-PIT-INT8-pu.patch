+// SDL_DOSOpl3Detect; OPL2 included). Distinct name for AdLib-path log clarity.
+extern bool SDL_DOSOpl2Detect(void);
+
+// Initializes an OPL2 chip to a known state: enables waveform-select (reg 0x01
+// bit 5), clears the rhythm/tremolo/vibrato latch (reg 0xBD), and KEY-OFFs the
+// 9 primary-bank voices. Does NOT touch the OPL3 0x105/0x104 registers.
+extern void SDL_DOSOpl2InitChip(void);
+
+// Silences an OPL2 chip: TL=0x3F max-attenuation sweep on both operators of the
