+/*
+ * DOSKUTSU patch (SDL/0110, Campaign 2 AdLib): PIT/INT8 OPL music pump.
+ *
+ * Workspace-local; NOT upstreamed (same status as SDL_dosmidi_tick.h).
+ *
+ * PURPOSE. On a pure AdLib / OPL-only card (including a PicoGUS in
+ * `/mode adlib`) there is no Sound Blaster, so the SB16 IRQ-5 that normally
+ * drives the MIDI tick (Lever 2b, SDL_dosmidi_tick.h) never fires -- the
+ * music has no clock. This pump replaces that clock with the 8253 PIT
+ * channel-0 timer interrupt (IRQ-0 / INT 8): it reprograms PIT ch0 from the
+ * BIOS default 18.2065 Hz up to a finer MIDI tick rate, hooks IRQ-0, and from
+ * that ISR drives the SAME registered MIDI tick callback the SB path uses
+ * (SDL_DOSMidiTickRegister / the engine's MidiScheduler tick_isr). The
+ * original BIOS INT 8 handler is chained at the divided rate (called once per
+ * 18.2065 Hz worth of fast ticks) so the DOS time-of-day clock stays correct.
+ *
+ * SINGLE OWNER OF PIT CH0. The pump is the sole writer of the PIT ch0 divisor
+ * for the duration of a run. SDL_DOSOplTimerPumpStart REFUSES (returns false)
+ * if the SB audio device is hot (SDL_DOSAudioSB_IsDeviceHot()), so the SB-IRQ
+ * clock and the PIT clock can never both drive the MIDI tick. On SB-present
+ * configs (opl3 / wb / organya) this pump is never started; the SB IRQ-5
+ * remains the clock exactly as before.
+ *
+ * RESTORATION IS MANDATORY. A left-reprogrammed PIT ch0 makes the DOS clock
+ * run fast after quit. SDL_DOSOplTimerPumpStop restores the divisor to the
+ * BIOS default (0 -> 65536 -> 18.2065 Hz) and unhooks IRQ-0; it MUST run on
+ * both normal teardown and an atexit-style early handler.
+ *
+ * ISR DISCIPLINE. The pump ISR runs in hardware interrupt context, preempting
+ * the cooperative scheduler. It performs no malloc/free, no FPU, no SDL API
+ * calls; the ISR + its data are DPMI-locked at Start. The tick callback it
+ * invokes (the engine's MidiScheduler::tick_isr) is already ISR-safe and the
+ * engine's MidiScheduler cli/sti + DPMI-lock guards must be gated on
+ * SDL_DOSMidiIsrAnyActive() (SDL_dosmidi_tick.h) so they engage under EITHER
+ * the SB-IRQ clock OR this PIT clock.
+ */
+
+#ifndef SDL_dosopltimer_h_
+#define SDL_dosopltimer_h_
+
+#include <SDL3/SDL_stdinc.h>
+
+#include <SDL3/SDL_begin_code.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Install the PIT-ch0 / IRQ-0 OPL music pump at `hz` ticks per second.
+ *
+ * Reprograms PIT ch0 to `hz`, hooks IRQ-0 (replace + manual every-Nth chain
+ * to the original BIOS INT 8 so the 18.2065 Hz DOS clock is preserved), and
+ * DPMI-locks the ISR + its data. The pump invokes the MIDI tick callback
+ * previously registered with SDL_DOSMidiTickRegister, at `hz`, from IRQ-0
+ * context, with a monotonic now_ms.
+ *
+ * Register the MIDI tick callback (SDL_DOSMidiTickRegister) BEFORE calling
+ * this, the same ordering the SB path uses (register at SoundManager::init
+ * before the clock arms).
+ *
+ * \param hz the tick rate (clamped/validated to [19, 1000]; ~120 recommended).
+ * \returns true if the pump was installed, false if it is already active, if
+ *          the SB audio device is hot (the SB IRQ-5 owns the clock), or if hz
+ *          is out of range.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSOplTimerPumpStart(int hz);
+
+/**
+ * Restore PIT ch0 to the BIOS 18.2065 Hz divisor and unhook IRQ-0.
+ *
+ * MUST run at shutdown and from an atexit-style handler. Idempotent: a no-op
+ * if the pump is not active. Never masks IRQ-0 (the system timer must keep
+ * running).
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSOplTimerPumpStop(void);
+
+/**
+ * \returns true if the PIT OPL pump is currently active for this process.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSOplTimerPumpActive(void);
+
+#ifdef __cplusplus
+}
+#endif
+#include <SDL3/SDL_close_code.h>
+
+#endif /* SDL_dosopltimer_h_ */
