diff --git a/src/core/dos/SDL_dos_audio_synth.c b/src/core/dos/SDL_dos_audio_synth.c
index 9dc29b6c3..285180bb0 100644
--- a/src/core/dos/SDL_dos_audio_synth.c
+++ b/src/core/dos/SDL_dos_audio_synth.c
@@ -39,6 +39,8 @@
 #if defined(SDL_PLATFORM_DOS)
 
 #include "SDL_dos_audio_synth.h"
+#include <SDL3/SDL_dosmidi_tick.h>  /* SDL/0110: registered-tick accessor + Any-active predicate */
+#include <SDL3/SDL_dosopltimer.h>   /* SDL/0110: AdLib PIT/IRQ-0 OPL music pump API */
 
 /* DOSKUTSU patch (Phase 10 patch 0041): route Phase 10 init banners
    through doskutsu_dbg_log so they reach <TAG>SDL.LOG (sdldbg.log).
@@ -1174,6 +1176,257 @@ void SDL_DOSOpl3Shutdown(void)
     SDL_DOSOpl3WriteRegister(0x105, 0x00);
 }
 
+/* ========================================================================
+ * DOSKUTSU patch (SDL/0110, Campaign 2 AdLib): OPL2 chip helpers
+ * ========================================================================
+ * OPL2 = 9 voices, single bank (0x388/0x389). NO secondary bank, NO OPL3
+ * 0x105/0x104. Voices 0-8 are all primary-bank (s_opl3_voice_offsets[0..8]),
+ * so the existing voice/patch/note helpers serve them unchanged; only chip
+ * init/shutdown + detect differ from the OPL3 path. See ADLIB-NATIVE-DESIGN.md
+ * sec.7.1. */
+
+bool SDL_DOSOpl2Detect(void)
+{
+    /* OPL2 detection == the standard Adlib timer-1 rollover sequence on the
+       primary base, which detects ANY OPL (OPL2 included). Reuse the OPL3
+       detector verbatim; the distinct name is for AdLib-path log clarity and
+       so the engine's MidiBackendOpl2 has a semantically-named entry point. */
+    return SDL_DOSOpl3Detect();
+}
+
+void SDL_DOSOpl2InitChip(void)
+{
+    /* OPL2: do NOT write 0x105 (OPL3 enable) or 0x104 (4-op) -- those are
+       secondary-bank / OPL3-only and hit nonexistent registers on a real
+       OPL2 / PicoGUS AdLib mode. */
+    /* Enable waveform-select (reg 0x01 bit 5 = WSE) so non-sine operator
+       waveforms are usable, per the AdLib/OPL2 spec. */
+    SDL_DOSOpl3WriteRegister(0x01, 0x20);
+    /* Clear the rhythm-mode / tremolo-depth / vibrato-depth latch (reg 0xBD)
+       -- the wub-wub source; start from a known-quiet melodic state. */
+    SDL_DOSOpl3WriteRegister(0xBD, 0x00);
+    /* KEY-OFF the 9 primary-bank voices (all reg<0x100 -> primary port; the
+       secondary bank is never touched). */
+    for (int v = 0; v < 9; v++) {
+        SDL_DOSOpl3VoiceNoteOff(v);
+    }
+    doskutsu_dbg_log("audio: SDL/0110 OPL2 chip init (9 voices, single bank "
+                     "0x388/0x389; no OPL3 0x105/0x104; WSE on; 0xBD cleared)");
+}
+
+void SDL_DOSOpl2Shutdown(void)
+{
+    /* TL=0x3F max-attenuation sweep on both operators of the 9 primary-bank
+       voices (the OPL3 wub-wub-teardown discipline, sized for OPL2's 9
+       voices), then KEY-OFF + clear 0xBD. No OPL3-mode-disable -- we never
+       enabled it. */
+    for (int v = 0; v < 9; v++) {
+        const uint16_t op0 = s_opl3_voice_offsets[v].op0_base;
+        const uint16_t op1 = s_opl3_voice_offsets[v].op1_base;
+        SDL_DOSOpl3WriteRegister((uint16_t)(0x40 + op0), 0x3F);
+        SDL_DOSOpl3WriteRegister((uint16_t)(0x40 + op1), 0x3F);
+    }
+    for (int v = 0; v < 9; v++) {
+        SDL_DOSOpl3VoiceNoteOff(v);
+    }
+    SDL_DOSOpl3WriteRegister(0xBD, 0x00);
+    doskutsu_dbg_log("audio: SDL/0110 OPL2 chip shutdown (9-voice TL=0x3F "
+                     "sweep + KEY-OFF + 0xBD clear; OPL2 mode left intact)");
+}
+
+/* ========================================================================
+ * DOSKUTSU patch (SDL/0110, Campaign 2 AdLib): PIT/INT8 OPL music pump
+ * ========================================================================
+ * Replaces the SB16 IRQ-5 as the MIDI clock on a no-SB AdLib box. Reprograms
+ * 8253 PIT ch0 to a fine tick rate, hooks IRQ-0 (replace + manual every-Nth
+ * chain to the original BIOS INT 8 so the 18.2065 Hz DOS clock is preserved),
+ * and from that ISR drives the SAME registered MIDI tick callback the SB path
+ * uses. See ADLIB-NATIVE-DESIGN.md sec.3 + LEAD DECISIONS (d). API +
+ * discipline contract: include/SDL3/SDL_dosopltimer.h. */
+
+#define DOS_PIT_INPUT_HZ      1193182UL  /* 8253 PIT input clock */
+#define DOS_OPL_PUMP_HZ_MIN   19         /* >= the BIOS 18.2 Hz floor */
+#define DOS_OPL_PUMP_HZ_MAX   1000       /* ISR-overhead ceiling */
+
+static DOS_InterruptHook s_opl_pit_hook;
+static volatile bool     s_opl_pump_active = false;
+
+/* Far pointer (offset:selector) to the saved original protected-mode INT 8
+   handler, for the manual every-Nth chain. Layout matches gas `lcall *mem`
+   (32-bit offset then 16-bit selector). DPMI-locked at Start. */
+static volatile struct { uint32_t off; uint16_t sel; } s_old_int8_vec;
+
+/* ISR-touched state (all DPMI-locked at Start). */
+static volatile uint32_t s_pit_div = 0;       /* our PIT ch0 divisor */
+static volatile uint32_t s_us_per_tick = 0;   /* microseconds per fast tick */
+static volatile uint32_t s_us_frac = 0;       /* sub-millisecond us accumulator */
+static volatile Uint64   s_now_ms = 0;        /* monotonic ms for the tick cb */
+static volatile uint32_t s_bios_accum = 0;    /* fractional toward the 18.2 Hz BIOS tick */
+static SDL_DOSMidiTickCallback s_pump_tick_cb = NULL;
+
+/* Chain to the original BIOS INT 8 (it issues its own EOI). Simulate the
+   interrupt entry: push flags, far-call the saved protected-mode vector; the
+   handler's IRET pops EIP/CS/EFLAGS, balancing the CALL's CS/EIP + our pushfl.
+   This is the canonical DJGPP "call the previous handler" idiom. DPMI-locked.
+   NOTE (g2k-validation item per [[dosbox_not_proxy]]): the EOI/chain split +
+   this far-call are the BIOS-tick-correctness risk the design flagged -- they
+   require real-HW confirmation; DOSBox-X cannot validate IRQ-0 timing. */
+static void OplPitChainOld(void)
+{
+    __asm__ __volatile__(
+        "pushfl\n\t"
+        "lcall *%0\n\t"
+        :
+        : "m"(s_old_int8_vec)
+        : "memory", "cc");
+}
+static void OplPitChainOld_End(void) {}
+
+/* IRQ-0 / INT 8 ISR. Installed via DOS_HookInterruptReplace (an IRET wrapper
+   enters this as a plain C function). Runs with interrupts disabled. */
+static void OplPitISR(void)
+{
+    /* 1. advance the monotonic clock by one fast-tick period (no 64-bit
+       divide in-ISR: collapse the us accumulator to ms with a small loop). */
+    s_us_frac += s_us_per_tick;
+    while (s_us_frac >= 1000u) {
+        s_us_frac -= 1000u;
+        s_now_ms++;
+    }
+
+    /* 2. drive the music (the engine's ISR-safe MidiScheduler::tick_isr). */
+    if (s_pump_tick_cb) {
+        s_pump_tick_cb(s_now_ms);
+    }
+
+    /* 3. preserve the BIOS 18.2065 Hz tick. Accumulate our divisor; each time
+       it rolls 65536, the original INT 8 must run exactly once -- which makes
+       the BIOS handler fire at (fast_rate * div / 65536) == PIT_INPUT/65536 ==
+       18.2065 Hz EXACTLY, independent of our chosen rate. The original handler
+       issues its own EOI, so we do NOT EOI on a chained tick; otherwise we EOI
+       the master PIC ourselves. */
+    s_bios_accum += s_pit_div;
+    if (s_bios_accum >= 65536u) {
+        s_bios_accum -= 65536u;
+        OplPitChainOld();      /* original BIOS INT 8 runs + EOIs */
+    } else {
+        DOS_EndOfInterrupt(0); /* master-PIC EOI (IRQ-0) */
+    }
+}
+static void OplPitISR_End(void) {}
+
+bool SDL_DOSOplTimerPumpStart(int hz)
+{
+    if (s_opl_pump_active) {
+        doskutsu_dbg_log("audio: SDL/0110 OPL timer pump: already active -- refused");
+        return false;
+    }
+    /* SINGLE OWNER of PIT ch0: never coexist with the SB IRQ-5 clock. */
+    if (SDL_DOSAudioSB_IsDeviceHot()) {
+        doskutsu_dbg_log("audio: SDL/0110 OPL timer pump: REFUSED -- SB device is "
+                         "hot (SB IRQ-5 owns the MIDI clock; the PIT pump is the "
+                         "no-SB AdLib path only)");
+        return false;
+    }
+    if (hz < DOS_OPL_PUMP_HZ_MIN || hz > DOS_OPL_PUMP_HZ_MAX) {
+        doskutsu_dbg_log("audio: SDL/0110 OPL timer pump: hz=%d out of range "
+                         "[%d,%d] -- refused", hz, DOS_OPL_PUMP_HZ_MIN,
+                         DOS_OPL_PUMP_HZ_MAX);
+        return false;
+    }
+
+    /* PIT ch0 divisor + per-tick microseconds (derived from the ACTUAL divisor
+       so tempo tracks the real fire rate, not the requested hz). The 64-bit
+       math here runs at Start, not in-ISR. */
+    uint32_t div = (uint32_t)(DOS_PIT_INPUT_HZ / (unsigned)hz);
+    if (div < 1u)     div = 1u;
+    if (div > 65535u) div = 65535u;
+    s_pit_div     = div;
+    s_us_per_tick = (uint32_t)(((Uint64)div * 1000000ULL) / DOS_PIT_INPUT_HZ);
+    s_us_frac     = 0;
+    s_now_ms      = 0;
+    s_bios_accum  = 0;
+
+    /* Snapshot the registered MIDI tick callback. The engine registers it
+       (SDL_DOSMidiTickRegister) BEFORE Start, mirroring the SB init order. */
+    s_pump_tick_cb = SDL_DOSMidiTickGetRegistered();
+
+    /* Install IRQ-0 via the REPLACE variant: an IRET wrapper enters OplPitISR
+       as the terminal handler, so we own the EOI + the manual every-Nth chain
+       (the chaining variant would run the old handler every fire == BIOS clock
+       ~6.6x fast at 120 Hz). */
+    DOS_HookInterruptReplace(0, OplPitISR, &s_opl_pit_hook);
+    s_old_int8_vec.off = (uint32_t)s_opl_pit_hook.original_irq_handler_seginfo.pm_offset;
+    s_old_int8_vec.sel = (uint16_t)s_opl_pit_hook.original_irq_handler_seginfo.pm_selector;
+
+    /* DPMI-lock the ISR + chain helper + all ISR-touched data BEFORE arming
+       the fast PIT rate so no page-fault can occur in interrupt context. */
+    DOS_LockCode(OplPitISR, OplPitISR_End);
+    DOS_LockCode(OplPitChainOld, OplPitChainOld_End);
+    DOS_LockVariable(s_pit_div);
+    DOS_LockVariable(s_us_per_tick);
+    DOS_LockVariable(s_us_frac);
+    DOS_LockVariable(s_now_ms);
+    DOS_LockVariable(s_bios_accum);
+    DOS_LockVariable(s_pump_tick_cb);
+    DOS_LockVariable(s_old_int8_vec);
+    DOS_LockVariable(s_opl_pump_active);
+
+    /* Program PIT ch0: control 0x43 = 0x36 (ch0, lobyte+hibyte, mode 3,
+       binary), then divisor low+high to 0x40. */
+    DOS_DisableInterrupts();
+    outportb(0x43, 0x36);
+    outportb(0x40, (Uint8)(div & 0xFF));
+    outportb(0x40, (Uint8)((div >> 8) & 0xFF));
+    s_opl_pump_active = true;
+    DOS_EnableInterrupts();
+
+    doskutsu_dbg_log("audio: SDL/0110 OPL timer pump STARTED hz=%d div=%u "
+                     "us_per_tick=%u (PIT ch0 reprogrammed; BIOS INT8 chained "
+                     "~every %u fast ticks -> 18.2065 Hz; tick_cb=%s)",
+                     hz, (unsigned)div, (unsigned)s_us_per_tick,
+                     (unsigned)(65536u / div),
+                     s_pump_tick_cb ? "registered"
+                                    : "NULL(no MidiScheduler tick registered!)");
+    return true;
+}
+
+void SDL_DOSOplTimerPumpStop(void)
+{
+    if (!s_opl_pump_active) {
+        return; /* idempotent */
+    }
+    /* Restore PIT ch0 to the BIOS default divisor (0 == 65536 -> 18.2065 Hz)
+       FIRST, so even a final in-flight ISR fire self-EOIs at the BIOS rate. */
+    DOS_DisableInterrupts();
+    outportb(0x43, 0x36);
+    outportb(0x40, 0x00);
+    outportb(0x40, 0x00);
+    s_opl_pump_active = false;
+    DOS_EnableInterrupts();
+
+    /* Restore the original INT 8 vector + free the IRET wrapper. Pass
+       disable_interrupt=false: IRQ-0 (the system timer) must NEVER be masked. */
+    DOS_UnhookInterrupt(&s_opl_pit_hook, false);
+
+    doskutsu_dbg_log("audio: SDL/0110 OPL timer pump STOPPED (PIT ch0 restored "
+                     "to 18.2065 Hz; IRQ-0 unhooked; timer left unmasked)");
+}
+
+bool SDL_DOSOplTimerPumpActive(void)
+{
+    return s_opl_pump_active;
+}
+
+/* DOSKUTSU patch (SDL/0110): shared ISR-active predicate. True if either the
+   SB16 IRQ-5 MIDI tick OR the AdLib PIT/IRQ-0 pump is driving the scheduler.
+   The engine's MidiScheduler reentrancy guards switch to this so they engage
+   under either clock (see SDL_dosmidi_tick.h). */
+bool SDL_DOSMidiIsrAnyActive(void)
+{
+    return SDL_DOSMidiIsrTickActive() || SDL_DOSOplTimerPumpActive();
+}
