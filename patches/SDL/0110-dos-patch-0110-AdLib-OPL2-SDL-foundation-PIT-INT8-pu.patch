     g_dos_midi_tick_cb = cb;
 }
 
+/* DOSKUTSU patch (SDL/0110, Campaign 2 AdLib): accessor for the registered
+   MIDI tick callback. The AdLib PIT/IRQ-0 OPL pump (SDL_dosopltimer.h, in
+   SDL_dos_audio_synth.c) snapshots this at SDL_DOSOplTimerPumpStart so it can
+   drive the SAME engine MidiScheduler tick the SB IRQ-5 path drives. The SB
+   path keeps reading g_dos_midi_tick_cb directly in SoundBlasterIRQHandler;
+   the pump lives in a different TU and cannot see this file-static, hence the
+   accessor. */
+SDL_DOSMidiTickCallback SDL_DOSMidiTickGetRegistered(void)
+{
+    return g_dos_midi_tick_cb;
+}
+
 /* Engine-visible accessor. Resolved at OpenDevice (sentinel-cached);
  * stable post-init. */
 bool SDL_DOSMidiIsrTickActive(void)
