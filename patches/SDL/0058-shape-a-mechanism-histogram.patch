 src/audio/dos/SDL_dosaudio_sb.c | 133 ++++++++++++++++++++++++++++++++
 1 file changed, 133 insertions(+)

diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index 6c040d7a1..0aeebfef7 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -153,6 +153,42 @@ static bool g_dos_silence_detect_enabled = true;
                        fps lever; predicted +3 to +5 fps vs PLAY1) */
 static bool g_dos_silence_shape_d_active = false;
 
+/* DOSKUTSU patch (Phase 11 patch 0058): Shape A mechanism-histogram
+   instrumentation state. Diagnostic backstop for wave-36 PLAY6 Shape
+   D fps lever per `pressure_test_tidy_narratives.md` discipline: if
+   PLAY6 doesn't deliver predicted +3 to +5 fps from Shape D
+   engagement, this histogram tells wave-37 whether the wave-35 cost
+   attribution hypothesis (per docs/PHASE11-WAVE-35-FINDINGS.md
+   section 2.1 -- "scan during dosmemput on cooperative scheduler
+   adds wall-clock to fi_ms") was correct, or whether the real cost
+   driver lives elsewhere (mixer-tick, cooperative-scheduler yield,
+   audio-thread wall-clock, etc.).
+
+   Per-100-PlayDevice-call histogram of:
+     - scan outcomes: silent vs noisy buffers per block
+     - scan wall-clock per outcome: lets us see if scan-loop wall-
+       clock alone matches the +3.34 ms fi_ms regression, or if the
+       cost is somewhere OTHER than the scan itself
+     - per-scan averages: instructions-per-byte sanity check
+
+   Gated on SDL_HINT_DOSKUTSU_SILENCE_HISTO=1 (strict-"1" match per
+   CLAUDE.md env-var convention; default OFF). Cost when OFF: zero
+   (cached static-bool short-circuits). Cost when ON: 2
+   SDL_GetTicksNS reads per Shape A scan + accumulator updates +
+   1 emit per 100 PlayDevice calls. Negligible.
+
+   Rides along Shape A path ONLY (Shape D doesn't perform the scan,
+   so wall-clock per scan is moot under Shape D). If PLAY6 sets BOTH
+   SHAPE=D and HISTO=1, the histogram still emits banner-active at
+   open but the per-block counters stay 0 because the Shape A branch
+   never executes. */
+static bool g_p58_silence_histo_active = false;
+static Uint32 g_p58_silent_count = 0;     /* scans that returned all-silence */
+static Uint32 g_p58_noisy_count = 0;      /* scans that returned non-silence */
+static Uint64 g_p58_silent_us_total = 0;  /* sum of wall-us for silent scans */
+static Uint64 g_p58_noisy_us_total = 0;   /* sum of wall-us for noisy scans */
+static Uint32 g_p58_pd_call_count = 0;    /* cadence: 100 PlayDevice calls/emit */
+
 /* DOSKUTSU patch (Phase 11 patch 0057): weak-fallback definition for
    the SDL_mixer-defined volatile. The strong definition lives in
    SDL3_mixer's MixerCallback TU
@@ -773,6 +809,44 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
         }
     }
 
+    /* DOSKUTSU patch (Phase 11 patch 0058): resolve Shape A mechanism
+       histogram engagement gate once at OpenDevice time. Strict-"1"
+       match per CLAUDE.md env-var convention. Diagnostic backstop for
+       PLAY6 Shape D fps lever: if PLAY6 doesn't move the needle, this
+       histogram tells wave-37 whether scan-loop wall-clock alone
+       explained the +3.34 ms fi_ms regression (silent_us_total /
+       silent_n should approximate the per-scan wall-cost) or whether
+       the cost lives elsewhere (cooperative-scheduler, mixer-tick,
+       etc.).
+
+       Independent of SHAPE=D engagement: HISTO=1 rides along Shape A
+       branch in PlayDevice; under SHAPE=D the scan doesn't run and
+       histogram counters stay 0 (informative empty data -- confirms
+       Shape D dispatch is engaged). Per
+       contract_grep_targets_require_enabling_env_vars.md the BAT cell
+       that enables histo MUST set the env var; banner emit names the
+       var explicitly so the operator can grep-verify. */
+    {
+        const char *histo_hint = SDL_GetHint("SDL_HINT_DOSKUTSU_SILENCE_HISTO");
+        g_p58_silence_histo_active =
+            (histo_hint && histo_hint[0] == '1' && histo_hint[1] == 0);
+        if (g_p58_silence_histo_active) {
+            doskutsu_dbg_log("audio: SDL/0058 Shape A mechanism histogram ACTIVE "
+                             "(HISTO=1; emits [silence-histo n=100 silent_n=N "
+                             "silent_us_total=N noisy_n=N noisy_us_total=N] "
+                             "per 100 PlayDevice calls; rides Shape A only)");
+            /* Reset counters so first emit measures from this point. */
+            g_p58_silent_count = 0;
+            g_p58_noisy_count = 0;
+            g_p58_silent_us_total = 0;
+            g_p58_noisy_us_total = 0;
+            g_p58_pd_call_count = 0;
+        } else {
+            doskutsu_dbg_log("audio: SDL/0058 Shape A mechanism histogram OFF "
+                             "(set SDL_HINT_DOSKUTSU_SILENCE_HISTO=1 to engage)");
+        }
+    }
+
     /* DOSKUTSU patch (Phase 11 patch 0055): resolve P12 SDL-side audio
        instrumentation gates once at OpenDevice time. BOTH FLIP_INSTR
        AND P12_AUDIO_INSTR must be set to "1" (strict-"1" match) for
@@ -1394,6 +1468,11 @@ static bool DOSSOUNDBLASTER_PlayDevice(SDL_AudioDevice *device, const Uint8 *buf
         if (g_dos_silence_shape_d_active) {
             all_silence = (doskutsu_mixer_actual_mixed_bytes == 0);
         } else {
+            /* Shape A bytewise scan. SDL/0058 brackets the scan with
+               SDL_GetTicksNS when HISTO=1 to attribute scan-loop
+               wall-clock to silent-vs-noisy buckets per outcome. */
+            const Uint64 _p58_t0 =
+                g_p58_silence_histo_active ? SDL_GetTicksNS() : 0;
             const Uint8 silence = soundblaster_silence_value;
             const Uint8 *p = buffer;
             const Uint8 *end = buffer + buffer_size;
@@ -1401,6 +1480,60 @@ static bool DOSSOUNDBLASTER_PlayDevice(SDL_AudioDevice *device, const Uint8 *buf
             while (p < end) {
                 if (*p++ != silence) { all_silence = false; break; }
             }
+            if (g_p58_silence_histo_active) {
+                /* DOSKUTSU patch (Phase 11 patch 0058): per-bucket scan-
+                   wall-clock accumulation. Shape A path only (Shape D
+                   doesn't scan; its counters stay 0; the cadence-driven
+                   emit below still fires under both shapes). */
+                const Uint64 _p58_us =
+                    (SDL_GetTicksNS() - _p58_t0) / 1000ULL;
+                if (all_silence) {
+                    g_p58_silent_count++;
+                    g_p58_silent_us_total += _p58_us;
+                } else {
+                    g_p58_noisy_count++;
+                    g_p58_noisy_us_total += _p58_us;
+                }
+            }
+        }
+
+        /* DOSKUTSU patch (Phase 11 patch 0058): cadence counter +
+           emit-at-100 placed OUTSIDE the SHAPE dispatch so it fires
+           under BOTH Shape A and Shape D paths when HISTO=1.
+
+           Rationale: under SHAPE=D the Shape A scan branch doesn't
+           execute, but the cadence counter MUST still tick so the
+           engagement-verify emit fires per
+           docs/PHASE11-WAVE-36-CONTRACT.md v3.3+ section 4 grep target
+           specification `[silence-histo n=100 silent_n=0
+           silent_us_total=0 noisy_n=0 noisy_us_total=0] >= 1 emit`.
+           Initially (pre-amend) the counter was nested inside the
+           Shape A branch's histo-active block; under SHAPE=D the
+           counter never ticked + no emit fired (absence-signal
+           pattern); contract spec expected presence-with-zeros
+           pattern. Per
+           contract_grep_targets_require_enabling_env_vars.md the
+           contract grep target IS the authoritative signal; the
+           implementation must match. Presence-with-zeros is also
+           more discriminating than absence (an absent emit could
+           mean Shape D engaged OR HISTO env-var not set OR binary
+           crashed; a present-zero-valued emit unambiguously means
+           HISTO engaged + Shape A scan path didn't fire). */
+        if (g_p58_silence_histo_active) {
+            if (++g_p58_pd_call_count >= 100) {
+                doskutsu_dbg_log(
+                    "[silence-histo n=100 silent_n=%u silent_us_total=%lu "
+                    "noisy_n=%u noisy_us_total=%lu]",
+                    g_p58_silent_count,
+                    (unsigned long)g_p58_silent_us_total,
+                    g_p58_noisy_count,
+                    (unsigned long)g_p58_noisy_us_total);
+                g_p58_silent_count = 0;
+                g_p58_noisy_count = 0;
+                g_p58_silent_us_total = 0;
+                g_p58_noisy_us_total = 0;
+                g_p58_pd_call_count = 0;
+            }
         }
         if (all_silence) {
             /* Skip the ring write — ring continues to drain via IRQ →
