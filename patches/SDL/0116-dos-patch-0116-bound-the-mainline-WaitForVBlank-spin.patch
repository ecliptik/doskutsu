From ef7306031120aadef9e66b363ccba39c554f1462 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Mon, 6 Jul 2026 11:57:12 -0700
Subject: [PATCH] dos: patch 0116 -- bound the mainline WaitForVBlank spin
 (HW-IO hang guard)

WaitForVBlank spins on the VGA input-status-1 retrace bit (0x3DA bit 3)
with NO timeout, in two back-to-back loops. It runs on the normal flush
path on any palette-change frame (vsync_interval>0 || dac_needs_update).
On real hardware a mode whose retrace bit never toggles (a flaky BIOS or
an odd/unexpected mode) hard-freezes the machine -- exactly the class of
HW-IO wedge the project already hit and worked around in the VRAM-resident
flip path (patch 0077's _vram_resident_wait_vblank_bounded), but the
mainline copy was never bounded.

For a PUBLIC release running on uncontrolled hardware, an unbounded
port-spin is a latent lockup. This patch bounds each spin with the same
2,000,000-iteration guard cap patch 0077 uses, so the worst case is a
finite stall + fall-through, never an infinite hang.

DEFAULT-ON with a strict-"0" killswitch (SDL_HINT_DOSKUTSU_VBLANK_BOUND=0)
restoring the original unbounded spin, plus a one-shot boot banner
"SDL/0116 VBLANK-BOUND" for the smoke banner gate. On a healthy card the
retrace edge arrives in far fewer than 2M iterations, so behavior on the
g2k reference target is unchanged.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 src/video/dos/SDL_dosframebuffer.c | 45 ++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/src/video/dos/SDL_dosframebuffer.c b/src/video/dos/SDL_dosframebuffer.c
index 741bd4a4f..a95b41218 100644
--- a/src/video/dos/SDL_dosframebuffer.c
+++ b/src/video/dos/SDL_dosframebuffer.c
@@ -862,6 +862,11 @@ static bool populate_fb_state_for_direct_fb(SDL_VideoDevice *device,
 // surface creation so the boot banner is emitted before the first flush.
 static int g_bank_gran_fix = 1;
 
+// DOSKUTSU patch 0116 (v1.6.1 public-HW): runtime lever for the bounded
+// mainline WaitForVBlank spin. DEFAULT-ON; strict-"0" killswitch
+// SDL_HINT_DOSKUTSU_VBLANK_BOUND=0 restores the original unbounded spin.
+static int g_vblank_bound = 1;
+
 bool DOSVESA_CreateWindowFramebuffer(SDL_VideoDevice *device, SDL_Window *window, SDL_PixelFormat *format, void **pixels, int *pitch)
 {
     // DOSKUTSU patch 0115 (v1.6.1 public-HW): one-shot resolve + boot banner
@@ -883,6 +888,24 @@ bool DOSVESA_CreateWindowFramebuffer(SDL_VideoDevice *device, SDL_Window *window
         }
     }
 
+    // DOSKUTSU patch 0116 (v1.6.1 public-HW): one-shot resolve + boot banner
+    // for the bounded-WaitForVBlank killswitch. "SDL/0116 VBLANK-BOUND" is the
+    // smoke banner-gate anchor.
+    {
+        static bool _vb_resolved = false;
+        if (!_vb_resolved) {
+            _vb_resolved = true;
+            const char *h = SDL_GetHint("SDL_HINT_DOSKUTSU_VBLANK_BOUND");
+            g_vblank_bound = (h && SDL_strcmp(h, "0") == 0) ? 0 : 1;
+            doskutsu_dbg_log("sdl: SDL/0116 VBLANK-BOUND %s "
+                             "(mainline WaitForVBlank spins are guard-capped; a mode "
+                             "whose retrace bit never toggles yields a finite stall + "
+                             "fall-through instead of an infinite HW-IO hang; "
+                             "killswitch SDL_HINT_DOSKUTSU_VBLANK_BOUND=0)",
+                             g_vblank_bound ? "ENABLED" : "DISABLED");
+        }
+    }
+
     // DOSKUTSU diagnostic (patches/SDL/0008 + 0009): per-call entry trace
     // for EVERY CreateWindowFramebuffer invocation. Patch 0008 caught only
     // the final invocation in a real-HW capture; the new sequence counter
@@ -1185,6 +1208,28 @@ static void BankedFramebufferCopyRect(const SDL_DisplayModeData *mdata,
 
 static void WaitForVBlank(void)
 {
+    if (g_vblank_bound) {
+        // DOSKUTSU patch 0116 (v1.6.1 public-HW): bounded spins (DEFAULT-ON).
+        // The original loops below spin on the VGA status port with NO
+        // timeout; on real HW an odd/broken mode whose retrace bit never
+        // toggles hard-freezes the machine (dosbox_not_proxy). The guard cap
+        // (same 2,000,000-iteration bound as patch 0077's
+        // _vram_resident_wait_vblank_bounded) makes the worst case a finite
+        // stall + fall-through instead of an infinite HW-IO hang. Killswitch
+        // SDL_HINT_DOSKUTSU_VBLANK_BOUND=0 restores the unbounded spin.
+        long guard;
+        for (guard = 0; (inportb(VGA_STATUS_PORT) & VGA_STATUS_VBLANK) &&
+                        guard < 2000000L; ++guard) {
+            SDL_CPUPauseInstruction();
+        }
+        for (guard = 0; !(inportb(VGA_STATUS_PORT) & VGA_STATUS_VBLANK) &&
+                        guard < 2000000L; ++guard) {
+            SDL_CPUPauseInstruction();
+        }
+        return;
+    }
+
+    // Legacy unbounded spin (killswitch SDL_HINT_DOSKUTSU_VBLANK_BOUND=0).
     while (inportb(VGA_STATUS_PORT) & VGA_STATUS_VBLANK) {
         SDL_CPUPauseInstruction();
     }
