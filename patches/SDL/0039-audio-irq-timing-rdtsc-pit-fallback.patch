diff --git a/src/core/dos/SDL_dos_audio_synth.c b/src/core/dos/SDL_dos_audio_synth.c
index e6adfb38f..f31ad1229 100644
--- a/src/core/dos/SDL_dos_audio_synth.c
+++ b/src/core/dos/SDL_dos_audio_synth.c
@@ -432,4 +432,112 @@ void SDL_DOSAudioForceResume(void)
     g_dos_audio_resume_request = true;
 }
 
+/* ========================================================================
+ * IRQ-safe timer auto-detection (patch 0039)
+ * ======================================================================== */
+
+/* Mode flag + TSC calibration. Read from IRQ context (volatile uint32_t,
+   atomic on x86); written only from SDL_DOSAudioInitTimer() at
+   non-IRQ init time. Default mode = BIOS_TICK so behavior is preserved
+   if InitTimer() is never called. */
+volatile uint32_t g_dos_audio_timer_mode = SDL_DOS_AUDIO_TIMER_BIOS_TICK;
+volatile uint32_t g_dos_audio_timer_tsc_mhz = 0;
+
+/* CPUID detection. The CPUID instruction is available on Pentium+;
+   486 may or may not have it (only some late-step 486DX4 do). We test
+   by attempting to flip EFLAGS bit 21 (ID flag) — settable only on
+   CPUs that support CPUID. */
+static int detect_cpuid_supported(void)
+{
+    int has_cpuid = 0;
+    __asm__ __volatile__ (
+        "pushfl                       \n"
+        "pushfl                       \n"
+        "xorl $0x00200000, (%%esp)    \n"
+        "popfl                        \n"
+        "pushfl                       \n"
+        "popl %%eax                   \n"
+        "xorl (%%esp), %%eax          \n"
+        "popfl                        \n"
+        "andl $0x00200000, %%eax      \n"
+        : "=a" (has_cpuid)
+        :
+        : "cc"
+    );
+    return has_cpuid != 0 ? 1 : 0;
+}
+
+/* CPUID feature query for TSC. Calls CPUID(EAX=1); EDX bit 4 = TSC
+   support. Pre-check has_cpuid; calling CPUID without support is a
+   #UD fault on pre-Pentium without CPUID. */
+static int detect_tsc_supported(void)
+{
+    if (!detect_cpuid_supported()) {
+        return 0;
+    }
+    uint32_t edx = 0;
+    __asm__ __volatile__ (
+        "movl $1, %%eax    \n"
+        "cpuid             \n"
+        : "=d" (edx)
+        :
+        : "eax", "ebx", "ecx", "cc"
+    );
+    return ((edx & (1u << 4)) != 0) ? 1 : 0;
+}
+
+/* Calibrate TSC speed in cycles-per-µs. Called once at init, non-IRQ
+   context. Uses SDL_GetTicksNS as the wall-clock reference (which is
+   safe outside IRQ context). Spins for ~10 ms to get a stable rate. */
+static uint32_t calibrate_tsc_cycles_per_us(void)
+{
+    /* Read TSC inline (we already verified support before calling). */
+    Uint32 tsc_lo_start, tsc_hi_start;
+    __asm__ __volatile__ ("rdtsc" : "=a"(tsc_lo_start), "=d"(tsc_hi_start));
+    const Uint64 tsc_start = ((Uint64)tsc_hi_start << 32) | tsc_lo_start;
+    const Uint64 t_start_ns = SDL_GetTicksNS();
+
+    /* Spin for at least ~10 ms wall-clock. */
+    while ((SDL_GetTicksNS() - t_start_ns) < SDL_MS_TO_NS(10)) {
+        /* spin */
+    }
+
+    Uint32 tsc_lo_end, tsc_hi_end;
+    __asm__ __volatile__ ("rdtsc" : "=a"(tsc_lo_end), "=d"(tsc_hi_end));
+    const Uint64 tsc_end = ((Uint64)tsc_hi_end << 32) | tsc_lo_end;
+    const Uint64 t_end_ns = SDL_GetTicksNS();
+
+    const Uint64 elapsed_ns = t_end_ns - t_start_ns;
+    if (elapsed_ns == 0) {
+        return 0; /* should not happen; defensive */
+    }
+    const Uint64 cycles = tsc_end - tsc_start;
+    /* cycles_per_us = cycles / (elapsed_ns / 1000) = cycles * 1000 / elapsed_ns. */
+    const Uint64 cycles_per_us = (cycles * 1000ULL) / elapsed_ns;
+    return (uint32_t)cycles_per_us;
+}
+
+void SDL_DOSAudioInitTimer(void)
+{
+    if (detect_tsc_supported()) {
+        const uint32_t mhz = calibrate_tsc_cycles_per_us();
+        if (mhz > 0) {
+            g_dos_audio_timer_tsc_mhz = mhz;
+            g_dos_audio_timer_mode = SDL_DOS_AUDIO_TIMER_RDTSC;
+            SDL_Log("audio IRQ timer: RDTSC (Pentium-class detected, "
+                    "%u cycles/us ~= %u MHz)",
+                    (unsigned)mhz, (unsigned)mhz);
+            return;
+        }
+        /* TSC supported but calibration failed — fall through to PIT. */
+    }
+
+    /* PIT counter 0 is always available on PC-compatible hardware.
+       BIOS programs it at boot for the IRQ-0 timer interrupt. The
+       latch+read approach is non-disruptive to the BIOS programming. */
+    g_dos_audio_timer_mode = SDL_DOS_AUDIO_TIMER_PIT;
+    SDL_Log("audio IRQ timer: 8253 PIT counter 0 "
+            "(486-class fallback, ~838 ns/tick)");
+}
+
 #endif /* SDL_PLATFORM_DOS */
diff --git a/src/core/dos/SDL_dos_audio_synth.h b/src/core/dos/SDL_dos_audio_synth.h
index a6faebeca..a98e588de 100644
--- a/src/core/dos/SDL_dos_audio_synth.h
+++ b/src/core/dos/SDL_dos_audio_synth.h
@@ -189,6 +189,101 @@ extern void SDL_DOSAudioForcePause(void);
 // paused. Companion to ForcePause.
 extern void SDL_DOSAudioForceResume(void);
 
+/* ------------------------------------------------------------------------
+ * IRQ-safe timer for audio_irq_wall_us measurement (patch 0039)
+ * ------------------------------------------------------------------------
+ *
+ * Patch 0038 used BIOS tick at 0040:006C for IRQ entry/exit timing. That
+ * was wrong: BIOS tick advances via IRQ-0 (timer interrupt), and our
+ * audio IRQ handler runs with CLI held by DPMI. IRQ-0 can't fire during
+ * our handler → entry_tick == exit_tick always → cumulative wall_us
+ * stayed 0. Iter 1 surfaced this bug.
+ *
+ * Patch 0039 fix: auto-detect a timer that advances independent of CLI:
+ *   1. RDTSC (Pentium+, detected via CPUID): ~12 ns at PODP83 83 MHz.
+ *   2. 8253 PIT counter 0 (always available): ~838 ns at 1.193 MHz.
+ *   3. BIOS tick (kept as last-resort fallback; known broken in IRQ
+ *      context but harmless if mode never selects it).
+ *
+ * Both RDTSC and PIT counter 0 advance continuously regardless of CPU
+ * interrupt-flag state and are atomic single-bus-cycle (or single-
+ * instruction) reads. IRQ-safe by construction.
+ *
+ * Detection runs once at init; mode is then stable for the run. Engine
+ * has no role in timer selection.
+ */
+
+typedef enum {
+    SDL_DOS_AUDIO_TIMER_BIOS_TICK = 0, /* fallback / coarse — broken in IRQ context */
+    SDL_DOS_AUDIO_TIMER_PIT,           /* 8253 PIT counter 0, ~838 ns */
+    SDL_DOS_AUDIO_TIMER_RDTSC          /* CPU TSC, ~12 ns at 83 MHz */
+} SDL_DOSAudioTimerMode;
+
+extern volatile uint32_t g_dos_audio_timer_mode;     /* one of SDL_DOSAudioTimerMode */
+extern volatile uint32_t g_dos_audio_timer_tsc_mhz;  /* TSC cycles per µs (only valid when mode == RDTSC) */
+
+/* Initializes timer auto-detection. Must be called from non-IRQ context
+   (uses SDL_GetTicksNS for TSC calibration). Logs the chosen mode at
+   INFO level via SDL_Log so operator + flush-instr can verify path at
+   runtime. Idempotent; safe to call multiple times (re-detects). */
+extern void SDL_DOSAudioInitTimer(void);
+
+/* IRQ-safe inline timer reads. Both functions are header-defined so the
+   compiler inlines them at the IRQ-handler call site (no external function
+   call → no memory-lock concerns for the call itself). All underlying
+   operations (rdtsc instruction, PIT port I/O, BIOS tick far-peek) are
+   IRQ-safe. */
+
+SDL_FORCE_INLINE Uint64 SDL_DOSAudioReadTimer(void)
+{
+    /* Mode-dispatched read. Returns an opaque timestamp; pair with
+       SDL_DOSAudioTimerDeltaUs to compute elapsed µs. */
+    const uint32_t mode = g_dos_audio_timer_mode;
+    if (mode == SDL_DOS_AUDIO_TIMER_RDTSC) {
+        uint32_t lo, hi;
+        __asm__ __volatile__ ("rdtsc" : "=a"(lo), "=d"(hi));
+        return ((Uint64)hi << 32) | lo;
+    } else if (mode == SDL_DOS_AUDIO_TIMER_PIT) {
+        /* PIT counter 0 latch + read: write 0x00 to control port 0x43
+           (latch counter 0); then read low + high bytes from port 0x40.
+           Counter is 16-bit; counts down (BIOS programs it in mode 3
+           for IRQ-0 timer). */
+        outportb(0x43, 0x00);
+        const Uint8 lo = inportb(0x40);
+        const Uint8 hi = inportb(0x40);
+        return (Uint64)((Uint16)((hi << 8) | lo));
+    }
+    /* Fallback: BIOS tick (broken-in-IRQ-context; safe value but useless). */
+    return (Uint64)_farpeekl(_dos_ds, 0x46Cul);
+}
+
+SDL_FORCE_INLINE uint32_t SDL_DOSAudioTimerDeltaUs(Uint64 entry, Uint64 exit_)
+{
+    const uint32_t mode = g_dos_audio_timer_mode;
+    if (mode == SDL_DOS_AUDIO_TIMER_RDTSC) {
+        const Uint64 cycles = exit_ - entry; /* modular wrap on uint64_t */
+        const uint32_t mhz = g_dos_audio_timer_tsc_mhz;
+        return (mhz > 0) ? (uint32_t)(cycles / mhz) : 0;
+    } else if (mode == SDL_DOS_AUDIO_TIMER_PIT) {
+        /* PIT counts DOWN: entry > exit normally; if exit > entry, wrapped
+           (counter rolled 0xFFFF → 0xFFFE → ... → 0x0000 → 0xFFFF). */
+        const uint16_t e = (uint16_t)entry;
+        const uint16_t x = (uint16_t)exit_;
+        const uint32_t delta_counts = (e >= x)
+            ? (uint32_t)(e - x)
+            : (uint32_t)(0x10000u - x + e);
+        /* 1 count = 838.0959 ns ≈ 838 / 1000 µs.
+           Or equivalently: delta_us = delta_counts * 1000 / 1193 (since
+           PIT freq is 1193182 Hz; 1000000 / 1193182 ≈ 0.838). */
+        return (delta_counts * 1000u) / 1193u;
+    }
+    /* BIOS tick fallback (broken-in-IRQ-context per § E timer rationale;
+       the multiply is technically correct for the resolution but won't
+       see non-zero deltas in practice). */
+    const uint32_t delta_ticks = (uint32_t)exit_ - (uint32_t)entry;
+    return delta_ticks * 54925u;
+}
+
 /* ------------------------------------------------------------------------
  * Per-block extern counters (read by engine at audit-flush boundary)
  * ------------------------------------------------------------------------
