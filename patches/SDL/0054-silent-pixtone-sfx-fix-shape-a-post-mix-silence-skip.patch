 // Commit the staging buffer into the ring buffer.
@@ -998,6 +977,98 @@ static Uint8 *DOSSOUNDBLASTER_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_
 static bool DOSSOUNDBLASTER_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buffer_size)
 {
     struct SDL_PrivateAudioData *hidden = device->hidden;
+
+    /* DOSKUTSU patch (Phase 11 patch 0054, Shape A): post-mix silence
+       detection + skip-ring-write throttle. Replaces the SDL/0050
+       pre-mix quiescence gate that GetDeviceBuf used to implement
+       (see GetDeviceBuf above for the architectural reasoning).
+
+       When the mixer produces all-silence output (no Pixtone SFX
+       active + music backend is out-of-band like OPL3 / WaveBlaster):
+       skip the ring write here and SDL_Delay(10) to throttle the audio
+       thread. The IRQ-5 ISR continues draining the ring (now-silent
+       residue from prior iters), the consecutive-silent-IRQ counter
+       ticks, DSP auto-engage idle-pause fires — same fps-gain
+       mechanism as SDL/0050; just gated on actual mix-result silence
+       (post-mix) instead of pre-mix stream-availability.
+
+       Why this is correct under AUDIO_BACKEND=opl3 + Pixtone SFX:
+       SDL3's mix loop (SDL_audio.c:1254) runs every iter under Shape A
+       because GetDeviceBuf always returns non-zero buffer_size. The
+       mix calls SDL_GetAudioStreamData on each bound stream, which
+       fires the get-callback chain (SDL3_mixer's MixerCallback →
+       per-track TrackGetCallback → pulls from Pixtone-loaded chunks).
+       When a Pixtone SFX fires via MIX_PlayTrack on main thread,
+       the next audio-thread iter (≤ 1 chunk-time later, typically
+       ~10-12 ms at 22050 mono / 256 frames) pulls the samples →
+       mix produces non-silence → this silence-detect block falls
+       through to the normal ring-write path → SFX plays.
+
+       The `g_dos_audio_quiescence_gate_disabled` flag forces the
+       normal path (skip silence-detect; always write to ring). Two
+       cases set it true:
+
+         - User sets `SDL_HINT_DOSKUTSU_DOS_AUDIO_QUIESCENCE_GATE=0`
+           at OpenDevice (killswitch; reverts to pre-0050 behavior;
+           e.g., the wave-34 H2 BAT cell that audibly confirmed SFX
+           was being trapped by SDL/0050's pre-mix gate).
+         - Engine calls `SDL_DOSAudioBeginShutdown()` before
+           MIX_DestroyMixer (SDL/0053); ensures audio thread cycles
+           through PlayDevice fast (no 10 ms SDL_Delay) so main wins
+           the device->lock contention during the shutdown teardown.
+
+       Silence detection: bytewise compare against
+       `soundblaster_silence_value` (0x00 for S16, 0x80 for U8
+       unsigned; initialized at OpenDevice from
+       `soundblaster_is_sb16 ? 0x00 : 0x80`). Early-exit on first
+       non-silence byte. Cost ~1-2 μs for typical 256-4096 byte
+       staging buffers; trivial relative to the mixer tick that
+       just produced the buffer (~50 μs).
+
+       Per `sdl_pause_api_must_audit_auto_resume_gates.md`: reusing
+       `g_dos_audio_quiescence_gate_disabled` rather than adding a new
+       state flag avoids the fragmentation footgun. Same flag's
+       semantic shifts from "skip GetDeviceBuf quiescence walk" (SDL/0050)
+       to "skip PlayDevice silence-detect" (SDL/0054) — semantically-
+       equivalent role ("disable the SDL/0050-derived behavior")
+       preserves SDL/0053's engine-signaled-shutdown contract.
+
+       Latency: SFX-trigger-to-first-sample-on-ring ≤ one audio-thread-
+       iter cycle (~10-12 ms). Same as the pre-SDL/0050 working SFX
+       path; no perceptible regression for game SFX. */
+    if (!g_dos_audio_quiescence_gate_disabled) {
+        const Uint8 silence = soundblaster_silence_value;
+        const Uint8 *p = buffer;
+        const Uint8 *end = buffer + buffer_size;
+        bool all_silence = true;
+        while (p < end) {
+            if (*p++ != silence) { all_silence = false; break; }
+        }
+        if (all_silence) {
+            /* Skip the ring write — ring continues to drain via IRQ →
+               ISR increments consecutive-silent-IRQ counter → DSP
+               auto-engage idle-pause fires when threshold met → IRQ-5
+               stops → fps recovered. Same mechanism as SDL/0050. */
+            SDL_Delay(10);  /* throttle ~100 iter/sec when quiescent;
+                               prevents CPU spin under cooperative
+                               scheduler. Held under device->lock per
+                               PlaybackAudioThreadIterate (SDL_audio.c:
+                               1179-1289), so the iter L L1 freeze
+                               geometry is preserved here just as it
+                               was in GetDeviceBuf under SDL/0050 —
+                               SDL/0053's SDL_DOSAudioBeginShutdown is
+                               the corresponding unlock mechanism (flips
+                               g_dos_audio_quiescence_gate_disabled true
+                               so this entire block is skipped during
+                               teardown). */
+            return true;
+        }
+    }
+
+    /* Normal path: mix produced non-silence (real audio — Pixtone SFX
+       sample, direct-stream OGG, etc.) OR gate disabled (killswitch
+       or shutdown coordination). Write the mixed staging buffer into
+       the ring. */
     const int mask = hidden->ring_size - 1;
     const int pos = hidden->ring_write & mask;
     const int first = (pos + buffer_size <= hidden->ring_size) ? buffer_size : (hidden->ring_size - pos);
