 static Uint8 *DOSSOUNDBLASTER_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
 {
-    struct SDL_PrivateAudioData *hidden = device->hidden;
-
-    /* DOSKUTSU patch (Phase 12 patch 0051): shutdown bypass for the
