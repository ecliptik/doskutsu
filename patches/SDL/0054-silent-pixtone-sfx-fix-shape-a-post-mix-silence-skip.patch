-        return hidden->staging_buffer;
-    }
-
-    /* DOSKUTSU patch (Phase 11 patch 0050, Phase 12 Option A): GetDeviceBuf
-       quiescence gate. Returns *buffer_size = 0 to signal "skip this audio-
