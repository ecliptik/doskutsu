+/*
+ * DOSKUTSU patch (Phase 10 patch 0037): hardware audio-synth helpers for
+ * the WaveBlaster (MPU-401) and OPL3 (YMF262) backends, plus the SB16
+ * audio-IRQ idle-pause coordination API.
+ *
+ * Design contract: docs/PHASE10-DESIGN.md § C / § D / § E.6 (gitignored).
+ * Instrumentation contract: docs/PHASE10-CONTRACT.md (gitignored).
+ *
+ * The helpers are consumed by the engine-side AudioBackendWB and
+ * AudioBackendOPL3 in vendor/nxengine-evo/src/sound/ (nx-engine's lane).
+ * The engine never writes to MPU-401 / OPL3 ports directly; it composes
+ * port operations via these helpers so all DPMI / port-output mechanics
+ * stay within the SDL DOS backend.
+ *
+ * Most helpers are non-inline (state-bearing or non-trivial) to avoid
+ * per-TU duplication of static state. A few hot-path / trivial helpers
+ * stay SDL_FORCE_INLINE.
+ */
+
+#include "SDL_internal.h"
+
+#ifndef SDL_dos_audio_synth_h_
+#define SDL_dos_audio_synth_h_
+
+#if defined(SDL_PLATFORM_DOS)
+
+#include "SDL_dos.h" // PIC + EOI macros, DOS_LockCode/Variable, DPMI types
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ------------------------------------------------------------------------
+ * MPU-401 (WaveBlaster) — § C of design doc
+ * ------------------------------------------------------------------------
+ *
+ * MIDI byte stream output to a UART-mode MPU-401. Default port 0x330 from
+ * BLASTER `Pxxxx`. Status port = base+1; bit 6 = data-ready-to-receive
+ * (must be 0 before a data write).
+ *
+ * Single-instance assumption: at most one MPU-401 in the system. Port
+ * stored at SDL_DOSMpu401Init time; subsequent WriteByte uses that port
+ * implicitly.
+ */
+
+// Probes MPU-401 at port_base + initializes UART mode if found.
+// Returns true on success, false if no MPU-401 present (engine falls back).
+// On success, stores port_base for subsequent WriteByte calls.
+extern bool SDL_DOSMpu401Init(uint16_t port_base);
+
+// Writes one MIDI byte to the data port. Polls bit 6 of status port until
+// clear (data-ready-to-receive). Sub-µs typical on real HW. Caller is
+// responsible for the byte being a valid MIDI message component.
+// Caller must have called SDL_DOSMpu401Init() previously; calling without
+// init is a no-op (writes nothing).
+extern void SDL_DOSMpu401WriteByte(uint8_t byte);
+
+// Sends MPU-401 reset (0xFF) to restore device to BIOS-default state.
+// Idempotent; safe to call without a prior Init.
+extern void SDL_DOSMpu401Shutdown(void);
+
+// Parses the BLASTER environment variable for the `Pxxxx` field.
+// Returns the port (0x330 default if BLASTER unset or P field absent).
+// Engine can call this directly or pass a fixed port to Init.
+extern uint16_t SDL_DOSMpu401GetBLASTERPort(void);
+
+/* ------------------------------------------------------------------------
+ * OPL3 (YMF262) — § D of design doc
+ * ------------------------------------------------------------------------
+ *
+ * FM-synth register I/O at fixed Adlib-compatible base 0x388 (primary
+ * bank, registers 0x000-0x0FF) + 0x38A (secondary bank, registers
+ * 0x100-0x1FF). 18 voices in 9-channel 2-op mode (recommended; see § D.5).
+ *
+ * Voice IDs 0-17. Voices 0-8 use primary bank registers; voices 9-17 use
+ * secondary bank.
+ */
+
+// Probes Adlib + OPL3 presence via timer-1 sequence. Returns true if some
+// OPL chip detected. Caller distinguishes OPL2 vs OPL3 via BLASTER `T`
+// field (T6 = SB16 = OPL3; T1/T3 = pre-SB16 = OPL2-only). For doskutsu's
+// target hardware (Vibra16S CT2490, BLASTER T6), this returning true
+// guarantees OPL3.
+extern bool SDL_DOSOpl3Detect(void);
+
+// Initializes OPL3 chip to known state: enables OPL3 mode (4-op disabled
+// = 18 × 2-op layout per § D.5), silences all voices.
+extern void SDL_DOSOpl3InitChip(void);
+
+// Restores Adlib OPL2 mode (clears OPL3 enable bit), silences all voices.
+// Leaves the chip in a state compatible with subsequent BIOS or Adlib-only
+// usage post-process-exit.
+extern void SDL_DOSOpl3Shutdown(void);
+
+// Single register write. Handles primary/secondary bank routing
+// automatically based on `reg`'s high bit. Includes the canonical
+// 6-dummy-status-read inter-write delay (~6 µs on PODP83 ISA bus).
+extern void SDL_DOSOpl3WriteRegister(uint16_t reg, uint8_t value);
+
+// Bulk register write. Equivalent to a loop of SDL_DOSOpl3WriteRegister
+// but composes inter-write delays slightly more efficiently.
+extern void SDL_DOSOpl3WriteRegisterBlock(
+    const uint16_t *regs, const uint8_t *vals, size_t n);
+
+// Looks up the operator + channel register offsets for a given voice.
+// Voice IDs 0-17. Voices 0-8 use primary bank; 9-17 use secondary bank.
+// Returns by out-pointer for clarity; primitive used by engine voice
+// allocator that wants to compose its own register sequences.
+extern void SDL_DOSOpl3VoiceRegOffsets(int voice_id,
+    uint16_t *out_op0_base, uint16_t *out_op1_base, uint16_t *out_channel);
+
+// Convenience: writes the 12-byte patch from `patch[12]` into the voice's
+// 12 patch registers (op0 6 bytes + op1 5 bytes + feedback/algorithm 1 byte).
+// Order matches docs/PHASE10-DESIGN.md § D.8 / plan doc § 5 OPL3Patch struct.
+extern void SDL_DOSOpl3VoiceWritePatch(int voice_id, const uint8_t patch[12]);
+
+// Convenience hot-path: triggers note-on for a voice. `freq` is the OPL3
+// F-num (10-bit, low byte to register 0xA0+ch, high bits combined with
+// block + key-on bit to register 0xB0+ch). `block` is the 3-bit octave
+// scaling (0-7).
+extern void SDL_DOSOpl3VoiceNoteOn(int voice_id, uint16_t freq, uint8_t block);
+
+// Convenience hot-path: silences a voice (clears key-on bit at 0xB0+ch).
+extern void SDL_DOSOpl3VoiceNoteOff(int voice_id);
+
+/* ------------------------------------------------------------------------
+ * Audio IRQ-5 idle-pause coordination — § E of design doc
+ * ------------------------------------------------------------------------
+ *
+ * When music is offloaded to OPL3/WB, the SB16 DMA stream becomes idle
+ * except during Pixtone SFX windows. The IRQ-5 handler entry/exit
+ * accounts for ~13.5 ms / flip wall-clock on real HW per the W20A2
+ * ablation (memory `audio_mix_zero_is_not_audio_off.md`); pausing the
+ * DSP when no SFX is in flight eliminates that cost.
+ *
+ * The mechanism is DSP-pause via DSP commands 0xD5 (pause 16-bit) /
+ * 0xD0 (pause 8-bit) and 0xD6 / 0xD4 (resume). The IRQ handler stays
+ * installed in the IDT; pausing the DSP suppresses end-of-buffer IRQs
+ * without touching IDT state.
+ *
+ * Default behavior is OFF (preserves Phase 9 / Organya behavior bit-
+ * for-bit). Engine flips ON via SDL_DOSAudioSetIdlePauseEnabled(true)
+ * after backend selection if and only if the music backend is OPL3 or
+ * WaveBlaster (i.e., music doesn't need DMA stream).
+ */
+
+// Callback fired at each pause-resume transition. Argument is nanoseconds
+// elapsed during the pause window (uint64 for sub-µs precision). Fired
+// from non-IRQ context; callback may use FPU, locks, allocations.
+typedef void (*SDL_DOSIdlePauseCallback)(Uint64 paused_ns);
+
+// Registers a callback fired on pause-resume transition. Single-slot;
+// re-registering overwrites. Pass NULL to clear.
+extern void SDL_DOSAudioRegisterIdlePauseCallback(SDL_DOSIdlePauseCallback cb);
+
+// Enables or disables the idle-pause mechanism. Default OFF. Engine
+// should flip ON only when music backend is hardware-offload (WB/OPL3)
+// AND Pixtone SFX continues through SB16 DAC. Disabling cancels any
+// pending pause request and resumes DMA if currently paused.
+extern void SDL_DOSAudioSetIdlePauseEnabled(bool enabled);
+
+// Diagnostic: forces an immediate pause request. For ablation iters
+// comparing "force-pause-always" vs "auto-detect-from-ring-fill" on
+// real HW. Use sparingly; bypasses normal ring-fill heuristics.
+extern void SDL_DOSAudioForcePause(void);
+
+// Diagnostic: cancels any pending pause + immediately resumes DMA if
+// paused. Companion to ForcePause.
+extern void SDL_DOSAudioForceResume(void);
+
+/* ------------------------------------------------------------------------
+ * Per-block extern counters (read by engine at audit-flush boundary)
+ * ------------------------------------------------------------------------
+ *
+ * Cumulative-since-init monotonic counters incremented by the SB16
+ * audio backend's IRQ handler. Per the kbd-counter precedent
+ * (patches 0023+0025), uint32_t volatile is atomic-readable on x86;
+ * no `cli`/`sti` synchronization required.
+ *
+ * Engine reads each at _maybe_flush_phase_timing_audit() entry, computes
+ * delta vs last-read static (file-scope in Renderer.cpp), assigns delta
+ * to engine-side g_p10_*_block. Modular subtraction is wrap-safe per
+ * C99 unsigned overflow semantics.
+ *
+ * The audio-IRQ wall-clock measurement is in microseconds (uint32_t)
+ * for atomic readability. Wraps at uint32_t max ≈ 71.6 min cumulative
+ * IRQ wall-clock; iter sessions are well under this.
+ */
+extern volatile uint32_t doskutsu_audio_irq_wall_us;
+extern volatile uint32_t doskutsu_audio_irq_count;
+extern volatile uint32_t doskutsu_audio_sfx_active_count;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SDL_PLATFORM_DOS
+
+#endif // SDL_dos_audio_synth_h_
