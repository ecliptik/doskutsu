-                    doskutsu_dbg_log("audio: SDL/0073 pixtone IRQ rate-divider: "
-                                     "ENGAGED RATEDIV=%d (shift_div=%d; each "
-                                     "Pixtone source sample held for %d output "
-                                     "stereo pairs; ISR consumption slowed %dx "
-                                     "= down %d octave(s); Bug 6 Tier-2 pitch "
-                                     "fix; tune via SDL_HINT_DOSKUTSU_PIXTONE_"
-                                     "IRQ_RATEDIV=1|2|4)",
-                                     (1 << rd_shift), (int)rd_shift,
-                                     (1 << rd_shift), (1 << rd_shift),
-                                     (int)rd_shift);
-                } else {
-                    doskutsu_dbg_log("audio: SDL/0073 pixtone IRQ rate-divider: "
-                                     "RATEDIV=1 (default; ISR consumption "
-                                     "byte-identical to pre-0073; set "
-                                     "SDL_HINT_DOSKUTSU_PIXTONE_IRQ_RATEDIV=2 "
-                                     "to correct the Tier-2 octave-high SFX)");
-                }
-            }
+            /* DOSKUTSU patch (Phase 11 patch 0074 Part 1): the 0073
+             * RATEDIV env-resolve that lived here is RELOCATED to the
+             * rate-diag site below (after SDL_UpdatedAudioDeviceFormat),
+             * where device->spec.freq is final so the tier-aware auto-
+             * default divider can be computed (this L3 block runs before
+             * the spec is finalized). See the "RATEDIV auto" block. */
 
             {
                 /* Banner-emit headroom math: N = additional shift bits beyond
@@ -2031,6 +2064,61 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
                          device->spec.freq, dos_rd_block_size, dos_rd_isr_chunk);
     }
 
+    /* DOSKUTSU patch (Phase 11 patch 0074 Part 1): RATEDIV auto-default.
+       SDL_UpdatedAudioDeviceFormat has finalized device->spec.freq, so
+       cache it + (when Lever 3 is engaged) resolve the env OVERRIDE and
+       recompute the ISR rate-divider shift. The engine set the master
+       content rate via SDL_DOSPixtoneSetMasterRate before the device
+       opened; divider = round(dev_freq/master_rate) (measured dev_freq=
+       44100 -> Tier-2 44100/11025=4 -> shift 2; Tier-1 44100/44100=1 ->
+       shift 0). The 0073 env knob SDL_HINT_DOSKUTSU_PIXTONE_IRQ_RATEDIV
+       is now a DEBUG OVERRIDE that wins when set ("1"/"2"/"4"). dev_freq
+       is cached unconditionally so a late SetMasterRate call can still
+       recompute. Per BUG6-BALANCE-AND-SHIP-FIX-DESIGN.md Part 1. */
+    g_dos_pixtone_dev_freq = device->spec.freq;
+    if (g_dos_pixtone_irq_mix_active) {
+        const char *rd_hint =
+            SDL_GetHint("SDL_HINT_DOSKUTSU_PIXTONE_IRQ_RATEDIV");
+        int rd_env_shift = -1; /* unset -> auto-default applies */
+        if (rd_hint && rd_hint[0] != '\0' && rd_hint[1] == '\0') {
+            if (rd_hint[0] == '1') rd_env_shift = 0;
+            else if (rd_hint[0] == '2') rd_env_shift = 1;
+            else if (rd_hint[0] == '4') rd_env_shift = 2;
+        }
+        g_dos_pixtone_ratediv_env_shift = rd_env_shift;
+        dos_pixtone_recompute_ratediv();
+
+        const int rd_master  = g_dos_pixtone_master_int16_rate;
+        const int rd_divider = (rd_master > 0)
+            ? (device->spec.freq + rd_master / 2) / rd_master : 0;
+        char rd_envdesc[24];
+        if (rd_env_shift >= 0)
+            SDL_snprintf(rd_envdesc, sizeof(rd_envdesc), "RATEDIV=%d", 1 << rd_env_shift);
+        else
+            SDL_strlcpy(rd_envdesc, "none", sizeof(rd_envdesc));
+        doskutsu_dbg_log("audio: SDL/0074 RATEDIV auto: dev_freq=%d "
+                         "master_rate=%d divider=%d shift_div=%d "
+                         "(env override=%s)",
+                         device->spec.freq, rd_master, rd_divider,
+                         (int)g_dos_pixtone_irq_ratediv_shift, rd_envdesc);
+        /* Cross-unit failure witness (flush-instr ask): master_rate==0 with
+           Lever 3 ON means the engine never called SDL_DOSPixtoneSetMasterRate
+           before the device opened (nxengine-evo/0169 missing or mis-ordered),
+           OR no env override is set -- so the auto-divider fell back to
+           shift_div=0 (RATEDIV=1) and Tier-2 SFX will SILENTLY play ~an octave
+           high again. Make that loud in the log instead of leaving it to a
+           reader noticing master_rate=0. */
+        if (rd_master == 0 && rd_env_shift < 0) {
+            doskutsu_dbg_log("audio: SDL/0074 RATEDIV auto: WARNING master_rate=0 "
+                             "+ no env override -- engine SDL_DOSPixtoneSetMasterRate "
+                             "(nxengine-evo/0169) did not run before device open; "
+                             "shift_div fell back to 0 (RATEDIV=1), so Tier-2 SFX "
+                             "will play ~an octave high. Fix the engine setter call "
+                             "or set SDL_HINT_DOSKUTSU_PIXTONE_IRQ_RATEDIV=4 to "
+                             "force the Tier-2 divider.");
+        }
+    }
+
     if (device->buffer_size > (32 * 1024)) {
         return SDL_SetError("Buffer size is too large (choose smaller audio format and/or fewer sample frames)"); // DMA buffer has to fit in 64K segment, so buffer_size has to be half that, as we double it.
     }
@@ -2274,6 +2362,60 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
         WriteSoundBlasterDSP(0x30);                                             // 16-bit stereo signed PCM
         WriteSoundBlasterDSP((Uint8)(block_size & 0xFF));
         WriteSoundBlasterDSP((Uint8)(block_size >> 8));
+
+        /* DOSKUTSU patch (Phase 11 patch 0074 Part 2): SB16 CT1745 analog
+           mixer balance lever. The SB16 driver historically programs only
+           the DSP rate + DMA (and the SB Pro 0x0E stereo bit on the pre-
+           SB16 path); the CT1745 PCM(Voice)-vs-FM(music) balance sits at
+           the card power-on default which favors FM -> Lever 3 SFX play too
+           quiet vs OPL3 music even at digital full-scale (Bug 6 balance,
+           the last blocker after the RATEDIV pitch fix). Program the CT1745
+           volume registers (mixer_addr=base+0x04, data=base+0x05; 5-bit
+           level in bits 7-3, value = level<<3, level 0..31):
+             Master 0x30/0x31 = 31<<3 (0xF8, max -- deterministic state so
+                                       Voice/FM are the only variables)
+             Voice  0x32/0x33 = voice_vol<<3 (PCM/DAC = the SFX path)
+             FM     0x34/0x35 = fm_vol<<3    (OPL3 music)
+           Env knobs (cache-at-boot, clamp 0..31):
+             SDL_HINT_DOSKUTSU_SB16_VOICE_VOL (default 31)
+             SDL_HINT_DOSKUTSU_SB16_FM_VOL    (default 24 -- lowers music)
+           Killswitch SDL_HINT_DOSKUTSU_SB16_MIXER_PROGRAM strict-"0" ->
+           touch nothing (byte-identical to pre-0074); default = program
+           (the ship fix is ON). CT1745-specific so scoped to is_sb16.
+           Per BUG6-BALANCE-AND-SHIP-FIX-DESIGN.md Part 2. */
+        {
+            const char *mp_hint = SDL_GetHint("SDL_HINT_DOSKUTSU_SB16_MIXER_PROGRAM");
+            const bool mixer_program = !(mp_hint && mp_hint[0] == '0' && mp_hint[1] == 0);
+            if (mixer_program) {
+                int voice_vol = 31, fm_vol = 24;
+                const char *vv = SDL_GetHint("SDL_HINT_DOSKUTSU_SB16_VOICE_VOL");
+                const char *fv = SDL_GetHint("SDL_HINT_DOSKUTSU_SB16_FM_VOL");
+                if (vv && vv[0] != '\0') {
+                    int v = SDL_atoi(vv);
+                    voice_vol = (v < 0) ? 0 : (v > 31) ? 31 : v;
+                }
+                if (fv && fv[0] != '\0') {
+                    int v = SDL_atoi(fv);
+                    fm_vol = (v < 0) ? 0 : (v > 31) ? 31 : v;
+                }
+                const int mixer_addr = soundblaster_base_port + 0x04;
+                const int mixer_data = soundblaster_base_port + 0x05;
+                outportb(mixer_addr, 0x30); outportb(mixer_data, (Uint8)(31 << 3));        // Master L
+                outportb(mixer_addr, 0x31); outportb(mixer_data, (Uint8)(31 << 3));        // Master R
+                outportb(mixer_addr, 0x32); outportb(mixer_data, (Uint8)(voice_vol << 3)); // Voice (PCM) L
+                outportb(mixer_addr, 0x33); outportb(mixer_data, (Uint8)(voice_vol << 3)); // Voice (PCM) R
+                outportb(mixer_addr, 0x34); outportb(mixer_data, (Uint8)(fm_vol << 3));    // FM L
+                outportb(mixer_addr, 0x35); outportb(mixer_data, (Uint8)(fm_vol << 3));    // FM R
+                doskutsu_dbg_log("audio: SDL/0074 SB16 mixer balance: master=31 "
+                                 "voice=%d fm=%d (CT1745 0x30/32/34; tune "
+                                 "SDL_HINT_DOSKUTSU_SB16_FM_VOL=0..31)",
+                                 voice_vol, fm_vol);
+            } else {
+                doskutsu_dbg_log("audio: SDL/0074 SB16 mixer balance: DISABLED "
+                                 "(SDL_HINT_DOSKUTSU_SB16_MIXER_PROGRAM=0; CT1745 "
+                                 "left at card default; byte-identical to pre-0074)");
+            }
+        }
     } else {
         // Pre-SB16 (DSP < 4): set sample rate via Time Constant
         // Time Constant = 256 - (1000000 / (channels * freq))
diff --git a/src/core/dos/SDL_dos_audio_synth.h b/src/core/dos/SDL_dos_audio_synth.h
