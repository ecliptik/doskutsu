diff --git a/include/SDL3/SDL_dospixtone.h b/include/SDL3/SDL_dospixtone.h
index 4b4d2ad65..0b3bd0cf9 100644
--- a/include/SDL3/SDL_dospixtone.h
+++ b/include/SDL3/SDL_dospixtone.h
@@ -286,6 +286,41 @@ extern SDL_DECLSPEC void SDLCALL SDL_DOSPixtoneSetGain(int32_t channel_id,
  */
 extern SDL_DECLSPEC bool SDLCALL SDL_DOSPixtoneIRQMixActive(void);
 
+/**
+ * Tell the SDL backend the Pixtone master content rate so it can compute
+ * the Lever 3 ISR consumption rate-divider automatically (patch 0074).
+ *
+ * The bug6-confirm iter measured device->spec.freq = 44100 Hz in ALL
+ * audio tiers; under Tier-2 the engine's SAMPLE_RATE=11025 only sets the
+ * Pixtone MASTER render rate, not the device. The IRQ-5 ISR consumes the
+ * master at the device frame rate (one int16 sample per output stereo
+ * pair), so when the master represents fewer int16/sec than the device
+ * drains, the SFX play too fast (~an octave per factor of 2). The fix is
+ * a consumption rate-divider = round(device->spec.freq / master_rate);
+ * this setter supplies the divisor.
+ *
+ * \param master_int16_rate the master buffer's content rate in int16
+ *                          samples per second = SAMPLE_RATE *
+ *                          AUDIO_CHANNELS (Tier-2 = 11025*1 = 11025;
+ *                          Tier-1 = 22050*2 = 44100). <= 0 is a no-op
+ *                          (keeps the RATEDIV=1 fallback).
+ *
+ * Call once at engine init, BEFORE the SDL audio device opens (i.e.
+ * before MIX_CreateMixerDevice), so the cached value is present when
+ * DOSSOUNDBLASTER_OpenDevice computes the auto-divider. A late call is
+ * tolerated (the divider is recomputed if the device freq is already
+ * cached). The SDL_HINT_DOSKUTSU_PIXTONE_IRQ_RATEDIV env var, if set,
+ * overrides this auto-default (debug knob). Safe to call unconditionally
+ * (harmless when Lever 3 is off -- the value is just cached).
+ *
+ * \threadsafety Engine main thread.
+ *
+ * \since SDL 3 -- doskutsu workspace-local patch 0074, 2026-05-22.
+ *
+ * \sa SDL_DOSPixtoneIRQMixActive
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSPixtoneSetMasterRate(int master_int16_rate);
+
 /**
  * Engine-visible counter: number of currently active ISR-channel
  * pool slots. Engine 0165 probe reads SUM of this +
diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index 3cb332d8d..2f73af135 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -834,6 +834,57 @@ static volatile Uint8 g_dos_pixtone_irq_mix_shift = 9;
  * OpenDevice. Per docs/internal/BUG6-RATE-CONFIRMED-INSTR-AND-FIX-DESIGN.md
  * + bug6_sfx_clip_pitch_mechanism. */
 static volatile Uint8 g_dos_pixtone_irq_ratediv_shift = 0;
+
+/* DOSKUTSU patch (Phase 11 patch 0074 Part 1): RATEDIV auto-default
+ * inputs. The bug6-confirm iter measured device->spec.freq = 44100 in
+ * ALL tiers; Tier-2 SAMPLE_RATE=11025 only sets the Pixtone MASTER render
+ * rate, NOT the device. So the ISR consumes the master at the device
+ * frame rate (one int16 per output stereo pair = 44100/s) while the
+ * master represents only master_int16_rate int16/s -> divider =
+ * round(dev_freq / master_rate) (Tier-2: 44100/11025=4; Tier-1:
+ * 44100/(22050*2)=1). The engine supplies master_int16_rate via
+ * SDL_DOSPixtoneSetMasterRate (= SAMPLE_RATE*AUDIO_CHANNELS) before the
+ * device opens; dev_freq is cached at OpenDevice. The 0073 env knob
+ * SDL_HINT_DOSKUTSU_PIXTONE_IRQ_RATEDIV becomes a DEBUG OVERRIDE on top.
+ * None of these are ISR-read (only the resulting shift is), so no DPMI
+ * lock is needed for them. Per BUG6-BALANCE-AND-SHIP-FIX-DESIGN.md Part 1. */
+static int g_dos_pixtone_master_int16_rate = 0;  /* engine: SAMPLE_RATE*AUDIO_CHANNELS */
+static int g_dos_pixtone_dev_freq = 0;           /* device->spec.freq, cached at OpenDevice */
+static int g_dos_pixtone_ratediv_env_shift = -1; /* env override; -1 = unset (auto applies) */
+
+/* Recompute the ISR rate-divider shift from the cached master rate +
+ * device freq. The env override (>= 0) always wins. Called from
+ * SDL_DOSPixtoneSetMasterRate (engine init) AND from OpenDevice (after
+ * dev_freq + the env hint are resolved); whoever runs last wins, so a
+ * late setter call is safe. Pure integer; the resulting Uint8 is the
+ * only ISR-read (DPMI-locked) field -- a single-byte store is atomic. */
+static void dos_pixtone_recompute_ratediv(void)
+{
+    if (g_dos_pixtone_ratediv_env_shift >= 0) {
+        g_dos_pixtone_irq_ratediv_shift = (Uint8)g_dos_pixtone_ratediv_env_shift;
+        return;
+    }
+    const int master = g_dos_pixtone_master_int16_rate;
+    const int devf   = g_dos_pixtone_dev_freq;
+    if (master <= 0 || devf <= 0) {
+        g_dos_pixtone_irq_ratediv_shift = 0; /* fallback RATEDIV=1 */
+        return;
+    }
+    const int d = (devf + master / 2) / master; /* round to nearest int */
+    if (d >= 1 && (d & (d - 1)) == 0) {
+        g_dos_pixtone_irq_ratediv_shift = (Uint8)__builtin_ctz((unsigned)d);
+    } else {
+        /* non-power-of-2 (not expected for shipped tiers): nearest power
+         * of 2 in log space + a warning. */
+        int p = 1, e = 0;
+        while ((p << 1) <= d) { p <<= 1; ++e; }
+        if ((d - p) > ((p << 1) - d)) ++e; /* round toward the larger pow2 */
+        g_dos_pixtone_irq_ratediv_shift = (Uint8)e;
+        doskutsu_dbg_log("audio: SDL/0074 RATEDIV auto: WARNING non-power-of-2 "
+                         "divider=%d (dev_freq=%d master_rate=%d) -> nearest "
+                         "shift_div=%d", d, devf, master, e);
+    }
+}
 /* ========================================================================
  * DOSKUTSU patch (Phase 11 patch 0072): Lever 2b -- MidiScheduler tick
  * from the SB16 IRQ-5 ISR
@@ -1022,6 +1073,21 @@ bool SDL_DOSPixtoneIRQMixActive(void)
     return g_dos_pixtone_irq_mix_active;
 }
 
+/* DOSKUTSU patch (Phase 11 patch 0074 Part 1): engine setter for the
+ * Pixtone master content rate (SAMPLE_RATE * AUDIO_CHANNELS int16/sec).
+ * The engine calls this once in SoundManager::init BEFORE
+ * MIX_CreateMixerDevice (= before the SDL audio device opens), so the
+ * cached value is available when OpenDevice computes the auto-RATEDIV
+ * shift. Recompute here too for late-call safety (if dev_freq is already
+ * cached). Harmless when Lever 3 is off (the value is just cached; the
+ * ISR never runs). Engine main thread. Per BUG6-BALANCE-AND-SHIP-FIX-
+ * DESIGN.md Part 1. */
+void SDL_DOSPixtoneSetMasterRate(int master_int16_rate)
+{
+    g_dos_pixtone_master_int16_rate = master_int16_rate;
+    dos_pixtone_recompute_ratediv();
+}
