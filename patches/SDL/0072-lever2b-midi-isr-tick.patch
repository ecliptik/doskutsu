+/**
+ * # CategoryDOSMidiTick
+ *
+ * **DOSKUTSU local addition (patches/SDL/0072, never upstreamed).** This
+ * header exports the SDL3-DOS Lever 2b MidiScheduler-tick-from-IRQ
+ * registration surface: an engine-callable mechanism that piggybacks
+ * the MIDI event-dispatch tick onto the existing SB16 IRQ-5 ISR,
+ * decoupling MIDI tempo accuracy from the render-rate-coupled engine
+ * main loop.
+ *
+ * ## Why this exists
+ *
+ * The 486-class campaign Bug 4 (music-tempo wobble under sub-25 fps
+ * gameplay) traces to the engine's MidiScheduler::tick being called
+ * from the main loop at the rendered-fps cadence. Under FIXED_TIMESTEP
+ * (v1.0.0 default-ON), the main loop runs the 50 Hz logic tick + an
+ * accumulator-based catch-up loop; the MidiScheduler::tick fires once
+ * per displayed frame (~22-25 Hz on DX2-66 heavy-music scenes). At
+ * that rate, MIDI events that should fire at sub-40-ms granularity
+ * land late, producing operator-perceptible tempo wobble.
+ *
+ * Lever 2b moves the MidiScheduler tick from the cooperative main-loop
+ * path INTO the SB16 IRQ-5 ISR. The IRQ already fires at ~43 Hz under
+ * Tier-2 (11025 Hz / 256 sample-frames), about 2x the rendered fps on
+ * heavy-music DX2-66 scenes. The MIDI tick gains a render-rate-
+ * independent cadence; tempo accuracy improves to ~23 ms granularity
+ * regardless of render-fps.
+ *
+ * Per docs/internal/LEVER2B-MIDI-ISR-TICK-DESIGN.md sec.1 + sec.8
+ * (Contract lock from #117/#125 STOP-and-ack closure).
+ *
+ * ## How the engine uses it
+ *
+ * 1. At engine init (SoundManager::init or equivalent), after the
+ *    SDL audio device opens, the engine calls
+ *    SDL_DOSMidiTickRegister(cb) where cb is an `extern "C"` C-shim
+ *    function that the engine implements. The shim invokes
+ *    MidiScheduler::getInstance().tick_isr(now_ms) -- the new
+ *    ISR-context-safe variant of the existing tick(now_ms) per the
+ *    design sec.2.
+ *
+ * 2. At each SB16 IRQ-5 fire (~43 Hz Tier-2), the SDL backend's
+ *    SoundBlasterIRQHandler invokes the registered callback with the
+ *    monotonic cumulative wall-time in milliseconds (computed via
+ *    inter-IRQ delta accumulation through the existing
+ *    SDL_DOSAudioReadTimer + SDL_DOSAudioTimerDeltaUs primitives).
+ *
+ * 3. The engine's main-loop call to MidiScheduler::tick(now_ms) is
+ *    SKIPPED when SDL_DOSMidiIsrTickActive() returns true (the engine
+ *    queries this once at init to decide); the ISR owns the tick.
+ *
+ * 4. At game-pause / game-unpause transitions (operator-perception
+ *    choice (b) -- "preserve today's halt"), the engine explicitly
+ *    calls MidiScheduler::stop / MidiScheduler::start to halt /
+ *    resume music alongside game state.
+ *
+ * ## IRQ-context discipline (engine callback)
+ *
+ * The registered callback runs in IRQ-5 context. The engine MUST
+ * honor the strict ISR-context constraints in tick_isr() per LEVER2B
+ * sec.2:
+ *
+ * - No malloc/free, no FPU, no SDL API calls inside the callback.
+ * - Use fixed-point int64 arithmetic for tempo math (replace the
+ *   existing double-based _us_per_tick with us_per_tick_x256).
+ * - DPMI-lock the MidiScheduler singleton + events buffer + backend
+ *   pointer (sec.2.3); use a fixed-size locked events array (~16K
+ *   entries; ~100 KB) instead of std::vector to avoid the
+ *   vector-growth-during-ISR-read failure class.
+ * - cli/sti around main-thread MidiScheduler::load / start / stop /
+ *   backend-set so the ISR cannot read partially-written state
+ *   (LEVER2B sec.2.5).
+ *
+ * ## Killswitch
+ *
+ * SDL_HINT_DOSKUTSU_MIDI_ISR_TICK strict-"1" engages; default OFF.
+ * Resolved once at DOSSOUNDBLASTER_OpenDevice; cached. Two banner
+ * variants emit on the SDL log channel: `audio: SDL/0072 midi tick
+ * from ISR: ENABLED (opt-in)` / `audio: SDL/0072 midi tick from ISR:
+ * DISABLED (default)`.
+ *
+ * No backend-gate -- Lever 2b is orthogonal to the music backend
+ * choice. The engine simply doesn't register a callback when running
+ * under Organya (the Organya backend doesn't use MidiScheduler).
+ * Under OPL3 / WB / midi-stub, the engine registers the callback when
+ * the killswitch is engaged.
+ *
+ * ## HW-IO risk
+ *
+ * Per [[dosbox_not_proxy]], ISR-context bugs can hard-freeze real HW
+ * but often pass DOSBox-X smoke gates. Lever 2b REQUIRES real-HW
+ * DX2-66 operator iter for tempo-perception validation. Killswitch
+ * default-OFF + main-loop fallback path stays alive when off so a
+ * real-HW DPMI-fault inside the registered callback mitigates to
+ * "operator disables via env var" rather than hard-freezing.
+ *
+ * ## Wall-clock measurement
+ *
+ * The MIDI tick cost folds into the existing
+ * `doskutsu_audio_irq_wall_us` counter (the ISR insertion sits AFTER
+ * the existing counter increments but BEFORE the exit_timer read per
+ * LEVER2B sec.8 Q4). flush-instr's existing instrumentation sees the
+ * combined cost; per-lever attribution requires separate
+ * instrumentation if needed.
+ *
+ * Like SDL_dosaudio_pump.h / shutdown.h / dospixtone.h /
+ * dosvesa_directaccess.h, this header is a workspace-local doskutsu
+ * addition. SDL/0072 hunks + these declarations are not contributed
+ * back to libsdl-org/SDL.
+ */
+
+#ifndef SDL_dosmidi_tick_h_
+#define SDL_dosmidi_tick_h_
+
+#include <SDL3/SDL_stdinc.h>
+
+#include <SDL3/SDL_begin_code.h>
+/* Set up for C function definitions, even when using C++ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Callback signature for the IRQ-5-driven MIDI tick. Invoked from
+ * IRQ context at each SB16 IRQ-5 fire (~43 Hz Tier-2). The callback
+ * receives the monotonic cumulative wall-time in milliseconds since
+ * OpenDevice baseline.
+ *
+ * IRQ-CONTEXT DISCIPLINE: the callback runs in IRQ context. Honor the
+ * strict rules per LEVER2B sec.2:
+ *
+ * - No malloc/free.
+ * - No FPU (no double/float arithmetic; use fixed-point int64).
+ * - No SDL API calls.
+ * - No DPMI thunks; all touched data must be DPMI-locked.
+ * - Bounded execution time (the IRQ-5 is held off other IRQs while
+ *   this runs; long execution blocks keyboard / timer IRQs).
+ *
+ * \param now_ms  monotonic cumulative wall-time in milliseconds since
+ *                the SDL_DOSMidiTickRegister-engagement (NOT since
+ *                process start); the underlying accumulator resets at
+ *                each DOSSOUNDBLASTER_OpenDevice fire. Cave Story
+ *                never re-inits audio so the reset behavior is
+ *                theoretical, but engine-side tick_isr implementations
+ *                should defensively handle the now_ms < last_now_ms
+ *                case as "reset detected; reseed baseline" rather
+ *                than computing a negative delta. Useful as the
+ *                MidiScheduler::tick(now_ms) timestamp argument.
+ *
+ * \since SDL 3 -- doskutsu workspace-local patch 0072, 2026-05-21.
+ */
+typedef void (*SDL_DOSMidiTickCallback)(Uint64 now_ms);
+
+/**
+ * Register the IRQ-5 MIDI tick callback. Called once at engine init
+ * from the main thread; the callback is invoked from the IRQ-5 ISR
+ * at each fire when SDL_HINT_DOSKUTSU_MIDI_ISR_TICK is engaged.
+ *
+ * Pass NULL to deregister (the ISR reverts to no-op for the tick step
+ * even when the killswitch is still engaged).
+ *
+ * Idempotent; safe to call multiple times (last call wins). Safe to
+ * call before / after / regardless of OpenDevice -- the callback is
+ * stored in DPMI-locked module-static state and only invoked from
+ * the ISR when both (a) killswitch ON, (b) callback non-NULL hold.
+ *
+ * \param cb  the engine-side callback function pointer (or NULL to
+ *            deregister). The callback storage is DPMI-locked at
+ *            OpenDevice; the callback body must be ISR-safe per the
+ *            SDL_DOSMidiTickCallback typedef comment.
+ *
+ * \threadsafety Call from the engine main thread. The callback
+ *               pointer write is a single volatile pointer store
+ *               (atomic on aligned x86); the ISR reader sees either
+ *               the old or new value but never a torn pointer.
+ *
+ * \since SDL 3 -- doskutsu workspace-local patch 0072, 2026-05-21.
+ *
+ * \sa SDL_DOSMidiIsrTickActive
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSMidiTickRegister(SDL_DOSMidiTickCallback cb);
+
+/**
+ * Returns true if Lever 2b ISR MIDI tick is active for this process.
+ * Resolved once at DOSSOUNDBLASTER_OpenDevice from
+ * SDL_HINT_DOSKUTSU_MIDI_ISR_TICK (strict-"1"); stable post-init.
+ *
+ * The engine reads this to decide whether to (a) register an ISR
+ * callback via SDL_DOSMidiTickRegister and (b) skip the per-frame
+ * MidiScheduler::tick(now_ms) call from the engine main loop. When
+ * false, the engine retains pre-Lever-2b behavior unchanged.
+ *
+ * \returns true if Lever 2b is engaged (SDL_HINT_DOSKUTSU_MIDI_ISR
+ *          _TICK=1 was observed at OpenDevice); false otherwise.
+ *
+ * \threadsafety Engine main thread; the cached bool is set once at
+ *               OpenDevice and not modified thereafter.
+ *
+ * \since SDL 3 -- doskutsu workspace-local patch 0072, 2026-05-21.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSMidiIsrTickActive(void);
+
+/* Ends C function definitions when using C++ */
+#ifdef __cplusplus
+}
+#endif
+#include <SDL3/SDL_close_code.h>
+
+#endif /* SDL_dosmidi_tick_h_ */
