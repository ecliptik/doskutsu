index 8592684e8..cf65f8e9f 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -32,2 +32,3 @@
 #include <SDL3/SDL_dospixtone.h>        /* DOSKUTSU patch 0071: engine-callable SDL_DOSPixtone* channel-pool API (Lever 3 IRQ-5 ISR mix) */
+#include <SDL3/SDL_dosmidi_tick.h>      /* DOSKUTSU patch 0072: engine-registered IRQ-5 MIDI tick callback (Lever 2b MidiScheduler ISR piggyback) */
 
@@ -814,2 +815,41 @@ static bool g_dos_pixtone_irq_mix_active = false;
 static volatile Uint8 g_dos_pixtone_irq_mix_shift = 9;
+/* ========================================================================
+ * DOSKUTSU patch (Phase 11 patch 0072): Lever 2b -- MidiScheduler tick
+ * from the SB16 IRQ-5 ISR
+ * ========================================================================
+ *
+ * Lever 2b piggybacks the MIDI event-dispatch tick onto the existing
+ * IRQ-5 handler, decoupling MIDI tempo accuracy from the render-rate-
+ * coupled engine main loop. Structural fix for 486-class campaign
+ * Bug 4 (music-tempo wobble under sub-25 fps gameplay).
+ *
+ * Mechanism: the engine registers a callback (typedef
+ * SDL_DOSMidiTickCallback in vendor/SDL/include/SDL3/SDL_dosmidi_tick.h)
+ * once at engine init. At each IRQ-5 fire, the SDL ISR invokes the
+ * callback with the monotonic cumulative wall-time in milliseconds,
+ * computed via inter-IRQ delta accumulation through the existing
+ * SDL_DOSAudioReadTimer + SDL_DOSAudioTimerDeltaUs primitives (the
+ * same per-IRQ-cost timer used at sb.c:729 / sb.c exit_timer site).
+ * The engine's main-loop MidiScheduler::tick callsite is SKIPPED
+ * when SDL_DOSMidiIsrTickActive() returns true.
+ *
+ * Killswitch: SDL_HINT_DOSKUTSU_MIDI_ISR_TICK strict-"1" engages;
+ * default OFF. No backend-gate -- Lever 2b is orthogonal to the music
+ * backend choice (the engine simply doesn't register a callback when
+ * running under Organya, which doesn't use MidiScheduler).
+ *
+ * Per docs/internal/LEVER2B-MIDI-ISR-TICK-DESIGN.md sec.1-7 + sec.8
+ * (Contract lock from #117/#125 STOP-and-ack closure). */
+static bool g_dos_midi_isr_tick_active = false;
+static SDL_DOSMidiTickCallback g_dos_midi_tick_cb = NULL;
+/* Inter-IRQ delta accumulator: at each IRQ fire we read
+ * SDL_DOSAudioReadTimer() into entry_timer (already done at the top of
+ * SoundBlasterIRQHandler), compute the delta vs the last IRQ's entry,
+ * and add to g_dos_midi_us_accum. The callback receives
+ * (g_dos_midi_us_accum / 1000) as monotonic now_ms. First-IRQ-post-
+ * register seeds last_entry_timer + skips the callback emit so the
+ * delta math is well-defined from the second IRQ on. */
+static volatile uint64_t g_dos_midi_us_accum = 0;
+static volatile Uint64   g_dos_midi_last_entry_timer = 0;
+static volatile bool     g_dos_midi_baseline_seeded = false;
 
@@ -1051,2 +1091,24 @@ void SDL_DOSPixtoneSetGain(int32_t channel_id, int16_t gain_x256)
 
+/* DOSKUTSU patch (Phase 11 patch 0072): Lever 2b -- engine-facing
+ * registration API. The engine registers an ISR-safe C callback at
+ * init; subsequent SB16 IRQ-5 fires invoke the callback with the
+ * monotonic cumulative now_ms. Pass NULL to deregister. Idempotent;
+ * last-call-wins.
+ *
+ * The callback pointer is a plain volatile pointer write; aligned on
+ * the i486+ target, atomic. The ISR-side reader observes either the
+ * old or new value but never a torn pointer. cli/sti is NOT needed
+ * for the pointer write (single-word atomic on x86 is sufficient). */
+void SDL_DOSMidiTickRegister(SDL_DOSMidiTickCallback cb)
+{
+    g_dos_midi_tick_cb = cb;
+}
+
+/* Engine-visible accessor. Resolved at OpenDevice (sentinel-cached);
+ * stable post-init. */
+bool SDL_DOSMidiIsrTickActive(void)
+{
+    return g_dos_midi_isr_tick_active;
+}
+
 // The IRQ handler. Copies one chunk from the ring buffer into the DMA
@@ -1157,2 +1219,30 @@ static void SoundBlasterIRQHandler(void)
 
+    /* DOSKUTSU patch (Phase 11 patch 0072): Lever 2b -- MidiScheduler
+       tick from the IRQ-5 ISR. Cached-bool gated + callback-non-NULL
+       gated; under killswitch OFF or no engine callback registered
+       the cost is two cached reads + early branch (sub-microsecond).
+       When engaged, computes monotonic cumulative now_ms from the
+       inter-IRQ delta of SDL_DOSAudioReadTimer (the same primitive
+       used for entry_timer + exit_timer) and invokes the engine
+       callback. First-IRQ-post-engagement seeds the baseline and
+       skips the emit so the delta math is well-defined.
+
+       NOTE this hook sits AFTER the existing counter increments and
+       BEFORE the exit_timer read at line 1191 so the MIDI tick cost
+       folds into doskutsu_audio_irq_wall_us per LEVER2B-MIDI-ISR-
+       TICK-DESIGN.md sec.8 Q4 + sec.10. */
+    if (g_dos_midi_isr_tick_active && g_dos_midi_tick_cb) {
+        if (!g_dos_midi_baseline_seeded) {
+            g_dos_midi_last_entry_timer = entry_timer;
+            g_dos_midi_baseline_seeded = true;
+        } else {
+            const uint32_t midi_delta_us =
+                SDL_DOSAudioTimerDeltaUs(g_dos_midi_last_entry_timer, entry_timer);
+            g_dos_midi_us_accum += midi_delta_us;
+            g_dos_midi_last_entry_timer = entry_timer;
+            const Uint64 now_ms = g_dos_midi_us_accum / 1000ULL;
+            g_dos_midi_tick_cb(now_ms);
+        }
+    }
+
     /* DOSKUTSU patch (Phase 10 patch 0039): wall-clock accumulate via
@@ -1532,2 +1622,37 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
 
+    /* DOSKUTSU patch (Phase 11 patch 0072): Lever 2b -- MidiScheduler
+       tick from IRQ-5 ISR. Resolve killswitch + emit banner. Reset
+       the inter-IRQ delta accumulator state on each OpenDevice so a
+       hypothetical future re-init path starts fresh (Cave Story never
+       re-inits audio, but the reset matches the existing 0071 pattern
+       for symmetry). No backend-gate -- Lever 2b is orthogonal to
+       the music backend choice; the engine simply doesn't register a
+       callback when running under Organya (which doesn't use
+       MidiScheduler). Per LEVER2B sec.3 + sec.6. */
+    {
+        const char *m2b_hint = SDL_GetHint("SDL_HINT_DOSKUTSU_MIDI_ISR_TICK");
+        const bool hint_set =
+            (m2b_hint && m2b_hint[0] == '1' && m2b_hint[1] == 0);
+        g_dos_midi_us_accum = 0;
