+    g_dos_pix_chan[c].buf_len      = buf_len;
+    g_dos_pix_chan[c].pos          = 0;
+    g_dos_pix_chan[c].gain_x256    = gain_x256;
+    g_dos_pix_chan[c].loop_forever = loop_forever;
+    g_dos_pix_chan[c].channel_id   = ++g_next_pix_channel_id;
+    g_dos_pix_chan[c].active       = true; /* publishing write -- LAST */
