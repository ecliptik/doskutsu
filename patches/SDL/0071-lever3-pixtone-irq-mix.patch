+/* ------------------------------------------------------------------------
+ * Phase 11 patch 0071 -- SDL_DOSPixtone* channel-pool API for Lever 3
+ * ------------------------------------------------------------------------
+ *
+ * Lever 3 (Pixtone IRQ-5 ISR mix): moves Pixtone PCM mixing from the
+ * cooperative-thread-filled SDL ring into the IRQ-5 ISR. The IRQ that
+ * owns the DMA buffer also does the SFX mix; the cooperative scheduler
+ * is bypassed for the SFX path. Structural answer to the wave-21 +
+ * sec.21 + #120 hypothesis-C verdict (cooperative-scheduler audio-
+ * thread starvation; up to 1701 ms max single-callback latency on
+ * real DX2-66).
+ *
+ * Engine routes Pixtone::play through SDL_DOSPixtoneStart when
+ * SDL_DOSPixtoneIRQMixActive() returns true; the SDL backend's
+ * SoundBlasterIRQHandler walks the channel pool and mixes each active
+ * channel's PCM data into the DMA half-buffer using int32 add + clamp
+ * on int16 samples (Pixtone PCM under Tier-2 is signed 16-bit mono at
+ * 11025 Hz per Pixtone.cpp:567's SDL_AudioSpec).
+ *
+ * Killswitch: SDL_HINT_DOSKUTSU_PIXTONE_IRQ_MIX strict-"1" engages.
+ * Default OFF. Backend-gated: refuses engagement when
+ * SDL_HINT_DOSKUTSU_AUDIO_BACKEND=organya (Lever 3 + Organya is
+ * compatible by construction but the design prefers OPL3/WB/midi-stub
+ * for clean SFX-vs-music separation per LEVER3 sec.5.4).
+ *
+ * IDs are monotonic int32_t; -1 indicates failure (no free channel on
+ * Start; unknown id on Stop / IsActive / SetGain). Engine stores
+ * returned id in _sound_fx[slot].channel.
+ *
+ * gain_x256 is fixed-point (256 = 1.0); the engine converts from its
+ * existing volume/gain model at the call site. loop_forever = true is
+ * for SND_STREAM1/SND_STREAM2/SND_PROPELLOR; one-shot SFX pass false.
+ *
+ * IRQ-context constraints honored: no malloc/free, no FPU, no SDL
+ * API calls, no DPMI thunks inside the ISR. The mix loop is pure
+ * integer arithmetic on DPMI-locked pool storage; raw_master_buf
+ * lock is engine-side responsibility (Pixtone::init extension per
+ * LEVER3 sec.7.3, patch nxengine-evo/0167).
+ *
+ * Per docs/internal/LEVER3-PIXTONE-IRQ-MIX-DESIGN.md sec.3 +
+ * sec.10 (Contract lock).
+ */
+
+extern SDL_DECLSPEC int32_t SDLCALL SDL_DOSPixtoneStart(const Uint8 *buf,
+                                                          Uint32 buf_len,
+                                                          int16_t gain_x256,
+                                                          bool loop_forever);
+extern SDL_DECLSPEC void SDLCALL SDL_DOSPixtoneStop(int32_t channel_id);
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSPixtoneIsActive(int32_t channel_id);
+extern SDL_DECLSPEC void SDLCALL SDL_DOSPixtoneSetGain(int32_t channel_id,
+                                                       int16_t gain_x256);
+
+/* Engine-visible accessor: is Lever 3 IRQ-mix active for this
+ * process? Resolved once at DOSSOUNDBLASTER_OpenDevice from
+ * SDL_HINT_DOSKUTSU_PIXTONE_IRQ_MIX (strict-"1") combined with the
+ * AUDIO_BACKEND backend-gate. Stable post-init; the engine reads it
+ * to gate its Pixtone::play routing branch (sec.4 of the design). */
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSPixtoneIRQMixActive(void);
+
+/* Engine-visible counter: number of currently active ISR-channel
+ * pool slots. Engine 0165 probe reads SUM of this +
+ * g_pixtone_active_count under Lever 3 ON (per the L3-Q5 Shape B
+ * contract). Atomically incremented in SDL_DOSPixtoneStart and
+ * decremented in the ISR at end-of-buffer via __sync_fetch_and_*
+ * (lock xadd on i486+); dual-writer-safe across engine thread + IRQ
+ * context. Engine-side reader is a single 32-bit volatile read --
+ * atomic on aligned x86. */
+extern volatile uint32_t g_dos_pixtone_active_count;
