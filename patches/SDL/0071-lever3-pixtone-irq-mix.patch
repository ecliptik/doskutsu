+        if (g_dos_pix_chan[c].pos >= g_dos_pix_chan[c].buf_len) {
+            if (g_dos_pix_chan[c].loop_forever) {
+                g_dos_pix_chan[c].pos = 0;
+            } else {
+                g_dos_pix_chan[c].active = false;
+                g_dos_pix_chan[c].channel_id = -1;
+                /* Dual-writer-safe decrement: __sync_fetch_and_sub
+                 * compiles to lock xsub on i486+ (atomic across the
+                 * engine-thread ++ in SDL_DOSPixtoneStart). Per L3-Q5
+                 * Shape B contract. */
+                __sync_fetch_and_sub(&g_dos_pixtone_active_count, 1u);
+            }
+        }
+    }
