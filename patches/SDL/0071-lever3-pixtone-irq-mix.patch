+ * stereo-duplicate write. nx-engine's 0167 routing patch scopes v1
+ * to non-resampled Pixtone::play only per the L3-Q1 contract.
+ *
+ * IRQ-context discipline (LEVER3 sec.2):
+ *   - No malloc/free: g_dos_pix_chan[] is file-scope static.
+ *   - No FPU: int32 accumulator on int16 source, gain is int16 x256.
+ *   - No SDL API calls.
+ *   - No DPMI thunks: all touched data is DPMI-locked at OpenDevice.
+ *
+ * Atomicity: g_dos_pixtone_active_count decrement on end-of-buffer uses
+ * __sync_fetch_and_sub (lock xsub on i486+) for dual-writer safety
+ * with the engine-context ++ in SDL_DOSPixtoneStart. Per L3-Q5 Shape
+ * B contract.
+ *
+ * Defensive guard: if pos > buf_len (shouldn't happen by design --
+ * prior IRQ should have deactivated the slot at end-of-buffer), the
+ * remaining_bytes computation would go negative + the Uint32 pos
+ * advance would wrap. The pos-out-of-bounds branch deactivates
+ * defensively rather than continuing with a corrupted slot. */
+static void PixtoneISRMix(Uint8 *dma_dst, int dma_len)
+{
+    int16_t *dst = (int16_t *)dma_dst;
+    const int n_samples = dma_len / 2;
+    const int n_stereo_pairs = n_samples / 2;
+
+    for (int c = 0; c < DOS_PIXTONE_CHANNELS; ++c) {
+        if (!g_dos_pix_chan[c].active) continue;
+
+        const int remaining_bytes = (int)g_dos_pix_chan[c].buf_len
+                                  - (int)g_dos_pix_chan[c].pos;
+        if (remaining_bytes <= 0) {
+            /* Defensive: pos out-of-bounds (shouldn't happen; prior IRQ
+             * end-of-buffer branch should have deactivated). Guard
+             * against the Uint32 pos-advance wrap-around. */
+            g_dos_pix_chan[c].active = false;
+            g_dos_pix_chan[c].channel_id = -1;
+            __sync_fetch_and_sub(&g_dos_pixtone_active_count, 1u);
+            continue;
+        }
