+/**
+ * # CategoryDOSPixtone
+ *
+ * **DOSKUTSU local addition (patches/SDL/0071, never upstreamed).** This
+ * header exports the SDL3-DOS Lever 3 Pixtone IRQ-mix channel-pool API:
+ * an engine-callable surface that routes Pixtone PCM SFX through the
+ * SB16 IRQ-5 ISR, bypassing the cooperative-scheduler SDL3_mixer ring
+ * path entirely.
+ *
+ * ## Why this exists
+ *
+ * The 486-class campaign + v2 Pixtone multi-source probe iter (#119,
+ * 2026-05-21) confirmed hypothesis C: cooperative-scheduler audio-thread
+ * starvation produces up to 1701 ms max single-callback latency on real
+ * DX2-66 hardware (`docs/internal/486-CLASS-CAMPAIGN-FINDINGS.md`
+ * sec.22). The existing SDL3_mixer ring-fill path is render-rate-
+ * coupled (the cooperative audio thread runs only when the engine
+ * yields); under heavy CPU + heavy render frames, the audio refill
+ * falls behind the IRQ-5 drain rate -> ring underrun -> audible SFX
+ * stutter (Bug 2).
+ *
+ * Lever 3 is the structural fix: move Pixtone PCM mix from the
+ * cooperative-thread SDL3_mixer ring path INTO `SoundBlasterIRQHandler`.
+ * The IRQ that owns the DMA buffer also does the SFX mix; the
+ * cooperative scheduler is bypassed for the SFX path entirely. Under
+ * the OPL3 backend (wave-46 default since 2026-05-14), music is direct
+ * chip writes (no PCM ring touch) + SFX is IRQ-mixed = 100% IRQ-driven
+ * audio.
+ *
+ * ## How the engine uses it
+ *
+ * 1. At engine init (Pixtone::init), the engine DPMI-locks each
+ *    `_sound_fx[slot].raw_master_buf` so the ISR can read PCM samples
+ *    without page-faulting (engine-side responsibility per LEVER3
+ *    sec.7.3; patches/nxengine-evo/0167).
+ *
+ * 2. At Pixtone::play time, the engine checks `SDL_DOSPixtoneIRQMixActive()`
+ *    (which reflects the cached killswitch + backend-gate decision from
+ *    `DOSSOUNDBLASTER_OpenDevice` time). If active, the engine routes
+ *    through `SDL_DOSPixtoneStart(buf, buf_len, gain_x256, loop_forever)`
+ *    instead of MIX_PlayTrack; the returned channel id is stored in
+ *    `_sound_fx[slot].channel`. If inactive, the engine uses the
+ *    existing SDL3_mixer track-pool path (byte-identical to pre-0071
+ *    behavior).
+ *
+ * 3. At Pixtone::stop time (or end-of-buffer for one-shots), the engine
+ *    calls `SDL_DOSPixtoneStop(channel_id)`. End-of-buffer is also
+ *    detected ISR-side; the ISR atomically decrements the active
+ *    counter and clears the slot.
+ *
+ * 4. The engine 0165 probe reads
+ *    `g_dos_pixtone_active_count + g_pixtone_active_count` under
+ *    Lever 3 ON (the L3-Q5 Shape B contract; ISR-side ATOMIC counter +
+ *    SDL3_mixer-side counter SUMmed to give the logical active SFX
+ *    count regardless of which mix-backend handles each SFX).
+ *
+ * ## Killswitch + backend-gate
+ *
+ * `SDL_HINT_DOSKUTSU_PIXTONE_IRQ_MIX` strict-`"1"` engages; default OFF.
+ * Backend-gate refuses engagement when
+ * `SDL_HINT_DOSKUTSU_AUDIO_BACKEND` == `"organya"` (Lever 3 + Organya
+ * is compatible by construction per LEVER3 sec.5.2 but the design
+ * prefers OPL3/WB/midi-stub for clean SFX-vs-music separation per
+ * sec.5.4). Resolved once at OpenDevice; cached.
+ *
+ * Three banner variants emit at OpenDevice on the SDL log channel:
+ * `audio: SDL/0071 pixtone IRQ-mix: ENABLED (opt-in via ...)`,
+ * `audio: SDL/0071 pixtone IRQ-mix: DISABLED (default; ...)`, or
+ * `audio: SDL/0071 pixtone IRQ-mix: REQUESTED but Organya backend
+ * active; skipping (...)`.
+ *
+ * ## IRQ-context discipline
+ *
+ * The ISR mix function (`PixtoneISRMix` in `SDL_dosaudio_sb.c`) honors
+ * the strict IRQ-context constraints per LEVER3 sec.2:
+ *
+ * - No `malloc`/`free`: channel pool is a file-scope static array.
+ * - No FPU: int32 accumulator + clamp on int16 source; gain is
+ *   fixed-point int16 x256.
+ * - No SDL API calls inside the ISR.
+ * - No DPMI thunks: all ISR-touched data is DPMI-locked at
+ *   `DOSSOUNDBLASTER_OpenDevice` (LEVER3 sec.7.1 + sec.7.2).
+ *
+ * ## HW-IO risk
+ *
+ * Per `[[dosbox_not_proxy]]`, ISR-context bugs can hard-freeze real HW
+ * but often pass DOSBox-X smoke gates. Lever 3 REQUIRES real-HW
+ * DX2-66 operator iter for behavioral validation. Killswitch
+ * default-OFF + SDL3_mixer fallback path stays alive when off so a
+ * real-HW DPMI-fault inside the ISR mitigates to "operator disables
+ * via env var" rather than hard-freezing.
+ *
+ * ## Stereo-duplicate mix
+ *
+ * Pixtone PCM under Tier-2 is signed 16-bit MONO at 11025 Hz per
+ * `vendor/nxengine-evo/src/sound/Pixtone.cpp:567`. The SB16 DMA stream
+ * is FORCED stereo S16 at `SDL_dosaudio_sb.c:1294-1295`. PixtoneISRMix
+ * stereo-duplicates each Pixtone mono sample into one stereo L+R pair
+ * (centered, no pan; v2 candidate to wire differential gain_x256 for
+ * positional audio). The Pixtone playback rate is self-correcting
+ * regardless of the actual IRQ_Hz / chunk_size product because
+ * `IRQ_Hz * n_stereo_pairs_per_IRQ = spec.freq` (= 11025 Hz consumption
+ * rate matches source rate).
+ *
+ * Per docs/internal/LEVER3-PIXTONE-IRQ-MIX-DESIGN.md sec.1-7 + sec.10
+ * (Contract lock from #117/#123 STOP-and-ack closure).
+ *
+ * Like SDL_dosaudio_pump.h + SDL_dosaudio_shutdown.h +
+ * SDL_dosvesa_directaccess.h, this header is a workspace-local
+ * doskutsu addition. SDL/0071 hunks + these declarations are not
+ * contributed back to libsdl-org/SDL.
+ */
+
+#ifndef SDL_dospixtone_h_
+#define SDL_dospixtone_h_
+
+#include <SDL3/SDL_stdinc.h>
+
+#include <SDL3/SDL_begin_code.h>
+/* Set up for C function definitions, even when using C++ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Start playing a Pixtone PCM SFX on the SDL-side ISR-mixed channel
+ * pool. Allocates a free channel from the fixed pool (DOS_PIXTONE_
+ * CHANNELS = 8 slots in `SDL_dosaudio_sb.c`), populates the slot
+ * fields atomically under `cli`/`sti`, and publishes the slot to the
+ * IRQ-5 ISR via the `active = true` flag.
+ *
+ * Returns the channel id (>= 0) on success; the engine stores it in
+ * `_sound_fx[slot].channel` for later `SDL_DOSPixtoneStop` /
+ * `SDL_DOSPixtoneIsActive` / `SDL_DOSPixtoneSetGain` calls.
+ *
+ * Returns -1 when no free channel is available (pool exhausted). The
+ * engine MAY invoke its own preempt-on-exhaustion policy (Lever 1
+ * channel-priority preemption) before retrying.
+ *
+ * \param buf           pointer to the Pixtone PCM data (int16 samples
+ *                      treated as raw bytes for compatibility with the
+ *                      existing `_sound_fx[slot].raw_master_buf`
+ *                      `uint8_t *` type). The buffer must be DPMI-
+ *                      locked by the caller; Pixtone::init's
+ *                      raw_master_buf lock (extended for Lever 3 in
+ *                      nxengine-evo/0167) covers this.
+ * \param buf_len       length of buf in BYTES (not samples; the ISR
+ *                      computes sample count as buf_len / 2).
+ * \param gain_x256     fixed-point gain (256 = 1.0); engine converts
+ *                      from its existing volume model at the call site.
+ * \param loop_forever  true for SND_STREAM1 / SND_STREAM2 / SND_PROPELLOR
+ *                      (looping SFX); false for one-shots.
+ *
+ * \returns the assigned channel id (>= 0) on success, or -1 if no
+ *          free channel.
+ *
+ * \threadsafety Call from the engine main thread (not from the audio
+ *               thread, not from an interrupt handler). The cli/sti
+ *               window inside is brief (find-free-slot + populate-
+ *               fields + publish); the engine-side counter increment
+ *               uses `__sync_fetch_and_add` for atomic safety with the
+ *               ISR's decrement at end-of-buffer.
+ *
+ * \since SDL 3 -- doskutsu workspace-local patch 0071, 2026-05-21.
+ *
+ * \sa SDL_DOSPixtoneStop
+ * \sa SDL_DOSPixtoneIsActive
+ * \sa SDL_DOSPixtoneSetGain
+ * \sa SDL_DOSPixtoneIRQMixActive
+ */
+extern SDL_DECLSPEC int32_t SDLCALL SDL_DOSPixtoneStart(const Uint8 *buf,
+                                                         Uint32 buf_len,
+                                                         int16_t gain_x256,
+                                                         bool loop_forever);
+
+/**
+ * Stop an active SDL-side Pixtone channel by its id. No-op if the
+ * channel is not active, or if the id doesn't match the slot's
+ * current `channel_id` (the slot may have been reused since the
+ * engine recorded the id; the engine compares channel_id at the slot
+ * to confirm).
+ *
+ * cli/sti window guards the slot's active-flag flip + counter
+ * decrement against the ISR.
+ *
+ * \param channel_id  the id returned from a prior SDL_DOSPixtoneStart
+ *                    call; negative values are no-op.
+ *
+ * \threadsafety Engine main thread.
+ *
+ * \since SDL 3 -- doskutsu workspace-local patch 0071, 2026-05-21.
+ *
+ * \sa SDL_DOSPixtoneStart
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSPixtoneStop(int32_t channel_id);
+
+/**
+ * Check whether an SDL-side Pixtone channel is still playing.
+ * Tolerates id mismatch (slot reused for a different SFX since the
+ * engine recorded the id) -- returns false in that case.
+ *
+ * Read-only; no cli/sti needed since aligned 32-bit volatile reads
+ * are atomic on x86. The engine polls this to implement Pixtone's
+ * `_sound_fx[slot].channel`-state checks.
+ *
+ * \param channel_id  the id to query.
+ *
+ * \returns true if the channel is still active and the id matches;
+ *          false otherwise (channel inactive, id mismatch, or
+ *          negative id).
+ *
+ * \threadsafety Engine main thread.
+ *
+ * \since SDL 3 -- doskutsu workspace-local patch 0071, 2026-05-21.
+ *
+ * \sa SDL_DOSPixtoneStart
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_DOSPixtoneIsActive(int32_t channel_id);
+
+/**
+ * Update the gain on an active SDL-side Pixtone channel. Plain
+ * volatile-write race-tolerant against the ISR: the worst case is
+ * one IRQ uses the old gain for one chunk (~23 ms at Tier-2) before
+ * the new gain takes effect.
+ *
+ * No-op if the channel is not active or the id doesn't match.
+ *
+ * NOTE: under Lever 3 v1, the engine-side Pixtone::setVolume routing
+ * may not call this (parked for v2 wiring per the L3 design). The
+ * SDL-side mechanism is available regardless; the engine chooses
+ * whether to call it. v2 candidate to wire setVolume -> this call.
+ *
+ * \param channel_id  the id to update.
+ * \param gain_x256   new fixed-point gain (256 = 1.0).
+ *
+ * \threadsafety Engine main thread.
+ *
+ * \since SDL 3 -- doskutsu workspace-local patch 0071, 2026-05-21.
+ *
+ * \sa SDL_DOSPixtoneStart
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSPixtoneSetGain(int32_t channel_id,
+                                                       int16_t gain_x256);
+
+/**
+ * Returns true if Lever 3 IRQ-mix is active for this process.
+ * Resolved once at `DOSSOUNDBLASTER_OpenDevice` from
+ * `SDL_HINT_DOSKUTSU_PIXTONE_IRQ_MIX` (strict-`"1"`) combined with
+ * the `SDL_HINT_DOSKUTSU_AUDIO_BACKEND` backend-gate. Stable
+ * post-init.
+ *
+ * The engine reads this to gate its Pixtone::play routing branch
+ * (sec.4 of the design): when true, route through
+ * SDL_DOSPixtoneStart; when false, use the existing SDL3_mixer
+ * track-pool path unchanged.
+ *
+ * \returns true if Lever 3 is engaged + the backend-gate accepted;
+ *          false otherwise (default-OFF, killswitch unset, or
+ *          backend-gate refused Organya).
+ *
+ * \threadsafety Engine main thread; the cached bool is set once at
+ *               OpenDevice and not modified thereafter.
+ *
