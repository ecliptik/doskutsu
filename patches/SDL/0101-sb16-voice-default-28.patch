From d05711c23e785c9ce17ebc5978b8990431a7f2ff Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Sun, 14 Jun 2026 17:28:10 -0700
Subject: [PATCH] dos: patch 0101 -- SB16 CT1745 Voice (PCM/SFX) default 31 ->
 28 (T76 ship balance)

Operator-validated (2026-06-15): at the SDL/0074 default voice=31 the PCM SFX
drowned the OPL3/WB music; voice=28 balances it (their saved cfg is
SB16_VOICE_VOL=28). Lower the hardcoded fallback (programmed when the
SB16_VOICE_VOL hint is unset) from 31 to 28 so the fresh-install default matches.
master stays 31, fm stays 28. Companion coherent defaults: SETUP recommend.c +
the include/doskutsu_config_keys.h registry default (separate commits) also move
to 28 so the .cfg-written / built-in-default / SDL-fallback paths all agree.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 src/audio/dos/SDL_dosaudio_sb.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index 7cc422c06..578f7bf8a 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -2805,7 +2805,7 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
              Voice  0x32/0x33 = voice_vol<<3 (PCM/DAC = the SFX path)
              FM     0x34/0x35 = fm_vol<<3    (OPL3 music)
            Env knobs (cache-at-boot, clamp 0..31):
-             SDL_HINT_DOSKUTSU_SB16_VOICE_VOL (default 31)
+             SDL_HINT_DOSKUTSU_SB16_VOICE_VOL (default 28 -- T76; was 31)
              SDL_HINT_DOSKUTSU_SB16_FM_VOL    (default 28 -- lowers music;
                                                p0075 ship-validated, was 24)
            Killswitch SDL_HINT_DOSKUTSU_SB16_MIXER_PROGRAM strict-"0" ->
@@ -2816,7 +2816,7 @@ static bool DOSSOUNDBLASTER_OpenDevice(SDL_AudioDevice *device)
             const char *mp_hint = SDL_GetHint("SDL_HINT_DOSKUTSU_SB16_MIXER_PROGRAM");
             const bool mixer_program = !(mp_hint && mp_hint[0] == '0' && mp_hint[1] == 0);
             if (mixer_program) {
-                int voice_vol = 31, fm_vol = 28; /* p0075 v1.0.1: fm 24->28, operator-validated SFX-vs-music balance (voice stays 31) */
+                int voice_vol = 28, fm_vol = 28; /* SDL/0101 T76: voice 31->28 (operator-validated -- SFX drowned music at 31). p0075 v1.0.1: fm 24->28. */
                 const char *vv = SDL_GetHint("SDL_HINT_DOSKUTSU_SB16_VOICE_VOL");
                 const char *fv = SDL_GetHint("SDL_HINT_DOSKUTSU_SB16_FM_VOL");
                 if (vv && vv[0] != '\0') {
-- 
