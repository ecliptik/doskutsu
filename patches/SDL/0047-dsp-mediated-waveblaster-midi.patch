diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index a9430c662..3a38e8ba6 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -87,6 +87,62 @@ static void WriteSoundBlasterDSP(const Uint8 val)
     outportb(port, val);
 }
 
+/* DOSKUTSU patch (Phase 10 patch 0047): DSP-mediated MIDI dispatch
+   helpers for the WaveBlaster backend.
+
+   W22-WB-F MPUPROBE forensic analysis (docs/MPUPROBE-W22WB-F-ANALYSIS.md)
+   showed that direct-port MPU-401 access at port 0x330/0x331 has two
+   essential issues on real SB16 PnP CTL0026 + DreamBlaster S2:
+   (a) MPU status bit 7 (TX-READY) never clears -- any polling-gated
+       write hangs indefinitely;
+   (b) the W22-WB-C/D lockups were SDL-orchestration issues, most
+       plausibly cross-firmware concurrency between MPU-port access
+       and DSP DMA programming.
+
+   DSP-mediated MIDI funnels all chip access through one bus contender
+   (the DSP write port at base+0xC), eliminating cross-firmware races.
+   The probe demonstrated this exact sequence (DSP cmd 0x34 + 0x38)
+   works on the real chip in section 10.
+
+   Sequence per Creative SB16 reference + probe-validated:
+     - Enter UART mode: WriteSoundBlasterDSP(0x34)
+     - Send each MIDI byte: WriteSoundBlasterDSP(0x38) + WriteSoundBlasterDSP(byte)
+     - No teardown DSP command needed (engine shutdown's 0xD3 speaker-off
+       in DOSSOUNDBLASTER_CloseDevice silences MIDI alongside DAC).
+
+   The functions are exposed as SDL_DOSAudioSB_* so the synth.c MPU-401
+   wrapper can dispatch through here when the DSP-mediated path is
+   selected, while keeping WriteSoundBlasterDSP static (encapsulation
+   of the DSP I/O port mechanics inside this file).
+
+   Init precondition (engine's responsibility, not ours): the SB16
+   audio backend must be open AND the audio playback thread should
+   have serviced at least one frame. We expose IsInitialized() for
+   the bare backend-open check; the ">=1 frame serviced" check is
+   intentionally engine-side because we don't track frame count here. */
+bool SDL_DOSAudioSB_IsInitialized(void)
+{
+    /* soundblaster_base_port is initialized to -1 at file scope and
+       set to a real port by DetectSoundBlaster() during DOSSOUNDBLASTER_
+       OpenDevice. Non-negative => OpenDevice ran to completion. */
+    return soundblaster_base_port >= 0;
+}
+
+void SDL_DOSAudioSB_DSPMidiEnterUART(void)
+{
+    /* No precondition gate -- caller (synth.c MPU init) checks
+       IsInitialized() first. WriteSoundBlasterDSP itself has a
+       100000-iter timeout on the DSP write-status port (0x22D bit 7)
+       which is reliable per W22-WB-F probe section 10 evidence. */
+    WriteSoundBlasterDSP(0x34);
+}
+
+void SDL_DOSAudioSB_DSPMidiWriteByte(Uint8 byte)
+{
+    WriteSoundBlasterDSP(0x38);
+    WriteSoundBlasterDSP(byte);
+}
+
 static Uint8 ReadSoundBlasterDSP(void)
 {
     const int query_port = soundblaster_base_port + 0xA;
diff --git a/src/core/dos/SDL_dos_audio_synth.c b/src/core/dos/SDL_dos_audio_synth.c
index a5509d3cd..3693d0961 100644
--- a/src/core/dos/SDL_dos_audio_synth.c
+++ b/src/core/dos/SDL_dos_audio_synth.c
@@ -60,7 +60,78 @@
    indicates "not initialized" (WriteByte becomes a no-op). */
 static int s_mpu401_port_base = -1;
 
+/* DOSKUTSU patch (Phase 10 patch 0047): dispatch path selector.
+   true = DSP-mediated MIDI (default) -- funnels through SB16 DSP cmd 0x34
+          + 0x38 via SDL_DOSAudioSB_DSPMidi* helpers (vendor/SDL/src/audio/
+          dos/SDL_dosaudio_sb.c).
+   false = direct-port (Option A from analysis) -- writes to port_base+0/1
+           directly. Selected when SDL_HINT_DOSKUTSU_AUDIO_WB_DIRECT_PORT=1.
+   Per W22-WB-F MPUPROBE forensic analysis (docs/MPUPROBE-W22WB-F-ANALYSIS.md),
+   DSP-mediated avoids cross-firmware races between MPU-port access and
+   DSP DMA programming that caused W22-WB-C/D lockups. */
+static bool s_mpu401_use_dsp = true;
+
+/* Forward declaration: direct-port path body (extracted from patch-0044
+   SDL_DOSMpu401Init for patch-0047 path-split). Callable only from
+   SDL_DOSMpu401Init's direct-port branch. */
+static bool SDL_DOSMpu401Init_DirectPort(uint16_t port_base);
+
 bool SDL_DOSMpu401Init(uint16_t port_base)
+{
+    /* DOSKUTSU patch (Phase 10 patch 0047): default = DSP-mediated MIDI.
+
+       W22-WB-F MPUPROBE forensic analysis (docs/MPUPROBE-W22WB-F-ANALYSIS.md)
+       showed that direct-port MPU-401 access causes lockups under SDL load
+       on real SB16 PnP CTL0026. The DSP-mediated path (DSP cmd 0x34 enter
+       UART + cmd 0x38 dispatch) was probe-validated on the same hardware
+       in section 10. DSP-mediated funnels all chip access through one
+       bus contender (port 0x22C), eliminating cross-firmware races.
+
+       Direct-port path (Option A from analysis) retained behind opt-in
+       hint SDL_HINT_DOSKUTSU_AUDIO_WB_DIRECT_PORT=1 for hardware where
+       DSP-mediated turns out to be fragile. Strict-1 env-var match per
+       CLAUDE.md.
+
+       Init-order discipline: both paths require the SB16 audio backend
+       to be open. Engine (nx-engine MidiBackendWaveBlaster) is responsible
+       for calling SDL_DOSMpu401Init AFTER SoundManager::init has run AND
+       after the audio thread has serviced at least one frame (per
+       analysis sec. "Recommendations for sdl-engine SDL/0047 author" hard-no
+       #3). We check IsInitialized() here as a minimum sanity gate. */
+    const char *direct_env = SDL_getenv("SDL_HINT_DOSKUTSU_AUDIO_WB_DIRECT_PORT");
+    const bool use_direct = (direct_env && direct_env[0] == '1' && direct_env[1] == 0);
+
+    if (!use_direct) {
+        /* === Default path: DSP-mediated MIDI (Option B) === */
+        if (!SDL_DOSAudioSB_IsInitialized()) {
+            doskutsu_dbg_log("mpu401: DSP-mediated init aborted -- SB16 backend "
+                             "not initialized (engine init order bug). Engine "
+                             "must SDL_AudioBackend_Init before calling "
+                             "SDL_DOSMpu401Init.");
+            return false;
+        }
+        doskutsu_dbg_log("mpu401: DSP-mediated init at port_base=0x%04x "
+                         "(default since patch 0047; DSP cmd 0x34 UART entry; "
+                         "set SDL_HINT_DOSKUTSU_AUDIO_WB_DIRECT_PORT=1 to use "
+                         "direct-port path instead)",
+                         (unsigned)port_base);
+        SDL_DOSAudioSB_DSPMidiEnterUART();
+        s_mpu401_port_base = (int)port_base;  /* sentinel = "ready"; not used for I/O */
+        s_mpu401_use_dsp = true;
+        return true;
+    }
+
+    /* === Opt-in path: direct-port MPU-401 (Option A; legacy 0044 default) === */
+    s_mpu401_use_dsp = false;
+    return SDL_DOSMpu401Init_DirectPort(port_base);
+}
+
+/* DOSKUTSU patch (Phase 10 patch 0047): direct-port path extracted from
+   the patch-0044 SDL_DOSMpu401Init body. Entry guarded behind the
+   SDL_HINT_DOSKUTSU_AUDIO_WB_DIRECT_PORT=1 hint. Body unchanged from
+   0044 except for the function name + the s_mpu401_use_dsp = false
+   assignment (set in caller before invoking this). */
+static bool SDL_DOSMpu401Init_DirectPort(uint16_t port_base)
 {
     /* DOSKUTSU patch (Phase 10 patch 0044): SKIP the probe by default.
 
@@ -171,13 +242,28 @@ void SDL_DOSMpu401WriteByte(uint8_t byte)
     if (s_mpu401_port_base < 0) {
         return; /* not initialized; silent no-op per docs */
     }
-    const Uint16 base = (Uint16)s_mpu401_port_base;
-    /* Spin until DRR clear (data ready to receive). On real HW with a
-       fast wavetable like DreamBlaster S2, this is typically already
-       clear; the spin is sub-us. */
-    while ((inportb((Uint16)(base + 1)) & 0x40) != 0) {
-        /* spin */
+
+    /* DOSKUTSU patch (Phase 10 patch 0047): dispatch via DSP-mediated
+       path when default; via direct-port when SDL_HINT_DOSKUTSU_AUDIO_
+       WB_DIRECT_PORT=1 was set at init time. */
+    if (s_mpu401_use_dsp) {
+        /* DSP-mediated: WriteSoundBlasterDSP polls DSP write-status
+           (port 0x22D bit 7) which IS reliable per W22-WB-F probe
+           section 10. Two DSP writes per MIDI byte; ~us each. NO
+           polling on the lying MPU status bit 7. */
+        SDL_DOSAudioSB_DSPMidiWriteByte(byte);
+        return;
     }
+
+    /* Direct-port path (Option A; legacy 0044 default). Per W22-WB-F
+       analysis hard-no #1: do NOT poll MPU status bit 7 (TX-READY)
+       before writing -- it never clears on SB16 PnP CTL0026. The
+       previous implementation's `while ((inportb(base+1) & 0x40) != 0)`
+       happened to work only because bit 6 (DRR) is a different bit
+       than bit 7 (TX-READY); but on chips where bit 6 also lies, this
+       would hang. Removing the poll altogether per analysis Option A
+       step 5 -- "BLIND write; do not poll status". */
+    const Uint16 base = (Uint16)s_mpu401_port_base;
     outportb(base, byte);
 }
 
@@ -186,10 +272,32 @@ void SDL_DOSMpu401Shutdown(void)
     if (s_mpu401_port_base < 0) {
         return; /* never initialized; nothing to reset */
     }
-    /* Reset to BIOS-default state. Suppress ACK polling on shutdown --
-       process is exiting; we don't care if reset is acknowledged. */
-    outportb((Uint16)(s_mpu401_port_base + 1), 0xFF);
+
+    /* DOSKUTSU patch (Phase 10 patch 0047): no teardown DSP command
+       needed for DSP-mediated path. Per W22-WB-F MPUPROBE analysis:
+       "DSP cmd 0xD3 to disable speaker is sufficient at shutdown" --
+       the existing audio-backend CloseDevice (DOSSOUNDBLASTER_CloseDevice
+       in SDL_dosaudio_sb.c) issues 0xD3 as part of its standard
+       teardown, silencing MIDI output through the WaveBlaster header
+       alongside the DAC.
+
+       Engine (MidiBackendWaveBlaster::~MidiBackendWaveBlaster) has
+       already issued all-notes-off MIDI bytes through the DSP path
+       BEFORE calling SDL_DOSMpu401Shutdown -- so no sustaining notes
+       remain. We just clear our state here.
+
+       Direct-port path retains the 0xFF reset write for symmetry with
+       what users opting into that path would expect. */
+    if (s_mpu401_use_dsp) {
+        /* DSP-mediated: no MPU port writes needed; engine's all-notes-
+           off already went through the DSP path. The audio-backend
+           CloseDevice's 0xD3 will silence final hold notes. */
+    } else {
+        /* Direct-port: reset to BIOS-default state. */
+        outportb((Uint16)(s_mpu401_port_base + 1), 0xFF);
+    }
     s_mpu401_port_base = -1;
+    s_mpu401_use_dsp = true; /* reset to default for next init cycle */
 }
 
 uint16_t SDL_DOSMpu401GetBLASTERPort(void)
