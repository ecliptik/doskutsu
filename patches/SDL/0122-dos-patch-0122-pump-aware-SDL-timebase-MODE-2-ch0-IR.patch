                      (unsigned)s_pcspk_fire_hz, PCSPK_NOTE_RING);
+    /* SDL/0122: one-shot boot banner (smoke BANNERS gate anchors on this line). */
+    doskutsu_dbg_log("audio: SDL/0122 pump-aware timebase %s (PIT ch0 MODE %d; "
+                     "SDL_GetPerformanceCounter derived from the IRQ-0 period "
+                     "counter, rebased at PumpStart perf_base=%lu; killswitch "
+                     "SDL_HINT_DOSKUTSU_PUMP_TIMEBASE=0 -> MODE 3 + uclock "
+                     "staircase)",
+                     s_pump_timebase ? "ENABLED" : "DISABLED(killswitch=0)",
+                     s_pump_timebase ? 2 : 3,
+                     (unsigned long)s_pump_perf_base);
