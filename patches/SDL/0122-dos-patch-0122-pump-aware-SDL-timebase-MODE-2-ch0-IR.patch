  * DOSKUTSU patch (SDL/0118, Campaign 2 Phase 2): PC-speaker square-wave SFX
  * ========================================================================
@@ -1347,6 +1382,12 @@ static void OplPitChainOld_End(void) {}
    enters this as a plain C function). Runs with interrupts disabled. */
 static void OplPitISR(void)
 {
+    /* SDL/0122: one PIT-ch0 period elapsed. This counter, times div, is the
+       coarse part of the pump-aware perf clock (phase from the live latch is
+       the fine part). Bare increment; the main-line reader reconciles it
+       against the latch with a consistency retry. */
+    s_isr_count++;
+
     /* 1. advance the monotonic clock by one fast-tick period (no 64-bit
        divide in-ISR: collapse the us accumulator to ms with a small loop). */
     s_us_frac += s_us_per_tick;
@@ -1369,6 +1410,7 @@ static void OplPitISR(void)
     s_bios_accum += s_pit_div;
     if (s_bios_accum >= 65536u) {
         s_bios_accum -= 65536u;
+        s_bios_chain++;        /* SDL/0122 ride-along: count actual BIOS chains */
         OplPitChainOld();      /* original BIOS INT 8 runs + EOIs */
     } else {
         DOS_EndOfInterrupt(0); /* master-PIC EOI (IRQ-0) */
@@ -1385,6 +1427,9 @@ static void OplPitISR_End(void) {}
    divide (the note ring holds precomputed divisors). DPMI-locked. */
