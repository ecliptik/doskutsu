+    /* SDL/0122: period counter (identical to OplPitISR -- see there). */
+    s_isr_count++;
+
     /* 1. advance the monotonic clock (identical to OplPitISR). */
     s_us_frac += s_us_per_tick;
     while (s_us_frac >= 1000u) {
@@ -1421,6 +1466,7 @@ static void OplPitBeepISR(void)
     s_bios_accum += s_pit_div;
     if (s_bios_accum >= 65536u) {
         s_bios_accum -= 65536u;
+        s_bios_chain++;        /* SDL/0122 ride-along: count actual BIOS chains */
