@@ -1464,6 +1510,21 @@ bool SDL_DOSOplTimerPumpStart(int hz)
        (SDL_DOSMidiTickRegister) BEFORE Start, mirroring the SB init order. */
     s_pump_tick_cb = SDL_DOSMidiTickGetRegistered();
 
+    /* SDL/0122: resolve the pump-aware-timebase killswitch (strict-"0", DEFAULT
