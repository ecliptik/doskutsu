 }
 
@@ -1586,6 +1663,27 @@ void SDL_DOSOplTimerPumpStop(void)
                      "to 18.2065 Hz; IRQ-0 unhooked; timer left unmasked)%s",
                      s_pcspk_sfx_enabled ? "; SDL/0118 PC-speaker restored (ch2+0x61)"
                                          : "");
+
+    /* SDL/0122 ride-along: the IRQ-0 unhook above is done, so s_isr_count and
+       s_bios_chain are now stable. Print the standing clock-skew question as a
+       number: each BIOS chain should fire once per 65536 PIT clocks worth of
+       fast ticks, i.e. expected = isr_count*div/65536. actual < expected means
+       IRQ-0 fires were missed (interrupts masked > one fast-tick period),
+       which is the only way the pump can lose DOS time. delta != 0 bounds the
+       skew on every future run without any bench time. */
+    {
+        const uint32_t div = s_pit_div ? s_pit_div : 1u;
+        const Uint64 expected = ((Uint64)s_isr_count * (Uint64)div) / 65536ULL;
+        const long   delta    = (long)((Sint64)s_bios_chain - (Sint64)expected);
+        doskutsu_dbg_log("audio: SDL/0122 pump teardown -- isr_count=%lu div=%u "
+                         "expected_bios_chains=%lu actual_bios_chains=%lu "
+                         "delta=%ld (delta<0 == IRQ-0 fires lost while interrupts "
+                         "were masked; delta==0 == no DOS time lost; timebase=%s)",
+                         (unsigned long)s_isr_count, (unsigned)div,
+                         (unsigned long)expected, (unsigned long)s_bios_chain,
+                         delta,
+                         s_pump_timebase ? "MODE2/ON" : "MODE3/off(killswitch)");
+    }
 }
 
 bool SDL_DOSOplTimerPumpActive(void)
@@ -1593,6 +1691,56 @@ bool SDL_DOSOplTimerPumpActive(void)
     return s_opl_pump_active;
 }
 
+/* DOSKUTSU patch (SDL/0122): monotonic PIT-clock delta since pump Start, in
+   PIT-input-clock units (1.193 MHz ~= UCLOCKS_PER_SEC 1193180, within ~2 ppm --
+   negligible against SDL's ms/ns rounding). Main-line only (SDL_GetPerformance-
+   Counter). uclock-style consistency retry around the latch: if an IRQ-0 fire
+   (which bumps s_isr_count) lands between the two reads of the period counter,
+   the count we latched belongs to a different period, so retry. With interrupts
+   ENABLED the pending IRQ-0 runs immediately, so a rollover mid-read always
+   shows as c1 != c2 -- do NOT cli here (that would defer the ISR and desync
+   s_isr_count from the latched count across a wrap). */
+static Uint64 opl_pump_pit_delta(void)
+{
+    const uint32_t div = s_pit_div ? s_pit_div : 1u;
+    uint32_t c1, c2;
+    uint16_t count = (uint16_t)div;
+    int guard = 0;
+    do {
+        c1 = s_isr_count;
+        outportb(0x43, 0x00);                     /* latch ch0 (non-destructive) */
+        count  = (uint16_t)inportb(0x40);         /* LSB */
+        count |= (uint16_t)(inportb(0x40) << 8);  /* MSB */
+        c2 = s_isr_count;
+    } while (c1 != c2 && ++guard < 8);
+    /* MODE 2 counts down div..1 (never 0); phase = counts elapsed this period. */
+    {
+        const uint32_t phase = (count != 0u && count <= div) ? (div - (uint32_t)count) : 0u;
+        return ((Uint64)c2 * (Uint64)div) + (Uint64)phase;
+    }
+}
+
+/* \returns the pump-aware performance counter (perf_base + PIT delta), rebased
+   at Start for continuity with uclock. Valid only while the MODE-2 timebase is
+   engaged; returns 0 otherwise (SDL_systimer.c gates on
+   SDL_DOSOplTimerTimebaseActive() before calling). */
+Uint64 SDL_DOSOplTimerPumpPerfCounter(void)
+{
+    if (!s_pump_timebase || !s_opl_pump_active) {
+        return 0;
+    }
+    return s_pump_perf_base + opl_pump_pit_delta();
+}
+
+/* \returns true when the MODE-2 pump timebase owns ch0 and SDL_systimer.c
+   should derive the perf counter from SDL_DOSOplTimerPumpPerfCounter() instead
+   of uclock(). False on all SB-present configs (pump never starts) and when the
+   killswitch reverted the pump to MODE 3. */
+bool SDL_DOSOplTimerTimebaseActive(void)
+{
+    return s_opl_pump_active && s_pump_timebase;
+}
+
 /* DOSKUTSU patch (SDL/0110): shared ISR-active predicate. True if either the
    SB16 IRQ-5 MIDI tick OR the AdLib PIT/IRQ-0 pump is driving the scheduler.
    The engine's MidiScheduler reentrancy guards switch to this so they engage
diff --git a/src/timer/dos/SDL_systimer.c b/src/timer/dos/SDL_systimer.c
index d47bae177..b1af263e4 100644
--- a/src/timer/dos/SDL_systimer.c
+++ b/src/timer/dos/SDL_systimer.c
@@ -26,17 +26,38 @@
 #include <time.h> /* uclock, uclock_t, UCLOCKS_PER_SEC */
 
 #include "../../core/dos/SDL_dos_scheduler.h"
+#include <SDL3/SDL_dosopltimer.h>  /* SDL/0122: pump-aware timebase */
 
 /* DJGPP's uclock() reprograms PIT channel 0 for a higher tick rate on first
    call, giving ~1.19 MHz resolution (UCLOCKS_PER_SEC == 1193180).  This is
    the same approach SDL2-dos used and gives sub-microsecond precision without
    any extra setup. */
 
-Uint64 SDL_GetPerformanceCounter(void)
+/* DOSKUTSU patch (SDL/0122): pump-aware timebase.
+
+   The AdLib/GUS OPL music pump (SDL/0110) reprograms PIT ch0 -- the same
+   counter uclock() reads -- so while it runs uclock()'s sub-tick value is
+   meaningless and SDL's whole clock staircases at the 55 ms BIOS tick. When the
+   pump owns ch0 in its MODE-2 readable configuration, derive the perf counter
+   from the pump's own IRQ-0 period counter instead (rebased at PumpStart so the
+   timeline is continuous with uclock before and after). On every SB-present
+   config the pump never starts, and the killswitch reverts it to MODE 3, so in
+   both cases this falls through to the unchanged uclock() path. Both sources
+   share the ~1.193 MHz PIT frequency, so UCLOCKS_PER_SEC stays the perf
+   frequency and SDL_SYS_DelayNS's math is unaffected. */
+static Uint64 dos_perf_now(void)
 {
+    if (SDL_DOSOplTimerTimebaseActive()) {
+        return SDL_DOSOplTimerPumpPerfCounter();
+    }
     return (Uint64)uclock();
 }
 
+Uint64 SDL_GetPerformanceCounter(void)
+{
+    return dos_perf_now();
+}
+
 Uint64 SDL_GetPerformanceFrequency(void)
 {
     return (Uint64)UCLOCKS_PER_SEC;
@@ -49,18 +70,21 @@ void SDL_SYS_DelayNS(Uint64 ns)
         return;
     }
 
-    const uclock_t delay_start = uclock();
-    const uclock_t target_ticks = (uclock_t)((ns * UCLOCKS_PER_SEC) / SDL_NS_PER_SECOND);
+    /* SDL/0122: read the clock through dos_perf_now() so the delay follows the
+       pump-aware timebase when the OPL pump owns ch0 (uclock is unreliable
+       there). Same UCLOCKS_PER_SEC frequency, so target_ticks is unchanged. */
+    const Uint64 delay_start = dos_perf_now();
+    const Uint64 target_ticks = (Uint64)((ns * UCLOCKS_PER_SEC) / SDL_NS_PER_SECOND);
 
-    while ((uclock() - delay_start) < target_ticks) {
+    while ((dos_perf_now() - delay_start) < target_ticks) {
         /* Always yield first so cooperative threads can run. */
         DOS_Yield();
 
         /* If more than 1 ms remains, do a short sleep to avoid burning
            100% CPU when no other threads need to run.  DJGPP's delay()
            is a busy-wait but it does halt-loop on the PIT, which is
-           lighter than a tight uclock() poll. */
-        uclock_t remaining = target_ticks - (uclock() - delay_start);
+           lighter than a tight poll. */
+        Uint64 remaining = target_ticks - (dos_perf_now() - delay_start);
         if (remaining > (UCLOCKS_PER_SEC / 1000)) {
             delay(1);
         }
