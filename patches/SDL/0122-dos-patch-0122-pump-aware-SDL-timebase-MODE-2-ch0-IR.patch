+/* ========================================================================
+ * DOSKUTSU patch (SDL/0122): pump-aware SDL timebase.
+ * ========================================================================
+ * THE BUG (diagnosed in GUS-ADLIB-FPS-FINDINGS.md): SDL/0110 reprograms PIT
+ * ch0 (div=9943, MODE 3), but ch0 is the same counter DJGPP uclock() reads,
+ * and uclock() is the ONLY timebase behind SDL_GetTicks / SDL_GetTicksNS /
+ * SDL_GetPerformanceCounter / SDL_Delay on DOS. uclock() assumes it owns ch0
+ * as a full-65536 sweep, so with the pump active SDL's clock freezes between
+ * 55 ms BIOS ticks (with +/-8 ms local jitter, INCLUDING GOING BACKWARDS) and
+ * jumps ~55 ms per tick. The engine's fixed-timestep accumulator runs off that
+ * staircase, so ~40% of rendered frames repeat an unchanged world -- the game
+ * FEELS like 18 fps on the gus/adlib backends while rendering ~28.
+ *
+ * THE FIX: program ch0 in MODE 2 (rate generator, control 0x34) instead of
+ * MODE 3 (0x36). Both fire IRQ-0 once per `div` counts, so the music tick rate
+ * and the BIOS-INT8 chain are UNCHANGED -- but MODE 2's latched counter
+ * single-sweeps div->1 linearly, so sub-tick phase is readable. The ISR keeps
+ * a DPMI-locked period counter (s_isr_count); a main-line reader returns the
+ * monotonic PIT-clock delta since Start (isr_count*div + phase), and
+ * SDL_systimer.c derives SDL_GetPerformanceCounter from it, rebased at Start so
+ * the timeline is continuous with uclock before and after the pump.
+ *
+ * Killswitch SDL_HINT_DOSKUTSU_PUMP_TIMEBASE=0 (strict-"0", DEFAULT ON) reverts
+ * ch0 to MODE 3 + uclock -- byte-identical to the pre-0122 (v1.6.x) behavior,
+ * the escape hatch if MODE-2 latch reads misbehave on some real board (the
+ * design's RTC/IRQ-8 fallback is the next step if that happens; see
+ * SDL_dosopltimer.h). All ch0-timebase state is ISR-touched -> volatile +
+ * DPMI-locked at Start. */
+static bool              s_pump_timebase   = false;  /* MODE-2 timebase engaged (main-line only) */
+static volatile uint32_t s_isr_count       = 0;      /* pump ISR fires since Start (period counter) */
+static volatile uint32_t s_bios_chain      = 0;      /* actual BIOS INT8 chains since Start (ride-along) */
+static Uint64            s_pump_perf_base   = 0;      /* uclock() snapshot at Start (continuity rebase) */
+
