+/**
+ * # CategoryDOSAudioShutdown
+ *
+ * **DOSKUTSU local addition (patches/SDL/0053, never upstreamed).** This
+ * header exports a single SDL3-DOS audio-backend helper: the engine signals
+ * "audio teardown is starting" before calling `MIX_DestroyMixer` so the
+ * backend can pre-empt its own SDL/0050 quiescence-gate path. Without that
+ * signal, the audio thread can be inside `SDL_Delay(10)` inside
+ * `DOSSOUNDBLASTER_GetDeviceBuf` *while holding `device->lock`*, and the
+ * cooperative scheduler under DOS prevents the main thread from acquiring
+ * the same lock long enough to set the SDL atomic shutdown flag. Result:
+ * indefinite freeze on Quit-to-DOS (iter L L1 2026-05-08, iter M M1
+ * 2026-05-08; see `docs/PHASE11-ITER-M-FREEZE-DIAGNOSTIC.md` for the full
+ * call-chain trace).
+ *
+ * ## How it works
+ *
+ * `SDL_DOSAudioBeginShutdown()` flips the same module-scope state variable
+ * that the SDL/0050 killswitch (`SDL_HINT_DOSKUTSU_DOS_AUDIO_QUIESCENCE_GATE`
+ * = "0") already controls. From the next `DOSSOUNDBLASTER_GetDeviceBuf`
+ * iteration on, the gate is bypassed — `GetDeviceBuf` returns the staging
+ * buffer normally without entering the 10 ms `SDL_Delay` quiescence-walk
+ * path. The audio thread cycles fast through `PlaybackAudioThreadIterate`,
+ * releases `device->lock` on each iteration, and the main thread wins the
+ * `SDL_LockMutex(device->lock)` call in `DestroyPhysicalAudioDevice`
+ * within at most one residual delay window (≤10 ms). Main then sets
+ * `device->shutdown = 1`, releases the lock, and joins the audio thread
+ * via `SDL_WaitThread`. Clean teardown.
+ *
+ * Reusing the existing killswitch state — rather than introducing a new
+ * `g_dos_audio_shutting_down` flag — avoids the state-flag fragmentation
+ * footgun documented in the SDL/0048 follow-up work (see
+ * `memory/sdl_pause_api_must_audit_auto_resume_gates.md`).
+ *
+ * ## When to call it
+ *
+ * From `SoundManager::shutdown()` (or equivalent engine teardown path)
+ * **immediately before** the call to `MIX_DestroyMixer`. The
+ * `[3/6] pre-Pixtone::shutdown` → `[4/6] pre-MIX_DestroyMixer` window in
+ * the doskutsu engine's `snd-shutdown` log markers is the canonical
+ * insertion point.
+ *
+ * ## Lifecycle + idempotence
+ *
+ * - The call is **one-shot per process lifetime**, but **idempotent**:
+ *   calling it twice has no additional effect (the underlying flag is
+ *   already set).
+ * - Safe to call even when `SDL_HINT_DOSKUTSU_DOS_AUDIO_QUIESCENCE_GATE=0`
+ *   killswitched the gate at OpenDevice time — the flag is already true;
+ *   this is a no-op redundant set.
+ * - Safe to call even when the audio device was never opened, or when
+ *   audio is otherwise uninitialized — the function simply writes to a
+ *   static module-scope variable; no SDL API dependencies.
+ * - The flag is **reset** the next time `DOSSOUNDBLASTER_OpenDevice` is
+ *   called (open-time hint re-resolution) — so if a future engine
+ *   re-initializes audio in the same process (Cave Story never does),
+ *   the gate engages again per the hint state.
+ *
+ * ## Threading
+ *
+ * The flag is a plain `bool` written by main (`SDL_DOSAudioBeginShutdown`)
+ * and read by the audio thread (`DOSSOUNDBLASTER_GetDeviceBuf`). On x86
+ * (DJGPP target), aligned bool writes are atomic; readers see either the
+ * old or new value but never a torn read. A racing reader observing the
+ * old value at most enters one more SDL_Delay(10) cycle before re-reading.
+ * No barrier or atomic primitive is required.
+ *
+ * ## Real-HW gate
+ *
+ * Per `memory/dosbox_not_behavioral_proxy_for_io.md`, DOSBox-X cannot
+ * reliably reproduce the cooperative-scheduler-vs-mutex contention timing
+ * that produces the freeze on real PODP83 + SB16. A DOSBox-X smoke gate
+ * can verify structural correctness (the new path executes, the log
+ * markers emit, the game still hits title) but only a real-hardware
+ * Quit-to-DOS cycle confirms the fix engages behaviorally. The wave-33
+ * PLAY matrix carries a dedicated quit-cycle cell for this gate.
+ *
+ * Like SDL_dosvesa_directaccess.h, this header is a workspace-local
+ * doskutsu addition. SDL/0053 hunks and these declarations are not
+ * contributed back to libsdl-org/SDL.
+ */
+
+#ifndef SDL_dosaudio_shutdown_h_
+#define SDL_dosaudio_shutdown_h_
+
+#include <SDL3/SDL_stdinc.h>
+
+#include <SDL3/SDL_begin_code.h>
+/* Set up for C function definitions, even when using C++ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Signal to the SDL3-DOS audio backend that engine-side teardown has begun
+ * and the SDL/0050 GetDeviceBuf quiescence gate should be disabled for the
+ * remainder of the process lifetime.
+ *
+ * Call this from the engine's audio-shutdown path immediately before
+ * `MIX_DestroyMixer()`. See the header-level documentation above for the
+ * call-chain reasoning and threading semantics.
+ *
+ * Idempotent; safe to call when audio was never initialized, when the gate
+ * is already killswitched, or repeatedly.
+ *
+ * \threadsafety Call from the main thread (the same thread that will call
+ *               `MIX_DestroyMixer`). Concurrent calls from other threads
+ *               are technically safe (single-bit one-way flag flip) but
+ *               not the intended use.
+ *
+ * \since SDL 3 — doskutsu workspace-local patch 0053, 2026-05-11.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSAudioBeginShutdown(void);
+
+/* Ends C function definitions when using C++ */
+#ifdef __cplusplus
+}
+#endif
+#include <SDL3/SDL_close_code.h>
+
+#endif /* SDL_dosaudio_shutdown_h_ */
