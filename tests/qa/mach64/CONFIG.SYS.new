[menu]
menuitem=VIBRAUSB, Vibra16 + PicoGUS USB (CD + MIDI)
menuitem=PGSB, PicoGUS Sound Blaster
menuitem=PGADLIB, PicoGUS AdLib
menuitem=PGGUS, PicoGUS Ultrasound
menuitem=VIBRA, Vibra16 only
menuitem=MACH64, Mach64 video test (M64VBE, no UniVBE)
menudefault=VIBRAUSB,5

[COMMON]
DOS=HIGH,UMB
FILES=30
BUFFERS=20
LASTDRIVE=M
STACKS=0,0
SHELL=C:\DOS\COMMAND.COM C:\DOS\ /P /E:1024
DEVICE=C:\DOS\HIMEM.SYS /TESTMEM:OFF
DEVICE=C:\DOS\EMM386.EXE NOEMS I=B000-B7FF I=C800-EFFF
REM real ATAPI optical drive (device OPTICAL = drive E:); present in EVERY profile
DEVICEHIGH=C:\DRIVERS\VIDECDD.SYS /D:OPTICAL

[VIBRAUSB]
REM PicoGUS USB-mode CD-ROM emulation (device MSCD000 = drive D:); USB mode only
DEVICEHIGH=C:\PICOGUS\CDMKE.SYS /P:250 /Q

[PGSB]

[PGADLIB]

[PGGUS]

[VIBRA]

[MACH64]
