+// DOSKUTSU patch 0077 (S3-2 Stage 1) -- bounded vblank wait. The existing
+// WaitForVBlank() at line ~1098 spins on the VGA status port with NO
+// timeout; in the VRAM-resident flip path that is a HW-IO hang risk on
+// real hardware if the retrace bit never toggles (a broken/odd mode can
+// hard-freeze g2k -- dosbox_not_proxy). This variant bounds each spin
+// with a guard so the worst case is a finite stall + fall-through, never
+// an infinite hang. Used AFTER the 0x4F07 display-start program so the
+// CRTC start-address latch (at vsync) has taken effect before we return
+// (fixes the wave-50 flicker, whose bug was waiting BEFORE the program).
+static void _vram_resident_wait_vblank_bounded(void)
+{
+    long guard;
+    // If currently inside a vblank, wait for it to end so we catch a
+    // fresh leading edge below.
+    for (guard = 0; (inportb(VGA_STATUS_PORT) & VGA_STATUS_VBLANK) &&
+                    guard < 2000000L; ++guard) {
+        SDL_CPUPauseInstruction();
+    }
+    // Wait for the next vblank to begin (the start-address latch boundary).
+    for (guard = 0; !(inportb(VGA_STATUS_PORT) & VGA_STATUS_VBLANK) &&
+                    guard < 2000000L; ++guard) {
+        SDL_CPUPauseInstruction();
+    }
+}
