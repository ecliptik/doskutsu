+    const Uint8 id_hi = _crtc_read(0x2D);
+    const Uint8 id_lo = _crtc_read(0x2E);
+    const Uint16 chip_id = (Uint16)(((Uint16)id_hi << 8) | id_lo);
+    if (out_chip_id) {
+        *out_chip_id = chip_id;
+    }
+    return (chip_id == 0x8A01);
